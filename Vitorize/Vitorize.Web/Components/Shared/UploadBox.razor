@using Vitorize.Web.Models.Admin.Common
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject ToastService Toasts
@inject IJSRuntime JS

<div class="vz-upload">
    @if (!string.IsNullOrWhiteSpace(Value))
    {
        <div class="vz-upload__preview">
            <img src="@Media.Resolve(Value)" alt="پیش‌نمایش" />
            <button type="button" class="vz-iconaction danger" @onclick="Clear" title="حذف تصویر">
                <Icon Name="trash" Size="16" />
            </button>
        </div>
    }
    else
    {
        <label class="vz-upload__drop @(_busy ? "busy" : "")">
            <InputFile OnChange="OnChange" accept="@Accept" disabled="@_busy" />
            @if (_busy)
            {
                <span class="vz-spinner sm"></span>
                <span class="vz-muted">در حال آپلود ...</span>
            }
            else
            {
                <span class="vz-upload__icon"><Icon Name="upload" Size="22" /></span>
                <span style="font-weight:700">@Label</span>
                <span class="vz-hint">@Guidance</span>
            }
        </label>
    }
</div>

<style>
    .vz-upload__drop { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; padding:26px; border:1.5px dashed var(--border-strong); border-radius:var(--clip-xs); background:var(--surface-2); cursor:pointer; text-align:center; transition:border-color .15s, background .15s; }
    .vz-upload__drop:hover { border-color: var(--admin-primary); background: var(--admin-primary-soft); }
    .vz-upload__drop input[type=file] { display:none; }
    .vz-upload__icon { width:46px; height:46px; border-radius:var(--clip-xs); background:var(--admin-primary-soft); color:var(--admin-primary); display:flex; align-items:center; justify-content:center; }
    .vz-upload__preview { position:relative; width:100%; border:1px solid var(--border); border-radius:var(--clip-xs); overflow:hidden; background:var(--surface-2); }
    .vz-upload__preview img { width:100%; max-height:220px; object-fit:contain; display:block; }
    .vz-upload__preview .vz-iconaction { position:absolute; top:10px; inset-inline-start:10px; background:var(--surface-solid); }
</style>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string Label { get; set; } = "برای آپلود تصویر کلیک کنید";
    [Parameter] public string Endpoint { get; set; } = "admin/uploads/product-image";
    [Parameter] public string Accept { get; set; } = "image/png,image/jpeg,image/webp,image/heic,image/heif,.jpg,.jpeg,.png,.webp,.heic,.heif";
    [Parameter] public string Guidance { get; set; } = "PNG، JPG، JPEG، WEBP یا HEIC — حداکثر ۲ مگابایت";
    [Parameter] public long MaxSizeBytes { get; set; } = 2 * 1024 * 1024;

    private bool _busy;

    private sealed class ConvertedImageResult
    {
        public string? Base64 { get; set; }
    }

    private async Task OnChange(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        if (file.Size > MaxSizeBytes)
        {
            Toasts.Error($"حجم تصویر نباید بیشتر از {MaxSizeBytes / (1024 * 1024)} مگابایت باشد.");
            return;
        }

        _busy = true;
        try
        {
            await using var input = file.OpenReadStream(MaxSizeBytes);
            Stream stream = input;
            var fileName = file.Name;
            var contentType = file.ContentType;
            MemoryStream? convertedStream = null;
            if (IsHeic(file))
            {
                await using var buffer = new MemoryStream();
                await input.CopyToAsync(buffer);
                var converted = await JS.InvokeAsync<ConvertedImageResult>("vzImageUpload.convertHeicToJpeg", buffer.ToArray());
                var convertedBytes = string.IsNullOrWhiteSpace(converted?.Base64)
                    ? Array.Empty<byte>()
                    : Convert.FromBase64String(converted.Base64);
                if (convertedBytes.Length == 0 || convertedBytes.Length > MaxSizeBytes)
                {
                    Toasts.Error("نسخه JPEG تصویر معتبر نیست یا از حداکثر حجم مجاز بیشتر است.");
                    return;
                }
                convertedStream = new MemoryStream(convertedBytes, writable: false);
                stream = convertedStream;
                fileName = Path.ChangeExtension(file.Name, ".jpeg");
                contentType = "image/jpeg";
            }

            await using (convertedStream)
            {
            var result = await Api.UploadAsync<UploadResultModel>(
                Endpoint, stream, fileName, contentType);

            if (result.IsSuccess && result.Data is not null)
            {
                Value = result.Data.FilePath;
                await ValueChanged.InvokeAsync(Value);
                Toasts.Success("تصویر با موفقیت آپلود شد.");
            }
            else
            {
                Toasts.Error(string.IsNullOrWhiteSpace(result.Message) ? "آپلود تصویر ناموفق بود." : result.Message);
            }
            }
        }
        catch (JSException)
        {
            Toasts.Error("تبدیل تصویر HEIC در این مرورگر ممکن نیست. لطفاً تصویر را به JPEG تبدیل کرده یا در تنظیمات دوربین آیفون، فرمت را روی «Most Compatible» بگذارید.");
        }
        catch
        {
            Toasts.Error("آپلود تصویر با خطا مواجه شد.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Clear()
    {
        Value = null;
        await ValueChanged.InvokeAsync(null);
    }

    private static bool IsHeic(IBrowserFile file)
    {
        var extension = Path.GetExtension(file.Name);
        return string.Equals(file.ContentType, "image/heic", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(file.ContentType, "image/heif", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(extension, ".heic", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(extension, ".heif", StringComparison.OrdinalIgnoreCase);
    }
}
