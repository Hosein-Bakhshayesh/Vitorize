@using System.Globalization
@using Microsoft.JSInterop
@using Vitorize.Application.Common
@inject IJSRuntime JS

<div class="vz-datepicker st-datepicker @((ReadOnly ? "is-readonly" : ""))">
    <div class="vz-datepicker__entry">
        @* dir=ltr on the field itself keeps digit entry predictable inside the RTL page: the year is
           typed first and the caret advances rightwards, as it does on every date field. *@
        @* st-input, matching every other field on the identity form. This used to be vz-input, from
           the admin stylesheet, so the birth date sat 2px shorter than its neighbours with a different
           radius, border and focus colour - visible as soon as you looked at the row.

           No autocomplete: the browser's "bday" autofill offers a Gregorian date, which is not what
           this field holds. dir=ltr stays, so digits enter left-to-right inside the RTL page. *@
        <input @ref="_entryElement" class="st-input st-datepicker__entry" type="text" inputmode="numeric"
               autocomplete="off" dir="ltr" maxlength="10" data-testid="persian-date-input"
               aria-label="تاریخ تولد به تقویم شمسی (سال/ماه/روز)"
               placeholder="@Placeholder" value="@_entry"
               @oninput="OnEntryInputAsync" @onchange="CommitEntryAsync" disabled="@ReadOnly" />
        <button type="button" class="vz-iconaction vz-datepicker__toggle" @onclick="Toggle" disabled="@ReadOnly"
                aria-label="باز کردن تقویم تاریخ تولد" aria-expanded="@_open">
            <Icon Name="calendar" Size="17" />
        </button>
        @if (HasValue)
        {
            <button type="button" class="vz-iconaction vz-datepicker__clear" @onclick="ClearAsync" disabled="@ReadOnly" title="پاک کردن" aria-label="پاک کردن تاریخ تولد">
                <Icon Name="x" Size="14" />
            </button>
        }
    </div>

    @* The message is raised through ValidationChanged and rendered by the page, so rendering it here
       as well showed an invalid date twice, stacked. *@

    @if (_open)
    {
        <div style="position:fixed;inset:0;z-index:115" @onclick="Close"></div>
        <div class="vz-cal" @onclick:stopPropagation="true" role="dialog" aria-label="انتخاب تاریخ تولد">
            <div class="vz-cal__head vz-cal__head--selectors">
                <select class="vz-input" aria-label="سال" value="@_viewYear" @onchange="ChangeYearAsync" disabled="@ReadOnly">
                    @foreach (var year in Enumerable.Range(_minYear, _maxYear - _minYear + 1).Reverse())
                    {
                        <option value="@year">@PersianDateHelper.ToPersianDigits(year.ToString(CultureInfo.InvariantCulture))</option>
                    }
                </select>
                <select class="vz-input" aria-label="ماه" value="@_viewMonth" @onchange="ChangeMonthAsync" disabled="@ReadOnly">
                    @for (var month = 1; month <= 12; month++)
                    {
                        <option value="@month">@PersianDateHelper.MonthNames[month - 1]</option>
                    }
                </select>
            </div>
            <div class="vz-cal__head">
                <button type="button" class="vz-cal__nav" @onclick="PrevMonth" disabled="@(ReadOnly || !CanMove(-1))" aria-label="ماه قبل"><Icon Name="chevron-right" Size="16" /></button>
                <div class="vz-cal__title">@MonthTitle</div>
                <button type="button" class="vz-cal__nav" @onclick="NextMonth" disabled="@(ReadOnly || !CanMove(1))" aria-label="ماه بعد"><Icon Name="chevron-left" Size="16" /></button>
            </div>

            <div class="vz-cal__grid">
                @foreach (var d in PersianDateHelper.WeekDayShortNames)
                {
                    <div class="vz-cal__dow">@d</div>
                }
                @for (var i = 0; i < _firstDow; i++)
                {
                    <span class="vz-cal__day empty"></span>
                }
                @for (var day = 1; day <= _daysInMonth; day++)
                {
                    var d = day;
                    var selectable = IsSelectable(d);
                    <button type="button" class="vz-cal__day @(IsSelected(d) ? "selected" : "") @(IsToday(d) ? "today" : "")"
                            @onclick="() => SelectDay(d)" disabled="@(ReadOnly || !selectable)">
                        @PersianDateHelper.ToPersianDigits(d.ToString(CultureInfo.InvariantCulture))
                    </button>
                }
            </div>

            <div class="vz-cal__foot">
                <button type="button" @onclick="SelectToday" disabled="@ReadOnly">امروز</button>
                <button type="button" class="clear" @onclick="ClearAsync" disabled="@ReadOnly">پاک کردن</button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public EventCallback<string?> ValidationChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// Hint text for the field. Six call sites were already passing one - the coupon and banner date
    /// ranges, and both ends of the range picker - while the markup hardcoded a sample date and
    /// ignored them, so "بدون محدودیت" never appeared. It is honoured now, with the sample date as the
    /// default for callers that do not supply one.
    /// </summary>
    [Parameter] public string Placeholder { get; set; } = "۱۳۷۵/۰۶/۱۵";

    private readonly DateTime _minimum = VerificationBirthDateRules.Minimum.ToDateTime(TimeOnly.MinValue);
    private ElementReference _entryElement;
    private bool _maskAttached;
    private bool _open;
    private int _viewYear;
    private int _viewMonth;
    private int _firstDow;
    private int _daysInMonth;
    private int _minYear;
    private int _maxYear;
    private string _entry = "";
    /// <summary>True while the customer is typing, so the field is not reformatted under the caret.</summary>
    private bool _editing;
    private string? _error;
    private DateTime? _lastValue;

    private DateTime Today => DateTime.Today;
    private bool HasValue => PersianDateHelper.IsValid(Value);
    private string MonthTitle => $"{PersianDateHelper.MonthNames[_viewMonth - 1]} {PersianDateHelper.ToPersianDigits(_viewYear.ToString(CultureInfo.InvariantCulture))}";

    /// <summary>
    /// Attaches the shared typing mask once the field exists. The mask inserts the separators as the
    /// customer types; parsing and validation still happen here on the server, so the component
    /// behaves correctly even if the script never runs.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_maskAttached || ReadOnly) return;
        try
        {
            await JS.InvokeVoidAsync("vzPersianDateMask.attach", _entryElement);
            _maskAttached = true;
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { /* still prerendering; retried on the next render */ }
    }

    protected override void OnInitialized()
    {
        var min = PersianDateHelper.ToJalaliParts(_minimum)!.Value;
        var max = PersianDateHelper.ToJalaliParts(Today)!.Value;
        _minYear = min.Year;
        _maxYear = max.Year;
        SyncEntry();
        InitView();
    }

    protected override void OnParametersSet()
    {
        if (Value != _lastValue)
        {
            _lastValue = Value;
            SyncEntry();
            if (!_open) InitView();
        }
    }

    /// <summary>
    /// The text shown in the field.
    ///
    /// Persian digits are the house style for a committed value, but rewriting the field to them the
    /// instant the eighth digit lands replaced the text under the caret - and assigning value collapses
    /// the selection to the end, so the caret jumped away exactly when someone finished typing and
    /// might want to correct the month. While the field is being edited the ASCII form the mask
    /// produces is kept; the Persian form appears once the value is committed from elsewhere.
    /// </summary>
    private void SyncEntry() =>
        _entry = HasValue
            ? (_editing ? PersianDateEntry.Mask(PersianDateHelper.ToShortDate(Value)) : PersianDateHelper.ToShortDate(Value))
            : "";

    private void InitView()
    {
        var parts = PersianDateHelper.ToJalaliParts(Value) ?? PersianDateHelper.ToJalaliParts(Today)!.Value;
        _viewYear = Math.Clamp(parts.Year, _minYear, _maxYear);
        _viewMonth = parts.Month;
        ClampView();
        RecomputeMonth();
    }

    private void ClampView()
    {
        if (_viewYear == _minYear)
        {
            var minMonth = PersianDateHelper.ToJalaliParts(_minimum)!.Value.Month;
            _viewMonth = Math.Max(_viewMonth, minMonth);
        }
        if (_viewYear == _maxYear)
        {
            var maxMonth = PersianDateHelper.ToJalaliParts(Today)!.Value.Month;
            _viewMonth = Math.Min(_viewMonth, maxMonth);
        }
    }

    private void RecomputeMonth()
    {
        _daysInMonth = PersianDateHelper.DaysInMonth(_viewYear, _viewMonth);
        _firstDow = PersianDateHelper.PersianDayOfWeek(_viewYear, _viewMonth, 1);
    }

    private void Toggle()
    {
        if (ReadOnly) return;
        _open = !_open;
        if (_open) InitView();
    }

    private void Close() => _open = false;

    private bool CanMove(int offset)
    {
        var year = _viewYear;
        var month = _viewMonth + offset;
        if (month < 1) { month = 12; year--; }
        if (month > 12) { month = 1; year++; }
        return year >= _minYear && year <= _maxYear && MonthHasSelectableDate(year, month);
    }

    private bool MonthHasSelectableDate(int year, int month)
    {
        for (var day = 1; day <= PersianDateHelper.DaysInMonth(year, month); day++)
        {
            var date = PersianDateHelper.ToGregorian(year, month, day);
            if (date.HasValue && date.Value >= _minimum && date.Value.Date <= Today) return true;
        }
        return false;
    }

    private void PrevMonth()
    {
        if (!CanMove(-1)) return;
        _viewMonth--;
        if (_viewMonth < 1) { _viewMonth = 12; _viewYear--; }
        RecomputeMonth();
    }

    private void NextMonth()
    {
        if (!CanMove(1)) return;
        _viewMonth++;
        if (_viewMonth > 12) { _viewMonth = 1; _viewYear++; }
        RecomputeMonth();
    }

    private async Task ChangeYearAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var year)) return;
        _viewYear = Math.Clamp(year, _minYear, _maxYear);
        ClampView(); RecomputeMonth();
        await Task.CompletedTask;
    }

    private async Task ChangeMonthAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var month)) return;
        _viewMonth = Math.Clamp(month, 1, 12);
        ClampView(); RecomputeMonth();
        await Task.CompletedTask;
    }

    private bool IsSelected(int day)
    {
        var parts = PersianDateHelper.ToJalaliParts(Value);
        return parts is { } p && p.Year == _viewYear && p.Month == _viewMonth && p.Day == day;
    }

    private bool IsToday(int day)
    {
        var today = PersianDateHelper.Today();
        return today.Year == _viewYear && today.Month == _viewMonth && today.Day == day;
    }

    private bool IsSelectable(int day)
    {
        var date = PersianDateHelper.ToGregorian(_viewYear, _viewMonth, day);
        return date.HasValue && date.Value >= _minimum && date.Value.Date <= Today;
    }

    private async Task SelectDay(int day)
    {
        if (!IsSelectable(day)) return;
        await SetValueAsync(PersianDateHelper.ToGregorian(_viewYear, _viewMonth, day));
        _open = false;
    }

    private async Task SelectToday()
    {
        if (ReadOnly) return;
        await SetValueAsync(Today);
        _open = false;
    }

    private async Task ClearAsync()
    {
        if (ReadOnly) return;
        _entry = "";
        await SetErrorAsync(null);
        Value = null;
        _lastValue = null;
        _open = false;
        await ValueChanged.InvokeAsync(null);
    }

    private async Task OnEntryInputAsync(ChangeEventArgs args)
    {
        // Typing is in progress, so a commit must not reformat the text under the caret.
        _editing = true;
        var typed = args.Value?.ToString() ?? "";
        // Hold the masked form, so a field typed while the script is unavailable still shows the
        // separators and the two paths cannot diverge.
        _entry = PersianDateEntry.Mask(typed);

        if (PersianDateEntry.IsComplete(_entry))
            await CommitEntryAsync(stillTyping: true);
        else if (_entry.Length == 0)
            await SetErrorAsync(null);
    }

    /// <summary>Blur committed the value, so the field may show the Persian form again.</summary>
    private Task CommitEntryAsync() => CommitEntryAsync(stillTyping: false);

    private async Task CommitEntryAsync(bool stillTyping)
    {
        if (ReadOnly) return;
        // Auto-committing on the eighth digit must not switch the field to Persian numerals under the
        // caret: assigning value collapses the selection to the end, so correcting the month afterwards
        // would mean repositioning by hand. Only leaving the field settles the display.
        _editing = stillTyping;
        if (string.IsNullOrWhiteSpace(_entry))
        {
            await ClearAsync();
            return;
        }
        if (!TryParseJalali(_entry, out var date) || date < _minimum || date.Date > Today)
        {
            await SetErrorAsync("تاریخ تولد واردشده معتبر نیست.");
            return;
        }
        await SetValueAsync(date);
    }

    private async Task SetValueAsync(DateTime? date)
    {
        Value = date;
        _lastValue = date;
        SyncEntry();
        await SetErrorAsync(null);
        await ValueChanged.InvokeAsync(date);
    }

    private async Task SetErrorAsync(string? value)
    {
        if (_error == value) return;
        _error = value;
        if (ValidationChanged.HasDelegate) await ValidationChanged.InvokeAsync(value);
    }

    // Entry formatting and parsing live in PersianDateEntry so the browser-side mask, this component
    // and the unit tests all share one definition of what "yyyy/MM/dd" means.
    private static bool TryParseJalali(string input, out DateTime date) =>
        PersianDateEntry.TryParse(input, out date);
}
