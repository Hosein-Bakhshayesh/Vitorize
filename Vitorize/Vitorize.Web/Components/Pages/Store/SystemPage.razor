@page "/about"
@page "/terms"
@page "/privacy"
@inject ApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContext

@* Canonical routes for the seeded system pages. Content, SEO and 404 behaviour come from the same
   CMS pipeline as custom pages; only the slug is fixed and the canonical URL is the short route. *@

@if (_page is not null)
{
    <SeoHead Title="@(_page.SeoTitle ?? _page.Title)" Description="@_page.SeoDescription"
             CanonicalPath="@($"/{_slug}")" LastModified="@(_page.UpdatedAt ?? _page.CreatedAt)" />
}
else if (!_loading)
{
    <SeoHead Title="صفحه یافت نشد" Description="این صفحه در دسترس نیست." Index="false" Follow="false" />
}

@if (_loading)
{
    <div class="st-state"><div class="st-spinner"></div></div>
}
else if (_page is null)
{
    <div class="st-state"><div class="st-state__ic"><Icon Name="file-text" Size="30" /></div><div style="font-weight:700">صفحه یافت نشد</div><a class="st-btn st-btn--primary st-btn--sm" href="/">بازگشت به خانه</a></div>
}
else
{
    <CmsPageContent Title="@_page.Title" ContentHtml="@_page.ContentHtml" />
}

@code {
    private bool _loading = true;
    private StorePageModel? _page;
    private string _slug = string.Empty;
    private string? _loadedSlug;

    protected override async Task OnParametersSetAsync()
    {
        _slug = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        if (_slug == _loadedSlug) return;
        _loadedSlug = _slug;
        _loading = true;

        var result = await Api.GetAsync<StorePageModel>($"pages/{Uri.EscapeDataString(_slug)}");
        // An unpublished system page is indistinguishable from a missing one for the public.
        _page = result.IsSuccess ? result.Data : null;
        if (_page is null && HttpContext.HttpContext is { Response.HasStarted: false } context)
            context.Response.StatusCode = StatusCodes.Status404NotFound;
        _loading = false;
    }
}
