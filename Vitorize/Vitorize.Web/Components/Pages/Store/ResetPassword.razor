@page "/reset-password"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>تغییر رمز عبور | ویتورایز</PageTitle>

<section class="auth-page" aria-labelledby="auth-title" aria-busy="@(_busy ? "true" : "false")">
    <div class="st-card auth-card">
        <header class="auth-heading">
            <div class="auth-icon"><Icon Name="shield-lock" Size="28" /></div>
            <h1 id="auth-title">تنظیم رمز عبور جدید</h1>
            <p class="st-muted">کد بازیابی و رمز عبور جدید خود را وارد کنید.</p>
        </header>

        <form @onsubmit="Submit" @onsubmit:preventDefault>
        <div class="st-field">
            <label class="st-label" for="reset-mobile">شماره موبایل</label>
            <input id="reset-mobile" class="st-input auth-phone @(MobileInvalid ? "is-invalid" : null)" @bind="_mobile" @ref="_mobileInput" inputmode="tel" autocomplete="tel" dir="ltr" disabled="@_busy" aria-invalid="@(MobileInvalid ? "true" : "false")" aria-describedby="@(MobileInvalid ? "reset-form-error" : null)" />
        </div>
        <div class="st-field">
            <label class="st-label" for="reset-code">کد بازیابی</label>
            <input id="reset-code" class="st-input @(CodeInvalid ? "is-invalid" : null)" @bind="_code" @ref="_codeInput" inputmode="numeric" autocomplete="one-time-code" dir="ltr" disabled="@_busy" placeholder="کد ارسال‌شده" aria-invalid="@(CodeInvalid ? "true" : "false")" aria-describedby="@(CodeInvalid ? "reset-form-error" : null)" />
        </div>
        <div class="st-field">
            <label class="st-label" for="reset-password">رمز عبور جدید</label>
            <input id="reset-password" class="st-input @(NewPasswordInvalid ? "is-invalid" : null)" type="password" autocomplete="new-password" @bind="_newPassword" @ref="_newPasswordInput" disabled="@_busy" placeholder="حداقل ۶ کاراکتر" aria-invalid="@(NewPasswordInvalid ? "true" : "false")" aria-describedby="@(NewPasswordInvalid ? "reset-form-error" : null)" />
        </div>
        <div class="st-field">
            <label class="st-label" for="reset-confirm">تکرار رمز عبور</label>
            <input id="reset-confirm" class="st-input @(ConfirmInvalid ? "is-invalid" : null)" type="password" autocomplete="new-password" @bind="_confirm" @ref="_confirmInput" disabled="@_busy" aria-invalid="@(ConfirmInvalid ? "true" : "false")" aria-describedby="@(ConfirmInvalid ? "reset-form-error" : null)" />
        </div>
        @if (_formError is not null)
        {
            <div id="reset-form-error" class="st-field__error" role="alert">@_formError</div>
        }
        <button type="submit" class="st-btn st-btn--primary st-btn--block st-btn--lg" disabled="@_busy" aria-label="تغییر رمز عبور">
            @if (_busy) { <span class="st-spinner sm"></span> } else { <span>تغییر رمز عبور</span> }
        </button>
        </form>

        <div class="st-divider"></div>
        <div class="auth-footer"><a href="/login">بازگشت به ورود</a></div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery] public string? Mobile { get; set; }

    private string _mobile = string.Empty;
    private string _code = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirm = string.Empty;
    private string? _formError;
    private bool _submitted;
    private ElementReference _mobileInput;
    private ElementReference _codeInput;
    private ElementReference _newPasswordInput;
    private ElementReference _confirmInput;
    private bool _busy;

    private bool MobileInvalid => _submitted && string.IsNullOrWhiteSpace(_mobile);
    private bool CodeInvalid => _submitted && string.IsNullOrWhiteSpace(_code);
    private bool NewPasswordInvalid => _submitted && string.IsNullOrWhiteSpace(_newPassword);
    private bool ConfirmInvalid => _submitted && !string.IsNullOrWhiteSpace(_newPassword) && _newPassword != _confirm;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(_mobile) && !string.IsNullOrWhiteSpace(Mobile))
            _mobile = Mobile;
    }

    private async Task Submit()
    {
        _formError = null;
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_mobile) || string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _formError = "همه فیلدها را تکمیل کنید.";
            if (string.IsNullOrWhiteSpace(_mobile)) await _mobileInput.FocusAsync();
            else if (string.IsNullOrWhiteSpace(_code)) await _codeInput.FocusAsync();
            else await _newPasswordInput.FocusAsync();
            return;
        }
        if (_newPassword != _confirm)
        {
            _formError = "رمز عبور و تکرار آن یکسان نیست.";
            await _confirmInput.FocusAsync();
            return;
        }

        _busy = true;
        var result = await Api.PostAsync("auth/reset-password", new
        {
            Mobile = _mobile.Trim(),
            Code = _code.Trim(),
            NewPassword = _newPassword,
            ConfirmNewPassword = _confirm
        });
        _busy = false;

        if (result.IsSuccess)
        {
            Toasts.Success("رمز عبور با موفقیت تغییر کرد. اکنون وارد شوید.");
            Nav.NavigateTo("/login");
        }
        else _formError = result.Message;
    }
}
