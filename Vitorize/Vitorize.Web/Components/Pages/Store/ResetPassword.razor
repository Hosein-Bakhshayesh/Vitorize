@page "/reset-password"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>تغییر رمز عبور | ویتورایز</PageTitle>

<div class="st-auth-page">
    <div class="st-card st-card__pad">
        <div style="text-align:center;margin-bottom:22px">
            <div style="width:54px;height:54px;border-radius:15px;background:var(--st-chip);color:var(--st-brand-2);display:flex;align-items:center;justify-content:center;margin:0 auto 12px"><Icon Name="shield-lock" Size="24" /></div>
            <h1 style="font-size:20px">تنظیم رمز عبور جدید</h1>
            <p class="st-muted" style="font-size:13px;margin-top:6px">کد بازیابی و رمز عبور جدید خود را وارد کنید.</p>
        </div>

        <div class="st-field">
            <label class="st-label">شماره موبایل</label>
            <input class="st-input @(MobileInvalid ? "is-invalid" : null)" @bind="_mobile" @ref="_mobileInput" inputmode="tel" aria-invalid="@(MobileInvalid ? "true" : "false")" aria-describedby="@(MobileInvalid ? "reset-form-error" : null)" />
        </div>
        <div class="st-field">
            <label class="st-label">کد بازیابی</label>
            <input class="st-input @(CodeInvalid ? "is-invalid" : null)" @bind="_code" @ref="_codeInput" inputmode="numeric" placeholder="کد ارسال‌شده" aria-invalid="@(CodeInvalid ? "true" : "false")" aria-describedby="@(CodeInvalid ? "reset-form-error" : null)" />
        </div>
        <div class="st-field">
            <label class="st-label">رمز عبور جدید</label>
            <input class="st-input @(NewPasswordInvalid ? "is-invalid" : null)" type="password" @bind="_newPassword" @ref="_newPasswordInput" placeholder="حداقل ۶ کاراکتر" aria-invalid="@(NewPasswordInvalid ? "true" : "false")" aria-describedby="@(NewPasswordInvalid ? "reset-form-error" : null)" />
        </div>
        <div class="st-field">
            <label class="st-label">تکرار رمز عبور</label>
            <input class="st-input @(ConfirmInvalid ? "is-invalid" : null)" type="password" @bind="_confirm" @ref="_confirmInput" aria-invalid="@(ConfirmInvalid ? "true" : "false")" aria-describedby="@(ConfirmInvalid ? "reset-form-error" : null)" />
        </div>
        @if (_formError is not null)
        {
            <div id="reset-form-error" class="st-field__error" role="alert">@_formError</div>
        }
        <button class="st-btn st-btn--primary st-btn--block st-btn--lg" @onclick="Submit" disabled="@_busy">
            @if (_busy) { <span class="st-spinner sm"></span> } else { <span>تغییر رمز عبور</span> }
        </button>

        <div class="st-divider"></div>
        <div style="text-align:center;font-size:13px"><a href="/login" style="color:var(--st-brand-2)">بازگشت به ورود</a></div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Mobile { get; set; }

    private string _mobile = string.Empty;
    private string _code = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirm = string.Empty;
    private string? _formError;
    private bool _submitted;
    private ElementReference _mobileInput;
    private ElementReference _codeInput;
    private ElementReference _newPasswordInput;
    private ElementReference _confirmInput;
    private bool _busy;

    private bool MobileInvalid => _submitted && string.IsNullOrWhiteSpace(_mobile);
    private bool CodeInvalid => _submitted && string.IsNullOrWhiteSpace(_code);
    private bool NewPasswordInvalid => _submitted && string.IsNullOrWhiteSpace(_newPassword);
    private bool ConfirmInvalid => _submitted && !string.IsNullOrWhiteSpace(_newPassword) && _newPassword != _confirm;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(_mobile) && !string.IsNullOrWhiteSpace(Mobile))
            _mobile = Mobile;
    }

    private async Task Submit()
    {
        _formError = null;
        _submitted = true;
        if (string.IsNullOrWhiteSpace(_mobile) || string.IsNullOrWhiteSpace(_code) || string.IsNullOrWhiteSpace(_newPassword))
        {
            _formError = "همه فیلدها را تکمیل کنید.";
            if (string.IsNullOrWhiteSpace(_mobile)) await _mobileInput.FocusAsync();
            else if (string.IsNullOrWhiteSpace(_code)) await _codeInput.FocusAsync();
            else await _newPasswordInput.FocusAsync();
            return;
        }
        if (_newPassword != _confirm)
        {
            _formError = "رمز عبور و تکرار آن یکسان نیست.";
            await _confirmInput.FocusAsync();
            return;
        }

        _busy = true;
        var result = await Api.PostAsync("auth/reset-password", new
        {
            Mobile = _mobile.Trim(),
            Code = _code.Trim(),
            NewPassword = _newPassword,
            ConfirmNewPassword = _confirm
        });
        _busy = false;

        if (result.IsSuccess)
        {
            Toasts.Success("رمز عبور با موفقیت تغییر کرد. اکنون وارد شوید.");
            Nav.NavigateTo("/login");
        }
        else _formError = result.Message;
    }
}
