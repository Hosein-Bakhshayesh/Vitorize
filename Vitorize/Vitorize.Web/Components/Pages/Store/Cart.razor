@page "/cart"
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject CartState CartSvc
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@using Vitorize.Web.Helpers
@using Vitorize.Web.Services.UI
@using Microsoft.AspNetCore.Components.Authorization
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>سبد خرید | ویتورایز</PageTitle>

<div class="st-bc"><a href="/">خانه</a> <Icon Name="chevron-left" Size="13" /> <span>سبد خرید</span></div>
<h1 style="font-size:22px;margin-bottom:18px">سبد خرید شما</h1>

@if (MergeError == "1")
{
    <div class="st-alert st-alert--danger st-errpage--inline" role="alert">
        انتقال سبد مهمان انجام نشد و اطلاعات آن حفظ شده است. برای تلاش مجدد، از حساب خارج شوید و دوباره وارد شوید.
    </div>
}

@if (_loading)
{
    <div class="st-state"><div class="st-spinner"></div></div>
}
else if (_cart is null || _cart.Items.Count == 0)
{
    @if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="st-alert st-alert--danger st-errpage--inline" role="alert">
            <span>@_loadError</span>
            <button class="st-btn st-btn--outline st-btn--sm" @onclick="Load">تلاش مجدد</button>
        </div>
    }
    else
    {
        <StoreState Info="_emptyInfo" Class="st-errpage--inline" />
    }
}
else
{
    @if (_cart.Items.Any(x => x.RequiresKyc))
    {
        <div data-testid="cart-kyc-requirement" class="st-alert st-alert--info" style="margin-bottom:16px">
            <Icon Name="shield" Size="18" />
            <div>برخی اقلام این سبد نیازمند احراز هویت هستند. <a href="/customer/verification">تکمیل احراز هویت</a></div>
        </div>
    }
    <div class="st-split">
        <div class="st-stack">
            @foreach (var item in _cart.Items)
            {
                <div class="st-card st-card__pad st-cart-item" style="display:flex;gap:14px;align-items:center">
                    <div class="st-cart-item__image" style="width:70px;height:56px;border-radius:10px;overflow:hidden;background:var(--st-surface-2);flex:0 0 70px">
                        @if (!string.IsNullOrWhiteSpace(item.ThumbnailImagePath))
                        { <img src="@Media.Resolve(item.ThumbnailImagePath)" alt="" style="width:100%;height:100%;object-fit:cover" /> }
                        else { <div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--st-muted)"><Icon Name="box" Size="22" /></div> }
                    </div>
                    <div class="st-cart-item__info" style="flex:1;min-width:0">
                        <div style="font-weight:700;font-size:14px">@item.ProductTitle</div>
                        @if (!string.IsNullOrWhiteSpace(item.VariantTitle))
                        { <div class="st-muted" style="font-size:12px">@item.VariantTitle</div> }
                        @if (item.InputValues.Count > 0)
                        {
                            <div class="st-input-summary">@foreach (var value in item.InputValues) { <span><b>@value.FieldLabel:</b> @value.Value</span> }</div>
                        }
                        @if (item.InputFields.Count > 0)
                        {
                            <button class="st-btn st-btn--ghost st-btn--sm" @onclick="() => EditInputs(item)"><Icon Name="edit" Size="13" /> ویرایش اطلاعات خرید</button>
                        }
                        <div class="st-muted" style="font-size:12.5px;margin-top:4px">قیمت واحد: @AUI.MoneyFa(item.UnitPrice)</div>
                    </div>
                    <div class="st-qty">
                        <button @onclick="() => UpdateQty(item, item.Quantity - 1)" disabled="@_busy">−</button>
                        <span>@AUI.Number(item.Quantity)</span>
                        <button @onclick="() => UpdateQty(item, item.Quantity + 1)" disabled="@_busy">+</button>
                    </div>
                    <div class="st-cart-item__total" style="text-align:end;min-width:120px">
                        <div style="font-weight:800">@AUI.MoneyFa(item.TotalPrice)</div>
                        <button class="st-btn st-btn--ghost st-btn--sm" style="color:var(--st-danger);margin-top:4px" @onclick="() => Remove(item)" disabled="@_busy"><Icon Name="trash" Size="14" /> حذف</button>
                    </div>
                </div>
            }
            <button class="st-btn st-btn--ghost st-btn--sm" style="color:var(--st-danger);align-self:flex-start" @onclick="Clear" disabled="@_busy">
                <Icon Name="trash" Size="14" /> خالی کردن سبد خرید
            </button>
        </div>

        <div class="st-card st-card__pad st-cart-sum" style="align-self:start;position:sticky;top:calc(var(--st-header-h) + 16px)">
            <h3 style="font-size:16px;margin-bottom:16px">خلاصه سفارش</h3>

            <div class="st-promo">
                <input class="st-input" placeholder="کد تخفیف" @bind="_coupon" disabled="@(_discount > 0)" />
                @if (_discount > 0)
                {
                    <button class="st-btn st-btn--ghost st-btn--sm" @onclick="ClearCoupon">حذف</button>
                }
                else
                {
                    <button class="st-btn st-btn--outline st-btn--sm" @onclick="ApplyCoupon" disabled="@_couponBusy">
                        @if (_couponBusy) { <span class="st-spinner sm"></span> } else { <span>اعمال</span> }
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_couponMsg))
            {
                <div class="st-promo__msg @(_discount > 0 ? "ok" : "err")">@_couponMsg</div>
            }

            <div class="st-sumrow"><span class="st-muted">تعداد اقلام</span><span>@AUI.Number(_cart.TotalQuantity)</span></div>
            <div class="st-sumrow"><span class="st-muted">جمع کل</span><span>@AUI.MoneyFa(_cart.SubtotalAmount)</span></div>
            @if (_discount > 0)
            {
                <div class="st-sumrow" style="color:var(--st-success)"><span>تخفیف کد @_appliedCode</span><span>−@AUI.MoneyFa(_discount)</span></div>
            }
            @if (VatEnabled)
            {
                <div class="st-sumrow" data-testid="cart-vat-row"><span class="st-muted">مالیات بر ارزش افزوده (@AUI.Percent(VatRatePercent)٪)</span><span>@AUI.MoneyFa(VatAmount)</span></div>
            }
            <div class="st-sumrow total" data-testid="cart-payable"><span>مبلغ قابل پرداخت</span><span>@AUI.MoneyFa(Payable)</span></div>

            <button type="button" class="st-btn st-btn--accent st-btn--block st-btn--lg" style="margin-top:14px" @onclick="ContinueToCheckoutAsync">
                <Icon Name="lock" Size="17" /> ادامه و پرداخت امن
            </button>
            <a class="st-btn st-btn--ghost st-btn--block" style="margin-top:8px" href="/shop">ادامه خرید</a>

            <div class="st-cart-trust">
                <span><Icon Name="lock" Size="14" /> پرداخت امن</span>
                <span><Icon Name="zap" Size="14" /> تحویل آنی</span>
                <span><Icon Name="shield-check" Size="14" /> اصالت تضمینی</span>
            </div>
        </div>
    </div>
}

<Modal Visible="_inputOpen" Title="ویرایش اطلاعات خرید" Icon="file-text" OnClose="CloseInputs" InitialFocusId="@_focusTargetId">
    <ChildContent>
        @if (_editingItem is not null)
        {
            <div class="st-dynamic-form">
                @foreach (var field in _editingItem.InputFields.OrderBy(x => x.SortOrder))
                {
                    <div class="st-field">
                        <label class="st-label" for="@InputId(_editingItem, field.Key)">@field.Label @if (field.IsRequired) { <span class="req" data-testid="@($"cart-input-required-{field.Key}")" aria-label="الزامی">*</span> } else { <span class="st-optional" data-testid="@($"cart-input-optional-{field.Key}")">اختیاری</span> }</label>
                        @if (!string.IsNullOrWhiteSpace(field.Description)) { <span class="st-help">@field.Description</span> }
                        @if (field.FieldType is 6 or 7)
                        { <select id="@InputId(_editingItem, field.Key)" class="st-select @(EditError(field.Key) is null ? null : "is-invalid")" value="@EditValue(field.Key)" @onchange="e => SetEditValue(field.Key, e.Value?.ToString())" aria-invalid="@(EditError(field.Key) is null ? "false" : "true")" aria-describedby="@(EditError(field.Key) is null ? null : ErrorId(_editingItem, field.Key))"><option value="">— انتخاب کنید —</option>@foreach (var option in field.Options) { <option value="@option">@option</option> }</select> }
                        else if (field.FieldType == 8)
                        { <label class="st-check @(EditError(field.Key) is null ? null : "is-invalid")"><input id="@InputId(_editingItem, field.Key)" type="checkbox" checked="@IsEditChecked(field.Key)" @onchange="e => SetEditCheckbox(field.Key, e.Value)" aria-invalid="@(EditError(field.Key) is null ? "false" : "true")" aria-describedby="@(EditError(field.Key) is null ? null : ErrorId(_editingItem, field.Key))" /><span>@field.Placeholder</span></label> }
                        else if (field.FieldType == 5)
                        { <textarea id="@InputId(_editingItem, field.Key)" class="st-textarea @(EditError(field.Key) is null ? null : "is-invalid")" placeholder="@field.Placeholder" value="@EditValue(field.Key)" @oninput="e => SetEditValue(field.Key, e.Value?.ToString())" aria-invalid="@(EditError(field.Key) is null ? "false" : "true")" aria-describedby="@(EditError(field.Key) is null ? null : ErrorId(_editingItem, field.Key))"></textarea> }
                        else
                        { <input id="@InputId(_editingItem, field.Key)" class="st-input @(EditError(field.Key) is null ? null : "is-invalid")" type="@InputType(field.FieldType)" dir="@InputDirection(field.FieldType)" placeholder="@field.Placeholder" value="@EditValue(field.Key)" @oninput="e => SetEditValue(field.Key, e.Value?.ToString())" autocomplete="off" aria-invalid="@(EditError(field.Key) is null ? "false" : "true")" aria-describedby="@(EditError(field.Key) is null ? null : ErrorId(_editingItem, field.Key))" /> }
                        @if (field.IsSensitive) { <span class="st-help"><Icon Name="lock" Size="12" /> برای حفظ امنیت، مقدار قبلی نمایش داده نمی‌شود و باید دوباره وارد شود.</span> }
                        @if (field.RequiresConfirmation)
                        {
                            <input id="@ConfirmationId(_editingItem, field.Key)" class="st-input @(EditError(field.Key) is null ? null : "is-invalid")" type="password" placeholder="تکرار @field.Label" value="@EditConfirmation(field.Key)" @oninput="e => SetEditConfirmation(field.Key, e.Value?.ToString())" autocomplete="off" />
                        }
                        @if (EditError(field.Key) is { } error)
                        {
                            <span id="@ErrorId(_editingItem, field.Key)" class="st-field__error" role="alert">@error</span>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer><button class="st-btn st-btn--outline" @onclick="CloseInputs">انصراف</button><button class="st-btn st-btn--accent" @onclick="SaveInputs" disabled="@_busy">ذخیره اطلاعات</button></Footer>
</Modal>

@code {
    private bool _loading = true, _busy, _couponBusy;
    private string? _loadError;
    private CartModel? _cart;
    private string _coupon = string.Empty;
    private string _appliedCode = string.Empty;
    private decimal _discount;
    private string? _couponMsg;
    // Server-computed pricing. With no coupon applied these mirror the cart preview; once a coupon
    // is validated they mirror the coupon preview. The Razor layer performs no VAT arithmetic.
    private ValidateCouponResultModel? _couponPricing;
    private bool _inputOpen;

    private bool VatEnabled => _couponPricing?.VatEnabled ?? _cart?.VatEnabled ?? false;
    private decimal VatRatePercent => _couponPricing?.VatRatePercent ?? _cart?.VatRatePercent ?? 0m;
    private decimal VatAmount => _couponPricing?.VatAmount ?? _cart?.VatAmount ?? 0m;
    private decimal Payable => _couponPricing?.FinalAmount ?? _cart?.FinalAmount ?? 0m;
    private CartItemModel? _editingItem;
    private readonly Dictionary<string, string?> _editValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string?> _editConfirmValues = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> _editFieldErrors = new(StringComparer.OrdinalIgnoreCase);
    private string? _focusTargetId;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "mergeError")] public string? MergeError { get; set; }

    private ErrorStateInfo _emptyInfo =
        ErrorStates.Resolve("empty-cart", new Vitorize.Web.Services.UI.StoreBranding(new Dictionary<string, string>()));

    protected override async Task OnInitializedAsync()
    {
        _emptyInfo = ErrorStates.Resolve("empty-cart", await Branding.GetAsync());
        await Load();
    }

    private async Task ApplyCoupon()
    {
        if (_cart is null || string.IsNullOrWhiteSpace(_coupon)) return;
        _couponBusy = true; _couponMsg = null;
        var r = await Api.PostAsync<ValidateCouponResultModel>("coupons/validate",
            new { Code = _coupon.Trim(), OrderAmount = _cart.SubtotalAmount });
        _couponBusy = false;
        if (r.IsSuccess && r.Data is { CouponId: not null })
        {
            _couponPricing = r.Data;
            _discount = r.Data.DiscountAmount;
            _appliedCode = r.Data.Code ?? _coupon.Trim();
            _couponMsg = $"کد تخفیف اعمال شد: {AUI.MoneyFa(_discount)} تخفیف";
        }
        else
        {
            _couponPricing = null;
            _discount = 0; _appliedCode = string.Empty;
            _couponMsg = string.IsNullOrWhiteSpace(r.Message) ? "کد تخفیف نامعتبر است." : r.Message;
        }
    }

    private void ClearCoupon()
    {
        _couponPricing = null;
        _discount = 0; _appliedCode = string.Empty; _coupon = string.Empty; _couponMsg = null;
    }

    private async Task Load()
    {
        _loading = true; _loadError = null;
        try
        {
            var result = await Api.GetAsync<CartModel>("cart");
            if (result.IsSuccess && result.Data is not null)
            {
                _cart = result.Data;
                CartSvc.Set(_cart.TotalQuantity);
            }
            else
            {
                _cart = null;
                _loadError = "سبد خرید بارگذاری نشد. لطفاً دوباره تلاش کنید.";
            }
        }
        catch
        {
            _cart = null;
            _loadError = "سبد خرید بارگذاری نشد. لطفاً دوباره تلاش کنید.";
        }
        finally { _loading = false; }
    }

    private async Task UpdateQty(CartItemModel item, int qty)
    {
        if (qty < 1) { await Remove(item); return; }
        _busy = true;
        var result = await Api.PutAsync<CartModel>($"cart/items/{item.Id}", new { Quantity = qty });
        _busy = false;
        Apply(result);
    }

    private async Task Remove(CartItemModel item)
    {
        _busy = true;
        var result = await Api.DeleteAsync($"cart/items/{item.Id}");
        _busy = false;
        if (result.IsSuccess) await Load();
        else Toasts.Error(result.Message);
    }

    private async Task Clear()
    {
        _busy = true;
        var result = await Api.DeleteAsync("cart/clear");
        _busy = false;
        if (result.IsSuccess) { CartSvc.Clear(); await Load(); }
        else Toasts.Error(result.Message);
    }

    private void Apply(ApiResult<CartModel> result)
    {
        if (result.IsSuccess && result.Data is not null)
        {
            _cart = result.Data;
            CartSvc.Set(_cart.TotalQuantity);
        }
        else Toasts.Error(result.Message);
    }

    private async Task ContinueToCheckoutAsync()
    {
        if (_cart is null) return;

        var validation = StorefrontInputValidator.ValidateCartCheckout(_cart.Items);
        if (!validation.IsValid && validation.InvalidItem is not null)
        {
            OpenInputs(validation.InvalidItem, validation.Validation.Errors);
            return;
        }

        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login?returnUrl=%2Fcheckout", forceLoad: true);
            return;
        }

        var checkoutHref = _discount > 0 && !string.IsNullOrWhiteSpace(_appliedCode)
            ? $"/checkout?coupon={Uri.EscapeDataString(_appliedCode)}"
            : "/checkout";
        Nav.NavigateTo(checkoutHref);
        await Task.CompletedTask;
    }

    private void EditInputs(CartItemModel item) => OpenInputs(item, null);

    private void OpenInputs(CartItemModel item, IReadOnlyDictionary<string, string>? errors)
    {
        _editingItem = item; _editValues.Clear(); _editConfirmValues.Clear(); _editFieldErrors.Clear();
        foreach (var field in item.InputFields)
        {
            var existing = item.InputValues.FirstOrDefault(x => x.FieldKey.Equals(field.Key, StringComparison.OrdinalIgnoreCase));
            _editValues[field.Key] = field.IsSensitive ? null : existing?.Value ?? field.DefaultValue;
        }
        if (errors is not null)
        {
            foreach (var error in errors) _editFieldErrors[error.Key] = error.Value;
            var firstInvalidKey = item.InputFields.Where(x => errors.ContainsKey(x.Key)).OrderBy(x => x.SortOrder).ThenBy(x => x.Id).Select(x => x.Key).FirstOrDefault();
            _focusTargetId = firstInvalidKey is null ? null : InputId(item, firstInvalidKey);
        }
        _inputOpen = true;
    }

    private async Task SaveInputs()
    {
        if (_editingItem is null) return;
        var validation = StorefrontInputValidator.ValidateFields(_editingItem.InputFields, _editValues, _editConfirmValues, _editingItem.InputValues);
        if (!validation.IsValid)
        {
            _editFieldErrors.Clear();
            foreach (var error in validation.Errors) _editFieldErrors[error.Key] = error.Value;
            var firstInvalidKey = _editingItem.InputFields.Where(x => validation.Errors.ContainsKey(x.Key)).OrderBy(x => x.SortOrder).ThenBy(x => x.Id).Select(x => x.Key).FirstOrDefault();
            _focusTargetId = firstInvalidKey is null ? null : InputId(_editingItem, firstInvalidKey);
            return;
        }
        _busy = true;
        var result = await Api.PutAsync<CartModel>($"cart/items/{_editingItem.Id}", new { Quantity = _editingItem.Quantity, InputValues = _editValues });
        _busy = false;
        if (result.IsSuccess) { _editFieldErrors.Clear(); _inputOpen = false; Apply(result); } else Toasts.Error(result.Message);
    }
    private string? EditValue(string key) => _editValues.GetValueOrDefault(key);
    private string? EditConfirmation(string key) => _editConfirmValues.GetValueOrDefault(key);
    private string? EditError(string key) => _editFieldErrors.GetValueOrDefault(key);
    private void SetEditValue(string key, string? value) { _editValues[key] = value; RefreshEditError(key); }
    private bool IsEditChecked(string key) => string.Equals(EditValue(key), "true", StringComparison.OrdinalIgnoreCase);
    private void SetEditCheckbox(string key, object? value) => SetEditValue(key,
        value is true || string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase) ? "true" : "false");
    private void SetEditConfirmation(string key, string? value) { _editConfirmValues[key] = value; RefreshEditError(key); }
    private void RefreshEditError(string key)
    {
        if (_editingItem is null || !_editFieldErrors.ContainsKey(key)) return;
        var validation = StorefrontInputValidator.ValidateFields(_editingItem.InputFields.Where(x => x.Key.Equals(key, StringComparison.OrdinalIgnoreCase)), _editValues, _editConfirmValues, _editingItem.InputValues);
        if (validation.IsValid) _editFieldErrors.Remove(key); else _editFieldErrors[key] = validation.Errors[key];
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTargetId is not { } targetId) return;
        _focusTargetId = null;
        try { await JS.InvokeAsync<bool>("vzStorefront.focusAndScroll", targetId); } catch { }
    }
    private void CloseInputs() { _inputOpen = false; _editFieldErrors.Clear(); _focusTargetId = null; }
    private static string InputId(CartItemModel item, string key) => $"cart-input-{item.Id:N}-{key}";
    private static string ConfirmationId(CartItemModel item, string key) => $"cart-confirm-{item.Id:N}-{key}";
    private static string ErrorId(CartItemModel item, string key) => $"cart-error-{item.Id:N}-{key}";
    private static string InputType(byte type) => type switch { 2 => "email", 3 => "tel", 4 => "number", 10 => "url", 11 => "date", 12 => "password", _ => "text" };
    private static string InputDirection(byte type) => type is 2 or 3 or 4 or 10 or 11 ? "ltr" : "rtl";
}
