@page "/cart"
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject CartState CartSvc
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@using Vitorize.Web.Helpers
@using Vitorize.Web.Services.UI
@using Microsoft.AspNetCore.Components.Authorization
@using Vitorize.Application.Common
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>سبد خرید | ویتورایز</PageTitle>

<section class="cart-page" aria-labelledby="cart-title" aria-busy="@(_loading || _busy || _couponBusy ? "true" : "false")">
<div class="st-bc"><a href="/">خانه</a> <Icon Name="chevron-left" Size="13" /> <span>سبد خرید</span></div>
<div class="cart-heading">
    <h1 id="cart-title">سبد خرید شما</h1>
    @if (_cart is { Items.Count: > 0 })
    {
        <span class="cart-count" role="status">@AUI.Number(_cart.TotalQuantity) کالا</span>
    }
</div>

@if (MergeError == "1")
{
    <div class="st-alert st-alert--danger st-errpage--inline" role="alert">
        انتقال سبد مهمان انجام نشد و اطلاعات آن حفظ شده است. برای تلاش مجدد، از حساب خارج شوید و دوباره وارد شوید.
    </div>
}

@* A read failure is reported wherever it happens, including over items that are still displayed:
   the customer sees that the shop could not refresh, not that their cart was emptied. *@
@if (!string.IsNullOrWhiteSpace(_loadError))
{
    <div class="st-alert st-alert--danger st-errpage--inline" role="alert" data-testid="cart-load-error">
        <span>@_loadError</span>
        <button type="button" class="st-btn st-btn--outline st-btn--sm" @onclick="Load" disabled="@(_loading || _busy || _couponBusy)">تلاش مجدد</button>
    </div>
}

@if (_loading)
{
    <div class="cart-loading st-state" role="status"><div class="st-spinner"></div><span>در حال بارگذاری سبد خرید ...</span></div>
}
else if (_cart is null || _cart.Items.Count == 0)
{
    @if (string.IsNullOrWhiteSpace(_loadError))
    {
        <StoreState Info="_emptyInfo" Class="st-errpage--inline" />
    }
}
else
{
    <div class="cart-layout">
        <div class="cart-items" aria-label="اقلام سبد خرید">
            @foreach (var item in _cart.Items)
            {
                <article @key="item.Id" class="st-cart-item" data-testid="cart-item" aria-labelledby="@($"cart-item-{item.Id}")">
                    @* Square: product media is presented 1:1 everywhere it appears. *@
                    <div class="st-cart-item__image">
                        <StoreImage Url="@item.ThumbnailImagePath" Alt="@item.ProductTitle" Contain="true" Icon="box" IconSize="26" />
                    </div>
                    <div class="st-cart-item__info">
                        <h2 id="@($"cart-item-{item.Id}")">@item.ProductTitle</h2>
                        @{ var variantTitle = ProductAvailabilityRules.CustomerFacingVariantTitle(item.VariantTitle); }
                        @if (!string.IsNullOrWhiteSpace(variantTitle))
                        { <div class="cart-variant st-muted">@variantTitle</div> }
                        @* Product-required information is collected at Checkout, so the cart shows
                           no editors for it and never blocks on it. *@
                        <div class="cart-unit-price st-muted">قیمت واحد: @AUI.MoneyFa(item.UnitPrice)</div>
                    </div>
                    <div class="st-qty" role="group" aria-label="@($"تعداد {item.ProductTitle}")">
                        <button type="button" @onclick="() => UpdateQty(item, item.Quantity - 1)" disabled="@(_busy || _couponBusy)" aria-label="@($"کاهش تعداد {item.ProductTitle}")">−</button>
                        <span class="cart-quantity" aria-live="polite" aria-atomic="true">@AUI.Number(item.Quantity)</span>
                        <button type="button" @onclick="() => UpdateQty(item, item.Quantity + 1)" disabled="@(_busy || _couponBusy)" aria-label="@($"افزایش تعداد {item.ProductTitle}")">+</button>
                    </div>
                    <div class="st-cart-item__total">
                        <div class="cart-line-total">@AUI.MoneyFa(item.TotalPrice)</div>
                        <button type="button" class="st-btn st-btn--ghost st-btn--sm cart-remove" aria-label="@($"حذف {item.ProductTitle} از سبد خرید")" @onclick="() => Remove(item)" disabled="@(_busy || _couponBusy)"><Icon Name="trash" Size="14" /> حذف</button>
                    </div>
                </article>
            }
            <button type="button" class="st-btn st-btn--ghost st-btn--sm cart-clear" @onclick="Clear" disabled="@(_busy || _couponBusy)">
                <Icon Name="trash" Size="14" /> خالی کردن سبد خرید
            </button>
        </div>

        <aside class="st-cart-sum" aria-labelledby="cart-summary-title">
            <h2 id="cart-summary-title">خلاصه سفارش</h2>

            <label class="cart-coupon-label" for="cart-coupon">کد تخفیف</label>
            <form class="st-promo" @onsubmit="ApplyCoupon" @onsubmit:preventDefault="true">
                <input id="cart-coupon" class="st-input" placeholder="کد تخفیف را وارد کنید" aria-describedby="cart-coupon-message" @bind="_coupon" disabled="@(_discount > 0 || _busy || _couponBusy)" />
                @if (_discount > 0)
                {
                    <button type="button" class="st-btn st-btn--ghost st-btn--sm" @onclick="ClearCoupon" disabled="@(_busy || _couponBusy)" aria-label="حذف کد تخفیف">حذف</button>
                }
                else
                {
                    <button type="submit" class="st-btn st-btn--outline st-btn--sm" disabled="@(_couponBusy || _busy)" aria-label="اعمال کد تخفیف">
                        @if (_couponBusy) { <span class="st-spinner sm"></span> } else { <span>اعمال</span> }
                    </button>
                }
            </form>
            <div id="cart-coupon-message" class="st-promo__msg @(_discount > 0 ? "ok" : "err")" role="status">@_couponMsg</div>

            <div class="st-sumrow"><span class="st-muted">تعداد اقلام</span><span>@AUI.Number(_cart.TotalQuantity)</span></div>
            <div class="st-sumrow"><span class="st-muted">جمع کل</span><span>@AUI.MoneyFa(_cart.SubtotalAmount)</span></div>
            @if (_discount > 0)
            {
                <div class="st-sumrow cart-discount"><span>تخفیف کد @_appliedCode</span><span>−@AUI.MoneyFa(_discount)</span></div>
            }
            @if (VatEnabled)
            {
                <div class="st-sumrow" data-testid="cart-vat-row"><span class="st-muted">مالیات بر ارزش افزوده (@AUI.Percent(VatRatePercent)٪)</span><span>@AUI.MoneyFa(VatAmount)</span></div>
            }
            <div class="st-sumrow total" data-testid="cart-payable" aria-live="polite" aria-atomic="true"><span>مبلغ قابل پرداخت</span><span>@AUI.MoneyFa(Payable)</span></div>

            <button type="button" class="st-btn st-btn--accent st-btn--block st-btn--lg cart-checkout" disabled="@(_busy || _couponBusy || _loading)" @onclick="ContinueToCheckoutAsync">
                <Icon Name="lock" Size="17" /> ادامه و پرداخت امن
            </button>
            <a class="st-btn st-btn--ghost st-btn--block cart-continue" href="/shop">ادامه خرید</a>

            <div class="st-cart-trust">
                <span><Icon Name="lock" Size="14" /> پرداخت امن</span>
                <span><Icon Name="zap" Size="14" /> تحویل آنی</span>
                <span><Icon Name="shield-check" Size="14" /> اصالت تضمینی</span>
            </div>
        </aside>
    </div>
}
</section>

@code {
    private bool _loading = true, _busy, _couponBusy;
    private string? _loadError;
    private CartModel? _cart;
    private string _coupon = string.Empty;
    private string _appliedCode = string.Empty;
    private decimal _discount;
    private string? _couponMsg;
    // Server-computed pricing. With no coupon applied these mirror the cart preview; once a coupon
    // is validated they mirror the coupon preview. The Razor layer performs no VAT arithmetic.
    private ValidateCouponResultModel? _couponPricing;

    private bool VatEnabled => _couponPricing?.VatEnabled ?? _cart?.VatEnabled ?? false;
    private decimal VatRatePercent => _couponPricing?.VatRatePercent ?? _cart?.VatRatePercent ?? 0m;
    private decimal VatAmount => _couponPricing?.VatAmount ?? _cart?.VatAmount ?? 0m;
    private decimal Payable => _couponPricing?.FinalAmount ?? _cart?.FinalAmount ?? 0m;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "mergeError")] public string? MergeError { get; set; }

    private ErrorStateInfo _emptyInfo =
        ErrorStates.Resolve("empty-cart", new Vitorize.Web.Services.UI.StoreBranding(new Dictionary<string, string>()));

    protected override async Task OnInitializedAsync()
    {
        _emptyInfo = ErrorStates.Resolve("empty-cart", await Branding.GetAsync());
        await Load();
    }

    private async Task ApplyCoupon()
    {
        if (_cart is null || string.IsNullOrWhiteSpace(_coupon)) return;
        _couponBusy = true; _couponMsg = null;
        var r = await Api.PostAsync<ValidateCouponResultModel>("coupons/validate",
            new { Code = _coupon.Trim(), OrderAmount = _cart.SubtotalAmount });
        _couponBusy = false;
        if (r.IsSuccess && r.Data is { CouponId: not null })
        {
            _couponPricing = r.Data;
            _discount = r.Data.DiscountAmount;
            _appliedCode = r.Data.Code ?? _coupon.Trim();
            _couponMsg = $"کد تخفیف اعمال شد: {AUI.MoneyFa(_discount)} تخفیف";
        }
        else
        {
            _couponPricing = null;
            _discount = 0; _appliedCode = string.Empty;
            _couponMsg = string.IsNullOrWhiteSpace(r.Message) ? "کد تخفیف نامعتبر است." : r.Message;
        }
    }

    private void ClearCoupon()
    {
        _couponPricing = null;
        _discount = 0; _appliedCode = string.Empty; _coupon = string.Empty; _couponMsg = null;
    }

    /// <summary>
    /// Loads the cart, keeping what is already on screen if the request fails.
    ///
    /// A failed read says nothing about what the customer's cart contains, so it must not be allowed
    /// to look like an emptied one: the last known items stay visible under a recoverable error with a
    /// retry. Only a successful response ever replaces the contents.
    /// </summary>
    private async Task Load()
    {
        _loading = true; _loadError = null;
        try
        {
            var result = await Api.GetAsync<CartModel>("cart");
            if (result.IsSuccess && result.Data is not null)
            {
                _cart = result.Data;
                CartSvc.Set(_cart.TotalQuantity);
            }
            else
            {
                _loadError = "سبد خرید بارگذاری نشد. لطفاً دوباره تلاش کنید.";
            }
        }
        catch
        {
            _loadError = "سبد خرید بارگذاری نشد. لطفاً دوباره تلاش کنید.";
        }
        finally { _loading = false; }
    }

    private async Task UpdateQty(CartItemModel item, int qty)
    {
        if (qty < 1) { await Remove(item); return; }
        _busy = true;
        var result = await Api.PutAsync<CartModel>($"cart/items/{item.Id}", new { Quantity = qty });
        _busy = false;
        Apply(result);
    }

    private async Task Remove(CartItemModel item)
    {
        _busy = true;
        var result = await Api.DeleteAsync($"cart/items/{item.Id}");
        _busy = false;
        if (result.IsSuccess) await Load();
        else Toasts.Error(result.Message);
    }

    private async Task Clear()
    {
        _busy = true;
        var result = await Api.DeleteAsync("cart/clear");
        _busy = false;
        if (result.IsSuccess) { CartSvc.Clear(); await Load(); }
        else Toasts.Error(result.Message);
    }

    private void Apply(ApiResult<CartModel> result)
    {
        if (result.IsSuccess && result.Data is not null)
        {
            _cart = result.Data;
            CartSvc.Set(_cart.TotalQuantity);
        }
        else Toasts.Error(result.Message);
    }

    private async Task ContinueToCheckoutAsync()
    {
        if (_cart is null) return;

        if (AuthState is null || (await AuthState).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo("/login?returnUrl=%2Fcheckout", forceLoad: true);
            return;
        }

        var checkoutHref = _discount > 0 && !string.IsNullOrWhiteSpace(_appliedCode)
            ? $"/checkout?coupon={Uri.EscapeDataString(_appliedCode)}"
            : "/checkout";
        Nav.NavigateTo(checkoutHref);
        await Task.CompletedTask;
    }

    private static string InputType(byte type) => type switch { 2 => "email", 3 => "tel", 4 => "number", 10 => "url", 11 => "date", 12 => "password", _ => "text" };
    private static string InputDirection(byte type) => type is 2 or 3 or 4 or 10 or 11 ? "ltr" : "rtl";
}
