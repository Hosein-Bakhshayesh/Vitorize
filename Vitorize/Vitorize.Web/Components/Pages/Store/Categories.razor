@page "/categories"
@inject ApiClient Api
@inject MediaUrlResolver Media

<SeoHead Title="دسته‌بندی محصولات" Description="دسته‌بندی محصولات و خدمات دیجیتال ویتورایز" CanonicalPath="/categories" />

<div class="st-bc"><a href="/">خانه</a> <Icon Name="chevron-left" Size="13" /> <span>دسته‌بندی‌ها</span></div>
<h1 style="font-size:22px;margin-bottom:18px">همه دسته‌بندی‌ها</h1>

@if (_loading)
{
    <div class="st-state"><div class="st-spinner"></div></div>
}
else if (_categories.Count == 0)
{
    <div class="st-state"><div class="st-state__ic"><Icon Name="layers" Size="32" /></div><div style="font-weight:700">دسته‌بندی‌ای یافت نشد</div></div>
}
else
{
    <div class="st-category-groups">
        @foreach (var parent in RootCategories)
        {
            var children = ChildrenOf(parent);
            <section class="st-category-group">
                <div class="st-category-group__head">
                    <a class="st-category-group__parent" href="@($"/category/{parent.Slug}")">
                        <span class="st-category-group__ic"><CategoryMedia IconKey="@parent.Icon" ImagePath="@parent.ImagePath" Alt="@(parent.ImageAltText ?? parent.Title)" IconSize="20" /></span>
                        <span>@parent.Title</span>
                    </a>
                    <a class="st-category-group__all" href="@($"/category/{parent.Slug}")">مشاهده همه <Icon Name="chevron-left" Size="14" /></a>
                </div>
                @if (children.Count == 0)
                {
                    <a class="st-category-group__empty" href="@($"/category/{parent.Slug}")">مشاهده محصولات این دسته</a>
                }
                else
                {
                    <div class="st-cats">
                        @foreach (var child in children)
                        {
                            <a class="st-cat" href="@($"/category/{child.Slug}")">
                                <div class="st-cat__ic">
                                    <CategoryMedia IconKey="@child.Icon" ImagePath="@child.ImagePath" Alt="@(child.ImageAltText ?? child.Title)" IconSize="22" />
                                </div>
                                <div class="st-cat__t">@child.Title</div>
                            </a>
                        }
                    </div>
                }
            </section>
        }
    </div>
}

@code {
    private bool _loading = true;
    private List<StoreLookupModel> _categories = new();
    private List<StoreLookupModel> RootCategories => _categories.Where(x => x.ParentId is null).ToList();
    private List<StoreLookupModel> ChildrenOf(StoreLookupModel category) =>
        _categories.Where(x => x.ParentId == category.Id).ToList();

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<StoreLookupModel>>("products/categories");
        _categories = result.Data ?? new();
        _loading = false;
    }
}
