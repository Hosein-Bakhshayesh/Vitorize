@page "/payment/result"
@inject CartState Cart
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>نتیجه پرداخت | ویتورایز</PageTitle>

<div class="st-state" style="padding:70px 24px">
    @if (Paid == "1")
    {
        <div class="st-state__ic" style="background:var(--st-success-soft);color:var(--st-success)"><Icon Name="check-circle" Size="40" /></div>
        <h1 style="font-size:24px">پرداخت با موفقیت انجام شد</h1>
        <p class="st-muted" style="max-width:440px">سفارش شما ثبت و در صورت تحویل آنی، کدها در جزئیات سفارش قابل مشاهده هستند.</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
            @if (OrderId is not null)
            {
                <a class="st-btn st-btn--primary" href="@($"/customer/orders/{OrderId}")"><Icon Name="package-check" Size="17" /> مشاهده سفارش و کدها</a>
            }
            <a class="st-btn st-btn--outline" href="/customer/orders">سفارش‌های من</a>
            <a class="st-btn st-btn--ghost" href="/shop">ادامه خرید</a>
        </div>
    }
    else
    {
        <div class="st-state__ic" style="background:var(--st-danger-soft);color:var(--st-danger)"><Icon Name="x-circle" Size="40" /></div>
        <h1 style="font-size:24px">پرداخت ناموفق بود</h1>
        <p class="st-muted" style="max-width:440px">متأسفانه پرداخت شما تکمیل نشد. در صورت کسر وجه، مبلغ طی ۷۲ ساعت بازگردانده می‌شود.</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:center">
            @if (_canRetry && OrderId is not null)
            {
                <button class="st-btn st-btn--primary" disabled="@_retrying" @onclick="RetryPayment"><Icon Name="refresh" Size="17" /> @(_retrying ? "در حال آماده‌سازی..." : "تلاش مجدد پرداخت")</button>
            }
            <a class="st-btn st-btn--primary" href="/cart">بازگشت به سبد خرید</a>
            @if (OrderId is not null)
            {
                <a class="st-btn st-btn--outline" href="@($"/customer/orders/{OrderId}")">جزئیات سفارش</a>
            }
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] public string? OrderId { get; set; }
    [SupplyParameterFromQuery] public string? Paid { get; set; }
    private bool _canRetry;
    private bool _retrying;

    protected override void OnInitialized()
    {
        if (Paid == "1") Cart.Clear();
    }

    protected override async Task OnParametersSetAsync()
    {
        _canRetry = false;
        if (Paid == "1" || !Guid.TryParse(OrderId, out var orderId)) return;
        var eligibility = await Api.GetAsync<PaymentRetryEligibilityModel>($"payments/retry-eligibility/{orderId}");
        _canRetry = eligibility.IsSuccess && eligibility.Data?.CanRetry == true;
    }

    private async Task RetryPayment()
    {
        if (!Guid.TryParse(OrderId, out var orderId)) return;
        _retrying = true;
        var start = await Api.PostAsync<PaymentStartResultModel>($"payments/retry/{orderId}");
        if (!start.IsSuccess || start.Data is null)
        {
            _retrying = false;
            _canRetry = false;
            Toasts.Error(start.Message);
            return;
        }
        if (!string.IsNullOrWhiteSpace(start.Data.PaymentUrl) && start.Data.PaymentUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(start.Data.PaymentUrl, forceLoad: true);
            return;
        }
        var verify = await Api.PostAsync<PaymentVerifyResultModel>($"payments/mock/verify/{start.Data.PaymentId}");
        _retrying = false;
        if (verify.IsSuccess && verify.Data?.IsPaid == true)
            Nav.NavigateTo($"/payment/result?orderId={orderId}&paid=1");
        else
            Toasts.Error(verify.Message);
    }
}
