@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject StoreBrandingService Branding
@inject NavigationManager Nav
@using Vitorize.Web.Models.Customer
@using AUI = Vitorize.Web.Helpers.AdminUiHelper
@using Vitorize.Shared.Storefront

<SeoHead Description="@_branding.MetaDescription" CanonicalPath="/" ImagePath="@_branding.OgImagePath" JsonLd="@HomeJsonLd()" />
<div class="hp-home" aria-busy="@_loading">
    @if (_loadFailed) { <div class="hp-data-notice" role="status">اطلاعات فروشگاه دریافت نشد. <button type="button" @onclick="LoadAsync">تلاش دوباره</button></div> }
    <section class="hp-hero" aria-labelledby="hp-title">
        <div class="hp-hero__copy">
            <h1 id="hp-title">@_branding.Get("HeroTitle", "زندگی دیجیتالتو پیشرفت بده حمال!")</h1>
            <p>@_branding.Get("HeroSubtitle", "لورم ایپسوم دولور سیت امت.")</p>
            @* The handoff drew these as plain shapes and they shipped that way: two links with an
               aria-label and no text, plus a block that was never anything but decoration. *@
            <div class="hp-hero__actions">
                <a class="hp-hero__cta" href="@_branding.HeroCtaUrl">@_branding.HeroCtaText</a>
                <a class="hp-hero__cta hp-hero__cta--ghost" href="@_branding.HeroSecondaryCtaUrl">@_branding.Get("HeroSecondaryCtaText", "دسته‌بندی‌ها")</a>
            </div>
        </div>
        <div class="hp-hero__mosaic">
            @for (var i = 0; i < 4; i++)
            {
                @* The hero is four fixed tiles, so a banner assigned to tile 3 must remain there
                   even when tiles 1 and 2 are empty. Using its index in a filtered list moved it
                   into the first empty tile. *@
                var banner = HeroBannerAt(i);
                @if (banner is not null)
                { <a class="hp-hero__tile hp-hero__tile--@(i + 1)" href="@(banner.LinkUrl ?? "/shop")" aria-label="@banner.Title"><StoreImage Url="@banner.ImagePath" MobileUrl="@banner.MobileImagePath" Alt="@(banner.AltText ?? banner.Title)" Loading="eager" /></a> }
                else { <div class="hp-hero__tile hp-hero__tile--@(i + 1) hp-ph hp-ph--@(i + 1)" aria-hidden="true"></div> }
            }
        </div>
    </section>
    @* A row of category icons, as the design specifies. The tree lives in the two header menus and
       on /categories; repeating it here buried the categories themselves under their branches. *@
    <section class="hp-section hp-categories" aria-labelledby="hp-cats-title">
        <h2 id="hp-cats-title">@_branding.HomeCategoriesTitle</h2>
        @if (_data.Categories.Count == 0) { <p class="hp-empty">@Empty("دسته‌بندی")</p> }
        else
        {
            <div class="hp-category-grid">
                @foreach (var category in _data.Categories.Take(_branding.HomeCategoryCount))
                {
                    <a class="hp-category" href="@($"/category/{category.Slug}")">
                        <span class="hp-category__image">
                            <CategoryMedia IconKey="@category.Icon" ImagePath="@category.ImagePath" Alt="@(category.ImageAltText ?? category.Title)" IconSize="44" />
                        </span>
                        <span class="hp-category__title">@category.Title</span>
                    </a>
                }
            </div>
            <a class="hp-cat-more" href="/categories">مشاهده همه دسته‌بندی‌ها <Icon Name="chevron-left" Size="15" /></a>
        }
    </section>
    @if (_branding.HomePopularProductsEnabled)
    {
    <section class="hp-section hp-products">
        <h2>@_branding.HomeProductsTitle</h2>
        @* Use the same interactive card as catalogue and related-products. Keeping a separate
           home-only card caused the visual and purchase actions to drift from every other page. *@
        <div class="st-lgrid hp-product-grid">
            @foreach (var product in _products.Take(8)) { <StoreProductCard @key="product.Id" Product="product" /> }
            @if (_products.Count == 0) { <p class="hp-empty">@Empty("محصول")</p> }
        </div>
        <a class="hp-products-more" href="/shop">مشاهده کالاهای بیشتر <Icon Name="arrow-left" Size="17" /></a>
    </section>
    }
    @* Unlike the four tiles at the top, which hold the composition together whether or not they are
       filled, this one spans the page on its own: an empty frame here is just a gap. *@
    <HomeSlideshow Slides="MiddleSlides" Variant="middle" AriaLabel="پیشنهادهای فروشگاه" />
    @* One card per configured feature, not a fixed four. The loop used to run to four whatever the
       settings held, so a shorter list left blank white circles standing on the page - and with the
       list empty, as it is on production, the whole section was four circles and nothing else. *@
    @if (HomeFeatures.Count > 0)
    {
        <section class="hp-section hp-benefits" aria-label="مزایای خرید از ویتورایز">
            @foreach (var feature in HomeFeatures.Take(4))
            {
                <article class="hp-benefit">
                    <span class="hp-benefit__circle" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(feature.Icon)) { <Icon Name="@feature.Icon" Size="56" /> }
                    </span>
                    <h2>@feature.Title</h2>
                    @if (!string.IsNullOrWhiteSpace(feature.Text)) { <p>@feature.Text</p> }
                </article>
            }
        </section>
    }
    @* The brand band: marks alone, each centred in its own slot, with nothing drawn around them.
       A brand whose logo was never uploaded rides the rail as its name rather than being dropped,
       which is what the band used to do with it. *@
    @if (BrandRail.Count > 0)
    {
    <section class="hp-section hp-brandrail" aria-label="برندهای فروشگاه">
        <div class="hp-brandrail__track" @ref="_brandRail">
            @* Both cycles contain the exact same, sufficiently long sequence. Translating by
               half the track therefore lands on identical pixels, with no empty tail or reset. *@
            @foreach (var cycleIndex in Enumerable.Range(0, 2))
            {
                <div class="hp-brandrail__group" aria-hidden="@(cycleIndex > 0 ? "true" : "false")" data-cycle="@cycleIndex">
                    @foreach (var repeatIndex in Enumerable.Range(0, BrandRailRepeats))
                    {
                        var isDuplicate = cycleIndex > 0 || repeatIndex > 0;
                        <div class="hp-brandrail__sequence" aria-hidden="@(isDuplicate ? "true" : "false")">
                            @foreach (var brand in BrandRail.AsEnumerable().Reverse())
                            {
                                <a class="@(isDuplicate ? "hp-brandrail-clone" : null)" href="@($"/brand/{brand.Slug}")" aria-label="@(isDuplicate ? null : brand.Title)" tabindex="@(isDuplicate ? "-1" : null)">
                                    @if (!string.IsNullOrWhiteSpace(brand.ImagePath))
                                    {
                                        @* StoreImage rather than a bare <img>: a logo that fails to
                                           load leaves a drawn glyph where the mark belongs, not a
                                           broken-image icon. *@
                                        <span class="hp-brandrail__media">
                                            <StoreImage Url="@brand.ImagePath" Alt="@(isDuplicate ? string.Empty : (brand.ImageAltText ?? brand.Title))" Icon="tag" IconSize="26" Contain="true" />
                                        </span>
                                    }
                                    else
                                    {
                                        @* Nothing to show but the name, which is still a brand. *@
                                        <span class="hp-brandrail__name">@brand.Title</span>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </section>
    }
    <section class="hp-section hp-reviews">
        <h2>@_branding.HomeReviewsTitle</h2>
        @* Below three reviews the rail cannot fill its width, and RTL would leave the cards pinned to
           one edge with a dead half-screen beside them; the same threshold that skips the scroll
           positioning below centres them instead. *@
        <div class="hp-review-track @(_reviews.Count is > 0 and < 3 ? "hp-review-track--few" : null)" @ref="_reviewRail" tabindex="0" role="region" aria-label="نظرات تاییدشده خریداران">
            @foreach (var review in _reviews)
            {
                <article class="hp-review">
                    <div class="hp-review__head"><span class="hp-review__avatar" aria-hidden="true"><Icon Name="user" Size="34" /></span><div><strong>@review.UserDisplayName</strong><span>@(review.IsBuyer ? "خریدار محصول" : "کاربر ویتورایز")</span></div><b class="hp-review__rating">@AUI.Number(review.Rating)/۵</b></div>
                    <p>@review.Comment</p>
                </article>
            }
            @if (_reviews.Count == 0) { <p class="hp-empty">@Empty("نظر تاییدشده")</p> }
        </div>
    </section>
    @* Was a fixed card whose only editable parts were two settings, with dot controls that were
       decoration: aria-hidden, never changing, nothing behind them. Each slide is a row now, with
       its own artwork and copy, and the dots drive it. *@
    <HomeSlideshow Slides="BottomSlides" Variant="bottom" AriaLabel="پیشنهادهای ویتورایز" />
    <section class="hp-section hp-blog">
        <h2>@_branding.HomeBlogTitle</h2>
        <div class="hp-blog-grid">
            @foreach (var post in _data.LatestBlogPosts.Take(_branding.HomeBlogCount))
            {
                @* The title is the link text now, so the card needs no aria-label to stand in for it. *@
                <a class="hp-blog-card" href="@($"/blog/{post.Slug}")">
                    <span class="hp-blog-card__media"><StoreImage Url="@post.CoverImagePath" Alt="@(post.CoverImageAltText ?? post.Title)" /></span>
                    <h3 class="hp-blog-card__title"><span>@post.Title</span></h3>
                </a>
            }
            @if (_data.LatestBlogPosts.Count == 0) { <p class="hp-empty">@Empty("مطلب")</p> }
        </div>
    </section>
    <section class="hp-section hp-faq">
        <h2>@_branding.HomeFaqTitle</h2>
        <div class="hp-faq__list">
            @for (var i = 0; i < Math.Min(4, _data.Faqs.Count); i++)
            {
                var faq = _data.Faqs[i];
                @* The handoff drew this as a plain grey disc and it shipped that way: an empty <i>
                   with nothing in it, so the one control that says a row can be opened showed nothing. *@
                @* Every row starts closed: opening the first one on load pushed the rest down
                   the page before the reader had asked anything. *@
                <details><summary><span>@faq.Question</span><i aria-hidden="true"><Icon Name="chevron-down" Size="26" /></i></summary><div class="hp-faq__answer">@faq.Answer</div></details>
            }
            @if (_data.Faqs.Count == 0) { <p class="hp-empty">@Empty("سوال")</p> }
        </div>
    </section>
</div>

@code {
    private bool _loading = true, _loadFailed;
    private bool _reviewsPositioned;
    private bool _brandRailStarted;
    private ElementReference _reviewRail;
    private ElementReference _brandRail;
    private IJSObjectReference? _module;
    private StoreHomeModel _data = new();
    private List<StoreProductModel> _products = new();
    private List<CustomerReviewModel> _reviews = new();
    private StoreBranding _branding = new(new Dictionary<string, string>());
    // Placeholder copy from the design used to stand in for an unset list, but it carried no icon and
    // no body text, so it produced cards with a bare heading. Nothing configured now means no section.
    private IReadOnlyList<HomeBlockItem> HomeFeatures => _branding.HomeFeatures;
    // Nothing is filtered out: the chip has room for a name, so a brand with no logo uploaded
    // rides the rail like any other instead of being dropped for lack of artwork.
    private List<StoreBrandModel> BrandRail => _data.Brands;
    private int BrandRailRepeats => Math.Max(2, (int)Math.Ceiling(16d / Math.Max(1, BrandRail.Count)));

    /// <summary>Active slides of one placement that actually have artwork; a slide without one
    /// would render as a gap. Placement is normalised the same way the server does it, so a row
    /// written before placements existed still reaches the foot slideshow it was made for.</summary>
    private List<StoreHomeSlideModel> SlidesOf(string placement) => _data.Slides
        .Where(x => !string.IsNullOrWhiteSpace(x.ImagePath) &&
                    HomeSlidePlacements.Normalize(x.Placement) == placement)
        .OrderBy(x => x.SortOrder).ToList();

    private List<StoreHomeSlideModel> MiddleSlides => SlidesOf(HomeSlidePlacements.Middle);
    private List<StoreHomeSlideModel> BottomSlides => SlidesOf(HomeSlidePlacements.Bottom);
    private string Empty(string name) => _loading ? "در حال دریافت اطلاعات…" : $"{name} برای نمایش وجود ندارد.";
    private StoreBannerModel? HeroBannerAt(int tile) => _data.Banners
        .Where(b => string.Equals(b.Position, "home-hero", StringComparison.OrdinalIgnoreCase) &&
                    !string.IsNullOrWhiteSpace(b.ImagePath) &&
                    b.SortOrder == tile)
        .FirstOrDefault();

    protected override async Task OnInitializedAsync() => await LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_brandRailStarted && (_reviewsPositioned || _reviews.Count < 3)) return;

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/home.js?v=20260922-4");
        if (!_brandRailStarted && BrandRail.Count > 0)
        {
            _brandRailStarted = true;
            await _module.InvokeVoidAsync("startBrandRail", _brandRail);
        }
        if (!_reviewsPositioned && _reviews.Count >= 3)
        {
            _reviewsPositioned = true;
            await _module.InvokeVoidAsync("positionReviews", _reviewRail);
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("stopBrandRail", _brandRail);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _branding = await Branding.GetAsync();
            var homeTask = Api.GetAsync<StoreHomeModel>("storefront/home");
            var productsTask = Api.GetAsync<PagedResult<StoreProductModel>>("products?pageSize=8");
            await Task.WhenAll(homeTask, productsTask);
            _loadFailed = !homeTask.Result.IsSuccess || !productsTask.Result.IsSuccess;
            if (homeTask.Result is { IsSuccess: true, Data: not null }) _data = homeTask.Result.Data;
            // Never mask API failures with invented products, prices or customer reviews.
            // Preserve the existing homepage selection and the admin-configured default sort.
            _products = _data.FeaturedProducts.Take(8).ToList();
            if (_products.Count == 0 && productsTask.Result is { IsSuccess: true, Data: not null })
                _products = productsTask.Result.Data.Items.ToList();
            var reviewTasks = _products.Where(p => p.ReviewCount > 0).Take(4)
                .Select(p => Api.GetAsync<CustomerReviewListModel>($"product-reviews/product/{p.Id}?page=1&pageSize=4&sort=newest")).ToArray();
            var results = await Task.WhenAll(reviewTasks);
            _reviews = results.Where(r => r.IsSuccess && r.Data is not null)
                .SelectMany(r => r.Data!.Reviews.Items).Where(r => r.IsApproved && !r.IsRejected).DistinctBy(r => r.Id)
                .OrderByDescending(r => r.CreatedAt).Take(8).ToList();
            _reviewsPositioned = false;
        }
        catch { _loadFailed = true; }
        finally { _loading = false; }
    }

    private string HomeJsonLd()
    {
        var home = SeoUrlBuilder.Canonical(_branding, Nav.Uri, "/");
        var organization = new Dictionary<string, object?>
        {
            ["@type"] = "Organization", ["@id"] = home + "#organization",
            ["name"] = _branding.SiteName, ["url"] = home
        };
        if (!string.IsNullOrWhiteSpace(_branding.HeaderLogoPath))
            organization["logo"] = Media.Resolve(_branding.HeaderLogoPath);
        var website = new Dictionary<string, object?>
        {
            ["@type"] = "WebSite", ["@id"] = home + "#website", ["url"] = home,
            ["name"] = _branding.SiteName, ["publisher"] = new Dictionary<string, object?> { ["@id"] = home + "#organization" },
            ["potentialAction"] = new Dictionary<string, object?>
            {
                ["@type"] = "SearchAction", ["target"] = home.TrimEnd('/') + "/search?q={search_term_string}",
                ["query-input"] = "required name=search_term_string"
            }
        };
        return SeoJsonLd.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org", ["@graph"] = new object[] { organization, website }
        });
    }

}
