@page "/"
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@inject NavigationManager Nav
@using Vitorize.Web.Models.Store
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<SeoHead Description="@_branding.MetaDescription" CanonicalPath="/" ImagePath="@_branding.OgImagePath" JsonLd="@HomeJsonLd()" />

@if (_loading)
{
    <section class="st-hwrap">
        <div class="st-skel" style="height:460px;border-radius:var(--st-clip-xl)"></div>
        <div class="st-hstats">
            <div class="st-skel" style="height:88px;border-radius:var(--st-clip-sm)"></div>
            <div class="st-skel" style="height:88px;border-radius:var(--st-clip-sm)"></div>
            <div class="st-skel" style="height:120px;border-radius:var(--st-clip-sm)"></div>
        </div>
    </section>
    <div class="st-grid" style="margin-top:48px">
        @for (var i = 0; i < 8; i++)
        {
            <div class="st-skel" style="height:280px;border-radius:var(--st-clip)"></div>
        }
    </div>
}
else
{
    <div class="vz-home">
        <section class="vz-home__hero">
            <div class="vz-hero__copy">
                <h1>@_branding.HeroTitle</h1>
                <p>@_branding.HeroSubtitle</p>
                <div class="vz-hero__actions">
                    <a href="@_branding.HeroCtaUrl" aria-label="@_branding.HeroCtaText"></a>
                    @if (!string.IsNullOrWhiteSpace(_branding.HeroSecondaryCtaText))
                    {
                        <a class="vz-hero__action--outline" href="@_branding.HeroSecondaryCtaUrl" aria-label="@_branding.HeroSecondaryCtaText"></a>
                    }
                    <span class="vz-hero__action--muted"></span>
                </div>
            </div>
            <div class="vz-hero__mosaic" aria-label="@_branding.HeroTitle">
                @for (var i = 0; i < 4; i++)
                {
                    var banner = HeroBanners.ElementAtOrDefault(i);
                    <a class="vz-hero__tile vz-hero__tile--@(i + 1)" href="@(banner?.LinkUrl ?? "/shop")" tabindex="-1">
                        @if (banner is not null)
                        {
                            <StoreImage Url="@banner.ImagePath" MobileUrl="@banner.MobileImagePath" Alt="@(banner.AltText ?? banner.Title)" Icon="image" />
                        }
                    </a>
                }
            </div>
        </section>

        @if (_data.Categories.Count > 0)
        {
            <section class="vz-section vz-categories">
                <h2>دسته‌بندی‌های محبوب ویتورایز</h2>
                <div class="vz-category-grid">
                    @foreach (var category in _data.Categories.Take(6))
                    {
                        <a href="@($"/category/{category.Slug}")" class="vz-category">
                            <span class="vz-category__media"><CategoryMedia IconKey="@category.Icon" ImagePath="@category.ImagePath" Alt="@category.Title" IconSize="25" /></span>
                            <span>@category.Title</span>
                        </a>
                    }
                </div>
            </section>
        }

        @{ var bestsellerProducts = _data.FeaturedProducts.Count > 0 ? _data.FeaturedProducts : _latest; }
        @if (bestsellerProducts.Count > 0)
        {
            <section class="vz-section vz-products">
                <h2>محصولات پرفروش ویتورایز</h2>
                <div class="vz-product-grid">
                    @foreach (var product in bestsellerProducts.Take(8))
                    {
                        <StoreProductCard Product="product" />
                    }
                </div>
            </section>
        }

        <section class="vz-section vz-showcase">
            @if (CampaignBanner is not null)
            {
                <a class="vz-showcase__media" href="@(CampaignBanner.LinkUrl ?? "/shop")">
                    <StoreImage Url="@CampaignBanner.ImagePath" MobileUrl="@CampaignBanner.MobileImagePath" Alt="@(CampaignBanner.AltText ?? CampaignBanner.Title)" Icon="image" Width="1400" Height="700" />
                </a>
            }
            else
            {
                <div class="vz-showcase__media" aria-hidden="true"></div>
            }
            <span class="vz-showcase__dots" aria-hidden="true"></span>
        </section>

        @if (_branding.HomeFeatures.Count > 0)
        {
            <section class="vz-section vz-benefits">
                <div class="vz-benefit-grid">
                    @foreach (var feature in _branding.HomeFeatures.Take(4))
                    {
                        <article class="vz-benefit">
                            <span class="vz-benefit__icon"><LucideIcon IconKey="@feature.Icon" Size="28" FallbackIconKey="circle" /></span>
                            <h2>@feature.Title</h2>
                            <p>@feature.Text</p>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_data.Brands.Count > 0)
        {
            <section class="vz-brand-strip" aria-label="برندهای همکار">
                <div class="vz-brand-strip__track">
                    @foreach (var brand in _data.Brands.Take(12))
                    {
                        <a href="@($"/brand/{brand.Slug}")" title="@brand.Title">
                            @if (!string.IsNullOrWhiteSpace(brand.ImagePath))
                            {
                                <img src="@Media.Resolve(brand.ImagePath)" alt="@(brand.ImageAltText ?? brand.Title)" loading="lazy" />
                            }
                            else { <span>@brand.Title</span> }
                        </a>
                    }
                </div>
            </section>
        }

        <section class="vz-section vz-testimonials" aria-label="نظرات شما">
            <h2>نظرات شما</h2>
            <div class="vz-testimonial-track">
                @foreach (var testimonial in Testimonials)
                {
                    <article class="vz-testimonial">
                        <div class="vz-testimonial__head">
                            <span class="vz-testimonial__rating">@testimonial.Rating</span>
                            <div><strong>@testimonial.Name</strong><span>@testimonial.Role</span></div>
                            <i aria-hidden="true"></i>
                        </div>
                        <p>@testimonial.Text</p>
                    </article>
                }
            </div>
        </section>

        <section class="vz-section vz-promo">
            <div class="vz-promo__card">
                <div class="vz-promo__copy">
                    <h2>@_branding.NewsletterTitle</h2>
                    <p>@_branding.NewsletterSubtitle</p>
                </div>
                <form @onsubmit="SubscribeNewsletter" @onsubmit:preventDefault="true">
                    <input type="email" placeholder="@_branding.NewsletterPlaceholder" @bind="_newsletterEmail" />
                    <button type="submit">@_branding.NewsletterCtaText</button>
                </form>
                <span class="vz-promo__dots" aria-hidden="true"></span>
            </div>
        </section>

        @if (_data.LatestBlogPosts.Count > 0)
        {
            <section class="vz-section vz-blog">
                <h2>جدیدترین بلاگ‌ها</h2>
                <div class="vz-blog-grid">
                    @foreach (var post in _data.LatestBlogPosts.Take(3))
                    {
                        <a href="@($"/blog/{post.Slug}")" class="vz-blog-card">
                            <StoreImage Url="@post.CoverImagePath" Alt="@(post.CoverImageAltText ?? post.Title)" Icon="file-text" />
                            <span>@post.Title</span>
                        </a>
                    }
                </div>
            </section>
        }

        @if (_data.Faqs.Count > 0)
        {
            <section class="vz-section vz-faq">
                <h2>سوالات پرتکرار شما</h2>
                <div class="vz-faq__list">
                    @{ var faqs = _data.Faqs.Take(4).ToList(); }
                    @for (var index = 0; index < faqs.Count; index++)
                    {
                        var faq = faqs[index];
                        <FaqItem Question="@faq.Question" Answer="@faq.Answer" InitiallyOpen="@(index == 2)" />
                    }
                </div>
            </section>
        }
    </div>
}

@code {
    [Inject] private ToastService Toasts { get; set; } = default!;

    private bool _loading = true;
    private StoreHomeModel _data = new();
    private List<StoreProductModel> _latest = new();
    private List<StoreProductModel> _popular = new();
    private string _newsletterEmail = string.Empty;

    private static readonly TestimonialPreview[] Testimonials =
    [
        new("نام", "مشتری ۱ ساله", "۴/۵", "خدایی خیلی سریع بود؛ من خودم سفارش‌هام رو از شما می‌گیرم، دمت گرم."),
        new("گیمینگ ۷۸", "کاربر ویتورایز", "۱/۵", "ویتو چی؟ این چیه؟ بخش جانبی خیلی زود فعّال شد و تجربهٔ خرید خوبی داشتم."),
        new("وایزری", "مشتری قدیمی", "۵/۵", "چون بهتراشو می‌دم."),
        new("احمد", "مشتری قدیمی", "۵/۵", "خرید من کارت رو بدون مشکل و در کمترین زمان انجام دادم.")
    ];

    private List<StoreBannerModel> HeroBanners => _data.Banners
        .Where(b => string.Equals(b.Position, "home-hero", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(b.ImagePath))
        .OrderBy(b => b.SortOrder)
        .ToList();

    private StoreBannerModel? CampaignBanner => _data.Banners
        .Where(b => string.Equals(b.Position, "home-secondary", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(b.ImagePath))
        .OrderBy(b => b.SortOrder)
        .FirstOrDefault();

    private List<string> MarqueeItems
    {
        get
        {
            var items = _data.Brands.Select(b => b.Title)
                .Concat(_data.Categories.Select(c => c.Title))
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .Take(12)
                .ToList();
            return items;
        }
    }

    private Vitorize.Web.Services.UI.StoreBranding _branding =
        new(new Dictionary<string, string>());

    protected override async Task OnInitializedAsync()
    {
        // Branding is awaited first because it decides whether the popular-products request is worth
        // making at all. It is served from a short-lived process cache, so this is not an extra
        // round trip in practice — and when the section is off, the catalogue query never runs.
        _branding = await Branding.GetAsync();

        var homeTask = Api.GetAsync<StoreHomeModel>("storefront/home");
        // No sort key on purpose: the server then applies the admin-configured storefront default,
        // so this section and the shop page agree on the order instead of pinning "newest" here.
        var latestTask = Api.GetAsync<PagedResult<StoreProductModel>>("products?pageSize=8");
        var popularTask = _branding.HomePopularProductsEnabled
            // Explicitly ranked, so this section keeps its own meaning instead of drifting with the
            // storefront's configurable default order. Best-selling is the only real ranking signal
            // Vitorize stores - paid-order quantity - so the heading now reflects the actual order.
            ? Api.GetAsync<PagedResult<StoreProductModel>>("products?sort=bestselling&pageSize=20")
            : null;

        await Task.WhenAll(new Task[] { homeTask, latestTask }
            .Concat(popularTask is null ? Array.Empty<Task>() : new Task[] { popularTask }));

        if (homeTask.Result is { IsSuccess: true, Data: not null }) _data = homeTask.Result.Data;
        if (latestTask.Result is { IsSuccess: true, Data: not null }) _latest = latestTask.Result.Data.Items.ToList();

        // "Popular" has no dedicated backend sort — rank the catalogue by real engagement
        // (review count, then rating). No fabricated data; purely client-side ordering of the API result.
        if (popularTask?.Result is { IsSuccess: true, Data: { } popular })
        {
            _popular = popular.Items
                .OrderByDescending(p => p.ReviewCount)
                .ThenByDescending(p => p.AverageRating)
                .Take(8)
                .ToList();
        }

        _loading = false;
    }

    private void SubscribeNewsletter()
    {
        // No newsletter backend endpoint exists; acknowledge locally without inventing an API.
        if (string.IsNullOrWhiteSpace(_newsletterEmail) || !_newsletterEmail.Contains('@'))
        {
            Toasts.Error("لطفاً یک ایمیل معتبر وارد کنید.");
            return;
        }
        Toasts.Success("از عضویت شما سپاسگزاریم! به‌زودی با شما در تماس خواهیم بود.");
        _newsletterEmail = string.Empty;
    }

    private string HomeJsonLd()
    {
        var home = SeoUrlBuilder.Canonical(_branding, Nav.Uri, "/");
        var organization = new Dictionary<string, object?>
        {
            ["@type"] = "Organization", ["@id"] = home + "#organization",
            ["name"] = _branding.SiteName, ["url"] = home
        };
        if (!string.IsNullOrWhiteSpace(_branding.HeaderLogoPath))
            organization["logo"] = Media.Resolve(_branding.HeaderLogoPath);
        var website = new Dictionary<string, object?>
        {
            ["@type"] = "WebSite", ["@id"] = home + "#website", ["url"] = home,
            ["name"] = _branding.SiteName, ["publisher"] = new Dictionary<string, object?> { ["@id"] = home + "#organization" },
            ["potentialAction"] = new Dictionary<string, object?>
            {
                ["@type"] = "SearchAction", ["target"] = home.TrimEnd('/') + "/search?q={search_term_string}",
                ["query-input"] = "required name=search_term_string"
            }
        };
        return SeoJsonLd.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org", ["@graph"] = new object[] { organization, website }
        });
    }

    private sealed record TestimonialPreview(string Name, string Role, string Rating, string Text);
}
