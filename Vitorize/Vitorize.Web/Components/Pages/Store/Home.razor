@page "/"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject StoreBrandingService Branding
@inject NavigationManager Nav
@using Vitorize.Web.Models.Customer
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<SeoHead Description="@_branding.MetaDescription" CanonicalPath="/" ImagePath="@_branding.OgImagePath" JsonLd="@HomeJsonLd()" />
<div class="hp-home" aria-busy="@_loading">
    @if (_loadFailed) { <div class="hp-data-notice" role="status">اطلاعات فروشگاه دریافت نشد. <button type="button" @onclick="LoadAsync">تلاش دوباره</button></div> }
    <section class="hp-hero" aria-labelledby="hp-title">
        <div class="hp-hero__copy">
            <h1 id="hp-title">@_branding.Get("HeroTitle", "زندگی دیجیتالتو پیشرفت بده حمال!")</h1>
            <p>@_branding.Get("HeroSubtitle", "لورم ایپسوم دولور سیت امت.")</p>
            <div class="hp-hero__actions">
                <a href="@_branding.HeroCtaUrl" aria-label="@_branding.HeroCtaText"></a>
                <a href="@_branding.HeroSecondaryCtaUrl" aria-label="@_branding.Get("HeroSecondaryCtaText", "مشاهده دسته‌بندی‌ها")"></a>
                <span aria-hidden="true"></span>
            </div>
        </div>
        <div class="hp-hero__mosaic">
            @for (var i = 0; i < 4; i++)
            {
                var banner = HeroBanners.ElementAtOrDefault(i);
                @if (banner is not null)
                { <a class="hp-hero__tile hp-hero__tile--@(i + 1)" href="@(banner.LinkUrl ?? "/shop")" aria-label="@banner.Title"><StoreImage Url="@banner.ImagePath" MobileUrl="@banner.MobileImagePath" Alt="@(banner.AltText ?? banner.Title)" Loading="eager" /></a> }
                else { <div class="hp-hero__tile hp-hero__tile--@(i + 1) hp-ph hp-ph--@(i + 1)" aria-hidden="true"></div> }
            }
        </div>
    </section>
    <section class="hp-section hp-categories" aria-labelledby="hp-cats-title">
        <h2 id="hp-cats-title">دسته‌بندی‌های محبوب ویتورایز</h2>
        @if (CategoryRoots.Count == 0) { <p class="hp-empty">@Empty("دسته‌بندی")</p> }
        else
        {
            <div class="hp-cat-board">
                @foreach (var root in CategoryRoots)
                {
                    var branches = ChildrenOf(root.Id);
                    <article class="hp-cat-card">
                        <a class="hp-cat-card__head" href="@CategoryUrl(root)">
                            <span class="hp-cat-card__ic" aria-hidden="true"><CategoryMedia IconKey="@root.Icon" ImagePath="@root.ImagePath" Alt="@root.Title" IconSize="24" /></span>
                            <span class="hp-cat-card__t">@root.Title</span>
                            <Icon Name="chevron-left" Size="16" />
                        </a>
                        @if (branches.Count > 0)
                        {
                            <ul class="hp-cat-branch">
                                @foreach (var branch in branches)
                                {
                                    var leaves = DescendantsOf(branch.Id);
                                    <li>
                                        <a class="hp-cat-branch__link" href="@CategoryUrl(branch)"><i aria-hidden="true"></i><span>@branch.Title</span></a>
                                        @if (leaves.Count > 0)
                                        {
                                            <ul class="hp-cat-leaf">
                                                @foreach (var leaf in leaves)
                                                { <li><a href="@CategoryUrl(leaf)">@leaf.Title</a></li> }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                        <a class="hp-cat-card__all" href="@CategoryUrl(root)">مشاهده همه محصولات <Icon Name="chevron-left" Size="14" /></a>
                    </article>
                }
            </div>
            <a class="hp-cat-more" href="/categories">مشاهده همه دسته‌بندی‌ها <Icon Name="chevron-left" Size="15" /></a>
        }
    </section>
    <section class="hp-section hp-products">
        <h2>محصولات پرفروش ویتورایز</h2>
        <div class="hp-product-grid">
            @foreach (var product in _products.Take(8)) { <HomeProductCard Product="product" /> }
            @if (_products.Count == 0) { <p class="hp-empty">@Empty("محصول")</p> }
        </div>
    </section>
    <section class="hp-section hp-showcase" aria-label="پیشنهادهای فروشگاه">
        <div class="hp-banner @(CampaignBanners.Count == 0 ? "hp-ph hp-ph--wide" : null)">
            @if (CampaignBanners.ElementAtOrDefault(_campaignIndex) is { } campaign)
            { <a href="@(campaign.LinkUrl ?? "/shop")" aria-label="@campaign.Title"><StoreImage Url="@campaign.ImagePath" MobileUrl="@campaign.MobileImagePath" Alt="@(campaign.AltText ?? campaign.Title)" /></a> }
            <div class="hp-dots" aria-label="انتخاب بنر">
                @for (var i = 0; i < Math.Max(CampaignBanners.Count, 5); i++)
                {
                    var index = i;
                    @if (index < CampaignBanners.Count)
                    { <button type="button" class="@(index == _campaignIndex ? "is-active" : null)" aria-label="بنر @(index + 1)" aria-pressed="@(index == _campaignIndex)" @onclick="() => _campaignIndex = index"></button> }
                    else { <span aria-hidden="true" class="@(index == 1 ? "is-active" : null)"></span> }
                }
            </div>
        </div>
    </section>
    <section class="hp-section hp-benefits" aria-label="مزایای خرید از ویتورایز">
        @for (var i = 0; i < 4; i++)
        {
            var feature = HomeFeatures.ElementAtOrDefault(i);
            <article class="hp-benefit"><span class="hp-benefit__circle" aria-hidden="true"></span>
                @if (feature is not null) { <h2>@feature.Title</h2><p>@feature.Text</p> }
            </article>
        }
    </section>
    <section class="hp-section hp-brands" aria-label="برندها">
        <div class="hp-brands__track">
            @foreach (var brand in _data.Brands.Take(12).Reverse())
            {
                <a href="@($"/brand/{brand.Slug}")" aria-label="@brand.Title">
                    @if (!string.IsNullOrWhiteSpace(brand.ImagePath))
                    { <img src="@Media.Resolve(brand.ImagePath)" alt="@(brand.ImageAltText ?? brand.Title)" loading="lazy" /> }
                    else { <span>@brand.Title</span> }
                </a>
            }
        </div>
    </section>
    <section class="hp-section hp-reviews">
        <h2>نظرات شما</h2>
        <div class="hp-review-track" @ref="_reviewRail" tabindex="0" role="region" aria-label="نظرات تاییدشده خریداران">
            @foreach (var review in _reviews)
            {
                <article class="hp-review">
                    <div class="hp-review__head"><i aria-hidden="true"></i><div><strong>@review.UserDisplayName</strong><span>@(review.IsBuyer ? "خریدار محصول" : "کاربر ویتورایز")</span></div><b dir="ltr">@AUI.Number(review.Rating)/۵</b></div>
                    <p>@review.Comment</p>
                </article>
            }
            @if (_reviews.Count == 0) { <p class="hp-empty">@Empty("نظر تاییدشده")</p> }
        </div>
    </section>
    <section class="hp-section hp-promo" aria-label="اینستاگرام ویتورایز">
        <div class="hp-promo__card">
            <div><h2>@_branding.Get("InstagramBannerTitle", "اینستا رو هم فالو کن ناموسن.")</h2><p>@_branding.Get("InstagramBannerSubtitle", "هراز چند مزه می‌ریزیم اونجا")</p></div>
            @if (!string.IsNullOrWhiteSpace(_branding.InstagramUrl))
            { <a href="@_branding.InstagramUrl" target="_blank" rel="noopener noreferrer">برو اینستاگرام</a> }
            <div class="hp-dots" aria-hidden="true"><span class="is-active"></span><span></span></div>
        </div>
    </section>
    <section class="hp-section hp-blog">
        <h2>جدیدترین بلاگ‌ها</h2>
        <div class="hp-blog-grid">
            @foreach (var post in _data.LatestBlogPosts.Take(3))
            {
                @* The title is the link text now, so the card needs no aria-label to stand in for it. *@
                <a class="hp-blog-card" href="@($"/blog/{post.Slug}")">
                    <span class="hp-blog-card__media"><StoreImage Url="@post.CoverImagePath" Alt="@(post.CoverImageAltText ?? post.Title)" /></span>
                    <h3 class="hp-blog-card__title"><span>@post.Title</span></h3>
                </a>
            }
            @if (_data.LatestBlogPosts.Count == 0) { <p class="hp-empty">@Empty("مطلب")</p> }
        </div>
    </section>
    <section class="hp-section hp-faq">
        <h2>سوالات پرتکرار شما</h2>
        <div class="hp-faq__list">
            @for (var i = 0; i < Math.Min(4, _data.Faqs.Count); i++)
            {
                var faq = _data.Faqs[i];
                <details open="@(i == 2)"><summary><span>@faq.Question</span><i aria-hidden="true"></i></summary><div class="hp-faq__answer">@faq.Answer</div></details>
            }
            @if (_data.Faqs.Count == 0) { <p class="hp-empty">@Empty("سوال")</p> }
        </div>
    </section>
</div>

@code {
    private bool _loading = true, _loadFailed;
    private bool _reviewsPositioned;
    private ElementReference _reviewRail;
    private IJSObjectReference? _module;
    private int _campaignIndex;
    private StoreHomeModel _data = new();
    private List<StoreProductModel> _products = new();
    private List<CustomerReviewModel> _reviews = new();
    private StoreBranding _branding = new(new Dictionary<string, string>());
    private IReadOnlyList<HomeBlockItem> HomeFeatures => string.IsNullOrWhiteSpace(_branding.Get("HomeFeaturesJson", ""))
        ? ReferenceFeatures : _branding.HomeFeatures;
    // Copy from the supplied design is a presentation default only; configured copy wins.
    private static readonly HomeBlockItem[] ReferenceFeatures =
    [
        new("", "پشتیبانی‌های", ""),
        new("", "قیمت مناسب", ""),
        new("", "پرایمر و تنوع", ""),
        new("", "سرعت خرید بالا", "")
    ];
    private List<StoreLookupModel> _categoryTree = new();
    /// <summary>Root categories shown on the homepage board, in the administrator's configured order.</summary>
    private List<StoreLookupModel> CategoryRoots => CategoryTree.Roots(_categoryTree).Take(8).ToList();
    private List<StoreLookupModel> ChildrenOf(Guid parentId) => CategoryTree.ChildrenOf(_categoryTree, parentId);
    private List<StoreLookupModel> DescendantsOf(Guid parentId) => CategoryTree.DescendantsOf(_categoryTree, parentId);
    private static string CategoryUrl(StoreLookupModel category) => $"/category/{category.Slug}";
    private string Empty(string name) => _loading ? "در حال دریافت اطلاعات…" : $"{name} برای نمایش وجود ندارد.";
    private List<StoreBannerModel> HeroBanners => Banners("home-hero");
    private List<StoreBannerModel> CampaignBanners => Banners("home-secondary");
    private List<StoreBannerModel> Banners(string position) => _data.Banners
        .Where(b => string.Equals(b.Position, position, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(b.ImagePath))
        .OrderBy(b => b.SortOrder).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reviewsPositioned || _reviews.Count < 3) return;
        _reviewsPositioned = true;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/home.js");
        await _module.InvokeVoidAsync("positionReviews", _reviewRail);
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _branding = await Branding.GetAsync();
            var homeTask = Api.GetAsync<StoreHomeModel>("storefront/home");
            var productsTask = Api.GetAsync<PagedResult<StoreProductModel>>("products?pageSize=8");
            // storefront/home only carries root categories; the lookup carries ParentId, which the board needs.
            var categoriesTask = Api.GetAsync<List<StoreLookupModel>>("products/categories");
            await Task.WhenAll(homeTask, productsTask, categoriesTask);
            _loadFailed = !homeTask.Result.IsSuccess || !productsTask.Result.IsSuccess;
            if (homeTask.Result is { IsSuccess: true, Data: not null }) _data = homeTask.Result.Data;
            _categoryTree = categoriesTask.Result is { IsSuccess: true, Data: not null }
                ? categoriesTask.Result.Data
                // Without the lookup the hierarchy is unknown; show the roots flat rather than nothing.
                : _data.Categories.Select(c => new StoreLookupModel
                {
                    Id = c.Id, Title = c.Title, Slug = c.Slug,
                    Icon = c.Icon, ImagePath = c.ImagePath, ImageAltText = c.ImageAltText
                }).ToList();
            // Never mask API failures with invented products, prices or customer reviews.
            // Preserve the existing homepage selection and the admin-configured default sort.
            _products = _data.FeaturedProducts.Take(8).ToList();
            if (_products.Count == 0 && productsTask.Result is { IsSuccess: true, Data: not null })
                _products = productsTask.Result.Data.Items.ToList();
            _campaignIndex = 0;
            var reviewTasks = _products.Where(p => p.ReviewCount > 0).Take(4)
                .Select(p => Api.GetAsync<CustomerReviewListModel>($"product-reviews/product/{p.Id}?page=1&pageSize=4&sort=newest")).ToArray();
            var results = await Task.WhenAll(reviewTasks);
            _reviews = results.Where(r => r.IsSuccess && r.Data is not null)
                .SelectMany(r => r.Data!.Reviews.Items).Where(r => r.IsApproved && !r.IsRejected).DistinctBy(r => r.Id)
                .OrderByDescending(r => r.CreatedAt).Take(8).ToList();
            _reviewsPositioned = false;
        }
        catch { _loadFailed = true; }
        finally { _loading = false; }
    }

    private string HomeJsonLd()
    {
        var home = SeoUrlBuilder.Canonical(_branding, Nav.Uri, "/");
        var organization = new Dictionary<string, object?>
        {
            ["@type"] = "Organization", ["@id"] = home + "#organization",
            ["name"] = _branding.SiteName, ["url"] = home
        };
        if (!string.IsNullOrWhiteSpace(_branding.HeaderLogoPath))
            organization["logo"] = Media.Resolve(_branding.HeaderLogoPath);
        var website = new Dictionary<string, object?>
        {
            ["@type"] = "WebSite", ["@id"] = home + "#website", ["url"] = home,
            ["name"] = _branding.SiteName, ["publisher"] = new Dictionary<string, object?> { ["@id"] = home + "#organization" },
            ["potentialAction"] = new Dictionary<string, object?>
            {
                ["@type"] = "SearchAction", ["target"] = home.TrimEnd('/') + "/search?q={search_term_string}",
                ["query-input"] = "required name=search_term_string"
            }
        };
        return SeoJsonLd.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org", ["@graph"] = new object[] { organization, website }
        });
    }

}
