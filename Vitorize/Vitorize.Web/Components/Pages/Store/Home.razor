@page "/"
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@inject NavigationManager Nav
@using Vitorize.Web.Models.Store
@using Vitorize.Web.Models.Customer
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<SeoHead Description="@_branding.MetaDescription" CanonicalPath="/" ImagePath="@_branding.OgImagePath" JsonLd="@HomeJsonLd()" />

@if (_loading)
{
    <section class="st-hwrap">
        <div class="st-skel" style="height:460px;border-radius:var(--st-clip-xl)"></div>
        <div class="st-hstats">
            <div class="st-skel" style="height:88px;border-radius:var(--st-clip-sm)"></div>
            <div class="st-skel" style="height:88px;border-radius:var(--st-clip-sm)"></div>
            <div class="st-skel" style="height:120px;border-radius:var(--st-clip-sm)"></div>
        </div>
    </section>
    <div class="st-grid" style="margin-top:48px">
        @for (var i = 0; i < 8; i++)
        {
            <div class="st-skel" style="height:280px;border-radius:var(--st-clip)"></div>
        }
    </div>
}
else
{
    <div class="st-home">
    @* ---------- Hero ---------- *@
    <section class="st-home-hero">
        <div class="st-home-hero__content">
            @if (!string.IsNullOrWhiteSpace(_branding.HeroKicker))
            {
                <div class="st-home-hero__kicker">@_branding.HeroKicker</div>
            }
            <h1>@_branding.HeroTitle</h1>
            <p>@_branding.HeroSubtitle</p>
            <div class="st-home-hero__actions">
                <a class="st-btn st-btn--primary" href="@_branding.HeroCtaUrl"><Icon Name="shopping-bag" Size="17" /> @_branding.HeroCtaText</a>
                @if (!string.IsNullOrWhiteSpace(_branding.HeroSecondaryCtaText))
                {
                    <a class="st-btn st-btn--outline" href="@_branding.HeroSecondaryCtaUrl">@_branding.HeroSecondaryCtaText</a>
                }
            </div>
            <div class="st-home-hero__promises" aria-label="مزیت‌های خرید از ویتورایز">
                <span><Icon Name="zap" Size="15" /> تحویل آنی</span>
                <span><Icon Name="shield-check" Size="15" /> پرداخت امن</span>
                <span><Icon Name="headphones" Size="15" /> پشتیبانی ۲۴/۷</span>
            </div>
        </div>
        <div class="st-home-hero__visual">
            @if (HeroBanners.Count > 0)
            {
                <HeroSlider Banners="HeroBanners" ShowContent="false" />
            }
            else
            {
                <div class="st-home-hero__mosaic" aria-hidden="true">
                    @if (_data.Categories.Count > 0)
                    {
                        @foreach (var c in _data.Categories.Take(4))
                        {
                            <div><CategoryMedia IconKey="@c.Icon" ImagePath="@c.ImagePath" Alt="" IconSize="32" /></div>
                        }
                    }
                    else
                    {
                        @for (var i = 0; i < 4; i++)
                        {
                            <div><Icon Name="gamepad-2" Size="32" /></div>
                        }
                    }
                </div>
            }
        </div>
    </section>

    @* ---------- Popular categories ---------- *@
    @if (_data.Categories.Count > 0)
    {
        <section class="st-section st-home-categories st-reveal">
            <div class="st-section__head st-section__head--center">
                <div class="st-section__title"><span class="bar"></span> دسته‌بندی‌های محبوب ویتورایز</div>
            </div>
            <div class="st-bento st-bento--popular">
                @{ var cats = _data.Categories.Take(6).ToList(); }
                @foreach (var c in cats)
                {
                    <a class="st-bento__tile" href="@($"/category/{c.Slug}")">
                        <div class="st-bento__ic">
                            <CategoryMedia IconKey="@c.Icon" ImagePath="@c.ImagePath" Alt="@c.Title" IconSize="18" />
                        </div>
                        <div class="st-bento__t">@c.Title</div>
                    </a>
                }
            </div>
        </section>
    }

    @* ---------- Best sellers: the 4 × 2 product arrangement in the reference ---------- *@
    @if (_popular.Count > 0)
    {
        <section class="st-section st-home-bestsellers st-reveal">
            <div class="st-section__head st-section__head--center">
                <div class="st-section__title">محصولات پرفروش ویتورایز</div>
            </div>
            <div class="st-grid">
                @foreach (var product in _popular.Take(8))
                {
                    <StoreProductCard Product="product" />
                }
            </div>
        </section>
    }

    @* ---------- Full-width campaign: present even before an admin uploads its artwork. ---------- *@
    <section class="st-section st-reveal st-ref-campaign-section">
        @if (CampaignBanner is not null)
        {
            <a class="st-campaign" href="@(string.IsNullOrWhiteSpace(CampaignBanner.LinkUrl) ? "/shop" : CampaignBanner.LinkUrl)">
                <StoreImage Url="@CampaignBanner.ImagePath" MobileUrl="@CampaignBanner.MobileImagePath" Alt="@CampaignBanner.Title" Icon="gift" Width="1400" Height="700" />
            </a>
        }
        else
        {
            <a class="st-campaign st-campaign--placeholder" href="/shop" aria-label="مشاهده پیشنهادهای ویژه">
                <span class="st-campaign__eyebrow">پیشنهاد ویژه</span>
                <span class="st-campaign__copy">
                    <strong>پیشنهادهای تازهٔ ویتورایز</strong>
                    <small>محصولات دیجیتال با تحویل سریع و مطمئن</small>
                </span>
                <span class="st-campaign__dots" aria-hidden="true"><i></i><i></i></span>
            </a>
        }
    </section>

    @* ---------- Why Vitorize / How it works (from Settings: HomeFeaturesJson) ---------- *@
    @if (_branding.HomeFeatures.Count > 0)
    {
        <section class="st-section st-ref-redundant-trust st-reveal">
            <div class="st-section__center">
                <div class="st-section__kicker">@_branding.HomeFeaturesKicker</div>
                <h2 class="st-section__h">@_branding.HomeFeaturesTitle</h2>
            </div>
            <div class="st-hiw">
                @{ var stepNo = 0; }
                @foreach (var f in _branding.HomeFeatures)
                {
                    stepNo++;
                    <div class="st-hiw__step">
                        <div class="st-hiw__num">@AUI.Number(stepNo)</div>
                        <div class="st-hiw__ic"><LucideIcon IconKey="@f.Icon" Size="22" FallbackIconKey="shapes" /></div>
                        <div class="st-hiw__t">@f.Title</div>
                        <div class="st-hiw__d">@f.Text</div>
                    </div>
                }
            </div>
        </section>
    }

    @* ---------- Four trust cards: directly after the campaign as in the reference ---------- *@
    @if (_branding.TrustBadges.Count > 0)
    {
        <section class="st-section st-ref-trust-cards st-reveal">
            <div class="st-hero-mini" style="margin:0">
                @foreach (var t in _branding.TrustBadges.Take(4))
                {
                    <div class="st-trust">
                        <span class="st-trust__ic"><LucideIcon IconKey="@t.Icon" Size="20" FallbackIconKey="shield-check" /></span>
                        <div><div class="st-trust__t">@t.Title</div><div class="st-trust__s">@t.Text</div></div>
                    </div>
                }
            </div>
        </section>
    }

    @* ---------- Brand / platform ribbon ---------- *@
    @if (MarqueeItems.Count > 0)
    {
        <div class="st-marquee" aria-label="برندها و پلتفرم‌های محبوب">
            <div class="st-marquee__track">
                @foreach (var m in MarqueeItems) { <span class="st-marquee__item">@m</span> }
                @foreach (var m in MarqueeItems) { <span class="st-marquee__item">@m</span> }
            </div>
        </div>
    }

    @* ---------- Recent approved customer reviews ---------- *@
    @if (_testimonials.Count > 0)
    {
        <section class="st-section st-ref-testimonials st-reveal">
            <div class="st-section__head st-section__head--center">
                <div class="st-section__title">نظرهای شما</div>
            </div>
            <div class="st-ref-testimonials__rail">
                @foreach (var review in _testimonials.Take(4))
                {
                    <article class="st-ref-testimonial">
                        <div class="st-ref-testimonial__head">
                            <div>
                                <strong>@review.UserDisplayName</strong>
                                <small>@(review.IsBuyer ? "مشتری ویتورایز" : "کاربر ویتورایز")</small>
                            </div>
                            <span aria-label="امتیاز @review.Rating از ۵">@AUI.Number(review.Rating) / ۵</span>
                            <i aria-hidden="true"></i>
                        </div>
                        <p>@review.Comment</p>
                    </article>
                }
            </div>
        </section>
    }

    @* ---------- Brands ---------- *@
    @if (_data.Brands.Count > 0)
    {
        <section class="st-section st-home-brands st-ref-redundant-brands st-reveal">
            <div class="st-section__head st-section__head--center"><div class="st-section__title"><span class="bar"></span> برندهای محبوب</div></div>
            <div class="st-brands st-home-brandrail">
                @foreach (var b in _data.Brands.Take(12))
                {
                    <a class="st-brand-tile" href="@($"/brand/{b.Slug}")" title="@b.Title">
                        @if (!string.IsNullOrWhiteSpace(b.ImagePath))
                        {
                            <img src="@Media.Resolve(b.ImagePath)" alt="@(b.ImageAltText ?? b.Title)" loading="lazy"
                                 onerror="this.style.display='none';var s=this.nextElementSibling;if(s)s.style.display='block';" />
                            <span style="display:none">@b.Title</span>
                        }
                        else { <span>@b.Title</span> }
                    </a>
                }
            </div>
        </section>
    }

    @* ---------- Editorial campaign, positioned before blog and FAQ as in the reference. ---------- *@
    <section class="st-section st-ref-news-section st-reveal">
        <div class="st-news st-ref-news">
            <span class="st-news__aurora"></span>
            <div class="st-news__in">
                <h2 class="st-news__t">@_branding.NewsletterTitle</h2>
                <p class="st-news__s">@_branding.NewsletterSubtitle</p>
                <form class="st-news__form" @onsubmit="SubscribeNewsletter" @onsubmit:preventDefault="true">
                    <input type="email" placeholder="@_branding.NewsletterPlaceholder" @bind="_newsletterEmail" />
                    <button class="st-btn st-btn--accent st-btn--lg" type="submit"><Icon Name="send" Size="16" /> @_branding.NewsletterCtaText</button>
                </form>
            </div>
        </div>
    </section>

    @* ---------- Latest Blog ---------- *@
    @if (_data.LatestBlogPosts.Count > 0)
    {
        <section class="st-section st-ref-blog st-reveal">
            <div class="st-section__head st-section__head--center">
                <div class="st-section__title">جدیدترین بلاگ‌ها</div>
            </div>
            <div class="st-grid">
                @foreach (var post in _data.LatestBlogPosts.Take(3))
                {
                    <a class="st-pcard" href="@($"/blog/{post.Slug}")">
                        <div class="st-pcard__media">
                            <StoreImage Url="@post.CoverImagePath" Alt="@(post.CoverImageAltText ?? post.Title)" Icon="file-text" />
                        </div>
                        <div class="st-pcard__body">
                            <div class="st-pcard__title">@post.Title</div>
                            <div class="st-muted" style="font-size:12px"><PersianDateDisplay Value="post.CreatedAt" /></div>
                        </div>
                    </a>
                }
            </div>
        </section>
    }

    @* ---------- FAQ Preview ---------- *@
    @if (_data.Faqs.Count > 0)
    {
        <section class="st-section st-ref-faq st-reveal">
            <div class="st-section__head st-section__head--center">
                <div class="st-section__title">سوالات پرتکرار شما</div>
            </div>
            <div class="st-stack">
                @foreach (var f in _data.Faqs.Take(5))
                {
                    <FaqItem Question="@f.Question" Answer="@f.Answer" />
                }
            </div>
        </section>
    }

    </div>
}

@code {
    [Inject] private ToastService Toasts { get; set; } = default!;

    private bool _loading = true;
    private StoreHomeModel _data = new();
    private List<StoreProductModel> _latest = new();
    private List<StoreProductModel> _popular = new();
    private List<CustomerReviewModel> _testimonials = new();
    private string _newsletterEmail = string.Empty;

    private List<StoreBannerModel> HeroBanners => _data.Banners
        .Where(b => string.Equals(b.Position, "home-hero", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(b.ImagePath))
        .OrderBy(b => b.SortOrder)
        .ToList();

    private StoreBannerModel? CampaignBanner => _data.Banners
        .Where(b => string.Equals(b.Position, "home-secondary", StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(b.ImagePath))
        .OrderBy(b => b.SortOrder)
        .FirstOrDefault();

    private List<string> MarqueeItems
    {
        get
        {
            var items = _data.Brands.Select(b => b.Title)
                .Concat(_data.Categories.Select(c => c.Title))
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct()
                .Take(12)
                .ToList();
            return items;
        }
    }

    private Vitorize.Web.Services.UI.StoreBranding _branding =
        new(new Dictionary<string, string>());

    protected override async Task OnInitializedAsync()
    {
        // Branding is awaited first because it decides whether the popular-products request is worth
        // making at all. It is served from a short-lived process cache, so this is not an extra
        // round trip in practice — and when the section is off, the catalogue query never runs.
        _branding = await Branding.GetAsync();

        var homeTask = Api.GetAsync<StoreHomeModel>("storefront/home");
        // No sort key on purpose: the server then applies the admin-configured storefront default,
        // so this section and the shop page agree on the order instead of pinning "newest" here.
        var latestTask = Api.GetAsync<PagedResult<StoreProductModel>>("products?pageSize=8");
        // This section is explicit in the supplied homepage reference, so it must always load the
        // real paid-order ranking instead of relying on an optional branding flag.
        var popularTask = Api.GetAsync<PagedResult<StoreProductModel>>("products?sort=bestselling&pageSize=20");

        await Task.WhenAll(homeTask, latestTask, popularTask);

        if (homeTask.Result is { IsSuccess: true, Data: not null }) _data = homeTask.Result.Data;
        if (latestTask.Result is { IsSuccess: true, Data: not null }) _latest = latestTask.Result.Data.Items.ToList();

        // The API sort is the actual paid-order best-seller ranking. Keep it intact for the
        // homepage rather than replacing it with a review-based approximation.
        if (popularTask.Result is { IsSuccess: true, Data: { } popular })
        {
            _popular = popular.Items.Take(8).ToList();
        }

        // The reference includes a genuine review rail. Pull only approved, public review content
        // from the products already visible on this page; nothing is invented for presentation.
        var testimonialTasks = _data.FeaturedProducts.Take(8)
            .Select(p => Api.GetAsync<CustomerReviewListModel>($"product-reviews/product/{p.Id}?page=1&pageSize=2&sort=newest"))
            .ToList();
        if (testimonialTasks.Count > 0)
        {
            await Task.WhenAll(testimonialTasks);
            _testimonials = testimonialTasks
                .Where(t => t.Result is { IsSuccess: true, Data: not null })
                .SelectMany(t => t.Result.Data!.Reviews.Items)
                .OrderByDescending(r => r.CreatedAt)
                .Take(4)
                .ToList();
        }

        _loading = false;
    }

    private void SubscribeNewsletter()
    {
        // No newsletter backend endpoint exists; acknowledge locally without inventing an API.
        if (string.IsNullOrWhiteSpace(_newsletterEmail) || !_newsletterEmail.Contains('@'))
        {
            Toasts.Error("لطفاً یک ایمیل معتبر وارد کنید.");
            return;
        }
        Toasts.Success("از عضویت شما سپاسگزاریم! به‌زودی با شما در تماس خواهیم بود.");
        _newsletterEmail = string.Empty;
    }

    private string HomeJsonLd()
    {
        var home = SeoUrlBuilder.Canonical(_branding, Nav.Uri, "/");
        var organization = new Dictionary<string, object?>
        {
            ["@type"] = "Organization", ["@id"] = home + "#organization",
            ["name"] = _branding.SiteName, ["url"] = home
        };
        if (!string.IsNullOrWhiteSpace(_branding.HeaderLogoPath))
            organization["logo"] = Media.Resolve(_branding.HeaderLogoPath);
        var website = new Dictionary<string, object?>
        {
            ["@type"] = "WebSite", ["@id"] = home + "#website", ["url"] = home,
            ["name"] = _branding.SiteName, ["publisher"] = new Dictionary<string, object?> { ["@id"] = home + "#organization" },
            ["potentialAction"] = new Dictionary<string, object?>
            {
                ["@type"] = "SearchAction", ["target"] = home.TrimEnd('/') + "/search?q={search_term_string}",
                ["query-input"] = "required name=search_term_string"
            }
        };
        return SeoJsonLd.Serialize(new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org", ["@graph"] = new object[] { organization, website }
        });
    }
}
