@page "/page/{Slug}"
@inject ApiClient Api
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContext

@* Custom CMS pages. A system slug reached through this generic route is redirected to its canonical
   short route (/about, /terms, …) so the two URLs never claim independent canonical identities. *@

@if (_page is not null)
{
    <SeoHead Title="@(_page.SeoTitle ?? _page.Title)" Description="@_page.SeoDescription"
             CanonicalPath="@($"/page/{Uri.EscapeDataString(_page.Slug)}")" LastModified="@(_page.UpdatedAt ?? _page.CreatedAt)" />
}
else if (!_loading)
{
    <SeoHead Title="صفحه یافت نشد" Description="این صفحه در دسترس نیست." Index="false" Follow="false" />
}

<section class="content-page" aria-busy="@(_loading ? "true" : "false")">
@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت صفحه…</span></div>
}
else if (_page is null)
{
    <div class="st-state content-page__empty"><div class="st-state__ic"><Icon Name="file-text" Size="30" /></div><div class="cms-not-found__title">صفحه یافت نشد</div><a class="st-btn st-btn--primary st-btn--sm" href="/">بازگشت به خانه</a></div>
}
else
{
    <CmsPageContent Title="@_page.Title" ContentHtml="@_page.ContentHtml" />
}
</section>

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private bool _loading = true;
    private StorePageModel? _page;
    private string? _loadedSlug;

    protected override async Task OnParametersSetAsync()
    {
        if (Slug == _loadedSlug) return;
        _loadedSlug = Slug;
        _loading = true;
        var result = await Api.GetAsync<StorePageModel>($"pages/{Uri.EscapeDataString(Slug)}");
        _page = result.IsSuccess ? result.Data : null;

        if (_page is { IsSystem: true })
        {
            // Canonical redirect; the system route renders the same content.
            Nav.NavigateTo($"/{_page.Slug}", forceLoad: false, replace: true);
            return;
        }

        if (_page is null && HttpContext.HttpContext is { Response.HasStarted: false } context)
            context.Response.StatusCode = StatusCodes.Status404NotFound;
        _loading = false;
    }
}
