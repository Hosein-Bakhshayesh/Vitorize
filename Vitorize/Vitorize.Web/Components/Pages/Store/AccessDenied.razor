@page "/access-denied"
@using Vitorize.Web.Helpers
@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>دسترسی غیرمجاز | ویتورایز</PageTitle>

<SeoHead Title="@_info.Title" Description="@_info.Message" Index="false" Follow="false" />

<StoreState Info="_info" />

@code {
    private ErrorStateInfo _info =
        ErrorStates.Resolve("403", new Vitorize.Web.Services.UI.StoreBranding(new Dictionary<string, string>()));

    protected override async Task OnInitializedAsync()
    {
        var response = HttpContextAccessor.HttpContext?.Response;
        if (response is not null && !response.HasStarted)
            response.StatusCode = StatusCodes.Status403Forbidden;
        _info = ErrorStates.Resolve("403", await Branding.GetAsync());
    }
}
