@page "/checkout"
@inject ApiClient Api
@inject ToastService Toasts
@inject NavigationManager Nav
@inject MediaUrlResolver Media
@inject IJSRuntime JS
@using Vitorize.Application.Common
@using Vitorize.Web.Models.Customer
@using Vitorize.Web.Models.Store
@using Vitorize.Web.Services.UI
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>تکمیل خرید | ویتورایز</PageTitle>

<div class="st-steps">
    <div class="st-step done"><span class="st-step__n"><Icon Name="check" Size="13" /></span> سبد خرید</div>
    <div class="st-step active"><span class="st-step__n">۲</span> اطلاعات و پرداخت</div>
    <div class="st-step"><span class="st-step__n">۳</span> تکمیل سفارش</div>
</div>

@if (_loading)
{
    <div class="st-state"><div class="st-spinner"></div></div>
}
else if (_cart is null || _cart.Items.Count == 0)
{
    <div class="st-state" style="padding:60px 24px">
        <div class="st-state__ic"><Icon Name="cart" Size="32" /></div>
        <div style="font-weight:700">سبد خرید شما خالی است</div>
        <a class="st-btn st-btn--primary st-btn--sm" href="/shop">رفتن به فروشگاه</a>
    </div>
}
else
{
    <div class="st-split">
        <div class="st-stack">
            <div class="st-card">
                <div class="st-card__head"><Icon Name="user" Size="18" /> اطلاعات مشتری</div>
                <div class="st-card__pad">
                    <div class="st-stats" style="grid-template-columns:1fr 1fr">
                        <div><div class="st-muted" style="font-size:12px">نام</div><div style="font-weight:700">@(_user?.FullName ?? "-")</div></div>
                        <div><div class="st-muted" style="font-size:12px">موبایل</div><div style="font-weight:700" class="st-mono">@(_user?.Mobile ?? "-")</div></div>
                    </div>
                </div>
            </div>

            @* KYC here is post-payment: the customer pays now and delivery of the affected items
               waits for verification. That makes the explanation informational, but the customer
               still needs a way to act on it, so the panel always ends in a real link into the
               existing /customer/verification flow. The action follows the request's actual state
               so a customer whose documents are already under review is not told to submit again. *@
            @if (RequiresKyc && _user is not null && _user.VerificationStatus != (byte)VerificationStatus.Verified)
            {
                <div data-testid="checkout-kyc-information" class="st-alert st-alert--info st-checkout-kyc">
                    <Icon Name="shield" Size="20" />
                    <div>
                        <div style="font-weight:700">احراز هویت</div>
                        <div data-testid="checkout-kyc-post-payment-copy" style="font-size:12.5px;margin-top:4px">برای تحویل برخی اقلام این سفارش، پس از پرداخت تکمیل احراز هویت لازم است. پرداخت انجام می‌شود، اما تحویل این اقلام تا تکمیل احراز هویت در انتظار می‌ماند.</div>
                        <div data-testid="checkout-kyc-state" class="st-muted" style="font-size:12.5px;margin-top:6px">
                            وضعیت فعلی: <StoreBadge Text="@KycStateLabel" Intent="@KycStateIntent" Dot="false" />
                        </div>
                        @if (KycAwaitingReview)
                        {
                            <div style="font-size:12.5px;margin-top:6px">مدارک شما ارسال شده و در حال بررسی است؛ در حال حاضر اقدام دیگری لازم نیست.</div>
                            <a class="st-btn st-btn--outline st-btn--sm" style="margin-top:8px"
                               data-testid="checkout-kyc-status-link" href="/customer/verification">مشاهده وضعیت احراز هویت</a>
                        }
                        else
                        {
                            <div style="font-size:12.5px;margin-top:6px">@KycActionHint</div>
                            <a class="st-btn st-btn--outline st-btn--sm" style="margin-top:8px"
                               data-testid="checkout-kyc-cta" href="/customer/verification">@KycCtaLabel</a>
                        }
                    </div>
                </div>
            }

            <div class="st-card">
                <div class="st-card__head"><Icon Name="percent" Size="18" /> کد تخفیف</div>
                <div class="st-card__pad">
                    <div class="st-promo">
                        <input class="st-input" placeholder="کد تخفیف خود را وارد کنید" @bind="_coupon" disabled="@(_discount > 0)" />
                        @if (_discount > 0)
                        {
                            <button class="st-btn st-btn--ghost st-btn--sm" @onclick="ClearCoupon">حذف</button>
                        }
                        else
                        {
                            <button class="st-btn st-btn--outline st-btn--sm" @onclick="ApplyCoupon" disabled="@_couponBusy">
                                @if (_couponBusy) { <span class="st-spinner sm"></span> } else { <span>اعمال</span> }
                            </button>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_couponMsg))
                    {
                        <div class="st-promo__msg @(_discount > 0 ? "ok" : "err")">@_couponMsg</div>
                    }
                </div>
            </div>

            @* Product-required information is collected here, after the cart and before payment, so a
               payment can never start while a required value is missing. One card per cart line keeps
               it unambiguous which values belong to which purchased item. *@
            @if (ItemsNeedingInput.Count > 0)
            {
                <div class="st-card" data-testid="checkout-product-inputs">
                    <div class="st-card__head"><Icon Name="file-text" Size="18" /> اطلاعات مورد نیاز سفارش</div>
                    <div class="st-card__pad">
                        <div class="st-muted" style="font-size:12.5px;margin-bottom:12px">
                            برای آماده‌سازی اقلام زیر به اطلاعات زیر نیاز داریم. تا تکمیل موارد الزامی، پرداخت انجام نمی‌شود.
                        </div>
                        <div class="st-stack" style="gap:14px">
                            @foreach (var item in ItemsNeedingInput)
                            {
                                <div class="st-itemform" data-testid="checkout-input-card" data-item="@item.Id">
                                    <div class="st-itemform__head">
                                        <div class="st-itemform__media">
                                            @if (!string.IsNullOrWhiteSpace(item.ThumbnailImagePath))
                                            { <img src="@Media.Resolve(item.ThumbnailImagePath)" alt="" /> }
                                            else { <Icon Name="box" Size="18" /> }
                                        </div>
                                        <div style="flex:1;min-width:0">
                                            <div class="st-itemform__t">@item.ProductTitle</div>
                                            @{ var vt = ProductAvailabilityRules.CustomerFacingVariantTitle(item.VariantTitle); }
                                            <div class="st-itemform__s">
                                                @if (!string.IsNullOrWhiteSpace(vt)) { <span>@vt</span> <span>·</span> }
                                                <span>تعداد @AUI.Number(item.Quantity)</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="st-dynamic-form">
                                        @foreach (var field in item.InputFields.Where(x => x.IsActive).OrderBy(x => x.SortOrder).ThenBy(x => x.Id))
                                        {
                                            var fid = FieldId(item, field.Key);
                                            var err = FieldError(item, field.Key);
                                            <div class="st-field">
                                                <label class="st-label" for="@fid">
                                                    @field.Label
                                                    @if (field.IsRequired)
                                                    { <span class="req" data-testid="@($"checkout-input-required-{field.Key}")" aria-label="الزامی">*</span> }
                                                    else
                                                    { <span class="st-optional" data-testid="@($"checkout-input-optional-{field.Key}")">اختیاری</span> }
                                                </label>
                                                @if (!string.IsNullOrWhiteSpace(field.Description)) { <span class="st-help">@field.Description</span> }
                                                @if (field.FieldType is 6 or 7)
                                                {
                                                    <select id="@fid" class="st-select @(err is null ? null : "is-invalid")" value="@FieldValue(item, field.Key)"
                                                            @onchange="e => SetField(item, field.Key, e.Value?.ToString())"
                                                            aria-invalid="@(err is null ? "false" : "true")" aria-describedby="@(err is null ? null : FieldErrorId(item, field.Key))">
                                                        <option value="">— انتخاب کنید —</option>
                                                        @foreach (var option in field.Options) { <option value="@option">@option</option> }
                                                    </select>
                                                }
                                                else if (field.FieldType == 8)
                                                {
                                                    <label class="st-check @(err is null ? null : "is-invalid")">
                                                        <input id="@fid" type="checkbox" checked="@IsFieldChecked(item, field.Key)"
                                                               @onchange="e => SetFieldCheckbox(item, field.Key, e.Value)"
                                                               aria-invalid="@(err is null ? "false" : "true")" aria-describedby="@(err is null ? null : FieldErrorId(item, field.Key))" />
                                                        <span>@field.Placeholder</span>
                                                    </label>
                                                }
                                                else if (field.FieldType == 5)
                                                {
                                                    <textarea id="@fid" class="st-textarea @(err is null ? null : "is-invalid")" placeholder="@field.Placeholder"
                                                              value="@FieldValue(item, field.Key)" @oninput="e => SetField(item, field.Key, e.Value?.ToString())"
                                                              aria-invalid="@(err is null ? "false" : "true")" aria-describedby="@(err is null ? null : FieldErrorId(item, field.Key))"></textarea>
                                                }
                                                else
                                                {
                                                    <input id="@fid" class="st-input @(err is null ? null : "is-invalid")" type="@FieldInputType(field.FieldType)"
                                                           inputmode="@FieldInputMode(field.FieldType)" dir="@FieldDirection(field.FieldType)"
                                                           placeholder="@field.Placeholder" minlength="@field.MinLength" maxlength="@field.MaxLength"
                                                           value="@FieldValue(item, field.Key)" @oninput="e => SetField(item, field.Key, e.Value?.ToString())" autocomplete="off"
                                                           aria-invalid="@(err is null ? "false" : "true")" aria-describedby="@(err is null ? null : FieldErrorId(item, field.Key))" />
                                                }
                                                @if (field.IsSensitive)
                                                { <span class="st-help"><Icon Name="lock" Size="12" /> این مقدار رمزگذاری و در نمایش‌ها مخفی می‌شود.</span> }
                                                @if (field.RequiresConfirmation)
                                                {
                                                    <input id="@FieldConfirmId(item, field.Key)" class="st-input @(err is null ? null : "is-invalid")" type="password"
                                                           placeholder="تکرار @field.Label" value="@FieldConfirmation(item, field.Key)"
                                                           @oninput="e => SetFieldConfirmation(item, field.Key, e.Value?.ToString())" autocomplete="off" />
                                                }
                                                @if (err is { } message)
                                                {
                                                    <span id="@FieldErrorId(item, field.Key)" class="st-field__error" role="alert">@message</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="st-card">
                <div class="st-card__head"><Icon Name="credit-card" Size="18" /> روش پرداخت</div>
                <div class="st-card__pad">
                    <div class="st-paycards">
                        <div class="st-paycard @(_method == "gateway" ? "active" : null)" @onclick='() => _method = "gateway"'>
                            <span class="st-paycard__ic"><Icon Name="credit-card" Size="19" /></span>
                            <div><div class="st-paycard__t">پرداخت اینترنتی</div><div class="st-paycard__s">درگاه بانکی امن</div></div>
                            <span class="st-paycard__radio"></span>
                        </div>
                        <div class="st-paycard @(_method == "wallet" ? "active" : null) @(WalletEnough ? "" : "disabled")"
                             @onclick='() => { if (WalletEnough) _method = "wallet"; }'>
                            <span class="st-paycard__ic"><Icon Name="wallet" Size="19" /></span>
                            <div>
                                <div class="st-paycard__t">کیف پول ویتورایز</div>
                                <div class="st-paycard__s">موجودی: @AUI.MoneyFa(_walletBalance)@(WalletEnough ? "" : " (ناکافی)")</div>
                            </div>
                            <span class="st-paycard__radio"></span>
                        </div>
                    </div>
                    <div class="st-delivery-note">
                        <span class="ic"><Icon Name="zap" Size="16" /></span>
                        محصولات با تحویل آنی، بلافاصله پس از پرداخت در «سفارش‌های من» و «کدهای من» فعال می‌شوند.
                    </div>
                </div>
            </div>
        </div>

        <div class="st-card st-card__pad" style="align-self:start;position:sticky;top:calc(var(--st-header-h) + 16px)">
            <h3 style="font-size:16px;margin-bottom:14px">خلاصه سفارش</h3>
            <div class="st-stack" style="gap:8px;max-height:230px;overflow-y:auto;margin-bottom:10px">
                @foreach (var item in _cart.Items)
                {
                    <div class="st-spread" style="font-size:12.5px">
                        <span style="flex:1;min-width:0">@item.ProductTitle <span class="st-muted">×@AUI.Number(item.Quantity)</span></span>
                        <span class="st-mono">@AUI.MoneyFa(item.TotalPrice)</span>
                    </div>
                }
            </div>
            <div class="st-sumrow"><span class="st-muted">تعداد اقلام</span><span>@AUI.Number(_cart.TotalQuantity)</span></div>
            <div class="st-sumrow"><span class="st-muted">جمع کل</span><span>@AUI.MoneyFa(_cart.SubtotalAmount)</span></div>
            @if (_discount > 0)
            {
                <div class="st-sumrow" style="color:var(--st-success)"><span>تخفیف کد @_appliedCode</span><span>−@AUI.MoneyFa(_discount)</span></div>
            }
            @if (VatEnabled)
            {
                <div class="st-sumrow" data-testid="checkout-vat-row"><span class="st-muted">مالیات بر ارزش افزوده (@AUI.Percent(VatRatePercent)٪)</span><span>@AUI.MoneyFa(VatAmount)</span></div>
            }
            <div class="st-sumrow total" data-testid="checkout-payable"><span>مبلغ قابل پرداخت</span><span>@AUI.MoneyFa(Payable)</span></div>

            @if (_pendingOrderId is not null)
            {
                @* The order already exists; only its payment failed. Say so, so the customer knows
                   pressing the button again retries the payment rather than ordering twice. *@
                <div class="st-alert st-alert--warn" style="margin-top:14px" data-testid="checkout-pending-order">
                    <Icon Name="alert-triangle" Size="16" />
                    <span>سفارش شما ثبت شد اما پرداخت انجام نشد. برای تلاش دوباره روی دکمهٔ پرداخت بزنید.</span>
                </div>
            }
            <button class="st-btn st-btn--accent st-btn--block st-btn--lg" style="margin-top:14px"
                    data-testid="checkout-pay" @onclick="PlaceOrder" disabled="@_placing">
                @if (_placing) { <span class="st-spinner sm"></span> <span>در حال پردازش ...</span> }
                else if (_pendingOrderId is not null) { <Icon Name="lock" Size="18" /> <span>تلاش دوباره برای پرداخت @AUI.MoneyFa(Payable)</span> }
                else { <Icon Name="lock" Size="18" /> <span>پرداخت امن @AUI.MoneyFa(Payable)</span> }
            </button>
            <div class="st-secure"><Icon Name="lock" Size="13" /> رمزگذاری ۲۵۶ بیتی · پرداخت امن</div>
            <div class="st-cart-trust">
                <span><Icon Name="shield-check" Size="14" /> اصالت تضمینی</span>
                <span><Icon Name="zap" Size="14" /> تحویل آنی</span>
                <span><Icon Name="headphones" Size="14" /> پشتیبانی ۲۴/۷</span>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "coupon")] public string? CouponFromQuery { get; set; }

    private bool _loading = true, _placing, _couponBusy;
    // Set once checkout has created an order whose payment has not completed. It makes the
    // Pay button retry that order instead of re-running a checkout whose cart is already gone.
    private Guid? _pendingOrderId;
    private CartModel? _cart;
    private CustomerProfileModel? _user;
    private decimal _walletBalance;
    private string _coupon = string.Empty;
    private string _appliedCode = string.Empty;
    private decimal _discount;
    private string? _couponMsg;
    private string _method = "gateway";

    // Server-computed pricing only. VAT and the payable total are never derived in Razor, so the
    // amount shown before payment is exactly the amount the order will be created with.
    private ValidateCouponResultModel? _couponPricing;

    private bool VatEnabled => _couponPricing?.VatEnabled ?? _cart?.VatEnabled ?? false;
    private decimal VatRatePercent => _couponPricing?.VatRatePercent ?? _cart?.VatRatePercent ?? 0m;
    private decimal VatAmount => _couponPricing?.VatAmount ?? _cart?.VatAmount ?? 0m;
    private decimal Payable => _couponPricing?.FinalAmount ?? _cart?.FinalAmount ?? 0m;
    private bool WalletEnough => _cart is not null && _walletBalance >= Payable && Payable > 0;
    private bool RequiresKyc => _cart?.Items.Any(x => x.RequiresKyc) == true;

    // The customer's own verification request, used only to choose between "submit" and
    // "already under review". Null means nothing has been submitted yet.
    private CustomerVerificationModel? _verification;

    /// <summary>True once documents are submitted and still awaiting an administrator's decision.</summary>
    private bool KycAwaitingReview =>
        _verification is not null &&
        _verification.SubmittedAt.HasValue &&
        _verification.Status == (byte)VerificationStatus.Pending;

    private bool KycRejected =>
        _verification?.Status == (byte)VerificationStatus.Rejected ||
        _user?.VerificationStatus == (byte)VerificationStatus.Rejected;

    private string KycStateLabel =>
        KycRejected ? "نیازمند ارسال مجدد"
        : KycAwaitingReview ? "در حال بررسی"
        : "ثبت نشده";

    private string KycStateIntent => KycRejected ? "danger" : KycAwaitingReview ? "warning" : "muted";

    private string KycCtaLabel => KycRejected ? "ارسال مجدد مدارک" : "تکمیل احراز هویت";

    private string KycActionHint => KycRejected
        ? "مدارک قبلی تأیید نشد. برای تحویل این اقلام، مدارک را دوباره ارسال کنید."
        : "برای تحویل این اقلام، احراز هویت خود را تکمیل کنید.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusTargetId is not { } targetId) return;
        _focusTargetId = null;
        try { await JS.InvokeAsync<bool>("vzStorefront.focusAndScroll", targetId); } catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        var cartTask = Api.GetAsync<CartModel>("cart");
        var meTask = Api.GetAsync<CustomerProfileModel>("auth/me");
        var walletTask = Api.GetAsync<CustomerWalletModel>("wallet");
        await Task.WhenAll(cartTask, meTask, walletTask);

        _cart = cartTask.Result.Data;
        _user = meTask.Result.Data;
        _walletBalance = walletTask.Result.Data?.Balance ?? 0;
        _loading = false;

        // Only needed to pick the right KYC action, so it is fetched after the page can render and
        // a failure degrades to the "submit" action rather than blocking checkout.
        if (RequiresKyc && _user is not null && _user.VerificationStatus != (byte)VerificationStatus.Verified)
        {
            var verification = await Api.GetAsync<CustomerVerificationModel>("verification/me");
            _verification = verification.IsSuccess ? verification.Data : null;
        }

        // Re-validate a coupon carried over from the cart so its discount shows on the summary.
        if (!string.IsNullOrWhiteSpace(CouponFromQuery) && _cart is not null && _cart.Items.Count > 0)
        {
            _coupon = CouponFromQuery.Trim();
            await ApplyCoupon();
        }
    }

    private async Task ApplyCoupon()
    {
        if (_cart is null || string.IsNullOrWhiteSpace(_coupon)) return;
        _couponBusy = true; _couponMsg = null;
        var r = await Api.PostAsync<ValidateCouponResultModel>("coupons/validate",
            new { Code = _coupon.Trim(), OrderAmount = _cart.SubtotalAmount });
        _couponBusy = false;
        if (r.IsSuccess && r.Data is { CouponId: not null })
        {
            _couponPricing = r.Data;
            _discount = r.Data.DiscountAmount;
            _appliedCode = r.Data.Code ?? _coupon.Trim();
            _couponMsg = $"کد تخفیف اعمال شد: {AUI.MoneyFa(_discount)} تخفیف";
        }
        else
        {
            _couponPricing = null;
            _discount = 0; _appliedCode = string.Empty;
            _couponMsg = string.IsNullOrWhiteSpace(r.Message) ? "کد تخفیف نامعتبر است." : r.Message;
        }
    }

    private void ClearCoupon()
    {
        _couponPricing = null;
        _discount = 0; _appliedCode = string.Empty; _coupon = string.Empty; _couponMsg = null;
    }

    // ---- Product-required information, collected here and parked on the cart line it belongs to ----

    private readonly Dictionary<Guid, Dictionary<string, string?>> _itemValues = new();
    private readonly Dictionary<Guid, Dictionary<string, string?>> _itemConfirmations = new();
    private readonly Dictionary<Guid, Dictionary<string, string>> _itemErrors = new();
    private string? _focusTargetId;

    private List<CartItemModel> ItemsNeedingInput =>
        _cart?.Items.Where(x => x.InputFields.Any(f => f.IsActive)).ToList() ?? new();

    private static string FieldId(CartItemModel item, string key) => $"checkout-input-{item.Id:N}-{key}";
    private static string FieldConfirmId(CartItemModel item, string key) => $"checkout-confirm-{item.Id:N}-{key}";
    private static string FieldErrorId(CartItemModel item, string key) => $"checkout-error-{item.Id:N}-{key}";
    private static string FieldInputType(byte type) => type switch { 2 => "email", 3 => "tel", 4 => "number", 10 => "url", 11 => "date", 12 => "password", _ => "text" };
    private static string? FieldInputMode(byte type) => type switch { 2 => "email", 3 => "tel", 4 => "decimal", 10 => "url", _ => null };
    private static string FieldDirection(byte type) => type is 2 or 3 or 4 or 10 or 11 ? "ltr" : "rtl";

    private Dictionary<string, string?> ValuesFor(CartItemModel item)
    {
        if (_itemValues.TryGetValue(item.Id, out var existing)) return existing;
        // Seed from whatever the line already carries so an earlier attempt is never retyped.
        var seeded = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var field in item.InputFields.Where(x => x.IsActive))
        {
            var stored = item.InputValues.FirstOrDefault(v => v.FieldKey.Equals(field.Key, StringComparison.OrdinalIgnoreCase));
            seeded[field.Key] = field.IsSensitive ? null : stored?.Value ?? field.DefaultValue;
        }
        _itemValues[item.Id] = seeded;
        return seeded;
    }

    private string? FieldValue(CartItemModel item, string key) => ValuesFor(item).GetValueOrDefault(key);
    private bool IsFieldChecked(CartItemModel item, string key) =>
        string.Equals(FieldValue(item, key), "true", StringComparison.OrdinalIgnoreCase);
    private string? FieldConfirmation(CartItemModel item, string key) =>
        _itemConfirmations.TryGetValue(item.Id, out var map) ? map.GetValueOrDefault(key) : null;
    private string? FieldError(CartItemModel item, string key) =>
        _itemErrors.TryGetValue(item.Id, out var map) ? map.GetValueOrDefault(key) : null;

    private void SetField(CartItemModel item, string key, string? value)
    {
        ValuesFor(item)[key] = value;
        ClearFieldError(item, key);
    }

    private void SetFieldCheckbox(CartItemModel item, string key, object? value) =>
        SetField(item, key, value is true ? "true" : "false");

    private void SetFieldConfirmation(CartItemModel item, string key, string? value)
    {
        if (!_itemConfirmations.TryGetValue(item.Id, out var map))
            _itemConfirmations[item.Id] = map = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        map[key] = value;
        ClearFieldError(item, key);
    }

    private void ClearFieldError(CartItemModel item, string key)
    {
        if (_itemErrors.TryGetValue(item.Id, out var map)) map.Remove(key);
    }

    /// <summary>
    /// Validates every line's product information and reports the first invalid field so it can be
    /// focused. Returns false without touching payment when anything is missing or malformed.
    /// </summary>
    private bool ValidateProductInputs()
    {
        _itemErrors.Clear();
        _focusTargetId = null;

        foreach (var item in ItemsNeedingInput)
        {
            var fields = item.InputFields.Where(x => x.IsActive).ToList();
            var confirmations = _itemConfirmations.TryGetValue(item.Id, out var map)
                ? map
                : new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
            var validation = StorefrontInputValidator.ValidateFields(fields, ValuesFor(item), confirmations, item.InputValues);
            if (validation.IsValid) continue;

            _itemErrors[item.Id] = new Dictionary<string, string>(validation.Errors, StringComparer.OrdinalIgnoreCase);
            if (_focusTargetId is null)
            {
                var firstKey = fields.Where(x => validation.Errors.ContainsKey(x.Key))
                    .OrderBy(x => x.SortOrder).ThenBy(x => x.Id).Select(x => x.Key).FirstOrDefault();
                if (firstKey is not null) _focusTargetId = FieldId(item, firstKey);
            }
        }

        return _itemErrors.Count == 0;
    }

    /// <summary>Persists the captured values onto their cart lines so the order snapshot picks them up.</summary>
    private async Task<bool> PersistProductInputsAsync()
    {
        foreach (var item in ItemsNeedingInput)
        {
            var result = await Api.PutAsync<CartModel>($"cart/items/{item.Id}",
                new { Quantity = item.Quantity, InputValues = ValuesFor(item) });
            if (!result.IsSuccess)
            {
                Toasts.Error(result.Message);
                return false;
            }
            if (result.Data is not null) _cart = result.Data;
        }
        return true;
    }

    /// <summary>
    /// A backend failure message is shown as-is when there is one; an empty message would otherwise
    /// be swallowed by the toast service and leave the customer with no explanation at all.
    /// </summary>
    private void ShowError(string? message, string fallback) =>
        Toasts.Error(string.IsNullOrWhiteSpace(message) ? fallback : message);

    private async Task PlaceOrder()
    {
        // Re-entrancy guard: the button is disabled while placing, but a double event must never
        // start a second checkout for the same cart.
        if (_placing) return;

        try
        {
            _placing = true;

            // Checkout consumes the cart, so an order created by an earlier attempt whose payment
            // failed cannot be re-created — retrying pays the order that already exists. Without
            // this the cart is empty on the second press and the click does nothing at all.
            if (_pendingOrderId is { } pending)
            {
                await StartPaymentAsync(pending);
                return;
            }

            if (_cart is null || _cart.Items.Count == 0)
            {
                Toasts.Error("سبد خرید شما خالی است. لطفاً ابتدا محصولی به سبد خرید اضافه کنید.");
                Nav.NavigateTo("/cart");
                return;
            }

            // Nothing about payment happens until the product information is complete and stored.
            if (!ValidateProductInputs())
            {
                Toasts.Error("لطفاً اطلاعات مورد نیاز سفارش را تکمیل کنید.");
                return;
            }
            if (ItemsNeedingInput.Count > 0 && !await PersistProductInputsAsync()) return;

            var headers = new Dictionary<string, string> { ["Idempotency-Key"] = Guid.NewGuid().ToString("N") };
            var checkout = await Api.PostAsync<CheckoutResultModel>(
                "checkout",
                new { Description = (string?)null, CouponCode = string.IsNullOrWhiteSpace(_appliedCode) ? null : _appliedCode },
                headers);

            if (!checkout.IsSuccess || checkout.Data is null)
            {
                ShowError(checkout.Message, "ثبت سفارش انجام نشد. لطفاً دوباره تلاش کنید.");
                return;
            }

            await StartPaymentAsync(checkout.Data.OrderId);
        }
        catch (Exception)
        {
            // Any unexpected failure still has to reach the customer: a dead button is never an
            // acceptable outcome of pressing Pay.
            Toasts.Error("پرداخت آغاز نشد. لطفاً دوباره تلاش کنید.");
        }
        finally
        {
            _placing = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Pays an existing order. The order id is remembered so a failed payment can be retried
    /// without creating a second order, and every failure path reports a reason.
    /// </summary>
    private async Task StartPaymentAsync(Guid orderId)
    {
        _pendingOrderId = orderId;

        if (_method == "wallet")
        {
            var payKey = new Dictionary<string, string> { ["Idempotency-Key"] = Guid.NewGuid().ToString("N") };
            var pay = await Api.PostAsync<PaymentVerifyResultModel>($"payments/wallet/pay/{orderId}", null, payKey);
            if (pay.IsSuccess && pay.Data is not null)
            {
                _pendingOrderId = null;
                Nav.NavigateTo($"/payment/result?orderId={orderId}&paid={(pay.Data.IsPaid ? "1" : "0")}");
                return;
            }
            ShowError(pay.Message, "پرداخت از کیف پول انجام نشد. لطفاً دوباره تلاش کنید.");
            return;
        }

        // درگاه پرداخت
        var start = await Api.PostAsync<PaymentStartResultModel>($"payments/start/{orderId}");
        if (!start.IsSuccess || start.Data is null)
        {
            ShowError(start.Message, "امکان اتصال به درگاه پرداخت وجود ندارد. لطفاً دوباره تلاش کنید.");
            return;
        }

        if (!string.IsNullOrWhiteSpace(start.Data.PaymentUrl) &&
            start.Data.PaymentUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            _pendingOrderId = null;
            Nav.NavigateTo(start.Data.PaymentUrl, forceLoad: true);
            return;
        }

        // درگاه تستی: تایید داخلی
        var verify = await Api.PostAsync<PaymentVerifyResultModel>($"payments/mock/verify/{start.Data.PaymentId}");
        _pendingOrderId = null;
        if (verify.IsSuccess && verify.Data is not null)
            Nav.NavigateTo($"/payment/result?orderId={orderId}&paid={(verify.Data.IsPaid ? "1" : "0")}");
        else
            Nav.NavigateTo($"/payment/result?orderId={orderId}&paid=0");
    }
}
