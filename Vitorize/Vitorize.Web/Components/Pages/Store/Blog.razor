@page "/blog"
@inject ApiClient Api
@inject MediaUrlResolver Media

<SeoHead Title="وبلاگ" Description="آخرین راهنماها، اخبار و مطالب ویتورایز" CanonicalPath="/blog" />

<section class="content-page" aria-labelledby="blog-title" aria-busy="@(_loading ? "true" : "false")">
<div class="st-bc"><a href="/">خانه</a> <Icon Name="chevron-left" Size="13" /> <span>وبلاگ</span></div>
<h1 id="blog-title" class="content-page__title">آخرین مطالب</h1>

@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت مطالب…</span></div>
}
else if (_loadError)
{
    <div class="st-state content-page__empty" role="status"><Icon Name="alert" Size="30" /><p>دریافت مطالب انجام نشد.</p><button type="button" class="st-btn st-btn--outline" @onclick="Load">تلاش مجدد</button></div>
}
else if (_posts.Count == 0)
{
    <div class="st-state content-page__empty"><div class="st-state__ic"><Icon Name="file-text" Size="30" /></div><div class="st-muted">مطلبی منتشر نشده است.</div></div>
}
else
{
    <div class="st-grid">
        @foreach (var post in _posts)
        {
            <a class="st-pcard" href="@($"/blog/{post.Slug}")">
                <div class="st-pcard__media">
                    @if (!string.IsNullOrWhiteSpace(post.CoverImagePath))
                    { <img src="@Media.Resolve(post.CoverImagePath)" alt="@(post.CoverImageAltText ?? post.Title)" loading="lazy" /> }
                    else { <div class="ph"><Icon Name="file-text" Size="34" /></div> }
                </div>
                <div class="st-pcard__body">
                    <div class="st-pcard__title">@post.Title</div>
                    @if (!string.IsNullOrWhiteSpace(post.Summary))
                    { <div class="st-muted blog-card__summary">@post.Summary</div> }
                    <div class="st-muted blog-card__date"><PersianDateDisplay Value="post.CreatedAt" /></div>
                </div>
            </a>
        }
    </div>
}
</section>

@code {
    private bool _loading = true, _loadError;
    private List<StoreBlogPostModel> _posts = new();

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true;
        var result = await Api.GetAsync<List<StoreBlogPostModel>>("blog");
        _loadError = !result.IsSuccess;
        _posts = result.Data ?? new();
        _loading = false;
    }
}
