@page "/register"
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>ثبت‌نام | ویتورایز</PageTitle>

<div style="max-width:440px;margin:30px auto">
    <div class="st-card st-card__pad">
        <div style="text-align:center;margin-bottom:22px">
            <div style="display:flex;justify-content:center;margin-bottom:10px"><StoreLogo /></div>
            <h1 style="font-size:20px">@(IsVerifying ? "تأیید شماره موبایل" : "ساخت حساب کاربری")</h1>
            <p class="st-muted" style="font-size:13px;margin-top:6px">
                @(IsVerifying ? "برای تکمیل ثبت‌نام، کد ارسال‌شده را وارد کنید." : "در چند ثانیه عضو ویتورایز شوید.")
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="st-alert st-alert--danger" data-testid="register-error" style="margin-bottom:16px"><Icon Name="x-circle" Size="18" /> <span>@Error</span></div>
        }
        else if (!string.IsNullOrWhiteSpace(Notice))
        {
            <div class="st-alert st-alert--success" data-testid="register-notice" style="margin-bottom:16px"><Icon Name="check" Size="18" /> <span>@Notice</span></div>
        }

        @if (IsVerifying)
        {
            @* ── Step two: the code that was sent by SMS. Server-side form post, so the session cookie
                  is written before the next render and no token ever reaches the browser. ── *@
            <div class="st-alert st-alert--info" data-testid="register-otp-sent" style="margin-bottom:18px">
                <Icon Name="message" Size="17" />
                <span>کد تأیید به شماره <bdi class="st-mono" style="font-weight:700">@MaskedMobile</bdi> ارسال شد.</span>
            </div>

            <form method="post" action="/auth/customer/register/verify" data-enhance="false" data-vz-validate novalidate>
                <div class="st-field">
                    <label class="st-label" for="register-code">کد تأیید</label>
                    <input id="register-code" class="st-input" name="code" data-testid="register-otp-code"
                           inputmode="numeric" autocomplete="one-time-code" maxlength="6" required
                           placeholder="------" dir="ltr"
                           style="text-align:center;letter-spacing:8px;font-size:20px;font-weight:700" />
                </div>
                <button type="submit" class="st-btn st-btn--primary st-btn--block st-btn--lg" data-testid="register-otp-submit">
                    <Icon Name="check" Size="18" /> تأیید و تکمیل ثبت‌نام
                </button>
            </form>

            <div class="st-divider"></div>
            <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                <form method="post" action="/auth/customer/register/resend" data-enhance="false" style="margin:0">
                    <button type="submit" class="st-btn st-btn--ghost st-btn--sm" data-testid="register-otp-resend">
                        <Icon Name="refresh" Size="15" /> ارسال مجدد کد
                    </button>
                </form>
                <a class="st-btn st-btn--ghost st-btn--sm" data-testid="register-change-mobile" href="@RegisterRestartLink">
                    <Icon Name="edit" Size="15" /> تغییر شماره موبایل
                </a>
            </div>
        }
        else
        {
            <form method="post" action="/auth/customer/register" data-enhance="false" data-vz-validate novalidate>
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <div class="st-field">
                    <label class="st-label">نام و نام خانوادگی</label>
                    <input class="st-input" name="fullName" placeholder="نام کامل" required />
                </div>
                <div class="st-field">
                    <label class="st-label">شماره موبایل</label>
                    <input class="st-input" name="mobile" inputmode="tel" placeholder="۰۹۱۲۳۴۵۶۷۸۹" required />
                </div>
                <div class="st-field">
                    <label class="st-label">ایمیل (اختیاری)</label>
                    <input class="st-input" name="email" type="email" placeholder="example@mail.com" />
                </div>
                <div class="st-field">
                    <label class="st-label">رمز عبور</label>
                    <input class="st-input" name="password" type="password" placeholder="حداقل ۸ کاراکتر" required />
                </div>
                <p class="st-muted" style="font-size:12.5px;margin-bottom:14px">
                    برای تکمیل ثبت‌نام، یک کد تأیید به شماره موبایل شما پیامک می‌شود.
                </p>
                <button type="submit" class="st-btn st-btn--primary st-btn--block st-btn--lg"><Icon Name="user-plus" Size="18" /> ادامه و دریافت کد</button>
            </form>
        }

        <div class="st-divider"></div>
        <div style="text-align:center;font-size:13px">
            قبلاً ثبت‌نام کرده‌اید؟ <a href="@LoginLink" style="color:var(--st-brand-2);font-weight:700">وارد شوید</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Notice { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    /// <summary>"verify" once a registration code has been sent.</summary>
    [SupplyParameterFromQuery(Name = "stage")] public string? Stage { get; set; }

    private Vitorize.Web.Endpoints.CustomerAuthEndpoints.PendingRegistrationView? _pending;

    /// <summary>
    /// The verification step is only shown for a registration this browser actually started: the
    /// pending state lives in an HttpOnly cookie, so the stage cannot be forced from the address bar.
    /// </summary>
    private bool IsVerifying => string.Equals(Stage, "verify", StringComparison.OrdinalIgnoreCase) && _pending is not null;

    private string MaskedMobile => _pending?.MaskedMobile ?? string.Empty;

    protected override void OnInitialized()
    {
        var context = HttpContextAccessor.HttpContext;
        if (context is not null)
            _pending = Vitorize.Web.Endpoints.CustomerAuthEndpoints.ReadPendingRegistrationView(context);
    }

    private string EffectiveReturnUrl => string.IsNullOrWhiteSpace(ReturnUrl) ? _pending?.ReturnUrl ?? string.Empty : ReturnUrl;

    private string RegisterRestartLink => string.IsNullOrWhiteSpace(EffectiveReturnUrl)
        ? "/register"
        : $"/register?returnUrl={Uri.EscapeDataString(EffectiveReturnUrl)}";

    private string LoginLink => string.IsNullOrWhiteSpace(EffectiveReturnUrl)
        ? "/login"
        : $"/login?returnUrl={Uri.EscapeDataString(EffectiveReturnUrl)}";
}
