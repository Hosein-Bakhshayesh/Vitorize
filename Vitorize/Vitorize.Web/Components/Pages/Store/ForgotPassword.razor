@page "/forgot-password"
@inject ApiClient Api
@inject NavigationManager Nav
@inject ToastService Toasts

<PageTitle>بازیابی رمز عبور | ویتورایز</PageTitle>

<section class="auth-page" aria-labelledby="auth-title" aria-busy="@(_busy ? "true" : "false")">
    <div class="st-card auth-card">
        <header class="auth-heading">
            <div class="auth-icon"><Icon Name="lock" Size="28" /></div>
            <h1 id="auth-title">بازیابی رمز عبور</h1>
            <p class="st-muted">شماره موبایل خود را وارد کنید تا کد بازیابی ارسال شود.</p>
        </header>

        <form @onsubmit="Submit" @onsubmit:preventDefault>
        <div class="st-field">
            <label class="st-label" for="forgot-mobile">شماره موبایل</label>
            <input id="forgot-mobile" class="st-input auth-phone @(_mobileError is null ? null : "is-invalid")" @bind="_mobile" @bind:after="ClearMobileError" @ref="_mobileInput" inputmode="tel" autocomplete="tel" dir="ltr" disabled="@_busy" placeholder="۰۹۱۲۳۴۵۶۷۸۹" aria-invalid="@(_mobileError is null ? "false" : "true")" aria-describedby="@(_mobileError is null ? null : "forgot-mobile-error")" />
            @if (_mobileError is not null)
            {
                <span id="forgot-mobile-error" class="st-field__error" role="alert">@_mobileError</span>
            }
        </div>
        <button type="submit" class="st-btn st-btn--primary st-btn--block st-btn--lg" disabled="@_busy" aria-label="ارسال کد بازیابی">
            @if (_busy) { <span class="st-spinner sm"></span> } else { <span>ارسال کد بازیابی</span> }
        </button>
        </form>

        <div class="st-divider"></div>
        <div class="auth-footer">
            <a href="/login">بازگشت به ورود</a>
        </div>
    </div>
</section>

@code {
    private string _mobile = string.Empty;
    private string? _mobileError;
    private ElementReference _mobileInput;
    private bool _busy;

    private void ClearMobileError() => _mobileError = null;

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_mobile))
        {
            _mobileError = "شماره موبایل را وارد کنید.";
            await _mobileInput.FocusAsync();
            return;
        }
        _busy = true;
        var result = await Api.PostAsync("auth/forgot-password", new { Mobile = _mobile.Trim() });
        _busy = false;
        // پیام عمومی برای جلوگیری از افشای وجود حساب.
        Toasts.Success("در صورت وجود حساب کاربری، کد بازیابی ارسال شد.");
        Nav.NavigateTo($"/reset-password?mobile={Uri.EscapeDataString(_mobile.Trim())}");
    }
}
