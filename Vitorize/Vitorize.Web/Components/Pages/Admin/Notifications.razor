@page "/admin/notifications"
@inject ApiClient Api
@inject ToastService Toasts
@using Vitorize.Web.Models.Admin.Notifications
@using Vitorize.Web.Models.Admin.Sms
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageHeader Title="اعلان‌ها" Subtitle="اعلان‌های سیستمی و ارسال پیام به کاربران"
            Icon="bell" Breadcrumbs="@(new(){ ("اعلان‌ها", null) })">
    <Actions>
        <button class="vz-btn vz-btn--outline" @onclick="Load"><Icon Name="refresh" Size="17" /> بروزرسانی</button>
        <button class="vz-btn vz-btn--outline" data-testid="broadcast-open" @onclick="OpenBroadcast"><Icon Name="megaphone" Size="17" /> ارسال گروهی</button>
        <button class="vz-btn vz-btn--primary" @onclick="OpenSend"><Icon Name="send" Size="17" /> ارسال اعلان</button>
    </Actions>
</PageHeader>

@if (!_loading && _error is null)
{
    <div class="vz-stats">
        <StatCard Label="کل اعلان‌ها" Value="@AUI.Number(_items.Count)" Icon="bell" Accent="purple" />
        <StatCard Label="خوانده‌نشده" Value="@AUI.Number(_items.Count(n => !n.IsRead))" Icon="alert" Accent="orange" />
        <StatCard Label="خوانده‌شده" Value="@AUI.Number(_items.Count(n => n.IsRead))" Icon="check-circle" Accent="green" />
    </div>

    <div class="vz-spread" style="margin-bottom:16px;align-items:flex-end">
        <div class="vz-pills">
            @foreach (var f in ReadChips)
            {
                <button class="vz-pill @(_readFilter == f.Key ? "active" : "")" @onclick="() => SetReadFilter(f.Key)">
                    @f.Label <span class="vz-pill__count">@AUI.Number(CountFor(f.Key))</span>
                </button>
            }
        </div>
        <div style="position:relative;min-width:240px">
            <input class="vz-input" style="padding-inline-start:38px" placeholder="عنوان، متن یا کاربر ..." @bind="_search" @bind:event="oninput" />
            <span style="position:absolute;inset-inline-start:12px;top:50%;transform:translateY(-50%);color:var(--text-3)"><Icon Name="search" Size="17" /></span>
        </div>
    </div>
}

<div class="vz-card">
    <div class="vz-card__body flush">
        @if (_loading) { <LoadingState /> }
        else if (_error is not null) { <ErrorState Message="@_error" OnRetry="Load" /> }
        else if (Filtered.Count == 0) { <EmptyState Title="اعلانی یافت نشد" Icon="bell" /> }
        else
        {
            <div class="vz-table-wrap">
                <table class="vz-table">
                    <thead><tr><th>عنوان</th><th>کاربر</th><th>نوع</th><th>وضعیت</th><th>تاریخ</th><th class="col-actions">عملیات</th></tr></thead>
                    <tbody>
                        @foreach (var n in Filtered)
                        {
                            <tr style="@(n.IsRead ? "" : "background:var(--admin-primary-soft)")">
                                <td>
                                    <div class="vz-cell-title">@n.Title</div>
                                    <div class="vz-cell-sub">@AUI.ShortText(n.Message, 70)</div>
                                </td>
                                <td>@n.UserFullName</td>
                                <td><span class="vz-chip">@AUI.NotificationType(n.Type)</span></td>
                                <td><StatusBadge Text="@(n.IsRead ? "خوانده‌شده" : "خوانده‌نشده")" Intent="@(n.IsRead ? "muted" : "info")" /></td>
                                <td><PersianDateDisplay Value="n.CreatedAt" WithTime="true" /></td>
                                <td class="col-actions">
                                    @if (!n.IsRead)
                                    { <button class="vz-iconaction" title="علامت‌گذاری به‌عنوان خوانده‌شده" @onclick="() => MarkRead(n)"><Icon Name="check" Size="16" /></button> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pagination Page="_page" PageSize="_pageSize" TotalCount="_total" OnPageChanged="ChangePage" />
        }
    </div>
</div>

<SlidePanel Visible="_sendOpen" Title="ارسال اعلان به کاربر" Subtitle="پیام مستقیم به یک کاربر" Icon="send" OnClose="() => _sendOpen = false">
    <ChildContent>
        <div class="vz-form-grid one">
            <div class="vz-field">
                <label class="vz-label">کاربر گیرنده <span class="req">*</span></label>
                <select class="vz-select" value="@(_sendUserId == Guid.Empty ? "" : _sendUserId.ToString())"
                        @onchange="e => _sendUserId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : Guid.Empty">
                    <option value="">— انتخاب کاربر —</option>
                    @foreach (var u in _users) { <option value="@u.Id">@u.FullName — @u.Mobile</option> }
                </select>
            </div>
            <div class="vz-field">
                <label class="vz-label">عنوان <span class="req">*</span></label>
                <input class="vz-input" @bind="_sendTitle" />
            </div>
            <div class="vz-field">
                <label class="vz-label">متن پیام <span class="req">*</span></label>
                <textarea class="vz-textarea" @bind="_sendMessage"></textarea>
            </div>
            <label class="sms-mirror-option">
                <input type="checkbox" @bind="_sendSms" disabled="@(!SmsTextAvailable)" />
                <span><strong>ارسال پیامک هم‌زمان</strong><small>همین متن، بدون استفاده از قالب، با SMS.ir ارسال می‌شود.</small></span>
            </label>
            @if (!SmsTextAvailable)
            {
                <div class="vz-hint">برای فعال‌شدن این گزینه، اتصال SMS.ir را در تنظیمات کامل کنید.</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="() => _sendOpen = false" disabled="@_sending">انصراف</button>
        <button class="vz-btn vz-btn--primary" @onclick="DoSend" disabled="@_sending">
            @if (_sending) { <span class="vz-spinner sm"></span> } else { <Icon Name="send" Size="16" /> <span>ارسال اعلان</span> }
        </button>
    </Footer>
</SlidePanel>

@* ── FIX-15 broadcast history ──────────────────────────────────────────────────── *@
@if (_broadcasts.Count > 0)
{
    <div class="vz-card" style="margin-top:18px">
        <div class="vz-card__head"><Icon Name="megaphone" Size="18" /><div><div class="vz-card__title">تاریخچه ارسال‌های گروهی</div></div></div>
        <div class="vz-card__body flush">
            <div class="vz-table-wrap">
                <table class="vz-table" data-testid="broadcast-history">
                    <thead>
                        <tr><th>عنوان</th><th>مخاطبان</th><th>گیرندگان</th><th>زمان ارسال</th><th>فرستنده</th><th>وضعیت</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in _broadcasts)
                        {
                            <tr data-testid="@($"broadcast-row-{b.Id}")">
                                <td><span class="vz-cell-title">@b.Title</span></td>
                                <td><span class="vz-chip">@AudienceTitle(b.AudienceType)</span></td>
                                <td class="num" data-testid="broadcast-recipient-count">@AUI.Number(b.RecipientCount)</td>
                                <td class="vz-mono" style="font-size:12px"><PersianDateDisplay Value="b.SentAt" WithTime="true" /></td>
                                <td>@b.CreatedByFullName</td>
                                <td><StatusBadge Text="@BroadcastStatusTitle(b.Status)" Intent="@(b.Status == 2 ? "success" : b.Status == 3 ? "danger" : "warning")" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ── FIX-15 group announcements ────────────────────────────────────────────────── *@
<SlidePanel Visible="_broadcastOpen" Title="ارسال گروهی اعلان" Subtitle="ارسال یک اطلاعیه به مشتریان"
            Icon="megaphone" OnClose="CloseBroadcast">
    <ChildContent>
        <div class="vz-form-grid one">
            <div class="vz-field">
                <label class="vz-label">مخاطبان <span class="req">*</span></label>
                <div style="display:flex;gap:16px;flex-wrap:wrap">
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                        <input type="radio" name="bc-audience" checked="@(_bcAudience == AudienceAll)"
                               data-testid="broadcast-audience-all" @onchange="() => SetAudience(AudienceAll)" />
                        <span>همه مشتریان</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:6px;cursor:pointer">
                        <input type="radio" name="bc-audience" checked="@(_bcAudience == AudienceSelected)"
                               data-testid="broadcast-audience-selected" @onchange="() => SetAudience(AudienceSelected)" />
                        <span>مشتریان انتخاب‌شده</span>
                    </label>
                </div>
            </div>

            @if (_bcAudience == AudienceSelected)
            {
                <div class="vz-field">
                    <label class="vz-label">جستجوی مشتری</label>
                    <input class="vz-input" placeholder="نام یا شماره موبایل" data-testid="broadcast-user-search"
                           value="@_bcSearch" @oninput="OnSearchInput" />
                    @if (_bcSearchResults.Count > 0)
                    {
                        <div class="vz-card" style="margin-top:8px;max-height:220px;overflow-y:auto" data-testid="broadcast-search-results">
                            @foreach (var u in _bcSearchResults)
                            {
                                <button type="button" class="vz-ctx__item" style="width:100%;text-align:start"
                                        data-testid="@($"broadcast-pick-{u.Id}")" @onclick="() => AddRecipient(u)">
                                    @u.FullName <span class="vz-muted vz-mono">@u.Mobile</span>
                                </button>
                            }
                        </div>
                    }
                    @if (_bcSelected.Count > 0)
                    {
                        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:10px" data-testid="broadcast-selected-chips">
                            @foreach (var chip in _bcSelected)
                            {
                                <span class="vz-chip" style="display:inline-flex;align-items:center;gap:6px">
                                    @chip.FullName
                                    <button type="button" class="vz-iconaction" title="حذف"
                                            @onclick="() => RemoveRecipient(chip)"><Icon Name="x" Size="13" /></button>
                                </span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="vz-field">
                <label class="vz-label">عنوان <span class="req">*</span></label>
                <input class="vz-input" maxlength="250" data-testid="broadcast-title" @bind="_bcTitle" />
            </div>
            <div class="vz-field">
                <label class="vz-label">متن اعلان <span class="req">*</span></label>
                @* Plain text only: notifications are never rendered as HTML. *@
                <textarea class="vz-textarea" rows="5" data-testid="broadcast-message" @bind="_bcMessage"></textarea>
            </div>
            <label class="sms-mirror-option">
                <input type="checkbox" data-testid="broadcast-send-sms" @bind="_bcSendSms" disabled="@(!SmsTextAvailable)" />
                <span><strong>ارسال پیامک هم‌زمان</strong><small>همین متن اعلان برای هر گیرنده پیامک می‌شود.</small></span>
            </label>
            @if (!SmsTextAvailable)
            {
                <div class="vz-hint">ارسال پیامک از تنظیمات SMS غیرفعال است.</div>
            }
            <div class="vz-field">
                <label class="vz-label">لینک داخلی</label>
                <input class="vz-input" dir="ltr" placeholder="/page/summer-sale" data-testid="broadcast-action-url" @bind="_bcActionUrl" />
                <div class="vz-hint">اختیاری. فقط مسیرهای داخلی سایت مجاز هستند.</div>
            </div>

            <div class="vz-field">
                @if (_bcPreview is not null)
                {
                    <div class="@(_bcPreview.ExceedsLimit ? "vz-alert vz-alert--danger" : "vz-alert vz-alert--info")"
                         data-testid="broadcast-preview">
                        <Icon Name="users" Size="16" />
                        <span>تعداد گیرندگان: @AUI.Number(_bcPreview.RecipientCount) نفر</span>
                        @if (_bcPreview.IneligibleCount > 0)
                        {
                            <span class="vz-muted"> (@AUI.Number(_bcPreview.IneligibleCount) کاربر واجد شرایط نیست)</span>
                        }
                        @if (_bcPreview.ExceedsLimit)
                        {
                            <span> — بیشتر از سقف مجاز @AUI.Number(_bcPreview.MaximumRecipients) کاربر است.</span>
                        }
                    </div>
                }
                <button type="button" class="vz-btn vz-btn--outline vz-btn--sm" style="margin-top:8px"
                        data-testid="broadcast-preview-refresh" @onclick="RefreshPreview" disabled="@_bcPreviewing">
                    @if (_bcPreviewing) { <span class="vz-spinner sm"></span> } else { <Icon Name="refresh" Size="15" /> }
                    <span>محاسبه تعداد گیرندگان</span>
                </button>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="CloseBroadcast" disabled="@_bcSending">انصراف</button>
        <button class="vz-btn vz-btn--primary" data-testid="broadcast-send" @onclick="AskSendBroadcast"
                disabled="@(_bcSending || CannotSendBroadcast)">
            @if (_bcSending) { <span class="vz-spinner sm"></span> } else { <Icon Name="megaphone" Size="16" /> <span>ارسال</span> }
        </button>
    </Footer>
</SlidePanel>

<ConfirmDialog Visible="_bcConfirm" Title="ارسال گروهی اعلان" Intent="primary" Icon="megaphone"
               Message="@($"این اعلان برای {AUI.Number(_bcPreview?.RecipientCount ?? 0)} کاربر ارسال می‌شود.{(_bcSendSms ? " همین متن به‌صورت پیامک هم صف می‌شود." : string.Empty)} ادامه می‌دهید؟")"
               ConfirmText="ارسال" Busy="_bcSending"
               OnConfirm="SendBroadcast" OnCancel="() => _bcConfirm = false" />

@code {
    private bool _loading = true;
    private string? _error;
    private List<AdminNotificationModel> _items = new();
    private int _total;
    private int _page = 1;
    private const int _pageSize = 25;

    private string _search = string.Empty, _readFilter = "all";

    private static readonly (string Key, string Label)[] ReadChips =
    {
        ("all", "همه"), ("unread", "خوانده‌نشده"), ("read", "خوانده‌شده"),
    };
    private int CountFor(string key) => key switch
    {
        "unread" => _items.Count(n => !n.IsRead),
        "read" => _items.Count(n => n.IsRead),
        _ => _items.Count
    };

    private List<AdminUserModel> _users = new();
    private bool _sendOpen, _sending, _sendSms;
    private Guid _sendUserId;
    private string _sendTitle = string.Empty, _sendMessage = string.Empty;

    // ── FIX-15 broadcast state ────────────────────────────────────────────────
    private const byte AudienceAll = 1;
    private const byte AudienceSelected = 2;

    private bool _broadcastOpen, _bcSending, _bcPreviewing, _bcConfirm, _bcSendSms;
    private byte _bcAudience = AudienceAll;
    private string _bcTitle = string.Empty, _bcMessage = string.Empty, _bcActionUrl = string.Empty;
    private string _bcSearch = string.Empty;
    private CancellationTokenSource? _bcSearchCts;
    private List<AdminUserModel> _bcSearchResults = new();
    private readonly List<BroadcastRecipientChip> _bcSelected = new();
    private BroadcastPreviewResultModel? _bcPreview;
    private List<AdminBroadcastModel> _broadcasts = new();
    private SmsHealthModel? _smsHealth;
    private bool SmsTextAvailable => _smsHealth is { IsEnabled: true, IsConfigured: true };

    private static string AudienceTitle(byte audience) =>
        audience == AudienceSelected ? "مشتریان انتخاب‌شده" : "همه مشتریان";

    private static string BroadcastStatusTitle(byte status) => status switch
    {
        2 => "ارسال شد",
        3 => "ناموفق",
        _ => "در حال ارسال"
    };

    private bool CannotSendBroadcast =>
        string.IsNullOrWhiteSpace(_bcTitle) || string.IsNullOrWhiteSpace(_bcMessage) ||
        (_bcAudience == AudienceSelected && _bcSelected.Count == 0) ||
        (_bcPreview?.ExceedsLimit ?? false);

    protected override async Task OnInitializedAsync()
    {
        await Load();
        var u = await Api.GetAsync<PagedResult<AdminUserModel>>("admin/users?page=1&pageSize=300");
        _users = u.Data?.Items.ToList() ?? new();
        var sms = await Api.GetAsync<SmsHealthModel>("admin/sms/health");
        _smsHealth = sms.IsSuccess ? sms.Data : null;
        await LoadBroadcasts();
    }

    private async Task LoadBroadcasts()
    {
        var r = await Api.GetAsync<PagedResult<AdminBroadcastModel>>("admin/notification-broadcasts?page=1&pageSize=20");
        _broadcasts = r.Data?.Items.ToList() ?? new();
    }

    private void OpenBroadcast()
    {
        _bcAudience = AudienceAll;
        _bcTitle = _bcMessage = _bcActionUrl = _bcSearch = string.Empty;
        _bcSendSms = false;
        _bcSelected.Clear();
        _bcSearchResults.Clear();
        _bcPreview = null;
        _broadcastOpen = true;
        _ = RefreshPreview();
    }

    private void CloseBroadcast() => _broadcastOpen = false;

    private async Task SetAudience(byte audience)
    {
        _bcAudience = audience;
        _bcPreview = null;
        await RefreshPreview();
    }

    /// <summary>Debounced server-side search; the picker never loads the whole user table.</summary>
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _bcSearch = e.Value?.ToString() ?? string.Empty;
        _bcSearchCts?.Cancel();
        _bcSearchCts = new CancellationTokenSource();
        var token = _bcSearchCts.Token;

        if (_bcSearch.Trim().Length < 2) { _bcSearchResults = new(); return; }

        try
        {
            await Task.Delay(300, token);
            var query = $"admin/users?page=1&pageSize=10&role=Customer&status=1&search={Uri.EscapeDataString(_bcSearch.Trim())}";
            var r = await Api.GetAsync<PagedResult<AdminUserModel>>(query);
            if (token.IsCancellationRequested) return;
            _bcSearchResults = (r.Data?.Items ?? new List<AdminUserModel>())
                .Where(x => _bcSelected.All(c => c.Id != x.Id)).ToList();
            StateHasChanged();
        }
        catch (TaskCanceledException) { /* superseded by a newer keystroke */ }
    }

    private async Task AddRecipient(AdminUserModel user)
    {
        if (_bcSelected.All(x => x.Id != user.Id))
            _bcSelected.Add(new BroadcastRecipientChip { Id = user.Id, FullName = user.FullName, Mobile = user.Mobile });
        _bcSearchResults.RemoveAll(x => x.Id == user.Id);
        await RefreshPreview();
    }

    private async Task RemoveRecipient(BroadcastRecipientChip chip)
    {
        _bcSelected.RemoveAll(x => x.Id == chip.Id);
        await RefreshPreview();
    }

    private async Task RefreshPreview()
    {
        if (_bcAudience == AudienceSelected && _bcSelected.Count == 0) { _bcPreview = null; StateHasChanged(); return; }

        _bcPreviewing = true;
        var r = await Api.PostAsync<BroadcastPreviewResultModel>("admin/notification-broadcasts/preview", new
        {
            Audience = _bcAudience,
            SelectedCustomerIds = _bcSelected.Select(x => x.Id).ToList()
        });
        _bcPreviewing = false;
        _bcPreview = r.IsSuccess ? r.Data : null;
        if (!r.IsSuccess) Toasts.Error(r.Message);
        StateHasChanged();
    }

    private async Task AskSendBroadcast()
    {
        // Always confirm against a fresh count so the number the admin approves is current.
        await RefreshPreview();
        if (_bcPreview is null || _bcPreview.RecipientCount == 0)
        {
            Toasts.Warning("گیرنده‌ای برای این ارسال یافت نشد.");
            return;
        }
        if (_bcPreview.ExceedsLimit)
        {
            Toasts.Error($"تعداد گیرندگان بیشتر از سقف مجاز {_bcPreview.MaximumRecipients} کاربر است.");
            return;
        }
        _bcConfirm = true;
    }

    private async Task SendBroadcast()
    {
        _bcSending = true;
        var payload = new
        {
            Audience = _bcAudience,
            SelectedCustomerIds = _bcSelected.Select(x => x.Id).ToList(),
            Title = _bcTitle.Trim(),
            Message = _bcMessage.Trim(),
            ActionUrl = string.IsNullOrWhiteSpace(_bcActionUrl) ? null : _bcActionUrl.Trim(),
            SendSms = _bcSendSms
        };
        var headers = new Dictionary<string, string> { ["Idempotency-Key"] = $"broadcast-{Guid.NewGuid():N}" };
        var r = await Api.PostAsync<AdminBroadcastModel>("admin/notification-broadcasts", payload, headers);
        _bcSending = false;
        _bcConfirm = false;

        if (r.IsSuccess && r.Data is not null)
        {
            // Report the server's actual delivered count, never the preview estimate.
            Toasts.Success(_bcSendSms
                ? $"اعلان و پیامک برای {AUI.Number(r.Data.RecipientCount)} کاربر در صف ارسال قرار گرفت."
                : $"اعلان برای {AUI.Number(r.Data.RecipientCount)} کاربر ارسال شد.");
            _broadcastOpen = false;
            await LoadBroadcasts();
            await Load();
        }
        else Toasts.Error(r.Message);
    }

    private async Task Load()
    {
        _loading = true; _error = null;
        var query = $"admin/notifications/paged?page={_page}&pageSize={_pageSize}";
        if (!string.IsNullOrWhiteSpace(_search)) query += $"&search={Uri.EscapeDataString(_search.Trim())}";
        if (_readFilter == "read") query += "&isRead=true";
        else if (_readFilter == "unread") query += "&isRead=false";
        var r = await Api.GetAsync<PagedResult<AdminNotificationModel>>(query);
        if (r.IsSuccess && r.Data is not null) { _items = r.Data.Items.ToList(); _total = r.Data.TotalCount; }
        else _error = r.Message;
        _loading = false;
    }

    private List<AdminNotificationModel> Filtered => _items;
    private async Task ChangePage(int page) { _page = page; await Load(); }
    private async Task SetReadFilter(string filter) { _readFilter = filter; _page = 1; await Load(); }

    private async Task MarkRead(AdminNotificationModel n)
    {
        var r = await Api.PostAsync($"admin/notifications/{n.Id}/read");
        if (r.IsSuccess) { n.IsRead = true; Toasts.Success("اعلان خوانده شد."); }
        else Toasts.Error(r.Message);
    }

    private void OpenSend()
    {
        _sendUserId = Guid.Empty; _sendTitle = string.Empty; _sendMessage = string.Empty; _sendSms = false;
        _sendOpen = true;
    }

    private async Task DoSend()
    {
        if (_sendUserId == Guid.Empty) { Toasts.Error("انتخاب کاربر الزامی است."); return; }
        if (string.IsNullOrWhiteSpace(_sendTitle) || string.IsNullOrWhiteSpace(_sendMessage)) { Toasts.Error("عنوان و متن پیام الزامی است."); return; }

        _sending = true;
        var r = await Api.PostAsync("admin/notifications/send",
            new { UserId = _sendUserId, Title = _sendTitle, Message = _sendMessage, SendSms = _sendSms });
        _sending = false;

        if (r.IsSuccess) { Toasts.Success(_sendSms ? "اعلان ثبت و پیامک در صف ارسال قرار گرفت." : "اعلان برای کاربر ارسال شد."); _sendOpen = false; await Load(); }
        else Toasts.Error(r.Message);
    }
}
