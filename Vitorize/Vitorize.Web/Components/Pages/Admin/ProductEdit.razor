@page "/admin/products/create"
@page "/admin/products/{Id:guid}"
@implements IDisposable
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject ToastService Toasts
@inject NavigationManager Nav
@using Vitorize.Web.Models.Admin.Content
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageHeader Title="@(IsEdit ? "ویرایش محصول" : "افزودن محصول جدید")"
            Subtitle="جزئیات محصول دیجیتال و تنظیمات آن را وارد کنید"
            Icon="box"
            Breadcrumbs="@(new(){ ("محصولات", "admin/products"), (IsEdit ? (_model.Title ?? "ویرایش") : "محصول جدید", null) })">
    <Actions>
        <a class="vz-btn vz-btn--ghost" href="admin/products"><Icon Name="arrow-right" Size="17" /> بازگشت</a>
        @if (IsEdit)
        {
            <a class="vz-btn vz-btn--outline" href="@($"admin/products/{Id}/details")"><Icon Name="eye" Size="17" /> جزئیات</a>
            <a class="vz-btn vz-btn--outline" href="@($"admin/products/{Id}/images")"><Icon Name="image" Size="17" /> مدیریت تصاویر</a>
        }
        <button class="vz-btn vz-btn--primary vz-product-header-save" @onclick="Save" disabled="@_saving">
            @if (_saving) { <span class="vz-spinner sm"></span> } else { <Icon Name="save" Size="17" /> <span>@(IsEdit ? "ذخیره تغییرات" : "ثبت محصول")</span> }
        </button>
    </Actions>
</PageHeader>

@if (_loading) { <LoadingState /> }
else if (_error is not null) { <ErrorState Message="@_error" OnRetry="Load" /> }
else
{
    @if (IsEdit)
    {
        <div class="vz-card" style="margin-bottom:16px">
            <div class="vz-card__body">
                <div class="vz-summary">
                    <div class="vz-summary__item">
                        <span class="vz-summary__label">قیمت نهایی</span>
                        <span class="vz-summary__value">@AUI.MoneyFa(FinalPrice, _model.CurrencyType)</span>
                    </div>
                    <div class="vz-summary__item">
                        <span class="vz-summary__label">موجودی</span>
                        <span class="vz-summary__value">@(_hasVariants ? "واریانت‌دار" : AUI.Number(_availableStock))</span>
                    </div>
                    <div class="vz-summary__item">
                        <span class="vz-summary__label">وضعیت</span>
                        <span class="vz-summary__value">
                            <StatusBadge Text="@(_model.IsActive ? "منتشر شده" : "پیش‌نویس")" Intent="@(_model.IsActive ? "success" : "muted")" />
                        </span>
                    </div>
                    <div class="vz-summary__item">
                        <span class="vz-summary__label">تصاویر گالری</span>
                        <span class="vz-summary__value">@AUI.Number(_imageCount)</span>
                    </div>
                    <div class="vz-summary__item">
                        <span class="vz-summary__label">تاریخ ایجاد</span>
                        <span class="vz-summary__value" style="font-size:13px"><PersianDateDisplay Value="_createdAt" /></span>
                    </div>
                </div>
            </div>
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="Save" data-testid="admin-product-form" class="vz-long-form">
        <DataAnnotationsValidator />
        <div class="vz-grid-2">
            <div class="vz-stack">
                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-section__head">
                            <span class="vz-section__badge"><Icon Name="file-text" Size="16" /></span>
                            <span class="vz-section__title">اطلاعات اصلی</span>
                        </div>
                        <p class="vz-section__desc">عنوان و دسته‌بندی که در فروشگاه به مشتری نمایش داده می‌شود.</p>
                        <div class="vz-form-grid">
                            <div class="vz-field span-2">
                                <label class="vz-label">عنوان محصول <span class="req">*</span></label>
                                <InputText class="vz-input" data-testid="product-title" aria-label="عنوان محصول" @bind-Value="_model.Title" @bind-Value:after="OnTitleChanged" />
                                <ValidationMessage For="() => _model.Title" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label" dir="ltr" style="text-align:start">Slug <span class="req">*</span></label>
                                <InputText class="vz-input vz-mono" data-testid="product-slug" aria-label="Slug" @bind-Value="_model.Slug" />
                                <ValidationMessage For="() => _model.Slug" class="vz-val-msg" />
                            </div>
                            <div class="vz-field span-2">
                                <label class="vz-label">دسته‌بندی اصلی <span class="req">*</span></label>
                                <select class="vz-select" data-testid="product-category" aria-label="دسته‌بندی اصلی" value="@(_model.CategoryId == Guid.Empty ? "" : _model.CategoryId.ToString())"
                                        @onchange="OnPrimaryCategoryChanged">
                                    <option value="">— انتخاب دسته‌بندی —</option>
                                    @foreach (var c in _categories) { <option value="@c.Id">@c.Title</option> }
                                </select>
                                <div class="vz-hint">مسیر و نشانی محصول از این دسته‌بندی ساخته می‌شود.</div>
                                <ValidationMessage For="() => _model.CategoryId" class="vz-val-msg" />

                                @* A product may sit in several categories. The primary one above is
                                   always a member, so it is shown as a locked chip rather than as a
                                   removable one - taking it away would leave the breadcrumb without
                                   a category. *@
                                <label class="vz-label" style="margin-top:14px">دسته‌بندی‌های دیگر</label>
                                <div class="vz-chips" data-testid="product-category-chips">
                                    @if (_model.CategoryId != Guid.Empty)
                                    {
                                        <span class="vz-chip vz-chip--locked" data-testid="product-category-chip-primary">
                                            @CategoryTitle(_model.CategoryId)
                                            <span class="vz-chip__note">اصلی</span>
                                        </span>
                                    }
                                    @foreach (var id in _model.CategoryIds.Where(x => x != _model.CategoryId))
                                    {
                                        <span class="vz-chip" data-testid="product-category-chip">
                                            @CategoryTitle(id)
                                            <button type="button" class="vz-chip__x" data-testid="product-category-remove"
                                                    aria-label="@($"حذف {CategoryTitle(id)}")" @onclick="() => RemoveCategory(id)">×</button>
                                        </span>
                                    }
                                    @if (_model.CategoryIds.Count(x => x != _model.CategoryId) == 0)
                                    {
                                        <span class="vz-hint" style="margin:0" data-testid="product-category-empty">
                                            دسته‌بندی دیگری انتخاب نشده است.
                                        </span>
                                    }
                                </div>

                                <div class="vz-catpick">
                                    <input class="vz-input" data-testid="product-category-search" type="search"
                                           placeholder="جستجوی دسته‌بندی ..." @bind="_categoryQuery" @bind:event="oninput" />
                                    <div class="vz-catpick__list" data-testid="product-category-options">
                                        @foreach (var c in SelectableCategories)
                                        {
                                            <button type="button" class="vz-catpick__opt" data-testid="product-category-add"
                                                    @onclick="() => AddCategory(c.Id)">
                                                <Icon Name="plus" Size="13" /> <span>@c.Title</span>
                                            </button>
                                        }
                                        @if (SelectableCategories.Count == 0)
                                        {
                                            <span class="vz-hint" style="margin:0">دسته‌بندی دیگری برای افزودن نیست.</span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">برند</label>
                                <select class="vz-select" data-testid="product-brand" aria-label="برند" value="@(_model.BrandId?.ToString() ?? "")"
                                        @onchange="e => _model.BrandId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null">
                                    <option value="">— بدون برند —</option>
                                    @foreach (var b in _brands) { <option value="@b.Id">@b.Title</option> }
                                </select>
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">نوع محصول</label>
                                <select class="vz-select" data-testid="product-type" aria-label="نوع محصول" value="@_model.ProductType" @onchange="e => _model.ProductType = byte.Parse(e.Value!.ToString()!)">
                                    <option value="1">گیفت کارت</option>
                                    <option value="2">اکانت بازی</option>
                                    <option value="3">سرویس بازی</option>
                                    <option value="4">اشتراک</option>
                                    <option value="99">سایر</option>
                                </select>
                            </div>
                            <div class="vz-field span-2">
                                <label class="vz-label">توضیحات کوتاه</label>
                                <InputTextArea class="vz-textarea" data-testid="product-short-description" aria-label="توضیحات کوتاه" style="min-height:80px" @bind-Value="_model.ShortDescription" />
                            </div>
                            <div class="vz-field span-2">
                                <label class="vz-label">توضیحات کامل</label>
                                <RichTextEditor @bind-Value="_model.FullDescription" />
                                <span class="vz-hint">HTML خروجی هنگام ذخیره در سرور با فهرست سخت‌گیرانه تگ‌ها و ویژگی‌های مجاز پاک‌سازی می‌شود.</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-spread">
                            <div><div class="vz-section__head"><span class="vz-section__badge"><Icon Name="star" Size="16" /></span><span class="vz-section__title">ویژگی‌ها و مشخصات</span></div>
                            <p class="vz-section__desc">کارت‌های مرتب‌شده‌ای که در صفحه محصول نمایش داده می‌شوند.</p></div>
                            <button type="button" class="vz-btn vz-btn--outline vz-btn--sm" data-testid="add-product-feature" @onclick="AddFeature"><Icon Name="plus" Size="14" /> افزودن ویژگی</button>
                        </div>
                        @if (_model.Features.Count == 0) { <EmptyState Title="ویژگی‌ای تعریف نشده" Text="عنوان و مقدار مشخصات محصول را اضافه کنید." Icon="star" /> }
                        @for (var i = 0; i < _model.Features.Count; i++)
                        {
                            var index = i; var feature = _model.Features[index];
                            <div class="vz-builder-row" data-testid="product-feature-row" @key="feature">
                                <div class="vz-form-grid three">
                                    <div class="vz-field"><label class="vz-label">عنوان *</label><InputText class="vz-input" @bind-Value="feature.Title" /></div>
                                    <div class="vz-field"><label class="vz-label">مقدار *</label><InputText class="vz-input" @bind-Value="feature.Value" /></div>
                                    <div class="vz-field"><label class="vz-label">آیکن</label><LucideIconPicker @bind-Value="feature.IconKey" Compact="true" Placeholder="انتخاب آیکون ویژگی" /></div>
                                </div>
                                <div class="vz-builder-actions">
                                    <label class="vz-switch"><input type="checkbox" @bind="feature.IsActive" /><span class="vz-switch__track"></span><span class="vz-switch__label">فعال</span></label>
                                    <button type="button" class="vz-iconaction" disabled="@(index == 0)" @onclick="() => MoveFeature(index, -1)"><Icon Name="arrow-up" Size="15" /></button>
                                    <button type="button" class="vz-iconaction" disabled="@(index == _model.Features.Count - 1)" @onclick="() => MoveFeature(index, 1)"><Icon Name="arrow-down" Size="15" /></button>
                                    <button type="button" class="vz-iconaction danger" @onclick="() => _model.Features.RemoveAt(index)"><Icon Name="trash" Size="15" /></button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-spread">
                            <div><div class="vz-section__head"><span class="vz-section__badge"><Icon Name="file-text" Size="16" /></span><span class="vz-section__title">اطلاعات موردنیاز خریدار</span></div>
                            <p class="vz-section__desc">فرم پویا برای دریافت یک یا چند مقدار پیش از خرید یا در سبد خرید.</p></div>
                            <button type="button" class="vz-btn vz-btn--outline vz-btn--sm" data-testid="add-product-input" @onclick="AddInputField"><Icon Name="plus" Size="14" /> افزودن فیلد</button>
                        </div>
                        @if (_model.InputFields.Count == 0) { <EmptyState Title="اطلاعاتی لازم نیست" Text="برای این محصول فرم اختصاصی تعریف نشده است." Icon="file-text" /> }
                        @for (var i = 0; i < _model.InputFields.Count; i++)
                        {
                            var index = i; var field = _model.InputFields[index];
                            <div class="vz-builder-row" data-testid="product-input-row" @key="field">
                                <div class="vz-form-grid three">
                                    <div class="vz-field"><label class="vz-label">نام داخلی *</label><InputText class="vz-input vz-mono" @bind-Value="field.Key" /></div>
                                    <div class="vz-field"><label class="vz-label">برچسب فارسی *</label><InputText class="vz-input" @bind-Value="field.Label" /></div>
                                    <div class="vz-field"><label class="vz-label">نوع</label><select class="vz-select" @bind="field.FieldType">@foreach (var type in InputTypes) { <option value="@type.Key">@type.Label</option> }</select></div>
                                    <div class="vz-field"><label class="vz-label">Placeholder</label><InputText class="vz-input" @bind-Value="field.Placeholder" /></div>
                                    <div class="vz-field"><label class="vz-label">مرحله نمایش</label><select class="vz-select" @bind="field.DisplayStage"><option value="1">صفحه محصول</option><option value="2">سبد/تسویه</option></select></div>
                                    <div class="vz-field"><label class="vz-label">پیام اعتبارسنجی</label><InputText class="vz-input" @bind-Value="field.ValidationMessage" /></div>
                                    <div class="vz-field"><label class="vz-label">حداقل طول</label><InputNumber class="vz-input" @bind-Value="field.MinLength" /></div>
                                    <div class="vz-field"><label class="vz-label">حداکثر طول</label><InputNumber class="vz-input" @bind-Value="field.MaxLength" /></div>
                                    <div class="vz-field"><label class="vz-label">الگوی Regex امن</label><InputText class="vz-input vz-mono" @bind-Value="field.ValidationPattern" /></div>
                                    @if (field.FieldType is 6 or 7) { <div class="vz-field span-2"><label class="vz-label">گزینه‌ها (هر خط یک گزینه)</label><InputTextArea class="vz-textarea" @bind-Value="field.OptionsText" /></div> }
                                </div>
                                <div class="vz-builder-actions">
                                    <label class="vz-switch"><input type="checkbox" @bind="field.IsRequired" /><span class="vz-switch__track"></span><span class="vz-switch__label">الزامی</span></label>
                                    <label class="vz-switch"><input type="checkbox" @bind="field.IsSensitive" /><span class="vz-switch__track"></span><span class="vz-switch__label">حساس/رمزشده</span></label>
                                    <label class="vz-switch"><input type="checkbox" @bind="field.IsActive" /><span class="vz-switch__track"></span><span class="vz-switch__label">فعال</span></label>
                                    <button type="button" class="vz-iconaction" disabled="@(index == 0)" @onclick="() => MoveInput(index, -1)"><Icon Name="arrow-up" Size="15" /></button>
                                    <button type="button" class="vz-iconaction" disabled="@(index == _model.InputFields.Count - 1)" @onclick="() => MoveInput(index, 1)"><Icon Name="arrow-down" Size="15" /></button>
                                    <button type="button" class="vz-iconaction danger" @onclick="() => _model.InputFields.RemoveAt(index)"><Icon Name="trash" Size="15" /></button>
                                </div>
                            </div>
                        }
                        <div class="vz-alert vz-alert--warning">رمز عبور سرویس‌های شخص ثالث را دریافت نکنید. داده حساس فقط در صورت ضرورت قانونی و با دوره نگهداری مشخص فعال شود.</div>
                    </div>
                </div>

                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-section__head">
                            <span class="vz-section__badge"><Icon Name="credit-card" Size="16" /></span>
                            <span class="vz-section__title">قیمت‌گذاری و موجودی</span>
                        </div>
                        <p class="vz-section__desc">قیمت پایه و قیمت تخفیف‌خورده اختیاری را تعیین کنید.</p>
                        <div class="vz-form-grid three">
                            <div class="vz-field">
                                <label class="vz-label">واحد پول</label>
                                <select class="vz-select" data-testid="product-currency" aria-label="واحد پول" value="@_model.CurrencyType" @onchange="e => _model.CurrencyType = byte.Parse(e.Value!.ToString()!)">
                                    <option value="2">تومان</option>
                                    <option value="1">ریال</option>
                                </select>
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">قیمت پایه <span class="req">*</span></label>
                                <AmountInput Class="vz-input" data-testid="product-base-price" AriaLabel="قیمت پایه"
                                             Value="_model.BasePrice" ValueChanged="value => _model.BasePrice = value ?? 0" />
                                <ValidationMessage For="() => _model.BasePrice" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">قیمت با تخفیف</label>
                                <AmountInput Class="vz-input" data-testid="product-discount-price" AriaLabel="قیمت با تخفیف" @bind-Value="_model.DiscountPrice" />
                                <ValidationMessage For="() => _model.DiscountPrice" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">حداقل تعداد سفارش</label>
                                <InputNumber class="vz-input" data-testid="product-min-quantity" aria-label="حداقل تعداد سفارش" @bind-Value="_model.MinOrderQuantity" />
                                <ValidationMessage For="() => _model.MinOrderQuantity" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">حداکثر تعداد سفارش</label>
                                <InputNumber class="vz-input" data-testid="product-max-quantity" aria-label="حداکثر تعداد سفارش" @bind-Value="_model.MaxOrderQuantity" />
                                <ValidationMessage For="() => _model.MaxOrderQuantity" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">ترتیب نمایش</label>
                                <InputNumber class="vz-input" data-testid="product-sort-order" aria-label="ترتیب نمایش" @bind-Value="_model.SortOrder" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-section__head">
                            <span class="vz-section__badge"><Icon Name="zap" Size="16" /></span>
                            <span class="vz-section__title">تحویل و واریانت‌ها</span>
                        </div>
                        <p class="vz-section__desc">نحوه تحویل محصول و نسخه‌هایی که مشتری می‌تواند انتخاب کند.</p>

                        <label class="vz-label" style="margin-bottom:8px">نوع تحویل</label>
                        <div class="vz-delivery-pills">
                            @foreach (var d in DeliveryOptions)
                            {
                                <button type="button" data-testid="product-delivery-@d.Key" class="vz-delivery-pill @(_model.DeliveryType == d.Key ? "active" : "")"
                                        @onclick="() => _model.DeliveryType = d.Key">@d.Label</button>
                            }
                        </div>

                        <div class="vz-divider"></div>

                        <div class="vz-spread" style="margin-bottom:12px">
                            <label class="vz-label" style="margin:0">واریانت‌ها (تنوع محصول)</label>
                            @if (IsEdit)
                            {
                                <button type="button" class="vz-btn vz-btn--outline vz-btn--sm" data-testid="add-product-variant" @onclick="OpenVariantCreate"><Icon Name="plus" Size="14" /> واریانت جدید</button>
                            }
                        </div>

                        @if (!IsEdit)
                        {
                            <div class="vz-hint" style="padding:14px;border:1px dashed var(--border-strong);border-radius:var(--clip-xs);text-align:center">
                                برای افزودن واریانت، ابتدا محصول را ذخیره کنید.
                            </div>
                        }
                        else if (_variants.Count == 0)
                        {
                            <EmptyState Title="واریانتی تعریف نشده" Text="در صورت داشتن نسخه‌های مختلف (استاندارد، ویژه…) واریانت اضافه کنید." Icon="layers" />
                        }
                        else
                        {
                            <div class="vz-table-wrap">
                                <table class="vz-table">
                                    <thead><tr><th>عنوان</th><th>SKU</th><th>قیمت</th><th>حالت موجودی</th><th>موجودی</th><th>وضعیت</th><th class="col-actions">عملیات</th></tr></thead>
                                    <tbody>
                                        @foreach (var v in _variants.OrderBy(x => x.SortOrder))
                                        {
                                            <tr data-testid="product-variant-row">
                                                <td class="vz-cell-title">@v.Title @if (v.IsDefault) { <span class="vz-chip">پیش‌فرض</span> }</td>
                                                <td class="vz-mono">@(string.IsNullOrWhiteSpace(v.Sku) ? "—" : v.Sku)</td>
                                                <td><MoneyDisplay Amount="v.Price" Currency="v.CurrencyType" /></td>
                                                <td><span class="vz-chip">@AUI.VariantStockMode(v.StockMode)</span></td>
                                                <td class="num" data-testid="variant-stock-cell">@AUI.VariantStock(_model.DeliveryType, v.StockMode, v.StockQuantity, v.AvailableStock)</td>
                                                <td><StatusBadge Text="@(v.IsActive ? "فعال" : "غیرفعال")" Intent="@(v.IsActive ? "success" : "muted")" /></td>
                                                <td class="col-actions">
                                                    <button type="button" class="vz-iconaction" @onclick="() => OpenVariantEdit(v)" title="ویرایش"><Icon Name="edit" Size="15" /></button>
                                                    <button type="button" class="vz-iconaction danger" @onclick="() => AskDeleteVariant(v)" title="حذف"><Icon Name="trash" Size="15" /></button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <Pagination Page="_variantPage" PageSize="_variantPageSize" TotalCount="_variantTotal" OnPageChanged="ChangeVariantPage" />
                        }
                    </div>
                </div>

                @* Product-owned questions. They share the FAQ table with the site-wide list but are
                   reached only through this product's route, so nothing here can touch a global
                   entry. Answers stay plain text: the storefront HTML-encodes them, which is a
                   stronger guarantee than sanitising rich text would be. *@
                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-section__head">
                            <span class="vz-section__badge"><Icon Name="help-circle" Size="16" /></span>
                            <span class="vz-section__title">سوالات متداول این محصول</span>
                        </div>

                        @if (!IsEdit)
                        {
                            <div class="vz-hint">برای افزودن پرسش، ابتدا محصول را ذخیره کنید.</div>
                        }
                        else
                        {
                            <div class="vz-spread" style="margin-bottom:12px">
                                <span class="vz-hint" style="margin:0">
                                    فقط پرسش‌های همین محصول در صفحهٔ محصول نمایش داده می‌شوند.
                                </span>
                                <button type="button" class="vz-btn vz-btn--outline vz-btn--sm"
                                        data-testid="add-product-faq" @onclick="OpenFaqCreate">
                                    <Icon Name="plus" Size="14" /> پرسش جدید
                                </button>
                            </div>

                            @if (_productFaqs.Count == 0)
                            {
                                <div class="vz-hint" data-testid="product-faq-empty">
                                    برای این محصول پرسشی ثبت نشده است.
                                </div>
                            }
                            else
                            {
                                <div class="vz-table-wrap">
                                    <table class="vz-table" data-testid="product-faq-table">
                                        <thead>
                                            <tr>
                                                <th>ترتیب</th>
                                                <th>پرسش</th>
                                                <th>پاسخ</th>
                                                <th>وضعیت</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var f in _productFaqs)
                                            {
                                                <tr data-testid="product-faq-row">
                                                    <td>@AUI.Number(f.SortOrder)</td>
                                                    <td>@f.Question</td>
                                                    <td class="vz-truncate" style="max-width:280px">@f.Answer</td>
                                                    <td>
                                                        <StatusBadge Text="@(f.IsActive ? "فعال" : "غیرفعال")"
                                                                     Intent="@(f.IsActive ? "success" : "muted")" />
                                                    </td>
                                                    <td class="vz-rowactions">
                                                        <button type="button" class="vz-iconaction"
                                                                data-testid="edit-product-faq"
                                                                @onclick="() => OpenFaqEdit(f)" title="ویرایش">
                                                            <Icon Name="edit" Size="15" />
                                                        </button>
                                                        <button type="button" class="vz-iconaction danger"
                                                                data-testid="delete-product-faq"
                                                                @onclick="() => AskDeleteFaq(f)" title="حذف">
                                                            <Icon Name="trash" Size="15" />
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="vz-card">
                    <div class="vz-card__body">
                        <div class="vz-section__head">
                            <span class="vz-section__badge"><Icon Name="search" Size="16" /></span>
                            <span class="vz-section__title" dir="ltr" style="text-align:start">SEO Settings</span>
                        </div>
                        <p class="vz-section__desc">عنوان و توضیحات نمایش‌داده‌شده در نتایج موتورهای جستجو.</p>
                        <div class="vz-form-grid one">
                            <div class="vz-field">
                                <label class="vz-label" dir="ltr" style="text-align:start">SEO Title</label>
                                <InputText class="vz-input" data-testid="product-seo-title" aria-label="SEO Title" @bind-Value="_model.SeoTitle" />
                                <ValidationMessage For="() => _model.SeoTitle" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label" dir="ltr" style="text-align:start">SEO Description</label>
                                <InputTextArea class="vz-textarea" data-testid="product-seo-description" aria-label="SEO Description" style="min-height:70px" @bind-Value="_model.SeoDescription" />
                                <ValidationMessage For="() => _model.SeoDescription" class="vz-val-msg" />
                            </div>
                            <div class="vz-field">
                                <label class="vz-label" dir="ltr" style="text-align:start">Focus Keyword</label>
                                <InputText class="vz-input" data-testid="product-focus-keyword" aria-label="Focus Keyword" @bind-Value="_model.FocusKeyword" />
                                <span class="vz-help">فقط راهنمای تحریریه است و به‌عنوان meta keywords منتشر نمی‌شود.</span>
                            </div>
                            <div class="vz-field">
                                <label class="vz-label">برچسب‌ها و معادل‌های جستجو</label>
                                <div class="vz-check-grid">
                                    @foreach (var tag in _tags.Where(x => x.IsActive))
                                    {
                                        <label class="vz-check"><input type="checkbox" checked="@_model.TagIds.Contains(tag.Id)" @onchange="e => ToggleTag(tag.Id, e.Value)" /><span>@tag.Title</span></label>
                                    }
                                </div>
                                <a href="admin/product-tags" class="vz-help">مدیریت برچسب‌ها</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="vz-stack">
                <div class="vz-card">
                    <div class="vz-card__head"><Icon Name="image" Size="18" /><div><div class="vz-card__title">تصویر شاخص</div></div></div>
                    <div class="vz-card__body">
                        <UploadBox @bind-Value="_model.ThumbnailImagePath" Label="آپلود تصویر شاخص" />
                        <div class="vz-field" style="margin-top:12px"><label class="vz-label">متن جایگزین تصویر</label><InputText class="vz-input" data-testid="product-thumbnail-alt" aria-label="متن جایگزین تصویر" @bind-Value="_model.ThumbnailAltText" placeholder="توصیف کوتاه و طبیعی تصویر" /></div>
                        <ImageGuideline Spec="ImageSpecs.ProductThumbnail" />
                        @if (IsEdit)
                        {
                            <a class="vz-btn vz-btn--outline vz-btn--block" style="margin-top:12px" href="@($"admin/products/{Id}/images")">
                                <Icon Name="image" Size="16" /> مدیریت گالری تصاویر
                            </a>
                        }
                    </div>
                </div>

                <div class="vz-card">
                    <div class="vz-card__head"><Icon Name="settings" Size="18" /><div><div class="vz-card__title">وضعیت و گزینه‌ها</div></div></div>
                    <div class="vz-card__body vz-stack">
                        <label class="vz-switch"><input type="checkbox" data-testid="product-active" @bind="_model.IsActive" /><span class="vz-switch__track"></span><span class="vz-switch__label">محصول فعال (منتشر شده)</span></label>
                        <label class="vz-switch"><input type="checkbox" data-testid="product-featured" @bind="_model.IsFeatured" /><span class="vz-switch__track"></span><span class="vz-switch__label">محصول ویژه</span></label>
                        <label class="vz-switch">
                            <input type="checkbox" data-testid="product-force-out-of-stock" @bind="_model.ForceOutOfStock" />
                            <span class="vz-switch__track"></span>
                            <span class="vz-switch__label">نمایش به‌صورت ناموجود</span>
                        </label>
                        @if (_model.ForceOutOfStock)
                        {
                            @* Says plainly that inventory is untouched, because the whole point of the
                               override is that the administrator gets their stock back unchanged. *@
                            <div class="vz-hint" data-testid="product-force-out-of-stock-hint">
                                حتی در صورت وجود موجودی، این کالا در فروشگاه ناموجود نمایش داده می‌شود و قابل خرید نخواهد بود.
                                موجودی و کدهای این محصول تغییر نمی‌کند و با خاموش کردن این گزینه دقیقاً به حالت قبل برمی‌گردد.
                            </div>
                        }
                        <label class="vz-switch"><input type="checkbox" @bind="_model.RequiresSupportMessage" /><span class="vz-switch__track"></span><span class="vz-switch__label">نیازمند پیام پشتیبانی</span></label>
                    </div>
                </div>
            </div>
        </div>

        <div class="vz-savebar">
            <span class="vz-savebar__hint"><Icon Name="alert" Size="15" /> پیش از خروج از صفحه، تغییرات را ذخیره کنید.</span>
            <div style="display:flex;gap:10px">
                <a class="vz-btn vz-btn--outline" href="admin/products">انصراف</a>
                <button class="vz-btn vz-btn--primary" data-testid="product-save" type="submit" disabled="@_saving">
                    @if (_saving) { <span class="vz-spinner sm"></span> } else { <Icon Name="save" Size="17" /> <span>@(IsEdit ? "ذخیره تغییرات" : "ثبت محصول")</span> }
                </button>
            </div>
        </div>
    </EditForm>
}

<Modal Visible="_variantOpen" Title="@(_variantEditingId is null ? "افزودن واریانت" : "ویرایش واریانت")" Icon="layers" OnClose="() => _variantOpen = false">
    <ChildContent>
        <EditForm Model="_variant" OnValidSubmit="SaveVariant" id="variant-form" data-testid="variant-form">
            <DataAnnotationsValidator />
            <div class="vz-form-grid">
                <div class="vz-field span-2">
                    <label class="vz-label">عنوان واریانت <span class="req">*</span></label>
                    <InputText class="vz-input" data-testid="variant-title" @bind-Value="_variant.Title" />
                    <ValidationMessage For="() => _variant.Title" class="vz-val-msg" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">SKU</label>
                    <InputText class="vz-input vz-mono" data-testid="variant-sku" @bind-Value="_variant.Sku" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">مقدار / Value</label>
                    <InputText class="vz-input" data-testid="variant-value" @bind-Value="_variant.Value" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">قیمت <span class="req">*</span></label>
                    <AmountInput Class="vz-input" data-testid="variant-price" AriaLabel="قیمت واریانت"
                                 Value="_variant.Price" ValueChanged="value => _variant.Price = value ?? 0" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">قیمت با تخفیف</label>
                    <AmountInput Class="vz-input" data-testid="variant-discount-price" AriaLabel="قیمت تخفیف واریانت" @bind-Value="_variant.DiscountPrice" />
                </div>
                @* Inventory is decided by the product's delivery type, not chosen per variant: Instant
                   draws from the gift-code pool, every other mode from a managed quantity. Offering a
                   free choice here would let an administrator claim stock that cannot be delivered. *@
                @* Instant delivery draws its units from gift codes, so an inventory policy would be
                   meaningless there and the backend refuses it anyway. The choice is offered only
                   where it applies. *@
                @if (!IsInstantDelivery)
                {
                    <div class="vz-field">
                        <label class="vz-label">نوع موجودی</label>
                        <select class="vz-input" data-testid="variant-stock-mode"
                                value="@_variant.StockMode"
                                @onchange="OnVariantStockModeChanged">
                            <option value="2">موجودی محدود</option>
                            <option value="3">موجودی نامحدود</option>
                        </select>
                        @if (VariantIsUnlimited)
                        {
                            <div class="vz-hint" data-testid="variant-unlimited-hint">
                                این کالا محدودیت موجودی ندارد و همیشه قابل خرید است.
                            </div>
                        }
                    </div>
                }
                <div class="vz-field">
                    <label class="vz-label">موجودی</label>
                    @if (IsInstantDelivery)
                    {
                        <div class="vz-input" style="display:flex;align-items:center;background:var(--surface-2)"
                             data-testid="variant-stock-giftcode">
                            <span>@AdminUiHelper.Number(_variantGiftCodeStock) عدد کد قابل تحویل</span>
                        </div>
                        <div class="vz-hint">موجودی این نوع محصول بر اساس تعداد کدهای قابل تحویل محاسبه می‌شود.</div>
                    }
                    else
                    {
                        <InputNumber class="vz-input" data-testid="variant-stock-quantity"
                                     @bind-Value="_variant.StockQuantity" min="0" step="1"
                                     disabled="@VariantIsUnlimited" />
                        @if (VariantIsUnlimited)
                        {
                            <div class="vz-hint" data-testid="variant-stock-dormant">
                                در حالت نامحدود این عدد نادیده گرفته می‌شود و دست‌نخورده باقی می‌ماند؛
                                با بازگشت به «موجودی محدود» همان مقدار قبلی به کار می‌رود.
                            </div>
                        }
                        else
                        {
                            <div class="vz-hint">
                                تعداد قابل فروش این تنوع. مقدار صفر یعنی «ناموجود».
                                موجودی فقط پس از پرداخت موفق کسر می‌شود؛ افزودن به سبد خرید آن را رزرو نمی‌کند.
                            </div>
                        }
                        <div class="vz-hint" data-testid="variant-stock-availability">
                            وضعیت فعلی:
                            @if (VariantIsUnlimited)
                            {
                                <span class="vz-chip vz-chip--success">همیشه موجود</span>
                            }
                            else if (_variant.StockQuantity > 0)
                            {
                                <span class="vz-chip vz-chip--success">موجود</span>
                            }
                            else
                            {
                                <span class="vz-chip vz-chip--danger">ناموجود</span>
                            }
                            @if (_model.ForceOutOfStock)
                            {
                                <span class="vz-chip vz-chip--danger" data-testid="variant-forced-note">
                                    نمایش دستی ناموجود فعال است
                                </span>
                            }
                        </div>
                    }
                </div>
                <div class="vz-field">
                    <label class="vz-label">ترتیب نمایش</label>
                    <InputNumber class="vz-input" data-testid="variant-sort-order" @bind-Value="_variant.SortOrder" />
                </div>
                <div class="vz-field span-2" style="display:flex;gap:22px">
                    <label class="vz-switch"><input type="checkbox" data-testid="variant-default" @bind="_variant.IsDefault" /><span class="vz-switch__track"></span><span class="vz-switch__label">پیش‌فرض</span></label>
                    <label class="vz-switch"><input type="checkbox" data-testid="variant-active" @bind="_variant.IsActive" /><span class="vz-switch__track"></span><span class="vz-switch__label">فعال</span></label>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="() => _variantOpen = false" disabled="@_savingVariant">انصراف</button>
        <button class="vz-btn vz-btn--primary" type="submit" form="variant-form" disabled="@_savingVariant">
            @if (_savingVariant) { <span class="vz-spinner sm"></span> } else { <span>ذخیره واریانت</span> }
        </button>
    </Footer>
</Modal>

<Modal Visible="_faqOpen" Title="@(_faqEditingId is null ? "پرسش جدید محصول" : "ویرایش پرسش محصول")"
       Icon="help-circle" OnClose="() => _faqOpen = false">
    <ChildContent>
        <EditForm Model="_faq" OnValidSubmit="SaveFaq" id="product-faq-form" data-testid="product-faq-form">
            <DataAnnotationsValidator />
            <div class="vz-grid2">
                <div class="vz-field span-2">
                    <label class="vz-label">پرسش <span class="vz-req">*</span></label>
                    <InputText class="vz-input" data-testid="product-faq-question" @bind-Value="_faq.Question" />
                    <ValidationMessage For="() => _faq.Question" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-label">پاسخ <span class="vz-req">*</span></label>
                    <InputTextArea class="vz-input" rows="5" data-testid="product-faq-answer" @bind-Value="_faq.Answer" />
                    <div class="vz-hint">پاسخ به‌صورت متن ساده ذخیره و نمایش داده می‌شود.</div>
                    <ValidationMessage For="() => _faq.Answer" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">ترتیب نمایش</label>
                    <InputNumber class="vz-input" data-testid="product-faq-sort" @bind-Value="_faq.SortOrder" min="0" />
                </div>
                <div class="vz-field" style="display:flex;align-items:flex-end">
                    <label class="vz-switch">
                        <input type="checkbox" data-testid="product-faq-active" @bind="_faq.IsActive" />
                        <span class="vz-switch__track"></span><span class="vz-switch__label">فعال</span>
                    </label>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="() => _faqOpen = false" disabled="@_savingFaq">انصراف</button>
        <button class="vz-btn vz-btn--primary" type="submit" form="product-faq-form" data-testid="save-product-faq" disabled="@_savingFaq">
            @if (_savingFaq) { <span class="vz-spinner sm"></span> } else { <span>ذخیره پرسش</span> }
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_confirmFaqDelete" Title="حذف پرسش"
               Message="این پرسش از صفحهٔ محصول حذف می‌شود. ادامه می‌دهید؟"
               ConfirmText="حذف" Busy="_deletingFaq"
               OnConfirm="ConfirmDeleteFaq" OnCancel="() => _confirmFaqDelete = false" />

<ConfirmDialog Visible="_confirmVariantDelete" Title="حذف واریانت"
               Message="@($"آیا از حذف واریانت «{_variantTarget?.Title}» مطمئن هستید؟")"
               ConfirmText="حذف" Busy="_deletingVariant"
               OnConfirm="ConfirmDeleteVariant" OnCancel="() => _confirmVariantDelete = false" />

@code {
    [Parameter] public Guid? Id { get; set; }
    private bool IsEdit => Id is not null && Id != Guid.Empty;

    private bool _loading = true, _saving;
    private string? _error;

    private CreateProductRequestModel _model = new();
    private List<AdminCategoryModel> _categories = new();
    private List<AdminBrandModel> _brands = new();
    private List<AdminProductTagModel> _tags = new();
    private List<AdminProductVariantModel> _variants = new();
    private int _variantPage = 1, _variantTotal;
    private const int _variantPageSize = 25;
    private CancellationTokenSource? _variantLoadCts;

    // summary (edit mode)
    private int _availableStock;
    private bool _hasVariants;
    private int _imageCount;
    private DateTime _createdAt;

    private bool _variantOpen, _savingVariant;
    private CreateProductVariantRequestModel _variant = new();
    private Guid? _variantEditingId;

    private bool _confirmVariantDelete, _deletingVariant;
    private AdminProductVariantModel? _variantTarget;

    private decimal FinalPrice => _model.DiscountPrice is > 0 && _model.DiscountPrice < _model.BasePrice
        ? _model.DiscountPrice.Value : _model.BasePrice;

    private record DeliveryOption(byte Key, string Label);
    private static readonly DeliveryOption[] DeliveryOptions =
    {
        new(1, "تحویل آنی"), new(2, "تحویل دستی"), new(3, "نیازمند پشتیبانی"),
    };

    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        _loading = true; _error = null;

        var catTask = Api.GetAsync<List<AdminCategoryModel>>("admin/categories");
        var brandTask = Api.GetAsync<List<AdminBrandModel>>("admin/brands");
        var tagTask = Api.GetAsync<List<AdminProductTagModel>>("admin/product-tags");
        await Task.WhenAll(catTask, brandTask, tagTask);

        _categories = catTask.Result.Data ?? new();
        _brands = brandTask.Result.Data ?? new();
        _tags = tagTask.Result.Data ?? new();

        if (IsEdit)
        {
            var result = await Api.GetAsync<AdminProductModel>($"admin/products/{Id}");
            if (!result.IsSuccess || result.Data is null) { _error = result.Message; _loading = false; return; }

            var p = result.Data;
            _availableStock = p.AvailableStock;
            _hasVariants = p.HasVariants;
            _createdAt = p.CreatedAt;
            _model = new CreateProductRequestModel
            {
                CategoryId = p.CategoryId, CategoryIds = p.CategoryIds ?? new(), BrandId = p.BrandId, Title = p.Title, Slug = p.Slug,
                ShortDescription = p.ShortDescription, FullDescription = p.FullDescription,
                ThumbnailImagePath = p.ThumbnailImagePath, ThumbnailAltText = p.ThumbnailAltText, ProductType = p.ProductType, DeliveryType = p.DeliveryType,
                CurrencyType = p.CurrencyType, BasePrice = p.BasePrice, DiscountPrice = p.DiscountPrice,
                RequiresSupportMessage = p.RequiresSupportMessage,
                MinOrderQuantity = p.MinOrderQuantity, MaxOrderQuantity = p.MaxOrderQuantity,
                IsFeatured = p.IsFeatured, ForceOutOfStock = p.ForceOutOfStock, IsActive = p.IsActive, SeoTitle = p.SeoTitle,
                SeoDescription = p.SeoDescription, FocusKeyword = p.FocusKeyword, TagIds = p.TagIds ?? new(), SortOrder = p.SortOrder,
                Features = p.Features ?? new(), InputFields = p.InputFields ?? new()
            };

            await LoadVariants();
            await LoadProductFaqsAsync();
            await LoadImageCount();
        }
        else
        {
            _model = new CreateProductRequestModel { IsActive = true, CurrencyType = 2, ProductType = 1, DeliveryType = 1, MinOrderQuantity = 1 };
        }

        _loading = false;
    }

    private async Task LoadVariants()
    {
        _variantLoadCts?.Cancel();
        _variantLoadCts?.Dispose();
        _variantLoadCts = new CancellationTokenSource();
        var cancellationToken = _variantLoadCts.Token;
        var r = await Api.GetAsync<PagedResult<AdminProductVariantModel>>(
            $"admin/products/{Id}/variants/paged?page={_variantPage}&pageSize={_variantPageSize}", cancellationToken);
        if (cancellationToken.IsCancellationRequested) return;
        _variants = r.Data?.Items.ToList() ?? new();
        _variantTotal = r.Data?.TotalCount ?? 0;
    }

    private async Task LoadImageCount()
    {
        var r = await Api.GetAsync<PagedResult<AdminProductImageModel>>($"admin/products/{Id}/images/paged?page=1&pageSize=1");
        _imageCount = r.Data?.TotalCount ?? 0;
    }

    private async Task ChangeVariantPage(int page)
    {
        _variantPage = page;
        await LoadVariants();
    }

    private void OnTitleChanged()
    {
        // Auto-suggest a slug for brand-new products only (never overwrite on edit).
        if (!IsEdit && !string.IsNullOrWhiteSpace(_model.Title))
            _model.Slug = Slugify(_model.Title);
    }

    private static string Slugify(string input)
    {
        var slug = input.Trim().ToLowerInvariant();
        var sb = new System.Text.StringBuilder();
        foreach (var ch in slug)
        {
            if (ch == ' ' || ch == '_' || ch == '-') sb.Append('-');
            else if (char.IsLetterOrDigit(ch)) sb.Append(ch);
        }
        var result = sb.ToString();
        while (result.Contains("--")) result = result.Replace("--", "-");
        return result.Trim('-');
    }

    private async Task Save()
    {
        if (_model.CategoryId == Guid.Empty) { Toasts.Error("انتخاب دسته‌بندی الزامی است."); return; }
        if (string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Slug)) { Toasts.Error("عنوان و اسلاگ محصول الزامی است."); return; }

        if (_model.Features.Any(x => string.IsNullOrWhiteSpace(x.Title) || string.IsNullOrWhiteSpace(x.Value))) { Toasts.Error("عنوان و مقدار همه ویژگی‌ها الزامی است."); return; }
        if (_model.InputFields.Any(x => string.IsNullOrWhiteSpace(x.Key) || string.IsNullOrWhiteSpace(x.Label))) { Toasts.Error("نام داخلی و برچسب همه فیلدها الزامی است."); return; }
        for (var i = 0; i < _model.Features.Count; i++) _model.Features[i].SortOrder = (i + 1) * 10;
        for (var i = 0; i < _model.InputFields.Count; i++) _model.InputFields[i].SortOrder = (i + 1) * 10;
        _saving = true;
        var result = IsEdit
            ? await Api.PutAsync<AdminProductModel>($"admin/products/{Id}", _model)
            : await Api.PostAsync<AdminProductModel>("admin/products", _model);
        _saving = false;

        if (result.IsSuccess && result.Data is not null)
        {
            Toasts.Success(IsEdit ? "تغییرات محصول ذخیره شد." : "محصول با موفقیت ایجاد شد.");
            if (!IsEdit) Nav.NavigateTo($"admin/products/{result.Data.Id}");
        }
        else Toasts.Error(result.Message);
    }

    private void ToggleTag(Guid id, object? value)
    {
        var selected = value is bool b && b;
        if (selected && !_model.TagIds.Contains(id)) _model.TagIds.Add(id);
        if (!selected) _model.TagIds.Remove(id);
    }

    private record InputTypeOption(byte Key, string Label);
    private static readonly InputTypeOption[] InputTypes =
    {
        new(1,"متن"), new(2,"ایمیل"), new(3,"موبایل"), new(4,"عدد"), new(5,"متن چندخطی"),
        new(6,"انتخابی"), new(7,"رادیویی"), new(8,"تأیید/چک‌باکس"), new(9,"نام کاربری تلگرام"),
        new(10,"نشانی وب"), new(11,"تاریخ"), new(12,"محرمانه")
    };

    private void AddFeature() => _model.Features.Add(new ProductFeatureModel { IsActive = true, SortOrder = (_model.Features.Count + 1) * 10 });
    private void MoveFeature(int index, int offset) => Move(_model.Features, index, offset);
    private void AddInputField() => _model.InputFields.Add(new ProductInputFieldModel { IsActive = true, FieldType = 1, DisplayStage = 1, SortOrder = (_model.InputFields.Count + 1) * 10 });
    private void MoveInput(int index, int offset) => Move(_model.InputFields, index, offset);
    private static void Move<T>(List<T> list, int index, int offset)
    {
        var target = index + offset;
        if (index < 0 || index >= list.Count || target < 0 || target >= list.Count) return;
        (list[index], list[target]) = (list[target], list[index]);
    }

    /// <summary>Instant products take their inventory from gift codes, so no manual quantity is offered.</summary>
    // ---------------------------------------------------------------- product FAQ management
    private List<AdminFaqModel> _productFaqs = new();
    private AdminFaqInputModel _faq = new();
    private Guid? _faqEditingId;
    private bool _faqOpen, _savingFaq, _confirmFaqDelete, _deletingFaq;
    private AdminFaqModel? _faqPendingDelete;

    private async Task LoadProductFaqsAsync()
    {
        if (!IsEdit) { _productFaqs = new(); return; }

        var result = await Api.GetAsync<List<AdminFaqModel>>($"admin/products/{Id}/faqs");
        _productFaqs = result.IsSuccess && result.Data is not null ? result.Data : new();
    }

    private void OpenFaqCreate()
    {
        _faqEditingId = null;
        // A sensible next position rather than 0, so a new question lands at the end.
        _faq = new AdminFaqInputModel
        {
            IsActive = true,
            SortOrder = _productFaqs.Count == 0 ? 1 : _productFaqs.Max(x => x.SortOrder) + 1
        };
        _faqOpen = true;
    }

    private void OpenFaqEdit(AdminFaqModel faq)
    {
        _faqEditingId = faq.Id;
        _faq = new AdminFaqInputModel
        {
            Id = faq.Id,
            Question = faq.Question,
            Answer = faq.Answer,
            SortOrder = faq.SortOrder,
            IsActive = faq.IsActive
        };
        _faqOpen = true;
    }

    private async Task SaveFaq()
    {
        if (_savingFaq) return;

        try
        {
            _savingFaq = true;
            var result = _faqEditingId is null
                ? await Api.PostAsync<AdminFaqModel>($"admin/products/{Id}/faqs", _faq)
                : await Api.PutAsync<AdminFaqModel>($"admin/products/{Id}/faqs/{_faqEditingId}", _faq);

            if (!result.IsSuccess)
            {
                Toasts.Error(string.IsNullOrWhiteSpace(result.Message) ? "ذخیره پرسش انجام نشد." : result.Message);
                return;
            }

            _faqOpen = false;
            Toasts.Success(result.Message);
            await LoadProductFaqsAsync();
        }
        finally
        {
            _savingFaq = false;
        }
    }

    private void AskDeleteFaq(AdminFaqModel faq)
    {
        _faqPendingDelete = faq;
        _confirmFaqDelete = true;
    }

    private async Task ConfirmDeleteFaq()
    {
        if (_faqPendingDelete is null) { _confirmFaqDelete = false; return; }

        try
        {
            _deletingFaq = true;
            var result = await Api.DeleteAsync($"admin/products/{Id}/faqs/{_faqPendingDelete.Id}");
            if (result.IsSuccess) Toasts.Success(result.Message);
            else Toasts.Error(string.IsNullOrWhiteSpace(result.Message) ? "حذف پرسش انجام نشد." : result.Message);
            await LoadProductFaqsAsync();
        }
        finally
        {
            _deletingFaq = false;
            _confirmFaqDelete = false;
            _faqPendingDelete = null;
        }
    }

    // ---------------------------------------------------------------- categories
    private string _categoryQuery = string.Empty;

    /// <summary>Active categories not already attached, filtered by the search box.</summary>
    private List<AdminCategoryModel> SelectableCategories =>
        _categories
            .Where(c => c.Id != _model.CategoryId && !_model.CategoryIds.Contains(c.Id))
            .Where(c => string.IsNullOrWhiteSpace(_categoryQuery) ||
                        c.Title.Contains(_categoryQuery.Trim(), StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.Title)
            .Take(40)
            .ToList();

    private string CategoryTitle(Guid id) =>
        _categories.FirstOrDefault(c => c.Id == id)?.Title ?? "—";

    /// <summary>
    /// The primary category is always a member. Changing it swaps the old primary out of the set so
    /// a previous primary does not silently linger as an extra category.
    /// </summary>
    private void OnPrimaryCategoryChanged(ChangeEventArgs args)
    {
        var previous = _model.CategoryId;
        _model.CategoryId = Guid.TryParse(args.Value?.ToString(), out var parsed) ? parsed : Guid.Empty;

        _model.CategoryIds.Remove(previous);
        if (_model.CategoryId != Guid.Empty && !_model.CategoryIds.Contains(_model.CategoryId))
            _model.CategoryIds.Add(_model.CategoryId);
    }

    private void AddCategory(Guid id)
    {
        if (id == Guid.Empty || _model.CategoryIds.Contains(id)) return;
        _model.CategoryIds.Add(id);
        _categoryQuery = string.Empty;
    }

    private void RemoveCategory(Guid id)
    {
        // The primary category cannot be removed here; it changes only by choosing another primary.
        if (id == _model.CategoryId) return;
        _model.CategoryIds.Remove(id);
    }

    private bool IsInstantDelivery => _model.DeliveryType == (byte)Vitorize.Shared.Enums.DeliveryType.Instant;

    /// <summary>True while the variant being edited carries the Unlimited inventory policy.</summary>
    private bool VariantIsUnlimited =>
        _variant.StockMode == (byte)Vitorize.Shared.Enums.ProductVariantStockMode.Unlimited;

    /// <summary>
    /// Switching the policy never rewrites StockQuantity. The dormant number stays in the form and
    /// in the database, so Limited -> Unlimited -> Limited returns the administrator's real value
    /// instead of silently zeroing it. The backend applies the same rule.
    /// </summary>
    private void OnVariantStockModeChanged(ChangeEventArgs args)
    {
        if (byte.TryParse(args.Value?.ToString(), out var mode))
        {
            _variant.StockMode = mode;
        }
    }

    /// <summary>Gift-code stock of the variant being edited, shown read-only for Instant delivery.</summary>
    private int _variantGiftCodeStock;

    private void OpenVariantCreate()
    {
        _variantEditingId = null;
        _variantGiftCodeStock = 0;
        // The server derives StockMode from the product's delivery type; this mirrors it for display.
        _variant = new CreateProductVariantRequestModel
        {
            IsActive = true,
            StockMode = (byte)(IsInstantDelivery ? 1 : 2),
            StockQuantity = 0,
            SortOrder = 10
        };
        _variantOpen = true;
    }

    private void OpenVariantEdit(AdminProductVariantModel v)
    {
        _variantEditingId = v.Id;
        _variantGiftCodeStock = v.AvailableStock;
        _variant = new CreateProductVariantRequestModel
        {
            Title = v.Title, Sku = v.Sku, Price = v.Price, DiscountPrice = v.DiscountPrice,
            Value = v.Value, StockMode = v.StockMode, StockQuantity = v.StockQuantity,
            IsDefault = v.IsDefault, IsActive = v.IsActive, SortOrder = v.SortOrder
        };
        _variantOpen = true;
    }

    private async Task SaveVariant()
    {
        _savingVariant = true;
        var r = _variantEditingId is null
            ? await Api.PostAsync<AdminProductVariantModel>($"admin/products/{Id}/variants", _variant)
            : await Api.PutAsync<AdminProductVariantModel>($"admin/product-variants/{_variantEditingId}", _variant);
        _savingVariant = false;

        if (r.IsSuccess) { Toasts.Success("واریانت ذخیره شد."); _variantOpen = false; _variantPage = 1; await LoadVariants(); }
        else Toasts.Error(r.Message);
    }

    private void AskDeleteVariant(AdminProductVariantModel v) { _variantTarget = v; _confirmVariantDelete = true; }

    private async Task ConfirmDeleteVariant()
    {
        if (_variantTarget is null) return;
        _deletingVariant = true;
        var r = await Api.DeleteAsync($"admin/product-variants/{_variantTarget.Id}");
        _deletingVariant = false; _confirmVariantDelete = false;
        if (r.IsSuccess)
        {
            Toasts.Success("واریانت حذف شد.");
            if (_variants.Count == 1 && _variantPage > 1) _variantPage--;
            await LoadVariants();
        }
        else Toasts.Error(r.Message);
    }

    public void Dispose()
    {
        _variantLoadCts?.Cancel();
        _variantLoadCts?.Dispose();
    }
}
