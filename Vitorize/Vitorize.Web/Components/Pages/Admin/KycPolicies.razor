@page "/admin/kyc-policies"
@inject ApiClient Api
@inject ToastService Toasts

<PageHeader Title="سیاست‌های احراز هویت" Subtitle="نسخه‌های تاریخی و مدارک موردنیاز" Icon="shield" Breadcrumbs="@(new(){ ("احراز هویت", null), ("سیاست‌ها", null) })" />

@if (_loading) { <LoadingState /> }
else
{
    <div class="vz-grid-2" style="align-items:start">
        <div class="vz-card"><div class="vz-card__head"><div><div class="vz-card__title">سیاست‌ها و نسخه‌ها</div><div class="vz-muted">نسخه‌های منتشرشده تغییرناپذیر هستند.</div></div></div><div class="vz-card__body">
            @foreach (var policy in _policies)
            {
                <div data-testid="kyc-policy-@policy.Id" style="padding:12px 0;border-bottom:1px solid var(--border)"><div class="vz-spread"><strong>@policy.Name</strong><button data-testid="kyc-policy-create-version-@policy.Id" class="vz-btn vz-btn--sm vz-btn--ghost" @onclick="() => CreateVersion(policy)">نسخه جدید</button></div><div class="vz-muted">@policy.Code</div>
                    @foreach (var version in policy.Versions.OrderByDescending(x => x.Version))
                    {
                        <div data-testid="kyc-policy-version-@version.Id" class="vz-spread" style="margin-top:8px"><span>نسخه @version.Version — @version.CustomerTitle</span><span style="display:flex;gap:6px">@if (version.Status == 2) { <StatusBadge Text="منتشرشده" Intent="success" /> } else { <button data-testid="kyc-version-edit-@version.Id" class="vz-btn vz-btn--sm vz-btn--outline" @onclick="() => EditDraft(version)">ویرایش</button><button data-testid="kyc-version-publish-@version.Id" class="vz-btn vz-btn--sm vz-btn--outline" @onclick="() => Publish(version.Id)">انتشار</button> }</span></div>
                    }
                </div>
            }
        </div></div>
        <div class="vz-stack" style="gap:16px">
            @if (_draft is not null)
            {
                <div class="vz-card"><div class="vz-card__head"><div class="vz-card__title">پیش‌نویس نسخه @(_draft.Version)</div></div><div class="vz-card__body vz-stack">
                    <input class="vz-input" data-testid="kyc-draft-title" placeholder="عنوان مشتری" @bind="_draft.CustomerTitle" />
                    <textarea class="vz-input" data-testid="kyc-draft-instructions" placeholder="راهنمای مشتری" @bind="_draft.CustomerInstructions"></textarea>
                    <div class="vz-muted">مدارک موردنیاز این نسخه</div>
                    <label class="vz-muted">مهلت اقدام کاربر (ساعت؛ خالی = بدون محدودیت)</label>
                    <InputNumber class="vz-input" data-testid="kyc-draft-customer-action-deadline-hours" @bind-Value="_draft.CustomerActionDeadlineHours" />
                    @foreach (var document in _documentTypes.Where(x => x.IsActive))
                    {
                        var requirement = RequirementFor(document.Id);
                        <div data-testid="kyc-requirement-@document.Id" class="vz-spread"><label class="vz-switch"><input data-testid="kyc-requirement-enabled-@document.Id" type="checkbox" checked="@(requirement is not null)" @onchange="e => ToggleRequirement(document, e.Value is true)" /><span class="vz-switch__track"></span><span class="vz-switch__label">@document.Title</span></label>
                        @if (requirement is not null) { <span style="display:flex;gap:8px;align-items:center"><label>اجباری <input data-testid="kyc-requirement-required-@document.Id" type="checkbox" @bind="requirement.IsRequired" /></label><InputNumber data-testid="@($"kyc-requirement-sort-{document.Id}")" style="width:72px" @bind-Value="requirement.SortOrder" /></span> }
                        @if (requirement is not null)
                        {
                            <div class="vz-stack" style="padding:8px 0 0 28px;gap:6px">
                                <label class="vz-muted" for="kyc-redaction-mode-@document.Id">حالت پوشاندن اطلاعات</label>
                                <select id="kyc-redaction-mode-@document.Id" data-testid="kyc-redaction-mode-@document.Id" class="vz-input" style="max-width:220px" @bind="requirement.RedactionMode">
                                    <option value="0">بدون پوشاندن</option>
                                    <option value="1">اختیاری</option>
                                    <option value="2">اجباری</option>
                                </select>
                                <textarea data-testid="kyc-requirement-instructions-@document.Id" class="vz-input" placeholder="راهنمای مشتری برای این مدرک" @bind="requirement.CustomerInstructions"></textarea>
                                <textarea data-testid="kyc-redaction-instructions-@document.Id" class="vz-input" placeholder="راهنمای پوشاندن اطلاعات برای مشتری" @bind="requirement.RedactionInstructions"></textarea>
                            </div>
                        }</div>
                    }
                    <button data-testid="kyc-draft-save" class="vz-btn vz-btn--primary" @onclick="SaveDraft">ذخیره پیش‌نویس و مدارک</button>
                </div></div>
            }
            <div class="vz-card"><div class="vz-card__head"><div class="vz-card__title">سیاست جدید</div></div><div class="vz-card__body vz-stack"><input data-testid="kyc-policy-code" class="vz-input" placeholder="کد یکتا" @bind="_policy.Code" /><input data-testid="kyc-policy-name" class="vz-input" placeholder="نام سیاست" @bind="_policy.Name" /><input data-testid="kyc-policy-title" class="vz-input" placeholder="عنوان مشتری" @bind="_policy.CustomerTitle" /><textarea data-testid="kyc-policy-instructions" class="vz-input" placeholder="راهنمای مشتری" @bind="_policy.CustomerInstructions"></textarea><label class="vz-muted">مهلت اقدام کاربر (ساعت؛ خالی = بدون محدودیت)</label><InputNumber class="vz-input" data-testid="kyc-policy-customer-action-deadline-hours" @bind-Value="_policy.CustomerActionDeadlineHours" /><button data-testid="kyc-policy-create" class="vz-btn vz-btn--primary" @onclick="CreatePolicy">ایجاد نسخه پیش‌نویس</button></div></div>
            <div class="vz-card"><div class="vz-card__head"><div class="vz-card__title">نوع مدرک</div></div><div class="vz-card__body vz-stack">
                @foreach (var document in _documentTypes)
                {
                    <div data-testid="kyc-document-row-@document.Id" class="vz-spread"><span><strong>@document.Title</strong><span class="vz-muted"> @document.Code · @document.AllowedExtensions</span></span><button data-testid="kyc-document-edit-@document.Id" class="vz-btn vz-btn--sm vz-btn--ghost" @onclick="() => EditDocument(document)">ویرایش</button></div>
                }
                <input data-testid="kyc-document-code" class="vz-input" placeholder="کد یکتا" @bind="_document.Code" /><input data-testid="kyc-document-title" class="vz-input" placeholder="عنوان مدرک" @bind="_document.Title" /><textarea data-testid="kyc-document-description" class="vz-input" placeholder="توضیحات" @bind="_document.Description"></textarea><input data-testid="kyc-document-extensions" class="vz-input" placeholder="پسوندهای مجاز: jpg,jpeg,png,webp" @bind="_document.AllowedExtensions" /><InputNumber data-testid="kyc-document-max-size" @bind-Value="_document.MaxFileSizeBytes" /><InputNumber data-testid="kyc-document-sort" @bind-Value="_document.SortOrder" /><label class="vz-switch"><input data-testid="kyc-document-active" type="checkbox" @bind="_document.IsActive" /><span class="vz-switch__track"></span><span class="vz-switch__label">فعال</span></label><button data-testid="kyc-document-save" class="vz-btn vz-btn--outline" @onclick="SaveDocument">@(_document.Id == Guid.Empty ? "افزودن نوع مدرک" : "ذخیره نوع مدرک")</button></div></div>
        </div>
    </div>
}

@code {
    private bool _loading = true; private List<PolicyModel> _policies = new(); private List<DocumentTypeModel> _documentTypes = new(); private PolicyRequest _policy = new(); private DocumentRequest _document = new(); private PolicyVersionModel? _draft;
    protected override async Task OnInitializedAsync() => await Load();
    private async Task Load() { _loading = true; var policies = Api.GetAsync<List<PolicyModel>>("admin/kyc/policies"); var documents = Api.GetAsync<List<DocumentTypeModel>>("admin/kyc/document-types"); await Task.WhenAll(policies, documents); if (policies.Result.IsSuccess) _policies = policies.Result.Data ?? new(); else Toasts.Error(policies.Result.Message); _documentTypes = documents.Result.Data ?? new(); _loading = false; }
    private async Task CreatePolicy() { var r = await Api.PostAsync<PolicyModel>("admin/kyc/policies", _policy); if (!r.IsSuccess) { Toasts.Error(r.Message); return; } _policy = new(); Toasts.Success("سیاست ایجاد شد."); await Load(); }
    private async Task CreateVersion(PolicyModel policy) { var r = await Api.PostAsync<PolicyVersionModel>($"admin/kyc/policies/{policy.Id}/versions", new { CustomerTitle = policy.Name, CustomerInstructions = "", CustomerActionDeadlineHours = (int?)null }); if (!r.IsSuccess) { Toasts.Error(r.Message); return; } _draft = r.Data; Toasts.Success("نسخه پیش‌نویس ایجاد شد."); await Load(); }
    private void EditDraft(PolicyVersionModel version) => _draft = version.Clone();
    private async Task Publish(Guid id) { var r = await Api.PostAsync<PolicyVersionModel>($"admin/kyc/policy-versions/{id}/publish", new { }); if (!r.IsSuccess) { Toasts.Error(r.Message); return; } Toasts.Success("نسخه منتشر شد."); _draft = null; await Load(); }
    private async Task SaveDraft() { if (_draft is null) return; var meta = await Api.PutAsync<PolicyVersionModel>($"admin/kyc/policy-versions/{_draft.Id}", new { _draft.CustomerTitle, _draft.CustomerInstructions, _draft.CustomerActionDeadlineHours }); if (!meta.IsSuccess) { Toasts.Error(meta.Message); return; } var docs = await Api.PutAsync<object>($"admin/kyc/policy-versions/{_draft.Id}/document-requirements", new { Requirements = _draft.DocumentRequirements }); if (!docs.IsSuccess) { Toasts.Error(docs.Message); return; } Toasts.Success("پیش‌نویس ذخیره شد."); _draft = null; await Load(); }
    private async Task SaveDocument() { var r = _document.Id == Guid.Empty ? await Api.PostAsync<DocumentTypeModel>("admin/kyc/document-types", _document) : await Api.PutAsync<DocumentTypeModel>($"admin/kyc/document-types/{_document.Id}", _document); if (!r.IsSuccess) { Toasts.Error(r.Message); return; } _document = new(); Toasts.Success("نوع مدرک ذخیره شد."); await Load(); }
    private void EditDocument(DocumentTypeModel document) => _document = new() { Id = document.Id, Code = document.Code, Title = document.Title, Description = document.Description, IsActive = document.IsActive, AllowedExtensions = document.AllowedExtensions, MaxFileSizeBytes = document.MaxFileSizeBytes, SortOrder = document.SortOrder };
    private RequirementModel? RequirementFor(Guid id) => _draft?.DocumentRequirements.FirstOrDefault(x => x.KycDocumentTypeId == id);
    private void ToggleRequirement(DocumentTypeModel document, bool enabled) { if (_draft is null) return; var item = RequirementFor(document.Id); if (enabled && item is null) _draft.DocumentRequirements.Add(new RequirementModel { KycDocumentTypeId = document.Id, IsRequired = true, SortOrder = _draft.DocumentRequirements.Count * 10 + 10 }); else if (!enabled && item is not null) _draft.DocumentRequirements.Remove(item); }
    private sealed class PolicyModel { public Guid Id { get; set; } public string Code { get; set; } = ""; public string Name { get; set; } = ""; public List<PolicyVersionModel> Versions { get; set; } = new(); }
    private sealed class PolicyVersionModel { public Guid Id { get; set; } public int Version { get; set; } public byte Status { get; set; } public string CustomerTitle { get; set; } = ""; public string? CustomerInstructions { get; set; } public int? CustomerActionDeadlineHours { get; set; } public List<RequirementModel> DocumentRequirements { get; set; } = new(); public PolicyVersionModel Clone() => new() { Id = Id, Version = Version, Status = Status, CustomerTitle = CustomerTitle, CustomerInstructions = CustomerInstructions, CustomerActionDeadlineHours = CustomerActionDeadlineHours, DocumentRequirements = DocumentRequirements.Select(x => x.Clone()).ToList() }; }
    private sealed class RequirementModel { public Guid KycDocumentTypeId { get; set; } public bool IsRequired { get; set; } public int SortOrder { get; set; } public string? CustomerInstructions { get; set; } public byte RedactionMode { get; set; } public string? RedactionInstructions { get; set; } public RequirementModel Clone() => (RequirementModel)MemberwiseClone(); }
    private sealed class DocumentTypeModel { public Guid Id { get; set; } public string Code { get; set; } = ""; public string Title { get; set; } = ""; public string? Description { get; set; } public bool IsActive { get; set; } public string AllowedExtensions { get; set; } = "jpg,jpeg,png,webp"; public long MaxFileSizeBytes { get; set; } = 5242880; public int SortOrder { get; set; } }
    private sealed class PolicyRequest { public string Code { get; set; } = ""; public string Name { get; set; } = ""; public string CustomerTitle { get; set; } = ""; public string? CustomerInstructions { get; set; } public int? CustomerActionDeadlineHours { get; set; } }
    private sealed class DocumentRequest { public Guid Id { get; set; } public string Code { get; set; } = ""; public string Title { get; set; } = ""; public string? Description { get; set; } public string AllowedExtensions { get; set; } = "jpg,jpeg,png,webp"; public long MaxFileSizeBytes { get; set; } = 5242880; public bool IsActive { get; set; } = true; public int SortOrder { get; set; } }
}
