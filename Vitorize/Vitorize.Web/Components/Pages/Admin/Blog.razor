@page "/admin/blog"
@inject ApiClient Api
@inject ToastService Toasts
@inject MediaUrlResolver Media
@using Vitorize.Web.Models.Admin.Content
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageHeader Title="مدیریت وبلاگ" Subtitle="نوشتن، پیش‌نمایش و انتشار مطالب وبلاگ فروشگاه"
            Icon="file-text" Breadcrumbs="@(new(){ ("وبلاگ", null) })">
    <Actions>
        <button class="vz-btn vz-btn--outline" @onclick="Load"><Icon Name="refresh" Size="17" /> بروزرسانی</button>
        <button class="vz-btn vz-btn--primary" data-testid="blog-create" @onclick="OpenCreate"><Icon Name="plus" Size="17" /> مطلب جدید</button>
    </Actions>
</PageHeader>

<div class="vz-card">
    <div class="vz-card__body flush">
        @if (_loading) { <LoadingState /> }
        else if (_error is not null) { <ErrorState Message="@_error" OnRetry="Load" /> }
        else if (_items.Count == 0)
        {
            <EmptyState Title="هنوز مطلبی نوشته نشده است" Icon="file-text">
                <Actions><button class="vz-btn vz-btn--primary vz-btn--sm" @onclick="OpenCreate"><Icon Name="plus" Size="15" /> نوشتن اولین مطلب</button></Actions>
            </EmptyState>
        }
        else
        {
            <div class="vz-table-wrap">
                <table class="vz-table">
                    <thead>
                        <tr><th>عنوان</th><th>نامک</th><th>وضعیت</th><th>تاریخ انتشار</th><th>آخرین تغییر</th><th class="col-actions">عملیات</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _items)
                        {
                            <tr data-testid="@($"blog-row-{p.Slug}")">
                                <td><span class="vz-cell-title">@p.Title</span></td>
                                <td class="vz-mono" style="font-size:12px">/blog/@p.Slug</td>
                                <td><StatusBadge Text="@(p.IsPublished ? "منتشر شده" : "پیش‌نویس")" Intent="@(p.IsPublished ? "success" : "muted")" /></td>
                                <td class="vz-mono" style="font-size:12px"><PersianDateDisplay Value="p.PublishedAt" WithTime="true" /></td>
                                <td class="vz-mono" style="font-size:12px"><PersianDateDisplay Value="@(p.UpdatedAt ?? p.CreatedAt)" WithTime="true" /></td>
                                <td class="col-actions">
                                    <button class="vz-iconaction" title="ویرایش" data-testid="@($"blog-edit-{p.Slug}")" @onclick="() => OpenEdit(p)"><Icon Name="edit" Size="16" /></button>
                                    <button class="vz-iconaction" title="پیش‌نمایش" data-testid="@($"blog-preview-{p.Slug}")" @onclick="() => OpenPreviewFor(p)"><Icon Name="eye" Size="16" /></button>
                                    <button class="vz-iconaction" title="@(p.IsPublished ? "لغو انتشار" : "انتشار")"
                                            data-testid="@($"blog-publish-{p.Slug}")" @onclick="() => TogglePublish(p)">
                                        <Icon Name="@(p.IsPublished ? "eye-off" : "send")" Size="16" />
                                    </button>
                                    <button class="vz-iconaction danger" title="حذف" data-testid="@($"blog-delete-{p.Slug}")" @onclick="() => AskDelete(p)"><Icon Name="trash" Size="16" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ---------------------------------------------------------------- editor *@
<Modal Visible="_formOpen" Title="@(_model.Id is null ? "نوشتن مطلب جدید" : "ویرایش مطلب")"
       Icon="file-text" Size="lg" OnClose="CloseForm">
    <ChildContent>
        @* Preview is rendered INSIDE the editor dialog and only ever hides the form with CSS.
           Closing the dialog (or removing the form from the render tree) disposes the CKEditor
           instance and loses the unsaved body, which is exactly how the earlier publish failure
           happened: the title survived because it is a plain input, ContentHtml did not. *@
        @if (_previewMode)
        {
            <article class="vz-blog-preview" data-testid="blog-preview-body">
                <h2 style="margin:0 0 6px">@(!string.IsNullOrWhiteSpace(_model.Title) ? _model.Title : "بدون عنوان")</h2>
                @if (!string.IsNullOrWhiteSpace(_model.Slug))
                {
                    <div class="vz-mono vz-muted" style="font-size:12px;margin-bottom:12px">/blog/@_model.Slug</div>
                }
                @if (!string.IsNullOrWhiteSpace(_model.CoverImagePath))
                {
                    <img src="@Media.Resolve(_model.CoverImagePath)" alt="@_model.CoverImageAltText"
                         style="width:100%;max-height:320px;object-fit:cover;border-radius:10px;margin-bottom:14px" />
                }
                @if (!string.IsNullOrWhiteSpace(_model.Summary))
                {
                    <p class="vz-muted" style="font-size:14px">@_model.Summary</p>
                }
                @if (string.IsNullOrWhiteSpace(_model.ContentHtml))
                {
                    <p class="vz-muted">متنی برای نمایش وجود ندارد.</p>
                }
                else
                {
                    @* Renders the not-yet-saved editor value, so it has not passed the server
                       sanitizer yet. That is acceptable only because the audience is the author's
                       own session and CKEditor's schema cannot emit script/event-handler markup;
                       the value is sanitised on save and again on public read before it can ever
                       reach another user. Rendered with the same st-rich-content styling as the
                       public article body. *@
                    <div class="st-rich-content" style="line-height:2.1;font-size:15px">
                        @((MarkupString)(_model.ContentHtml ?? string.Empty))
                    </div>
                }
            </article>
        }

        <div style="@(_previewMode ? "display:none" : null)">
        <EditForm Model="_model" OnValidSubmit="Save" id="blog-form">
            <DataAnnotationsValidator />
            <div class="vz-form-grid">
                <div class="vz-field span-2">
                    <label class="vz-label">عنوان <span class="req">*</span></label>
                    <InputText class="vz-input" data-testid="blog-title" @bind-Value="_model.Title" />
                    <ValidationMessage For="() => _model.Title" class="vz-val-msg" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-label">نامک (Slug) <span class="req">*</span></label>
                    <InputText class="vz-input" data-testid="blog-slug" @bind-Value="_model.Slug" dir="ltr" />
                    <div class="vz-hint">نشانی عمومی: <span class="vz-mono">/blog/@_model.Slug</span></div>
                    <ValidationMessage For="() => _model.Slug" class="vz-val-msg" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-label">خلاصه</label>
                    <InputTextArea class="vz-textarea" rows="2" data-testid="blog-summary" @bind-Value="_model.Summary" />
                    <div class="vz-hint">در فهرست وبلاگ و بخش وبلاگ صفحه اصلی نمایش داده می‌شود.</div>
                    <ValidationMessage For="() => _model.Summary" class="vz-val-msg" />
                </div>

                @* Same rich-text component the product full description uses: identical CKEditor
                   configuration, upload rules, RTL handling and server-side sanitisation. *@
                <div class="vz-field span-2">
                    <label class="vz-label">متن مطلب</label>
                    <RichTextEditor @bind-Value="_model.ContentHtml" TestId="blog-content-editor"
                                    Placeholder="متن مطلب را بنویسید…" />
                    <span class="vz-hint">HTML هنگام ذخیره در سرور با همان فهرست سخت‌گیرانه تگ‌های مجاز پاک‌سازی می‌شود.</span>
                </div>

                @* Blog covers keep their natural aspect ratio — the 1:1 rule applies to product media only. *@
                <div class="vz-field">
                    <label class="vz-label">تصویر شاخص</label>
                    <UploadBox Value="@_model.CoverImagePath" Endpoint="admin/uploads/settings-image"
                               Accept="image/png,image/jpeg,image/webp"
                               Guidance="PNG، JPG یا WEBP — حداکثر ۲ مگابایت"
                               ValueChanged="v => _model.CoverImagePath = v" Label="آپلود تصویر شاخص" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">متن جایگزین تصویر</label>
                    <InputText class="vz-input" data-testid="blog-cover-alt" @bind-Value="_model.CoverImageAltText" />
                    <div class="vz-hint">برای دسترس‌پذیری و سئو.</div>
                    <ValidationMessage For="() => _model.CoverImageAltText" class="vz-val-msg" />
                </div>

                <div class="vz-field span-2">
                    <label class="vz-label">عنوان سئو</label>
                    <InputText class="vz-input" data-testid="blog-seo-title" @bind-Value="_model.SeoTitle" />
                    <div class="vz-hint">در صورت خالی بودن، از عنوان مطلب استفاده می‌شود.</div>
                    <ValidationMessage For="() => _model.SeoTitle" class="vz-val-msg" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-label">توضیحات سئو</label>
                    <InputTextArea class="vz-textarea" rows="3" data-testid="blog-seo-description" @bind-Value="_model.SeoDescription" />
                    <ValidationMessage For="() => _model.SeoDescription" class="vz-val-msg" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-label">کلیدواژه اصلی</label>
                    <InputText class="vz-input" data-testid="blog-focus-keyword" @bind-Value="_model.FocusKeyword" />
                    <ValidationMessage For="() => _model.FocusKeyword" class="vz-val-msg" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-switch">
                        <InputCheckbox @bind-Value="_model.IsPublished" data-testid="blog-published" />
                        <span class="vz-switch__track"></span>
                        <span class="vz-switch__label">منتشر شده</span>
                    </label>
                    <div class="vz-hint">مطلب جدید به‌صورت پیش‌نویس ذخیره می‌شود مگر این‌که این گزینه را روشن کنید.</div>
                </div>
            </div>
        </EditForm>
        </div>
    </ChildContent>
    <Footer>
        @* All footer buttons stay mounted and are toggled with CSS, never an @if: CKEditor pushes
           ValueChanged on blur, and if that round-trip re-created these buttons between the user's
           mousedown and Blazor dispatching the click, the click carried a stale handler id and was
           silently dropped — the "preview button does nothing right after typing" bug. Stable
           elements keep stable handler ids. type="button" is explicit so none of these can ever be
           treated as a submit for the blog form. *@
        <button type="button" class="vz-btn vz-btn--outline" data-testid="blog-preview-close"
                style="@(_previewMode ? null : "display:none")" @onclick="() => _previewMode = false">
            <Icon Name="edit" Size="16" /> بازگشت به ویرایش
        </button>
        <button type="button" class="vz-btn vz-btn--outline" style="@(_previewMode ? "display:none" : null)"
                @onclick="CloseForm" disabled="@_saving">انصراف</button>
        <button type="button" class="vz-btn vz-btn--outline" data-testid="blog-preview-form"
                style="@(_previewMode ? "display:none" : null)" @onclick="() => _previewMode = true" disabled="@_saving">
            <Icon Name="eye" Size="16" /> پیش‌نمایش
        </button>
        <button class="vz-btn vz-btn--primary" type="submit" form="blog-form" data-testid="blog-save" disabled="@_saving">
            @if (_saving) { <span class="vz-spinner sm"></span> } else { <Icon Name="save" Size="16" /> <span>ذخیره</span> }
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_confirmDelete" Title="حذف مطلب"
               Message="@($"آیا از حذف مطلب «{_target?.Title}» مطمئن هستید؟ این عملیات قابل بازگشت نیست.")"
               ConfirmText="حذف" Busy="_deleting"
               OnConfirm="ConfirmDelete" OnCancel="() => _confirmDelete = false" />

@code {
    private bool _loading = true;
    private string? _error;
    private List<AdminBlogPostListItemModel> _items = new();

    private bool _formOpen, _saving;
    private AdminBlogPostInputModel _model = new();

    /// <summary>Swaps the dialog body to the preview view without disposing the editor.</summary>
    private bool _previewMode;

    private bool _confirmDelete, _deleting;
    private AdminBlogPostListItemModel? _target;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        var result = await Api.GetAsync<List<AdminBlogPostListItemModel>>("admin/blog");
        if (result.IsSuccess && result.Data is not null) _items = result.Data;
        else _error = result.Message;
        _loading = false;
    }

    private void OpenCreate()
    {
        _model = new AdminBlogPostInputModel();
        _previewMode = false;
        _formOpen = true;
    }

    private async Task<AdminBlogPostModel?> FetchAsync(Guid id)
    {
        var result = await Api.GetAsync<AdminBlogPostModel>($"admin/blog/{id}");
        if (result.IsSuccess && result.Data is not null) return result.Data;
        Toasts.Error(result.Message);
        return null;
    }

    private static AdminBlogPostInputModel ToInput(AdminBlogPostModel post) => new()
    {
        Id = post.Id, Title = post.Title, Slug = post.Slug, Summary = post.Summary,
        ContentHtml = post.ContentHtml, CoverImagePath = post.CoverImagePath,
        CoverImageAltText = post.CoverImageAltText, SeoTitle = post.SeoTitle,
        SeoDescription = post.SeoDescription, FocusKeyword = post.FocusKeyword,
        IsPublished = post.IsPublished
    };

    private async Task OpenEdit(AdminBlogPostListItemModel item)
    {
        var post = await FetchAsync(item.Id);
        if (post is null) return;
        _model = ToInput(post);
        _previewMode = false;
        _formOpen = true;
    }

    /// <summary>Opens an existing article straight into the preview view.</summary>
    private async Task OpenPreviewFor(AdminBlogPostListItemModel item)
    {
        var post = await FetchAsync(item.Id);
        if (post is null) return;
        _model = ToInput(post);
        _previewMode = true;
        _formOpen = true;
    }

    private void CloseForm() { _formOpen = false; _previewMode = false; }

    private async Task Save()
    {
        _saving = true;
        var payload = new
        {
            _model.Title, _model.Slug, _model.Summary, _model.ContentHtml,
            _model.CoverImagePath, _model.CoverImageAltText,
            _model.SeoTitle, _model.SeoDescription, _model.FocusKeyword, _model.IsPublished
        };

        var result = _model.Id is null
            ? await Api.PostAsync<AdminBlogPostModel>("admin/blog", payload)
            : await Api.PutAsync<AdminBlogPostModel>($"admin/blog/{_model.Id}", payload);

        _saving = false;
        if (result.IsSuccess)
        {
            Toasts.Success(result.Message);
            _formOpen = false;
            await Load();
        }
        else Toasts.Error(result.Message);   // duplicate slug and reserved-slug errors surface here
    }

    private async Task TogglePublish(AdminBlogPostListItemModel p)
    {
        var action = p.IsPublished ? "unpublish" : "publish";
        var result = await Api.PostAsync<AdminBlogPostModel>($"admin/blog/{p.Id}/{action}");
        if (result.IsSuccess) { Toasts.Success(result.Message); await Load(); }
        else Toasts.Error(result.Message);
    }

    private void AskDelete(AdminBlogPostListItemModel p) { _target = p; _confirmDelete = true; }

    private async Task ConfirmDelete()
    {
        if (_target is null) return;
        _deleting = true;
        var result = await Api.DeleteAsync($"admin/blog/{_target.Id}");
        _deleting = false; _confirmDelete = false;
        if (result.IsSuccess) { Toasts.Success(result.Message); await Load(); }
        else Toasts.Error(result.Message);
    }
}
