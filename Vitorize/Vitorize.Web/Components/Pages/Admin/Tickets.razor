@page "/admin/tickets"
@implements IDisposable
@inject ApiClient Api
@inject ToastService Toasts
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageHeader Title="پشتیبانی و تیکت‌ها" Subtitle="مدیریت تیکت‌های مشتریان و پاسخگویی"
            Icon="message" Breadcrumbs="@(new(){ ("تیکت‌ها", null) })">
    <Actions>
        <button class="vz-btn vz-btn--outline" @onclick="LoadList"><Icon Name="refresh" Size="17" /> بروزرسانی</button>
    </Actions>
</PageHeader>

@if (_loading) { <LoadingState /> }
else if (_error is not null) { <ErrorState Message="@_error" OnRetry="LoadList" /> }
else
{
    <div class="vz-stats">
        <StatCard Label="کل تیکت‌ها" Value="@AUI.Number(_items.Count)" Icon="inbox" Accent="purple" />
        <StatCard Label="باز" Value="@AUI.Number(CountStatus(1))" Icon="message" Accent="blue" />
        <StatCard Label="در انتظار مدیر" Value="@AUI.Number(CountStatus(2))" Icon="clock" Accent="orange" />
        <StatCard Label="بسته شده" Value="@AUI.Number(CountStatus(4))" Icon="check-circle" Accent="green" />
    </div>

    <div class="vz-pills" style="margin-bottom:16px">
        @foreach (var f in StatusChips)
        {
            <button class="vz-pill @(_status == f.Key ? "active" : "")" @onclick="() => SetStatus(f.Key)">
                @f.Label <span class="vz-pill__count">@AUI.Number(f.Key == "all" ? _items.Count : CountStatus(byte.Parse(f.Key)))</span>
            </button>
        }
    </div>

    <div class="vz-inbox-grid">
        <div class="vz-card" style="align-self:start">
            <div class="vz-card__head">
                <Icon Name="inbox" Size="18" />
                <div><div class="vz-card__title">تیکت‌ها (@AUI.Number(Filtered.Count))</div></div>
            </div>
            <div class="vz-card__body flush" style="max-height:620px;overflow-y:auto">
                @if (Filtered.Count == 0) { <EmptyState Title="تیکتی یافت نشد" Icon="message" /> }
                else
                {
                    @foreach (var t in Filtered)
                    {
                        <div class="vz-ticket-item @(_selected?.Id == t.Id ? "active" : "")" @onclick="() => Select(t.Id)">
                            <div class="vz-spread">
                                <span class="vz-cell-title" style="font-size:13px">@t.Subject</span>
                                <StatusBadge Text="@AUI.TicketStatus(t.Status)" Intent="@TicketIntent(t.Status)" Dot="false" />
                            </div>
                            <div class="vz-spread" style="margin-top:6px">
                                <span class="vz-cell-sub">@t.UserFullName</span>
                                <span class="vz-cell-sub"><PersianDateDisplay Value="t.CreatedAt" /></span>
                            </div>
                        </div>
                    }
                }
            </div>
            <Pagination Page="_page" PageSize="_pageSize" TotalCount="_total" OnPageChanged="ChangePage" />
        </div>

        <div class="vz-card">
            @if (_loadingDetail) { <div class="vz-card__body"><LoadingState /></div> }
            else if (_selected is null)
            {
                <div class="vz-card__body"><EmptyState Title="یک تیکت را انتخاب کنید" Text="برای مشاهده گفتگو، تیکتی را از فهرست انتخاب کنید." Icon="message" /></div>
            }
            else
            {
                var t = _selected;
                <div class="vz-card__head">
                    <Icon Name="message" Size="18" />
                    <div>
                        <div class="vz-card__title">@t.Subject</div>
                        <div class="vz-card__sub">@t.UserFullName — @t.UserMobile · @AUI.TicketDepartment(t.Department) · اولویت @AUI.TicketPriority(t.Priority)</div>
                    </div>
                    <div class="right">
                        @if (t.Status == (byte)TicketStatus.Closed)
                        { <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="Reopen" disabled="@_acting"><Icon Name="refresh" Size="14" /> بازگشایی</button> }
                        else
                        { <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="Close" disabled="@_acting"><Icon Name="check" Size="14" /> بستن تیکت</button> }
                    </div>
                </div>
                <div class="vz-card__body" style="max-height:480px;overflow-y:auto;background:var(--surface-2)">
                    @if (t.IsFulfillmentTicket)
                    {
                        <div class="vz-msg__fulfillment" data-testid="fulfillment-items">
                            <strong>آیتم‌های تحویل پشتیبانی</strong>
                            @foreach (var item in t.FulfillmentItems)
                            {
                                <div>@item.ProductTitle @if (!string.IsNullOrWhiteSpace(item.VariantTitle)) { <span>— @item.VariantTitle</span> } <span>× @item.Quantity</span></div>
                                @if (item.InputValues.Count > 0)
                                {
                                    <dl class="vz-order-inputs">
                                        @foreach (var value in item.InputValues)
                                        {
                                            <div><dt>@value.FieldLabel</dt><dd class="@(value.IsSensitive && value.IsMasked ? "masked" : null)">@value.Value</dd></div>
                                        }
                                    </dl>
                                }
                            }
                        </div>
                    }
                    @if (_loadingMessages)
                    {
                        <LoadingState />
                    }
                    else if (_messagesError is not null)
                    {
                        <ErrorState Message="@_messagesError" OnRetry="LoadMessages" />
                    }
                    else if (_messages.Count == 0)
                    {
                        <EmptyState Title="پیامی برای این تیکت ثبت نشده است" Icon="message" />
                    }
                    else
                    {
                        @foreach (var m in _messages)
                        {
                            var mine = m.SenderUserId != t.UserId;
                            <div class="vz-msg @(mine ? "mine" : "")">
                                <div class="vz-msg__bubble @(m.IsInternalNote ? "note" : "")">
                                    @if (m.IsInternalNote) { <div class="vz-chip" style="margin-bottom:6px">یادداشت داخلی</div> }
                                    <div>@m.Message</div>
                                </div>
                                <div class="vz-msg__meta"><PersianDateDisplay Value="m.CreatedAt" WithTime="true" /></div>
                            </div>
                        }
                    }
                </div>
                <Pagination Page="_messagePage" PageSize="_messagePageSize" TotalCount="_messageTotal" OnPageChanged="ChangeMessagePage" />
                @if (t.Status != (byte)TicketStatus.Closed)
                {
                    <div style="padding:16px;border-top:1px solid var(--border)">
                        <textarea class="vz-textarea" style="min-height:70px" @bind="_reply" placeholder="پاسخ خود را بنویسید ..."></textarea>
                        <div class="vz-spread" style="margin-top:10px">
                            <label class="vz-switch"><input type="checkbox" @bind="_internalNote" /><span class="vz-switch__track"></span><span class="vz-switch__label">یادداشت داخلی</span></label>
                            <button class="vz-btn vz-btn--primary" @onclick="SendReply" disabled="@_acting">
                                @if (_acting) { <span class="vz-spinner sm"></span> } else { <Icon Name="send" Size="16" /> <span>ارسال پاسخ</span> }
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<style>
    .vz-ticket-item { padding:14px 18px; border-bottom:1px solid var(--border); cursor:pointer; transition:background .12s; }
    .vz-ticket-item:hover { background:var(--surface-2); }
    .vz-ticket-item.active { background:var(--admin-primary-soft); border-inline-start:3px solid var(--admin-primary); }
    .vz-msg { margin-bottom:16px; display:flex; flex-direction:column; align-items:flex-start; }
    .vz-msg.mine { align-items:flex-end; }
    .vz-msg__bubble { max-width:78%; background:var(--surface-solid); border:1px solid var(--border); border-radius:14px; padding:12px 15px; font-size:13px; line-height:1.9; }
    .vz-msg.mine .vz-msg__bubble { background:var(--admin-primary-soft); border-color:transparent; }
    .vz-msg__bubble.note { background:var(--warning-soft); border-color:transparent; }
    .vz-msg__meta { font-size:11px; color:var(--text-3); margin-top:5px; }
    .vz-msg__fulfillment { margin:0 0 16px; padding:12px 15px; border:1px solid var(--border); border-radius:14px; background:var(--surface-solid); font-size:13px; line-height:1.9; }
</style>

@code {
    private bool _loading = true;
    private string? _error;
    private List<TicketModel> _items = new();
    private int _total;
    private int _page = 1;
    private const int _pageSize = 25;

    private string _status = "all";

    private static readonly (string Key, string Label)[] StatusChips =
    {
        ("all", "همه"), ("1", "باز"), ("2", "در انتظار مدیر"), ("3", "در انتظار مشتری"), ("4", "بسته شده"),
    };
    private int CountStatus(byte s) => _items.Count(t => t.Status == s);

    private bool _loadingDetail, _acting;
    private TicketModel? _selected;
    private string _reply = string.Empty;
    private bool _internalNote;
    private List<TicketMessageModel> _messages = new();
    private int _messagePage = 1;
    private int _messageTotal;
    private const int _messagePageSize = 25;
    private bool _loadingMessages;
    private string? _messagesError;
    private CancellationTokenSource? _messageLoadCts;
    private CancellationTokenSource? _detailLoadCts;

    protected override Task OnInitializedAsync() => LoadList();

    private async Task LoadList()
    {
        _loading = true; _error = null;
        var query = $"admin/tickets/paged?page={_page}&pageSize={_pageSize}";
        if (_status != "all") query += $"&status={_status}";
        var r = await Api.GetAsync<PagedResult<TicketModel>>(query);
        if (r.IsSuccess && r.Data is not null) { _items = r.Data.Items.ToList(); _total = r.Data.TotalCount; }
        else _error = r.Message;
        _loading = false;
    }

    private List<TicketModel> Filtered => _items;
    private async Task ChangePage(int page) { _page = page; await LoadList(); }
    private async Task SetStatus(string status) { _status = status; _page = 1; await LoadList(); }

    private static string TicketIntent(byte status) => status switch
    {
        (byte)TicketStatus.Open => "info",
        (byte)TicketStatus.WaitingForAdmin => "warning",
        (byte)TicketStatus.WaitingForCustomer => "purple",
        _ => "muted"
    };

    private async Task Select(Guid id)
    {
        _detailLoadCts?.Cancel();
        _detailLoadCts?.Dispose();
        _detailLoadCts = new CancellationTokenSource();
        var cancellationToken = _detailLoadCts.Token;
        _messageLoadCts?.Cancel();
        _loadingDetail = true; _selected = null; _reply = string.Empty; _internalNote = false;
        _messages = new(); _messagePage = 1; _messageTotal = 0; _messagesError = null;
        try
        {
            var r = await Api.GetAsync<TicketModel>($"admin/tickets/{id}", cancellationToken);
            if (cancellationToken.IsCancellationRequested) return;
            if (r.IsSuccess && r.Data is not null)
            {
                _selected = r.Data;
                await LoadMessages();
            }
            else Toasts.Error(r.Message);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer ticket selection superseded this request.
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
                _loadingDetail = false;
        }
    }

    private async Task ChangeMessagePage(int page)
    {
        _messagePage = page;
        await LoadMessages();
    }

    private async Task LoadMessages()
    {
        if (_selected is null) return;
        _messageLoadCts?.Cancel();
        _messageLoadCts?.Dispose();
        _messageLoadCts = new CancellationTokenSource();
        var cancellationToken = _messageLoadCts.Token;
        var ticketId = _selected.Id;
        _loadingMessages = true;
        _messagesError = null;
        try
        {
            var r = await Api.GetAsync<PagedResult<TicketMessageModel>>(
                $"admin/tickets/{ticketId}/messages?page={_messagePage}&pageSize={_messagePageSize}&sortDirection=asc",
                cancellationToken);
            if (cancellationToken.IsCancellationRequested || _selected?.Id != ticketId) return;
            if (r.IsSuccess && r.Data is not null)
            {
                _messages = r.Data.Items.ToList();
                _messageTotal = r.Data.TotalCount;
            }
            else _messagesError = r.Message;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer ticket or page superseded this request.
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested && _selected?.Id == ticketId)
                _loadingMessages = false;
        }
    }

    private async Task SendReply()
    {
        if (_selected is null) return;
        if (string.IsNullOrWhiteSpace(_reply)) { Toasts.Error("متن پاسخ الزامی است."); return; }

        _acting = true;
        var r = await Api.PostAsync<TicketModel>($"admin/tickets/{_selected.Id}/messages",
            new { Message = _reply, AttachmentPath = (string?)null, IsInternalNote = _internalNote });
        _acting = false;

        if (r.IsSuccess && r.Data is not null)
        {
            _selected = r.Data;
            _reply = string.Empty;
            _internalNote = false;
            _messagePage = Math.Max(1, (int)Math.Ceiling((_messageTotal + 1d) / _messagePageSize));
            await LoadMessages();
            Toasts.Success("پاسخ ثبت شد.");
        }
        else Toasts.Error(r.Message);
    }

    private async Task Close()
    {
        if (_selected is null) return;
        _acting = true;
        var r = await Api.PostAsync<TicketModel>($"admin/tickets/{_selected.Id}/close");
        _acting = false;
        if (r.IsSuccess && r.Data is not null) { _selected = r.Data; Toasts.Success("تیکت بسته شد."); await LoadList(); }
        else Toasts.Error(r.Message);
    }

    private async Task Reopen()
    {
        if (_selected is null) return;
        _acting = true;
        var r = await Api.PostAsync<TicketModel>($"admin/tickets/{_selected.Id}/reopen");
        _acting = false;
        if (r.IsSuccess && r.Data is not null) { _selected = r.Data; Toasts.Success("تیکت بازگشایی شد."); await LoadList(); }
        else Toasts.Error(r.Message);
    }

    public void Dispose()
    {
        _detailLoadCts?.Cancel();
        _detailLoadCts?.Dispose();
        _messageLoadCts?.Cancel();
        _messageLoadCts?.Dispose();
    }
}
