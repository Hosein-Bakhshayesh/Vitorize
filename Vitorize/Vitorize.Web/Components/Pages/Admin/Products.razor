@page "/admin/products"
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject ToastService Toasts
@inject NavigationManager Nav
@inject IJSRuntime JS
@using AUI = Vitorize.Web.Helpers.AdminUiHelper
@using Vitorize.Shared.Storefront
@using Vitorize.Web.Models.Admin.Settings
@implements IDisposable

<PageHeader Title="مدیریت محصولات" Subtitle="لیست محصولات فروشگاه خود را مدیریت و ویرایش کنید"
            Icon="box" Breadcrumbs="@(new(){ ("محصولات", null) })">
    <Actions>
        <button class="vz-btn vz-btn--outline" @onclick="Load"><Icon Name="refresh" Size="17" /> بروزرسانی</button>
        <a class="vz-btn vz-btn--primary" href="admin/products/create"><Icon Name="plus" Size="17" /> افزودن محصول جدید</a>
    </Actions>
</PageHeader>

@if (_loading) { <LoadingState /> }
else if (_error is not null) { <ErrorState Message="@_error" OnRetry="Load" /> }
else
{
    <div class="vz-stats">
        <StatCard Label="همه محصولات" Value="@AUI.Number(_items.Count)" Icon="box" Accent="purple" />
        <StatCard Label="محصولات فعال" Value="@AUI.Number(_items.Count(p => p.IsActive))" Icon="check-circle" Accent="green" />
        <StatCard Label="ویژه" Value="@AUI.Number(_items.Count(p => p.IsFeatured))" Icon="star" Accent="orange" />
        <StatCard Label="ناموجود" Value="@AUI.Number(_items.Count(p => p.AvailableStock <= 0 && !p.HasVariants))" Icon="alert" Accent="red" />
    </div>

    <div class="vz-spread" style="margin-bottom:16px">
        <div class="vz-pills">
            @foreach (var f in StockFilters)
            {
                <button class="vz-pill @(_stockFilter == f.Key ? "active" : "")" @onclick="() => SelectStock(f.Key)">
                    @f.Label <span class="vz-pill__count">@AUI.Number(f.Count(_items))</span>
                </button>
            }
        </div>
    </div>

    @* Configures what CUSTOMERS see, not this table. The admin grid keeps its own column sorting
       and filters below, which is why this sits in its own card with an explicit description. *@
    <div class="vz-filterbar" data-testid="storefront-default-sort" style="margin-bottom:16px">
        <div class="vz-filterbar__row" style="align-items:flex-end">
            <div class="vz-field" style="min-width:280px">
                <label class="vz-label" for="storefront-default-sort-select">
                    <Icon Name="arrow-down-up" Size="15" /> مرتب‌سازی پیش‌فرض کالاها در فروشگاه
                </label>
                <select id="storefront-default-sort-select" class="vz-select"
                        data-testid="storefront-default-sort-select"
                        @bind="_storefrontSort" @bind:after="() => { _storefrontSortSaved = false; return Task.CompletedTask; }">
                    @foreach (var mode in StorefrontProductSortModes.All)
                    {
                        <option value="@mode.Key">@mode.Value</option>
                    }
                </select>
                <div class="vz-hint">این گزینه ترتیب پیش‌فرض نمایش کالاها برای مشتریان را تعیین می‌کند و بر مرتب‌سازی همین جدول مدیریت اثری ندارد. اگر مشتری خودش مرتب‌سازی دیگری انتخاب کند، انتخاب او اولویت دارد.</div>
            </div>
            <div class="vz-field" style="flex:0 0 auto">
                <button class="vz-btn vz-btn--primary" data-testid="storefront-default-sort-save"
                        disabled="@_savingStorefrontSort" @onclick="SaveStorefrontSort">
                    @if (_savingStorefrontSort) { <span class="vz-spinner sm"></span> } else { <Icon Name="save" Size="16" /> }
                    <span>ذخیره</span>
                </button>
            </div>
            @if (_storefrontSortSaved)
            {
                <div class="vz-field" style="flex:0 0 auto">
                    <span class="vz-badge vz-badge--success" data-testid="storefront-default-sort-saved">ذخیره شد</span>
                </div>
            }
        </div>
    </div>

    <div class="vz-filterbar">
        <div class="vz-filterbar__row">
            <div class="vz-field">
                <label class="vz-label">جستجو</label>
                <div class="vz-input-group">
                    <input class="vz-input" style="padding-inline-start:38px" placeholder="عنوان، اسلاگ ..." @bind="_search" @bind:event="oninput" @bind:after="ReloadFilters" />
                    <span style="position:absolute;inset-inline-start:13px;color:var(--text-3)"><Icon Name="search" Size="16" /></span>
                </div>
            </div>
            <div class="vz-field">
                <label class="vz-label">نوع محصول</label>
                <select class="vz-select" @bind="_typeFilter" @bind:after="ReloadFilters">
                    <option value="all">همه نوع‌ها</option>
                    <option value="1">گیفت کارت</option>
                    <option value="2">اکانت بازی</option>
                    <option value="3">سرویس بازی</option>
                    <option value="4">اشتراک</option>
                    <option value="99">سایر</option>
                </select>
            </div>
            <div class="vz-field">
                <label class="vz-label">دسته‌بندی</label>
                <select class="vz-select" @bind="_categoryFilter" @bind:after="ReloadFilters">
                    <option value="all">همه دسته‌ها</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Title</option>
                    }
                </select>
            </div>
            <div class="vz-field">
                <label class="vz-label">وضعیت</label>
                <select class="vz-select" @bind="_statusFilter" @bind:after="ReloadFilters">
                    <option value="all">همه وضعیت‌ها</option>
                    <option value="active">فعال</option>
                    <option value="inactive">غیرفعال</option>
                    <option value="featured">ویژه</option>
                </select>
            </div>
        </div>
    </div>

    @if (_selected.Count > 0)
    {
        <div class="vz-bulkbar">
            <span>@AUI.Number(_selected.Count) محصول انتخاب شده</span>
            <div style="margin-inline-start:auto;display:flex;gap:8px">
                <button class="vz-btn vz-btn--primary vz-btn--sm" @onclick="OpenBulkUpdate"><Icon Name="sliders-horizontal" Size="14" /> عملیات گروهی</button>
                <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="ExportSelected"><Icon Name="download" Size="14" /> خروجی انتخاب‌شده از صفحه جاری</button>
                <button class="vz-btn vz-btn--danger-soft vz-btn--sm" @onclick="AskBulkDelete"><Icon Name="trash" Size="14" /> حذف</button>
                <button class="vz-btn vz-btn--ghost vz-btn--sm" @onclick="ClearSelection">پاک‌کردن انتخاب</button>
            </div>
        </div>
    }

    <div class="vz-card">
        <div class="vz-card__body flush">
            @if (_items.Count == 0)
            {
                <EmptyState Title="محصولی یافت نشد" Text="با فیلترهای انتخابی محصولی پیدا نشد. فیلتر دیگری را امتحان کنید یا محصول جدیدی بسازید." Icon="box">
                    <Actions><a class="vz-btn vz-btn--primary vz-btn--sm" href="admin/products/create"><Icon Name="plus" Size="15" /> افزودن محصول</a></Actions>
                </EmptyState>
            }
            else
            {
                <div class="products-mobile-list">
                    @foreach (var p in Paged)
                    {
                        <article class="products-mobile-card">
                            <div class="products-mobile-card__head">
                                <span class="vz-check @(_selected.Contains(p.Id) ? "checked" : "")" @onclick="() => ToggleSelect(p.Id)" role="checkbox" aria-label="انتخاب محصول @p.Title">
                                    @if (_selected.Contains(p.Id)) { <Icon Name="check" Size="12" /> }
                                </span>
                                <a class="products-mobile-card__product" href="@($"admin/products/{p.Id}/details")">
                                    @if (!string.IsNullOrWhiteSpace(p.ThumbnailImagePath))
                                    { <img class="vz-thumb" src="@Media.Resolve(p.ThumbnailImagePath)" alt="@p.Title" /> }
                                    else
                                    { <span class="vz-thumb products-mobile-card__empty"><Icon Name="box" Size="18" /></span> }
                                    <span>
                                        <span class="products-mobile-card__title">@p.Title</span>
                                        <span class="vz-cell-sub">@p.CategoryTitle</span>
                                    </span>
                                </a>
                            </div>
                            <div class="products-mobile-card__facts">
                                <span><small>قیمت</small><b><MoneyDisplay Amount="p.BasePrice" Currency="p.CurrencyType" /></b></span>
                                <span><small>موجودی</small><b>@(p.HasVariants ? "واریانت‌دار" : p.AvailableStock > 0 ? AUI.Number(p.AvailableStock) : "ناموجود")</b></span>
                            </div>
                            <div class="products-mobile-card__badges">
                                <StatusBadge Text="@(p.IsActive ? "فعال" : "غیرفعال")" Intent="@(p.IsActive ? "success" : "muted")" />
                                @if (p.IsFeatured) { <StatusBadge Text="ویژه" Intent="warning" Dot="false" /> }
                                @if (p.DiscountPrice is > 0 && p.DiscountPrice < p.BasePrice) { <StatusBadge Text="تخفیف دارد" Intent="success" Dot="false" /> }
                            </div>
                            <div class="products-mobile-card__actions">
                                <a class="vz-btn vz-btn--outline vz-btn--sm" href="@($"admin/products/{p.Id}/details")"><Icon Name="eye" Size="15" /> جزئیات</a>
                                <a class="vz-btn vz-btn--primary vz-btn--sm" href="@($"admin/products/{p.Id}")"><Icon Name="edit" Size="15" /> ویرایش</a>
                            </div>
                        </article>
                    }
                </div>
                <div class="vz-table-wrap products-desktop-table">
                    <table class="vz-table">
                        <thead>
                            <tr>
                                <th style="width:40px">
                                    <span class="vz-check @(AllPageSelected ? "checked" : "")" @onclick="ToggleSelectAllPage" role="checkbox">
                                        @if (AllPageSelected) { <Icon Name="check" Size="12" /> }
                                    </span>
                                </th>
                                <th>محصول</th><th>نوع</th><th>برند</th><th>قیمت</th><th>تخفیف</th><th>موجودی</th><th>وضعیت</th><th class="col-actions">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Paged)
                            {
                                <tr>
                                    <td>
                                        <span class="vz-check @(_selected.Contains(p.Id) ? "checked" : "")" @onclick="() => ToggleSelect(p.Id)" role="checkbox">
                                            @if (_selected.Contains(p.Id)) { <Icon Name="check" Size="12" /> }
                                        </span>
                                    </td>
                                    <td>
                                        <div class="vz-cell-main">
                                            @if (!string.IsNullOrWhiteSpace(p.ThumbnailImagePath))
                                            {
                                                <img class="vz-thumb" src="@Media.Resolve(p.ThumbnailImagePath)" alt="@p.Title" />
                                            }
                                            else
                                            {
                                                <div class="vz-thumb" style="display:flex;align-items:center;justify-content:center;color:var(--text-3)"><Icon Name="box" Size="18" /></div>
                                            }
                                            <div>
                                                <a class="vz-cell-title" href="@($"admin/products/{p.Id}/details")" style="transition:color .12s" onmouseover="this.style.color='var(--admin-primary)'" onmouseout="this.style.color=''">@p.Title</a>
                                                <div class="vz-cell-sub">@p.CategoryTitle</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="vz-chip">@AUI.ProductType(p.ProductType)</span></td>
                                    <td>@(string.IsNullOrWhiteSpace(p.BrandTitle) ? "—" : p.BrandTitle)</td>
                                    <td><MoneyDisplay Amount="p.BasePrice" Currency="p.CurrencyType" /></td>
                                    <td>
                                        @if (p.DiscountPrice is > 0 && p.DiscountPrice < p.BasePrice)
                                        { <StatusBadge Text="@AUI.MoneyFa(p.DiscountPrice.Value, p.CurrencyType)" Intent="success" Dot="false" /> }
                                        else { <span class="vz-muted">—</span> }
                                    </td>
                                    <td class="num">
                                        @if (p.HasVariants) { <span class="vz-chip">واریانت‌دار</span> }
                                        else if (p.AvailableStock > 0) { @AUI.Number(p.AvailableStock) }
                                        else { <StatusBadge Text="ناموجود" Intent="danger" Dot="false" /> }
                                    </td>
                                    <td>
                                        <StatusBadge Text="@(p.IsActive ? "فعال" : "غیرفعال")" Intent="@(p.IsActive ? "success" : "muted")" />
                                        @if (p.IsFeatured) { <StatusBadge Text="ویژه" Intent="warning" Dot="false" /> }
                                    </td>
                                    <td class="col-actions">
                                        <AdminContextMenu>
                                                    <a class="vz-ctx__item" href="@($"admin/products/{p.Id}/details")"><Icon Name="eye" Size="15" /> مشاهده جزئیات</a>
                                                    <a class="vz-ctx__item" href="@($"admin/products/{p.Id}")"><Icon Name="edit" Size="15" /> ویرایش محصول</a>
                                                    <a class="vz-ctx__item" href="@($"admin/products/{p.Id}/images")"><Icon Name="image" Size="15" /> مدیریت تصاویر</a>
                                                    <button class="vz-ctx__item" @onclick="() => Duplicate(p)"><Icon Name="copy" Size="15" /> تکثیر محصول</button>
                                                    <div class="vz-ctx__divider"></div>
                                                    <button class="vz-ctx__item danger" @onclick="() => AskDelete(p)"><Icon Name="trash" Size="15" /> حذف محصول</button>
                                        </AdminContextMenu>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Page="_page" PageSize="_pageSize" TotalCount="_total" OnPageChanged="ChangePage" />
            }
        </div>
    </div>
}

<style>
    .products-mobile-list { display: none; }
    @@media (max-width: 760px) {
        .products-desktop-table { display: none; }
        .products-mobile-list { display: grid; gap: 9px; padding: 10px; }
        .products-mobile-card { display: grid; gap: 11px; padding: 13px; border: 1px solid var(--border); border-radius: var(--radius-md, 14px); background: var(--surface); }
        .products-mobile-card__head { display: flex; align-items: flex-start; gap: 10px; }
        .products-mobile-card__product { display: flex; flex: 1; min-width: 0; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
        .products-mobile-card__product > span:last-child { display: grid; min-width: 0; gap: 3px; }
        .products-mobile-card__title { overflow: hidden; color: var(--text); font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
        .products-mobile-card__empty { display: inline-flex; align-items: center; justify-content: center; color: var(--text-3); }
        .products-mobile-card__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
        .products-mobile-card__facts > span { display: grid; gap: 3px; padding: 8px 10px; border-radius: 9px; background: var(--surface-2); min-width: 0; }
        .products-mobile-card__facts small { color: var(--text-3); font-size: 11px; }
        .products-mobile-card__facts b { overflow: hidden; color: var(--text); font-size: 12px; text-overflow: ellipsis; white-space: nowrap; }
        .products-mobile-card__badges, .products-mobile-card__actions { display: flex; gap: 6px; flex-wrap: wrap; }
        .products-mobile-card__actions .vz-btn { flex: 1 1 120px; justify-content: center; }
    }
</style>

<ConfirmDialog Visible="_confirmDelete" Title="@_deleteTitle"
               Message="@_deleteMessage"
               ConfirmText="حذف" Busy="_deleting"
               OnConfirm="ConfirmDelete" OnCancel="CancelDelete" />

<Modal Visible="_bulkUpdateOpen" Title="عملیات گروهی محصولات" Icon="sliders-horizontal" Size="sm" OnClose="CloseBulkUpdate">
    <ChildContent>
        <p class="vz-card__sub" style="margin-top:0">این عملیات برای @AUI.Number(_selected.Count) محصول انتخاب‌شده اعمال می‌شود.</p>
        <div class="vz-field">
            <label class="vz-label" for="bulk-product-operation">عملیات</label>
            <select id="bulk-product-operation" class="vz-select" @bind="_bulkOperation" disabled="@_bulkUpdating">
                <optgroup label="قیمت">
                    <option value="increase-percent">افزایش درصدی قیمت</option>
                    <option value="decrease-percent">کاهش درصدی قیمت</option>
                    <option value="increase-amount">افزایش مبلغ ثابت</option>
                    <option value="decrease-amount">کاهش مبلغ ثابت</option>
                </optgroup>
                <optgroup label="موجودی">
                    <option value="mark-in-stock">موجود کردن</option>
                    <option value="mark-out-of-stock">ناموجود کردن</option>
                    <option value="mark-unlimited">نامحدود کردن</option>
                </optgroup>
            </select>
        </div>
        @if (IsPriceOperation)
        {
            <div class="vz-field">
                <label class="vz-label" for="bulk-product-value">@(IsPercentOperation ? "درصد تغییر" : "مبلغ تغییر")</label>
                <input id="bulk-product-value" class="vz-input" type="number" min="0.01" step="0.01" @bind="_bulkValue" disabled="@_bulkUpdating" />
                <div class="vz-hint">قیمت پایه و قیمت تمام واریانت‌های فعال، از جمله قیمت تخفیفِ معتبر، با همین مقدار تغییر می‌کند.</div>
            </div>
        }
        else if (_bulkOperation == "mark-in-stock")
        {
            <div class="vz-hint">فقط وضعیت «ناموجود اجباری» برداشته می‌شود؛ کالاهایی که موجودی واقعی یا کد هدیه ندارند، همچنان قابل خرید نخواهند بود.</div>
        }
        else if (_bulkOperation == "mark-out-of-stock")
        {
            <div class="vz-hint">فروش محصولات متوقف می‌شود، اما تعداد موجودی و کدهای هدیه آن‌ها دست‌نخورده می‌ماند.</div>
        }
        else
        {
            <div class="vz-hint">واریانت‌های معمولی نامحدود می‌شوند. محصولات تحویل فوری که به کد هدیه وابسته‌اند، نامحدود نمی‌شوند.</div>
        }
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="CloseBulkUpdate" disabled="@_bulkUpdating">انصراف</button>
        <button class="vz-btn vz-btn--primary" @onclick="ApplyBulkUpdate" disabled="@_bulkUpdating">
            @if (_bulkUpdating) { <span class="vz-spinner sm"></span> } else { <Icon Name="check" Size="15" /> }
            اعمال تغییرات
        </button>
    </Footer>
</Modal>

@code {
    // Storefront default ordering. Persisted through the ordinary Settings API; the storefront reads
    // it server-side, so a save takes effect on the next customer listing without any recycle.
    private string _storefrontSort = StorefrontProductSortModes.Default;
    private bool _savingStorefrontSort;
    private bool _storefrontSortSaved;

    private async Task LoadStorefrontSortAsync()
    {
        var result = await Api.GetAsync<SettingModel>($"admin/settings/{StorefrontProductSortModes.SettingKey}");
        // A database that has never seen the key is not an error: it simply means the default.
        _storefrontSort = StorefrontProductSortModes.Normalize(
            result is { IsSuccess: true, Data: not null } ? result.Data.Value : null);
    }

    private async Task SaveStorefrontSort()
    {
        _savingStorefrontSort = true;
        _storefrontSortSaved = false;
        var result = await Api.PostAsync<SettingModel>("admin/settings", new
        {
            Key = StorefrontProductSortModes.SettingKey,
            Value = StorefrontProductSortModes.Normalize(_storefrontSort),
            GroupName = "General",
            ValueType = "sortmode",
            Description = "ترتیب پیش‌فرض نمایش کالاها برای مشتریان در فروشگاه"
        });
        _savingStorefrontSort = false;
        if (result.IsSuccess)
        {
            _storefrontSortSaved = true;
            // The customer's sort menu reads the effective default from the cached public settings.
            Vitorize.Web.Services.UI.StoreBrandingService.Invalidate();
            Toasts.Success($"مرتب‌سازی پیش‌فرض فروشگاه روی «{StorefrontProductSortModes.Label(_storefrontSort)}» ذخیره شد.");
        }
        else Toasts.Error(result.Message);
    }

    private bool _loading = true;
    private string? _error;
    private List<AdminProductModel> _items = new();
    private List<AdminCategoryModel> _categories = new();
    private int _total;
    private CancellationTokenSource? _loadCancellation;
    private int _loadGeneration;

    private string _search = string.Empty;
    private string _typeFilter = "all";
    private string _categoryFilter = "all";
    private string _statusFilter = "all";
    private string _stockFilter = "all";

    private int _page = 1;
    private const int _pageSize = 10;

    private readonly HashSet<Guid> _selected = new();
    private Guid? _openMenuId;

    private bool _confirmDelete, _deleting, _bulkMode;
    private AdminProductModel? _target;
    private string _deleteTitle = "حذف محصول";
    private string _deleteMessage = string.Empty;
    private bool _bulkUpdateOpen, _bulkUpdating;
    private string _bulkOperation = "increase-percent";
    private decimal? _bulkValue;

    private record StockFilter(string Key, string Label, Func<List<AdminProductModel>, int> Count);

    private static readonly StockFilter[] StockFilters =
    {
        new("all", "همه", items => items.Count),
        new("instock", "موجود", items => items.Count(p => p.HasVariants || p.AvailableStock > 0)),
        new("out", "ناموجود", items => items.Count(p => !p.HasVariants && p.AvailableStock <= 0)),
        new("variants", "واریانت‌دار", items => items.Count(p => p.HasVariants)),
    };

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var q = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (q.TryGetValue("q", out var search)) _search = search.ToString();
        var categories = await Api.GetAsync<List<AdminCategoryModel>>("admin/categories");
        _categories = categories.Data ?? new();
        await LoadStorefrontSortAsync();
        await Load();
    }

    private async Task Load()
    {
        var previous = Interlocked.Exchange(ref _loadCancellation, new CancellationTokenSource());
        previous?.Cancel();
        previous?.Dispose();
        var cancellationToken = _loadCancellation!.Token;
        var generation = Interlocked.Increment(ref _loadGeneration);
        _loading = true; _error = null;
        var query = $"admin/products/paged?page={_page}&pageSize={_pageSize}";
        if (!string.IsNullOrWhiteSpace(_search)) query += $"&search={Uri.EscapeDataString(_search.Trim())}";
        if (byte.TryParse(_typeFilter, out var productType)) query += $"&productType={productType}";
        if (Guid.TryParse(_categoryFilter, out var categoryId)) query += $"&categoryId={categoryId}";
        if (_statusFilter == "active") query += "&isActive=true";
        else if (_statusFilter == "inactive") query += "&isActive=false";
        else if (_statusFilter == "featured") query += "&isFeatured=true";
        if (_stockFilter != "all") query += $"&stockState={_stockFilter}";
        try
        {
            var result = await Api.GetAsync<PagedResult<AdminProductModel>>(query, cancellationToken);
            if (generation != Volatile.Read(ref _loadGeneration)) return;
            if (result.IsSuccess && result.Data is not null) { _items = result.Data.Items.ToList(); _total = result.Data.TotalCount; }
            else _error = result.Message;
            _selected.Clear();
            CloseMenu();
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // A newer request owns the screen state.
        }
        finally
        {
            if (generation == Volatile.Read(ref _loadGeneration)) _loading = false;
        }
    }

    private async Task ReloadFilters() { _page = 1; await Load(); }
    private async Task SelectStock(string key) { _stockFilter = key; await ReloadFilters(); }
    private async Task ChangePage(int page) { _page = page; CloseMenu(); await Load(); }
    private List<AdminProductModel> Paged => _items;

    // ----- selection -----
    private bool AllPageSelected => Paged.Count > 0 && Paged.All(p => _selected.Contains(p.Id));

    private void ToggleSelect(Guid id)
    {
        if (!_selected.Add(id)) _selected.Remove(id);
    }

    private void ToggleSelectAllPage()
    {
        if (AllPageSelected) { foreach (var p in Paged) _selected.Remove(p.Id); }
        else { foreach (var p in Paged) _selected.Add(p.Id); }
    }

    private void ClearSelection() => _selected.Clear();

    private bool IsPriceOperation => _bulkOperation is "increase-percent" or "decrease-percent" or "increase-amount" or "decrease-amount";
    private bool IsPercentOperation => _bulkOperation.EndsWith("percent", StringComparison.Ordinal);

    private void OpenBulkUpdate()
    {
        if (_selected.Count == 0) return;
        _bulkOperation = "increase-percent";
        _bulkValue = null;
        _bulkUpdateOpen = true;
    }

    private void CloseBulkUpdate()
    {
        if (!_bulkUpdating) _bulkUpdateOpen = false;
    }

    private async Task ApplyBulkUpdate()
    {
        if (IsPriceOperation && (!_bulkValue.HasValue || _bulkValue.Value <= 0))
        {
            Toasts.Warning("مقدار تغییر قیمت را وارد کنید.");
            return;
        }

        _bulkUpdating = true;
        var result = await Api.PostAsync<BulkProductUpdateResultModel>("admin/products/bulk-update", new BulkProductUpdateRequestModel
        {
            Ids = _selected.ToList(),
            Operation = _bulkOperation,
            Value = IsPriceOperation ? _bulkValue : null
        });
        _bulkUpdating = false;

        if (!result.IsSuccess || result.Data is null)
        {
            Toasts.Error(result.Message);
            return;
        }

        var message = $"عملیات برای {AUI.Number(result.Data.UpdatedProductCount)} محصول انجام شد.";
        if (result.Data.SkippedGiftCodeProductCount > 0)
            message += $" {AUI.Number(result.Data.SkippedGiftCodeProductCount)} محصول کد هدیه نامحدود نشد.";
        Toasts.Success(message);
        _bulkUpdateOpen = false;
        await Load();
    }

    // ----- context menu -----
    private void ToggleMenu(Guid id) => _openMenuId = _openMenuId == id ? null : id;
    private void CloseMenu() => _openMenuId = null;

    // ----- duplicate -----
    private async Task Duplicate(AdminProductModel p)
    {
        CloseMenu();
        var suffix = DateTime.Now.ToString("HHmmss");
        var payload = new CreateProductRequestModel
        {
            CategoryId = p.CategoryId, BrandId = p.BrandId,
            Title = $"{p.Title} (کپی)", Slug = $"{p.Slug}-copy-{suffix}",
            ShortDescription = p.ShortDescription, FullDescription = p.FullDescription, RedirectUrl = p.RedirectUrl,
            ThumbnailImagePath = p.ThumbnailImagePath, ProductType = p.ProductType, DeliveryType = p.DeliveryType,
            CurrencyType = p.CurrencyType, BasePrice = p.BasePrice, DiscountPrice = p.DiscountPrice,
            RequiresSupportMessage = p.RequiresSupportMessage,
            MinOrderQuantity = p.MinOrderQuantity, MaxOrderQuantity = p.MaxOrderQuantity,
            IsFeatured = false, IsActive = false, SeoTitle = p.SeoTitle,
            SeoDescription = p.SeoDescription, SortOrder = p.SortOrder
        };
        var r = await Api.PostAsync<AdminProductModel>("admin/products", payload);
        if (r.IsSuccess && r.Data is not null)
        {
            Toasts.Success("نسخه جدید محصول ساخته شد. برای ویرایش هدایت می‌شوید.");
            Nav.NavigateTo($"admin/products/{r.Data.Id}");
        }
        else Toasts.Error(r.Message);
    }

    // ----- export -----
    private async Task ExportSelected()
    {
        var validated = await Api.PostAsync<List<AdminProductModel>>("admin/products/export-selection", new { Ids = _selected.ToList() });
        if (!validated.IsSuccess || validated.Data is null) { Toasts.Error(validated.Message); return; }
        var rows = validated.Data;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Title,Slug,Category,Brand,Type,BasePrice,DiscountPrice,Stock,Active,Featured");
        foreach (var p in rows)
        {
            sb.AppendLine(string.Join(",", new[]
            {
                Csv(p.Title), Csv(p.Slug), Csv(p.CategoryTitle), Csv(p.BrandTitle ?? ""),
                Csv(AUI.ProductType(p.ProductType)), p.BasePrice.ToString(System.Globalization.CultureInfo.InvariantCulture),
                (p.DiscountPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture),
                (p.HasVariants ? "variants" : p.AvailableStock.ToString()),
                p.IsActive ? "1" : "0", p.IsFeatured ? "1" : "0"
            }));
        }
        await JS.InvokeVoidAsync("vzAdmin.downloadText", $"products-{DateTime.Now:yyyyMMdd-HHmm}.csv", sb.ToString(), "text/csv");
        Toasts.Success($"{AUI.Number(rows.Count)} محصول در فایل CSV ذخیره شد.");
    }

    private static string Csv(string value)
    {
        return AdminCsv.Field(value);
    }

    public void Dispose()
    {
        var cancellation = Interlocked.Exchange(ref _loadCancellation, null);
        cancellation?.Cancel();
        cancellation?.Dispose();
    }

    // ----- delete (single + bulk) -----
    private void AskDelete(AdminProductModel p)
    {
        CloseMenu();
        _bulkMode = false; _target = p;
        _deleteTitle = "حذف محصول";
        _deleteMessage = $"آیا از حذف محصول «{p.Title}» مطمئن هستید؟ این عملیات قابل بازگشت نیست.";
        _confirmDelete = true;
    }

    private void AskBulkDelete()
    {
        _bulkMode = true; _target = null;
        _deleteTitle = "حذف گروهی محصولات";
        _deleteMessage = $"آیا از حذف {AUI.Number(_selected.Count)} محصول انتخاب‌شده مطمئن هستید؟ این عملیات قابل بازگشت نیست.";
        _confirmDelete = true;
    }

    private void CancelDelete()
    {
        if (_deleting) return;
        _confirmDelete = false; _target = null;
    }

    private async Task ConfirmDelete()
    {
        _deleting = true;
        if (_bulkMode)
        {
            int ok = 0, fail = 0;
            foreach (var id in _selected.ToList())
            {
                var r = await Api.DeleteAsync($"admin/products/{id}");
                if (r.IsSuccess) ok++; else fail++;
            }
            _deleting = false; _confirmDelete = false;
            if (ok > 0) Toasts.Success($"{AUI.Number(ok)} محصول حذف شد.");
            if (fail > 0) Toasts.Error($"{AUI.Number(fail)} محصول حذف نشد.");
            await Load();
        }
        else if (_target is not null)
        {
            var result = await Api.DeleteAsync($"admin/products/{_target.Id}");
            _deleting = false; _confirmDelete = false;
            if (result.IsSuccess) { Toasts.Success("محصول حذف شد."); await Load(); }
            else Toasts.Error(result.Message);
        }
        else { _deleting = false; _confirmDelete = false; }
    }
}
