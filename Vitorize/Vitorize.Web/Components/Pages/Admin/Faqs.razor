@page "/admin/faqs"
@inject ApiClient Api
@inject ToastService Toasts
@using Vitorize.Web.Models.Admin.Content
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageHeader Title="سوالات متداول" Subtitle="پرسش‌ها و پاسخ‌های نمایش‌داده‌شده در فروشگاه"
            Icon="message" Breadcrumbs="@(new(){ ("سوالات متداول", null) })">
    <Actions>
        <button class="vz-btn vz-btn--outline" @onclick="Load"><Icon Name="refresh" Size="17" /> بروزرسانی</button>
        <button class="vz-btn vz-btn--primary" data-testid="faq-create" @onclick="OpenCreate"><Icon Name="plus" Size="17" /> پرسش جدید</button>
    </Actions>
</PageHeader>

<div class="vz-card">
    <div class="vz-card__body flush">
        @if (_loading) { <LoadingState /> }
        else if (_error is not null) { <ErrorState Message="@_error" OnRetry="Load" /> }
        else if (_items.Count == 0)
        {
            <EmptyState Title="پرسشی ثبت نشده است" Icon="message">
                <Actions><button class="vz-btn vz-btn--primary vz-btn--sm" @onclick="OpenCreate"><Icon Name="plus" Size="15" /> افزودن پرسش</button></Actions>
            </EmptyState>
        }
        else
        {
            <div class="vz-table-wrap">
                <table class="vz-table">
                    <thead>
                        <tr><th>پرسش</th><th>ترتیب</th><th>وضعیت</th><th class="col-actions">عملیات</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in _items)
                        {
                            <tr>
                                <td>
                                    <div class="vz-cell-title">@f.Question</div>
                                    @* Answers are plain text everywhere, including this preview. *@
                                    <div class="vz-cell-sub" style="max-width:520px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@f.Answer</div>
                                </td>
                                <td class="num">@AUI.Number(f.SortOrder)</td>
                                <td><StatusBadge Text="@(f.IsActive ? "فعال" : "غیرفعال")" Intent="@(f.IsActive ? "success" : "muted")" /></td>
                                <td class="col-actions">
                                    <button class="vz-iconaction" title="ویرایش" @onclick="() => OpenEdit(f)"><Icon Name="edit" Size="16" /></button>
                                    <button class="vz-iconaction danger" title="حذف" @onclick="() => AskDelete(f)"><Icon Name="trash" Size="16" /></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<Modal Visible="_formOpen" Title="@(_model.Id is null ? "افزودن پرسش" : "ویرایش پرسش")"
       Icon="message" Size="lg" OnClose="CloseForm">
    <ChildContent>
        <EditForm Model="_model" OnValidSubmit="Save" id="faq-form">
            <DataAnnotationsValidator />
            <div class="vz-form-grid">
                <div class="vz-field span-2">
                    <label class="vz-label">پرسش <span class="req">*</span></label>
                    <InputText class="vz-input" data-testid="faq-question" @bind-Value="_model.Question" />
                    <ValidationMessage For="() => _model.Question" class="vz-val-msg" />
                </div>
                <div class="vz-field span-2">
                    <label class="vz-label">پاسخ <span class="req">*</span></label>
                    @* Plain text by design: no rich-text editor and no HTML rendering. *@
                    <InputTextArea class="vz-textarea" rows="5" data-testid="faq-answer" @bind-Value="_model.Answer" />
                    <div class="vz-hint">پاسخ به‌صورت متن ساده ذخیره و نمایش داده می‌شود.</div>
                    <ValidationMessage For="() => _model.Answer" class="vz-val-msg" />
                </div>
                <div class="vz-field">
                    <label class="vz-label">ترتیب نمایش</label>
                    <InputNumber class="vz-input" data-testid="faq-sort" @bind-Value="_model.SortOrder" />
                    <ValidationMessage For="() => _model.SortOrder" class="vz-val-msg" />
                </div>
                <div class="vz-field">
                    <label class="vz-switch">
                        <InputCheckbox @bind-Value="_model.IsActive" data-testid="faq-active" />
                        <span class="vz-switch__track"></span>
                        <span class="vz-switch__label">نمایش در فروشگاه</span>
                    </label>
                </div>
            </div>
        </EditForm>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="CloseForm" disabled="@_saving">انصراف</button>
        <button class="vz-btn vz-btn--primary" type="submit" form="faq-form" data-testid="faq-save" disabled="@_saving">
            @if (_saving) { <span class="vz-spinner sm"></span> } else { <Icon Name="save" Size="16" /> <span>ذخیره</span> }
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_confirmDelete" Title="حذف پرسش"
               Message="@($"آیا از حذف پرسش «{_target?.Question}» مطمئن هستید؟")"
               ConfirmText="حذف" Busy="_deleting"
               OnConfirm="ConfirmDelete" OnCancel="() => _confirmDelete = false" />

@code {
    private bool _loading = true;
    private string? _error;
    private List<AdminFaqModel> _items = new();

    private bool _formOpen, _saving;
    private AdminFaqInputModel _model = new();

    private bool _confirmDelete, _deleting;
    private AdminFaqModel? _target;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true; _error = null;
        var result = await Api.GetAsync<List<AdminFaqModel>>("admin/faqs");
        if (result.IsSuccess && result.Data is not null) _items = result.Data;
        else _error = result.Message;
        _loading = false;
    }

    private void OpenCreate()
    {
        _model = new AdminFaqInputModel { IsActive = true, SortOrder = (_items.Count + 1) * 10 };
        _formOpen = true;
    }

    private void OpenEdit(AdminFaqModel f)
    {
        _model = new AdminFaqInputModel
        {
            Id = f.Id, Question = f.Question, Answer = f.Answer,
            SortOrder = f.SortOrder, IsActive = f.IsActive
        };
        _formOpen = true;
    }

    private void CloseForm() => _formOpen = false;

    private async Task Save()
    {
        _saving = true;
        var payload = new { _model.Question, _model.Answer, _model.SortOrder, _model.IsActive };

        var result = _model.Id is null
            ? await Api.PostAsync<AdminFaqModel>("admin/faqs", payload)
            : await Api.PutAsync<AdminFaqModel>($"admin/faqs/{_model.Id}", payload);

        _saving = false;
        if (result.IsSuccess)
        {
            Toasts.Success(result.Message);
            _formOpen = false;
            await Load();
        }
        else Toasts.Error(result.Message);
    }

    private void AskDelete(AdminFaqModel f) { _target = f; _confirmDelete = true; }

    private async Task ConfirmDelete()
    {
        if (_target is null) return;
        _deleting = true;
        var result = await Api.DeleteAsync($"admin/faqs/{_target.Id}");
        _deleting = false; _confirmDelete = false;
        if (result.IsSuccess) { Toasts.Success(result.Message); await Load(); }
        else Toasts.Error(result.Message);
    }
}
