    private async Task ChangePage(int page) { _page = page; await Load(); }

    private static List<AdminOrderItemModel> Items(AdminOrderModel o) => o.Items.Count > 0 ? o.Items : o.OrderItems;
    private static List<AdminOrderDeliveryModel> ManualDeliveries(AdminOrderItemModel item) =>
