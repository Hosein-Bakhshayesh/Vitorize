        if (!await JS.InvokeAsync<bool>("confirm", "پیامک یادآوری احراز هویت برای این سفارش ارسال شود؟")) return;

        _kycSmsSending = true;
        var result = await Api.PostAsync<object>("admin/notifications/kyc-reminder/order", new { OrderId = _kycSmsOrder.Id, Message = _kycSmsMessage });
        _kycSmsSending = false;
        if (!result.IsSuccess)
        {
            Toasts.Error(result.Message);
            return;
        }

        Toasts.Success("یادآوری احراز هویت و پیامک در صف ارسال قرار گرفت.");
