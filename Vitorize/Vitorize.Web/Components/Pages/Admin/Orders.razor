    private static List<AdminOrderItemModel> Items(AdminOrderModel o) => o.Items.Count > 0 ? o.Items : o.OrderItems;

    private string DeadlineInput(AdminOrderItemModel item)
    {
        if (_kycDeadlineInputs.TryGetValue(item.Id, out var input)) return input;
        var value = item.Kyc?.CustomerActionDeadlineAt ?? DateTime.UtcNow.AddDays(1);
        return value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
    }

    private void SetDeadlineInput(Guid itemId, string? value) => _kycDeadlineInputs[itemId] = value ?? string.Empty;

    private bool TryReadDeadline(AdminOrderItemModel item, out DateTime deadlineAt)
    {
        deadlineAt = default;
        if (!DateTime.TryParse(DeadlineInput(item), CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var local))
        {
            Toasts.Error("مهلت معتبر وارد کنید.");
            return false;
        }

        deadlineAt = DateTime.SpecifyKind(local, DateTimeKind.Local).ToUniversalTime();
        if (deadlineAt <= DateTime.UtcNow)
        {
            Toasts.Error("مهلت باید در آینده باشد.");
            return false;
        }
        return true;
    }

    private async Task ExtendKycDeadline(Guid orderId, AdminOrderItemModel item)
    {
        if (!TryReadDeadline(item, out var deadlineAt)) return;
        var result = await Api.PutAsync<object>($"admin/verifications/order-items/{item.Id}/deadline", new { NewDeadlineAt = deadlineAt });
        if (!result.IsSuccess) { Toasts.Error(result.Message); return; }
        Toasts.Success("مهلت اقدام به‌روزرسانی شد.");
        await RefreshDetail(orderId);
    }

    private async Task ReopenKycDeadline(Guid orderId, AdminOrderItemModel item)
    {
        if (!TryReadDeadline(item, out var deadlineAt)) return;
        var result = await Api.PostAsync<object>($"admin/verifications/order-items/{item.Id}/reopen", new { NewDeadlineAt = deadlineAt });
        if (!result.IsSuccess) { Toasts.Error(result.Message); return; }
        Toasts.Success("فرصت اقدام مشتری بازگشایی شد.");
        await RefreshDetail(orderId);
    }

    private async Task FinalRejectKyc(AdminOrderItemModel item)
    {
        var result = await Api.PostAsync<object>($"admin/verifications/order-items/{item.Id}/final-reject", new { });
        if (!result.IsSuccess) { Toasts.Error(result.Message); return; }
        Toasts.Success("احراز هویت این آیتم به‌صورت نهایی رد شد.");
        if (_detail is not null) await RefreshDetail(_detail.Id);
    }

    private async Task ResolveKycFinance(AdminOrderItemModel item, bool external)
    {
        var reason = await JS.InvokeAsync<string?>("prompt", "دلیل تصمیم مالی را وارد کنید:");
        if (string.IsNullOrWhiteSpace(reason)) return;
        string? reference = null;
        if (external)
        {
            reference = await JS.InvokeAsync<string?>("prompt", "شماره پیگیری بازپرداخت خارجی را وارد کنید:");
            if (string.IsNullOrWhiteSpace(reference)) return;
        }
        var path = external ? $"admin/kyc-finance/order-items/{item.Id}/external-refund" : $"admin/kyc-finance/order-items/{item.Id}/no-refund";
        var result = await Api.PostAsync<object>(path, new { Reason = reason, ExternalReference = reference });
        if (!result.IsSuccess) { Toasts.Error(result.Message); return; }
        Toasts.Success(external ? "بازپرداخت خارجی ثبت شد." : "تصمیم مالی ثبت شد.");
        if (_detail is not null) await RefreshDetail(_detail.Id);
    }

    private async Task RefreshDetail(Guid orderId)
    {
        var result = await Api.GetAsync<AdminOrderModel>($"admin/orders/{orderId}");
        if (result.IsSuccess && result.Data is not null)
        {
            _detail = result.Data;
            await BuildTimeline(_detail);
        }
        else Toasts.Error(result.Message);
    }

    private async Task RevealInput(Guid orderId, AdminOrderInputValueModel value)
    {
        if (!value.Id.HasValue) return;
        var result = await Api.PostAsync<string>($"admin/orders/{orderId}/input-values/{value.Id}/reveal");
        if (result.IsSuccess) { value.Value = result.Data; value.IsMasked = false; Toasts.Success("مقدار حساس نمایش داده شد و رویداد امنیتی ثبت گردید."); }
        else Toasts.Error(result.Message);
    }
    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "؟" : name.Trim()[..1];

    // ----- selection -----
    private List<AdminOrderModel> SelectedItems => _items.Where(o => _selected.Contains(o.Id)).ToList();
    private List<AdminOrderModel> EligibleSelected => SelectedItems.Where(o => CanAct(o.Status)).ToList();
