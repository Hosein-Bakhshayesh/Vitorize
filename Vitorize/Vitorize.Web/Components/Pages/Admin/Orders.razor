@page "/admin/orders"
@inject ApiClient Api
@inject ToastService Toasts
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Vitorize.Web.Helpers
@using Vitorize.Application.Common
@using Vitorize.Shared.Enums
@using System.Globalization
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageHeader Title="مدیریت سفارش‌ها" Subtitle="سفارش‌های مشتریان را پیگیری و مدیریت کنید"
            Icon="cart" Breadcrumbs="@(new(){ ("سفارش‌ها", null) })">
    <Actions>
        <button class="vz-btn vz-btn--ghost vz-btn--icon" title="خروجی CSV صفحه جاری" @onclick="() => Export(Filtered)"><Icon Name="download" Size="17" /></button>
        <button class="vz-btn vz-btn--outline" @onclick="Load"><Icon Name="refresh" Size="17" /> بروزرسانی</button>
    </Actions>
</PageHeader>

@if (_loading) { <LoadingState /> }
else if (_error is not null) { <ErrorState Message="@_error" OnRetry="Load" /> }
else
{
    <div class="vz-stats">
        <StatCard Label="کل سفارش‌ها" Value="@AUI.Number(_items.Count)" Icon="cart" Accent="teal" />
        <StatCard Label="در انتظار پرداخت" Value="@AUI.Number(CountStatus((byte)OrderStatus.PendingPayment))" Icon="clock" Accent="orange" />
        <StatCard Label="در حال پردازش" Value="@AUI.Number(CountStatus((byte)OrderStatus.Processing))" Icon="refresh" Accent="blue" />
        <StatCard Label="تکمیل شده" Value="@AUI.Number(CountStatus((byte)OrderStatus.Completed))" Icon="check-circle" Accent="green" />
    </div>

    <div class="vz-pills" style="margin-bottom:16px">
        @foreach (var f in StatusChips)
        {
            <button class="vz-pill @(_statusFilter == f.Key ? "active" : "")" @onclick="() => SetStatusChip(f.Key)">
                @f.Label <span class="vz-pill__count">@AUI.Number(f.Key == "all" ? _items.Count : CountStatus(byte.Parse(f.Key)))</span>
            </button>
        }
    </div>

    <div class="vz-filterbar">
        <div class="vz-filterbar__row">
            <div class="vz-field">
                <label class="vz-label">جستجو</label>
                <input id="order-search" class="vz-input" placeholder="شماره سفارش، نام یا موبایل ... ( / )" @bind="_search" @bind:event="oninput" @bind:after="ResetPage" />
            </div>
            <div class="vz-field">
                <label class="vz-label">وضعیت پرداخت</label>
                <select class="vz-select" @bind="_payFilter" @bind:after="ResetPage">
                    <option value="all">همه</option>
                    <option value="1">در انتظار</option>
                    <option value="2">پرداخت شده</option>
                    <option value="3">ناموفق</option>
                    <option value="4">لغو شده</option>
                    <option value="5">بازگشت وجه</option>
                </select>
            </div>
            <div class="vz-field">
                <label class="vz-label">بازه تاریخ</label>
                <PersianDateRangePicker From="_from" FromChanged="async v => { _from = v; await ResetPage(); }" To="_to" ToChanged="async v => { _to = v; await ResetPage(); }" />
            </div>
        </div>
    </div>

    @if (_selected.Count > 0)
    {
        <div class="vz-bulkbar">
            <span>@AUI.Number(_selected.Count) سفارش انتخاب شد</span>
            <div style="flex:1"></div>
            <button class="vz-btn vz-btn--danger-soft vz-btn--sm" @onclick="OpenBulkCancel" disabled="@_bulkBusy"><Icon Name="x-circle" Size="14" /> لغو</button>
            <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="ExportSelected"><Icon Name="download" Size="14" /> خروجی انتخاب‌شده از صفحه جاری</button>
            <button class="vz-btn vz-btn--ghost vz-btn--sm" @onclick="ClearSelection">پاک‌کردن</button>
        </div>
    }

    <div class="vz-card">
        <div class="vz-card__body flush">
            @if (Filtered.Count == 0)
            {
                <EmptyState Title="سفارشی یافت نشد" Text="با فیلترهای فعلی سفارشی وجود ندارد." Icon="cart" />
            }
            else
            {
                <div class="vz-table-wrap">
                    <table class="vz-table">
                        <thead>
                            <tr>
                                <th style="width:40px">
                                    <span class="vz-check @(AllPageSelected ? "checked" : "")" @onclick="ToggleSelectPage">
                                        @if (AllPageSelected) { <Icon Name="check" Size="12" /> }
                                    </span>
                                </th>
                                <th>شماره سفارش</th><th>مشتری</th><th>مبلغ نهایی</th><th>پرداخت</th><th>وضعیت</th><th>تاریخ</th><th class="col-actions">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Paged)
                            {
                                <tr class="@(_selected.Contains(o.Id) ? "vz-row-selected" : "")">
                                    <td>
                                        <span class="vz-check @(_selected.Contains(o.Id) ? "checked" : "")" @onclick="() => ToggleSelect(o.Id)">
                                            @if (_selected.Contains(o.Id)) { <Icon Name="check" Size="12" /> }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="vz-copy vz-chip vz-mono" title="کپی شماره سفارش" @onclick="() => Copy(o.OrderNumber)">
                                            @o.OrderNumber <span class="vz-copy__icon"><Icon Name="copy" Size="12" /></span>
                                        </span>
                                    </td>
                                    <td>
                                        <div class="vz-cell-main">
                                            <span class="vz-avatar-sm">@Initial(o.UserFullName)</span>
                                            <div>
                                                <div class="vz-cell-title">@o.UserFullName</div>
                                                <div class="vz-cell-sub vz-mono">@o.UserMobile</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><MoneyDisplay Amount="o.FinalAmount" /></td>
                                    <td><StatusBadge Text="@AUI.PaymentStatus(o.PaymentStatus)" Intent="@AUI.StatusBadgeIntent(o.PaymentStatus, "payment")" /></td>
                                    <td><StatusBadge Text="@AUI.OrderStatus(o.Status)" Intent="@AUI.StatusBadgeIntent(o.Status, "order")" /></td>
                                    <td><PersianDateDisplay Value="o.CreatedAt" WithTime="true" /></td>
                                    <td class="col-actions">
                                        <AdminContextMenu>
                                                    <button class="vz-ctx__item" @onclick="() => OpenDetails(o.Id)"><Icon Name="eye" Size="15" /> مشاهده جزئیات</button>
                                                    @if (CanAct(o.Status))
                                                    {
                                                        <button class="vz-ctx__item" @onclick="() => QuickCancel(o)"><Icon Name="x-circle" Size="15" /> لغو سفارش</button>
                                                    }
                                                    <div class="vz-ctx__divider"></div>
                                                    <button class="vz-ctx__item" @onclick="() => Copy(o.OrderNumber)"><Icon Name="copy" Size="15" /> کپی شماره</button>
                                        </AdminContextMenu>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Pagination Page="_page" PageSize="_pageSize" TotalCount="_total" OnPageChanged="ChangePage" />
            }
        </div>
    </div>
}

@* ---------- detail ---------- *@
<Modal Visible="_detailOpen" Title="@($"جزئیات سفارش {_detail?.OrderNumber}")" Icon="cart" Size="lg" OnClose="() => _detailOpen = false">
    <ChildContent>
        @if (_loadingDetail) { <LoadingState /> }
        else if (_detail is not null)
        {
            var d = _detail;
            <div class="vz-stack">
                <div class="vz-card" style="box-shadow:none">
                    <div class="vz-card__body">
                        <Stepper Steps="BuildSteps(d)" />
                    </div>
                </div>

                <div class="vz-row" style="gap:14px;flex-wrap:wrap">
                    <div style="flex:1;min-width:200px">
                        <dl class="vz-deflist">
                            <dt>مشتری</dt><dd>@d.UserFullName</dd>
                            <dt>موبایل</dt><dd class="vz-mono">@d.UserMobile</dd>
                            <dt>وضعیت سفارش</dt><dd><StatusBadge Text="@AUI.OrderStatus(d.Status)" Intent="@AUI.StatusBadgeIntent(d.Status, "order")" /></dd>
                            <dt>وضعیت پرداخت</dt><dd><StatusBadge Text="@AUI.PaymentStatus(d.PaymentStatus)" Intent="@AUI.StatusBadgeIntent(d.PaymentStatus, "payment")" /></dd>
                        </dl>
                    </div>
                    <div style="flex:1;min-width:200px">
                        <dl class="vz-deflist">
                            <dt>جمع کل</dt><dd><MoneyDisplay Amount="d.SubtotalAmount" /></dd>
                            <dt>تخفیف</dt><dd><MoneyDisplay Amount="d.DiscountAmount" /></dd>
                            <dt>مبلغ نهایی</dt><dd style="font-weight:800"><MoneyDisplay Amount="d.FinalAmount" /></dd>
                        </dl>
                    </div>
                </div>

                <div id="completion-reason" class="vz-alert @(CanComplete(d) ? "vz-alert--success" : "vz-alert--warning")">
                    <Icon Name="package-check" Size="16" />
                    <span><b>وضعیت تحویل:</b> @FulfillmentSummary(d)</span>
                    @if (!CanComplete(d)) { <span style="margin-inline-start:6px">@CompletionReason(d)</span> }
                </div>

                <div>
                    <div class="vz-card__title" style="margin-bottom:10px">اقلام سفارش</div>
                    <div class="vz-table-wrap">
                        <table class="vz-table">
                            <thead><tr><th>محصول</th><th>تعداد</th><th>قیمت واحد</th><th>جمع</th><th>نوع تحویل</th><th>تحویل</th></tr></thead>
                            <tbody>
                                @foreach (var item in Items(d))
                                {
                                    <tr>
                                        <td class="vz-cell-title">
                                            @item.ProductTitle @(string.IsNullOrWhiteSpace(item.VariantTitle) ? "" : $"— {item.VariantTitle}")
                                            @if (item.InputValues.Count > 0)
                                            {
                                                <dl class="vz-order-inputs">
                                                    @foreach (var value in item.InputValues)
                                                    {
                                                        <div><dt>@value.FieldLabel</dt><dd class="@(value.IsSensitive && value.IsMasked ? "masked" : null)">@value.Value</dd>
                                                        @if (value.IsSensitive && value.IsMasked && value.Id.HasValue) { <button class="vz-btn vz-btn--ghost vz-btn--sm" @onclick="() => RevealInput(d.Id, value)"><Icon Name="eye" Size="12" /> نمایش با ثبت گزارش</button> }</div>
                                                    }
                                                </dl>
                                            }
                                        </td>
                                        <td class="num">@AUI.Number(item.Quantity)</td>
                                        <td><MoneyDisplay Amount="item.UnitPrice" /></td>
                                        <td><MoneyDisplay Amount="item.TotalPrice" /></td>
                                        <td>@AUI.DeliveryType(item.DeliveryType)</td>
                                        <td>
                                            <StatusBadge Text="@AUI.DeliveryStatus(item.DeliveryStatus)" Intent="muted" Dot="false" />
                                            @if (item.Kyc is not null)
                                            {
                                                <div class="vz-muted" style="font-size:12px;margin-top:6px">
                                                    <b>احراز هویت:</b> @item.Kyc.LifecycleLabel
                                                    @if (!string.IsNullOrWhiteSpace(item.Kyc.PolicyTitle)) { <span> — @item.Kyc.PolicyTitle</span> }
                                                    <div>انسداد تحویل: @(item.Kyc.BlocksFulfillment ? "بله" : "خیر")</div>
                                                    @if (item.Kyc.ThresholdAmount.HasValue) { <div>آستانه: @AUI.MoneyFa(item.Kyc.ThresholdAmount.Value) · مبلغ ارزیابی: @AUI.MoneyFa(item.Kyc.EvaluatedAmount)</div> }
                                                    @if (item.Kyc.CustomerActionDeadlineAt.HasValue) { <div>مهلت اقدام: @item.Kyc.CustomerActionDeadlineAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm") @(item.Kyc.IsCustomerActionOverdue ? "(منقضی)" : "")</div> }
                                                    @if (item.Kyc.LifecycleStatus == (byte)OrderItemKycStatus.FinalRejected)
                                                    {
                                                        <div>وضعیت مالی: @(item.Kyc.FinanceResolutionStatus switch { 1 => "در انتظار بررسی مالی", 2 => "بازپرداخت خارجی ثبت شده", 3 => "بدون بازپرداخت", _ => "در انتظار ایجاد پرونده مالی" })</div>
                                                        @if (item.Kyc.FinanceResolutionStatus == 1)
                                                        {
                                                            <div style="display:flex;gap:6px;align-items:center;margin-top:7px;flex-wrap:wrap">
                                                                <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="() => ResolveKycFinance(item, true)">ثبت بازپرداخت خارجی</button>
                                                                <button class="vz-btn vz-btn--ghost vz-btn--sm" @onclick="() => ResolveKycFinance(item, false)">ثبت بدون بازپرداخت</button>
                                                            </div>
                                                        }
                                                    }
                                                    @if (item.Kyc.LifecycleStatus is (byte)OrderItemKycStatus.AwaitingSubmission or (byte)OrderItemKycStatus.Rejected)
                                                    {
                                                        <div style="display:flex;gap:6px;align-items:center;margin-top:7px;flex-wrap:wrap">
                                                            <input class="vz-input" style="max-width:200px" type="datetime-local" value="@DeadlineInput(item)" @oninput="args => SetDeadlineInput(item.Id, args.Value?.ToString())" aria-label="مهلت اقدام مشتری" />
                                                            <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="() => ExtendKycDeadline(d.Id, item)">تمدید مهلت</button>
                                                        </div>
                                                    }
                                                    else if (item.Kyc.LifecycleStatus == (byte)OrderItemKycStatus.Expired)
                                                    {
                                                        <div style="display:flex;gap:6px;align-items:center;margin-top:7px;flex-wrap:wrap">
                                                            <input class="vz-input" style="max-width:200px" type="datetime-local" value="@DeadlineInput(item)" @oninput="args => SetDeadlineInput(item.Id, args.Value?.ToString())" aria-label="مهلت جدید اقدام مشتری" />
                                                            <button class="vz-btn vz-btn--outline vz-btn--sm" @onclick="() => ReopenKycDeadline(d.Id, item)">بازگشایی</button>
                                                            <button class="vz-btn vz-btn--danger-soft vz-btn--sm" @onclick="() => FinalRejectKyc(item)">رد نهایی</button>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            @if (CanFulfill(d, item))
                                            {
                                                <button class="vz-btn vz-btn--primary vz-btn--sm vz-manual-delivery" style="margin-top:8px"
                                                        @onclick="() => OpenManualDelivery(d, item)">
                                                    <Icon Name="package-check" Size="13" /> ثبت تحویل
                                                </button>
                                            }
                                            else if (item.DeliveryStatus != (byte)DeliveryStatus.Delivered)
                                            {
                                                <div class="vz-muted" style="font-size:12px;margin-top:6px">@FulfillmentGuidance(item)</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div>
                    <div class="vz-card__title" style="margin-bottom:12px">سیر وضعیت سفارش</div>
                    @if (_timeline.Count == 0) { <span class="vz-muted" style="font-size:13px">رویدادی ثبت نشده است.</span> }
                    else { <Timeline Items="_timeline" /> }
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        @if (_detail is not null && CanAct(_detail.Status))
        {
            <button class="vz-btn vz-btn--danger-soft" @onclick="OpenCancel" disabled="@_acting">لغو سفارش</button>
            <button class="vz-btn vz-btn--success" @onclick="CompleteDetail" disabled="@(_acting || !CanComplete(_detail))" aria-describedby="completion-reason">
                @if (_acting) { <span class="vz-spinner sm"></span> } else { <Icon Name="check" Size="16" /> <span>تکمیل سفارش</span> }
            </button>
        }
        <button class="vz-btn vz-btn--outline" @onclick="() => _detailOpen = false">بستن</button>
    </Footer>
</Modal>

@* ---------- manual delivery ---------- *@
<Modal Visible="_manualDeliveryOpen" Title="تحویل دستی سفارش" Icon="package-check" Size="sm" OnClose="CloseManualDelivery">
    <ChildContent>
        <div class="vz-stack">
            <div class="vz-alert vz-alert--info">
                محتوای تحویل فقط برای آیتم انتخاب‌شده ثبت می‌شود و در گزارش حسابرسی سفارش باقی می‌ماند.
            </div>
            <div class="vz-field">
                <label class="vz-label" for="manual-delivery-content">محتوای تحویل</label>
                <textarea id="manual-delivery-content" class="vz-textarea" maxlength="4000" rows="6"
                          @bind="_manualDeliveryContent" placeholder="اطلاعات لازم برای دریافت محصول یا خدمت"></textarea>
            </div>
            <label class="vz-checkrow" for="manual-delivery-visible">
                <input id="manual-delivery-visible" type="checkbox" @bind="_manualDeliveryVisible" />
                <span>نمایش محتوا به مشتری در جزئیات سفارش</span>
            </label>
        </div>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="CloseManualDelivery" disabled="@_manualDeliveryBusy">انصراف</button>
        <button class="vz-btn vz-btn--primary" @onclick="SubmitManualDelivery" disabled="@_manualDeliveryBusy">
            @if (_manualDeliveryBusy) { <span class="vz-spinner sm"></span> }
            else { <Icon Name="package-check" Size="15" /> }
            ثبت تحویل
        </button>
    </Footer>
</Modal>

@* ---------- cancel (single + bulk) ---------- *@
<Modal Visible="_cancelOpen" Title="@(_bulkCancel ? $"لغو {AUI.Number(EligibleSelected.Count)} سفارش" : "لغو سفارش")" Icon="x-circle" Size="sm" OnClose="() => _cancelOpen = false">
    <ChildContent>
        <div class="vz-field">
            <label class="vz-label">دلیل لغو سفارش</label>
            <textarea class="vz-textarea" @bind="_cancelReason" placeholder="دلیل لغو را وارد کنید"></textarea>
        </div>
    </ChildContent>
    <Footer>
        <button class="vz-btn vz-btn--outline" @onclick="() => _cancelOpen = false" disabled="@_acting">انصراف</button>
        <button class="vz-btn vz-btn--danger" @onclick="ConfirmCancel" disabled="@_acting">
            @if (_acting) { <span class="vz-spinner sm"></span> } else { <span>تأیید لغو</span> }
        </button>
    </Footer>
</Modal>

@code {
    private bool _loading = true;
    private string? _error;
    private List<AdminOrderModel> _items = new();
    private int _total;

    private string _search = string.Empty;
    private string _statusFilter = "all", _payFilter = "all";
    private DateTime? _from, _to;

    private int _page = 1;
    private const int _pageSize = 10;

    private readonly HashSet<Guid> _selected = new();
    private Guid? _openMenuId;

    private bool _detailOpen, _loadingDetail, _acting;
    private AdminOrderModel? _detail;
    private List<Timeline.Entry> _timeline = new();

    private bool _cancelOpen, _bulkCancel, _bulkBusy;
    private string _cancelReason = string.Empty;
    private AdminOrderModel? _cancelTarget;
    private bool _manualDeliveryOpen, _manualDeliveryBusy, _manualDeliveryVisible = true;
    private string _manualDeliveryContent = string.Empty;
    private AdminOrderModel? _manualDeliveryOrder;
    private AdminOrderItemModel? _manualDeliveryItem;
    private readonly Dictionary<Guid, string> _kycDeadlineInputs = new();

    private DotNetObjectReference<Orders>? _selfRef;

    private static readonly (string Key, string Label)[] StatusChips =
    {
        ("all", "همه"), ("1", "در انتظار پرداخت"), ("2", "در حال پردازش"),
        ("3", "تکمیل شده"), ("4", "لغو شده"), ("6", "بازگشت وجه"),
    };

    protected override Task OnInitializedAsync() => Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("vzAdmin.registerShortcuts", _selfRef, nameof(OnShortcut)); } catch { }
        }
    }

    private async Task Load()
    {
        _loading = true; _error = null;
        var query = $"admin/orders/paged?page={_page}&pageSize={_pageSize}";
        if (!string.IsNullOrWhiteSpace(_search)) query += $"&search={Uri.EscapeDataString(_search.Trim())}";
        if (_statusFilter != "all") query += $"&status={_statusFilter}";
        if (_payFilter != "all") query += $"&paymentStatus={_payFilter}";
        if (_from is not null) query += $"&fromDate={_from:yyyy-MM-dd}";
        if (_to is not null) query += $"&toDate={_to:yyyy-MM-dd}";
        var r = await Api.GetAsync<PagedResult<AdminOrderModel>>(query);
        if (r.IsSuccess && r.Data is not null) { _items = r.Data.Items.ToList(); _total = r.Data.TotalCount; }
        else _error = r.Message;
        _selected.Clear();
        _loading = false;
    }

    private int CountStatus(byte status) => _items.Count(o => o.Status == status);
    private static bool CanAct(byte status) => status is not (byte)OrderStatus.Completed
        and not (byte)OrderStatus.Cancelled and not (byte)OrderStatus.Refunded;

    private static bool CanComplete(AdminOrderModel order) =>
        CanAct(order.Status) && OrderFulfillmentRules.CanComplete(order.PaymentStatus, Items(order).Select(x => x.DeliveryStatus));

    private static bool CanFulfill(AdminOrderModel order, AdminOrderItemModel item) =>
        OrderFulfillmentRules.IsPaid(order.PaymentStatus) && CanAct(order.Status) &&
        item.DeliveryStatus != (byte)DeliveryStatus.Delivered &&
        item.Kyc?.BlocksFulfillment != true &&
        item.DeliveryType == (byte)DeliveryType.Manual;

    private static string FulfillmentSummary(AdminOrderModel order)
    {
        var items = Items(order);
        var delivered = items.Count(x => x.DeliveryStatus == (byte)DeliveryStatus.Delivered);
        return $"{AUI.Number(delivered)} از {AUI.Number(items.Count)} آیتم تحویل شده است.";
    }

    private static string CompletionReason(AdminOrderModel order)
    {
        if (!OrderFulfillmentRules.IsPaid(order.PaymentStatus))
            return "تکمیل سفارش پس از پرداخت امکان‌پذیر است.";
        var outstanding = OrderFulfillmentRules.OutstandingCount(Items(order).Select(x => x.DeliveryStatus));
        return outstanding > 0
            ? $"{AUI.Number(outstanding)} آیتم هنوز نیاز به تحویل دارد."
            : "وضعیت سفارش برای تکمیل معتبر نیست.";
    }

    private static string FulfillmentGuidance(AdminOrderItemModel item) => item.DeliveryType switch
    {
        _ when item.Kyc?.BlocksFulfillment == true => "تحویل این آیتم تا تکمیل احراز هویت مسدود است.",
        (byte)DeliveryType.Instant => item.DeliveryStatus == (byte)DeliveryStatus.Failed
            ? "تحویل خودکار ناموفق بوده است. وضعیت تحویل را بررسی کنید."
            : "در انتظار تحویل خودکار است.",
        (byte)DeliveryType.SupportRequired => "پس از انجام خدمت یا بررسی پشتیبانی، تحویل این آیتم را ثبت کنید.",
        _ => "این آیتم هنوز تحویل نشده است."
    };

