    private void OpenKycReminder(AdminOrderModel order)
    {
        CloseMenu();
        _kycSmsOrder = order;
        _kycSmsMessage = KycReminderDefaultText;
        _kycSmsOpen = true;
    }

    private void CloseKycReminder()
    {
        _kycSmsOpen = false;
        _kycSmsSending = false;
        _kycSmsOrder = null;
    }

    private async Task SendOrderKycReminder()
    {
        if (_kycSmsOrder is null || string.IsNullOrWhiteSpace(_kycSmsMessage))
        {
            Toasts.Error("متن پیامک الزامی است.");
            return;
