    private int StatusCount(byte status) => _statusCounts.FirstOrDefault(x => x.Status == status)?.Count ?? 0;
    private string CurrentFilterSummaryLabel => _payFilter switch
    {
        "1" => "پرداخت‌نشده‌ها",
