    private readonly Dictionary<Guid, string> _kycDeadlineInputs = new();
    private bool _kycSmsOpen, _kycSmsSending;
    private AdminOrderModel? _kycSmsOrder;
    private string _kycSmsMessage = KycReminderDefaultText;
    private const string KycReminderDefaultText = "با سلام، سفارش شما نیازمند تکمیل احراز هویت است. لطفاً برای ادامه فرایند تحویل، احراز هویت خود را در حساب کاربری تکمیل کنید.\n\nبا تشکر، ویتورایز\nvitorize.com";

    private DotNetObjectReference<Orders>? _selfRef;

    // Chip keys stay the existing numeric OrderStatus values sent to the API; only the labels come
    // from the central display mapping so every surface reads the same terminology.
    private static readonly (string Key, string Label)[] StatusChips =
    {
        ("all", "همه"),
        ("1", AUI.OrderStatus((byte)OrderStatus.PendingPayment)),
        ("2", AUI.OrderStatus((byte)OrderStatus.Processing)),
        ("3", AUI.OrderStatus((byte)OrderStatus.Completed)),
        ("4", AUI.OrderStatus((byte)OrderStatus.Cancelled)),
        ("6", AUI.OrderStatus((byte)OrderStatus.Refunded)),
    };

    protected override Task OnInitializedAsync() => Load();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("vzAdmin.registerShortcuts", _selfRef, nameof(OnShortcut)); } catch { }
