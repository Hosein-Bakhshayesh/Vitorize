@page "/customer/wallet"
@inject ApiClient Api
@inject NavigationManager Nav
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>کیف پول | ویتورایز</PageTitle>

<section class="customer-wallet-page" aria-labelledby="wallet-title" aria-busy="@(_loading || _busy ? "true" : "false")">
<header class="wallet-heading"><p>حساب کاربری / کیف پول</p><h1 id="wallet-title">کیف پول من</h1></header>

@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت اطلاعات کیف پول…</span></div>
}
else
{
    <div class="wallet-overview">
        <section class="st-card st-card__pad wallet-balance" aria-labelledby="wallet-balance-title">
            <div class="wallet-balance-heading">
                <div>
                    <h2 id="wallet-balance-title">موجودی فعلی</h2>
                    @if (_walletError)
                    {
                        <div class="wallet-read-error" role="status">دریافت موجودی انجام نشد.</div>
                        <button type="button" class="st-btn st-btn--outline st-btn--sm" @onclick="Load" disabled="@_busy">تلاش مجدد</button>
                    }
                    else
                    {
                        <div class="wallet-balance-value" data-testid="wallet-balance">@AUI.MoneyFa(_balance)</div>
                    }
                </div>
                <div class="wallet-icon"><Icon Name="wallet" Size="30" /></div>
            </div>
            <div class="wallet-balance-caption">
                <Icon Name="shield-check" Size="14" /> موجودی کیف پول برای پرداخت سریع سفارش‌ها استفاده می‌شود.
            </div>
        </section>

        <section class="st-card wallet-topup" aria-labelledby="wallet-topup-title">
            <h2 id="wallet-topup-title" class="st-card__head"><Icon Name="plus" Size="18" /> شارژ کیف پول</h2>
            <form class="st-card__pad" @onsubmit="TopUp" @onsubmit:preventDefault novalidate>
                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <div id="wallet-feedback" class="st-alert st-alert--@(_messageIsError ? "danger" : "success")" role="@(_messageIsError ? "alert" : "status")">@_message</div>
                }
                <div class="wallet-presets" role="group" aria-label="مبالغ پیشنهادی شارژ">
                    @foreach (var amount in QuickAmounts)
                    {
                        var a = amount;
                        <button type="button"
                                class="st-pill @(_amount == a ? "active" : null)"
                                aria-pressed="@(_amount == a ? "true" : "false")" disabled="@_busy"
                                @onclick="() => _amount = a">
                            @AUI.MoneyFa(a)
                        </button>
                    }
                </div>
                <div class="st-field">
                    <label class="st-label" for="wallet-amount">مبلغ دلخواه (تومان)</label>
                    <input id="wallet-amount" class="st-input st-mono" type="number" inputmode="numeric" dir="ltr" min="10000" step="10000" @bind="_amount" disabled="@_busy" aria-describedby="@(_messageIsError ? "wallet-feedback" : null)" />
                </div>
                <button type="submit" class="st-btn st-btn--primary st-btn--block" disabled="@_busy" aria-label="پرداخت و شارژ">
                    @if (_busy) { <span class="st-spinner sm"></span> <span>در حال اتصال ...</span> }
                    else { <Icon Name="credit-card" Size="16" /> <span>پرداخت و شارژ</span> }
                </button>
            </form>
        </section>
    </div>

    <section class="st-card wallet-transactions" aria-labelledby="wallet-transactions-title">
        <h2 id="wallet-transactions-title" class="st-card__head"><Icon Name="activity" Size="18" /> تراکنش‌ها</h2>
        @if (_transactionsError)
        {
            <div class="st-state wallet-empty" role="status"><Icon Name="alert" Size="28" /><p>دریافت تراکنش‌ها انجام نشد.</p><button type="button" class="st-btn st-btn--outline" @onclick="Load" disabled="@_busy">تلاش مجدد</button></div>
        }
        else if (_transactions.Count == 0)
        {
            <div class="st-state wallet-empty"><Icon Name="activity" Size="28" /><p class="st-muted">تراکنشی ثبت نشده است.</p></div>
        }
        else
        {
            <div class="st-mobile-records">
                @foreach (var t in _transactions)
                {
                    var credit = t.Type == (byte)WalletTransactionType.Credit;
                    <article class="st-mobile-record" data-testid="wallet-transaction">
                        <div class="st-mobile-record__head">
                            <StoreBadge Text="@AUI.WalletTransactionType(t.Type)" Intent="@(credit ? "success" : "danger")" />
                            <span class="wallet-amount @(credit ? "is-credit" : "is-debit")"><bdi>@(credit ? "+" : "−")@AUI.MoneyFa(t.Amount)</bdi></span>
                        </div>
                        <div class="st-mobile-record__rows">
                            <div class="st-mobile-record__row"><span>موجودی پس از تراکنش</span><span>@AUI.MoneyFa(t.BalanceAfter)</span></div>
                            <div class="st-mobile-record__row"><span>توضیحات</span><span>@(string.IsNullOrWhiteSpace(t.Description) ? AUI.WalletReferenceType(t.ReferenceType) : t.Description)</span></div>
                            <div class="st-mobile-record__row"><span>تاریخ</span><span><PersianDateDisplay Value="t.CreatedAt" WithTime="true" /></span></div>
                        </div>
                    </article>
                }
            </div>
            <div class="st-table-wrap st-mobile-records-desktop">
                <table class="st-table">
                    <caption class="wallet-table-caption">تاریخچه تراکنش‌های کیف پول</caption>
                    <thead><tr><th scope="col">نوع</th><th scope="col">مبلغ</th><th scope="col">موجودی پس از تراکنش</th><th scope="col">توضیحات</th><th scope="col">تاریخ</th></tr></thead>
                    <tbody>
                        @foreach (var t in _transactions)
                        {
                            var credit = t.Type == (byte)WalletTransactionType.Credit;
                            <tr data-testid="wallet-transaction">
                                <td><StoreBadge Text="@AUI.WalletTransactionType(t.Type)" Intent="@(credit ? "success" : "danger")" /></td>
                                <td class="wallet-amount @(credit ? "is-credit" : "is-debit")"><bdi>@(credit ? "+" : "−")@AUI.MoneyFa(t.Amount)</bdi></td>
                                <td>@AUI.MoneyFa(t.BalanceAfter)</td>
                                <td class="st-muted">@(string.IsNullOrWhiteSpace(t.Description) ? AUI.WalletReferenceType(t.ReferenceType) : t.Description)</td>
                                <td><PersianDateDisplay Value="t.CreatedAt" WithTime="true" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
</section>

@code {
    private static readonly decimal[] QuickAmounts = { 200_000, 500_000, 1_000_000, 2_000_000 };

    private bool _loading = true, _busy;
    private bool _walletError, _transactionsError, _messageIsError;
    private string? _message;
    private decimal _balance;
    private decimal _amount = 500_000;
    private List<CustomerWalletTransactionModel> _transactions = new();

    /// <summary>Set when the Zarinpal top-up callback redirects the browser back here.</summary>
    [SupplyParameterFromQuery(Name = "topup")] public string? TopupOutcome { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (TopupOutcome == "1") Feedback("شارژ کیف پول با موفقیت انجام شد.");
        else if (TopupOutcome == "0") Feedback("شارژ کیف پول تایید نشد. در صورت کسر مبلغ، حداکثر تا ۷۲ ساعت بازگشت داده می‌شود.", true);
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var walletTask = Api.GetAsync<CustomerWalletModel>("wallet");
        var txTask = Api.GetAsync<List<CustomerWalletTransactionModel>>("wallet/transactions");
        await Task.WhenAll(walletTask, txTask);
        _walletError = !walletTask.Result.IsSuccess || walletTask.Result.Data is null;
        _transactionsError = !txTask.Result.IsSuccess || txTask.Result.Data is null;
        _balance = walletTask.Result.Data?.Balance ?? 0;
        _transactions = (txTask.Result.Data ?? new()).OrderByDescending(t => t.CreatedAt).ToList();
        _loading = false;
    }

    private async Task TopUp()
    {
        _message = null;
        _messageIsError = false;
        if (_amount <= 0)
        {
            Feedback("مبلغ شارژ را وارد کنید.", true);
            return;
        }

        _busy = true;

        var start = await Api.PostAsync<CustomerTopUpStartModel>("wallet/topup", new { Amount = _amount });

        if (!start.IsSuccess || start.Data is null)
        {
            _busy = false;
            Feedback(start.Message, true);
            return;
        }

        // درگاه واقعی — انتقال کاربر به صفحه پرداخت
        if (!string.IsNullOrWhiteSpace(start.Data.PaymentUrl))
        {
            Nav.NavigateTo(start.Data.PaymentUrl, forceLoad: true);
            return;
        }

        // درگاه تست (Mock) — تایید مستقیم
        var verify = await Api.PostAsync<CustomerTopUpVerifyModel>(
            $"wallet/topup/mock/verify/{start.Data.TopUpId}");

        _busy = false;

        if (verify.IsSuccess && verify.Data is { IsPaid: true })
        {
            Feedback($"کیف پول با موفقیت {AUI.MoneyFa(verify.Data.Amount)} شارژ شد.");
            _loading = true;
            await Load();
        }
        else
        {
            Feedback(verify.Message, true);
        }
    }

    private void Feedback(string? message, bool error = false)
    {
        _message = string.IsNullOrWhiteSpace(message) ? "پاسخی دریافت نشد. دوباره تلاش کنید." : message;
        _messageIsError = error;
    }
}
