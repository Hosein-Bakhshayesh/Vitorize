@page "/customer/verification"
@inject ApiClient Api
@inject MediaUrlResolver Media
@inject ToastService Toasts
@using AUI = Vitorize.Web.Helpers.AdminUiHelper
@using Vitorize.Web.Models.Store
@using Vitorize.Application.Common

<PageTitle>احراز هویت | ویتورایز</PageTitle>

<section class="customer-verification-page" aria-labelledby="verification-title" aria-busy="@(_loading ? "true" : "false")">
<header class="verification-heading">
    <p>حساب کاربری / احراز هویت</p>
    <h1 id="verification-title">احراز هویت</h1>
    <p class="st-muted">برای ادامه فرایند تحویل سفارش، اطلاعات و مدارک صاحب کارت بانکی را ثبت کنید.</p>
</header>

@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت اطلاعات احراز هویت…</span></div>
}
else if (_loadError)
{
    <div class="st-state verification-empty" role="status"><Icon Name="alert" Size="30" /><p>دریافت اطلاعات احراز هویت انجام نشد.</p><button type="button" class="st-btn st-btn--outline" @onclick="() => Load()">تلاش مجدد</button></div>
}
else
{
    <section class="st-card verification-why">
        <div class="verification-why__title"><Icon Name="info" Size="18" /> چرا احراز هویت لازم است؟</div>
        <div class="verification-why__notice-wrap @(_whyNoticeExpanded ? "is-expanded" : null)">
            <div class="verification-why__notice">@(_kycSettings?.CustomerNotice ?? OrderKycSettings.DefaultCustomerNotice)</div>
            <button type="button" class="verification-why__toggle" @onclick="ToggleWhyNotice" aria-expanded="@_whyNoticeExpanded">
                @if (_whyNoticeExpanded)
                {
                    <span>نمایش کمتر</span>
                }
                else
                {
                    <span aria-hidden="true">… </span><span>نمایش بیشتر</span>
                }
            </button>
        </div>
    </section>
    @if (_orderItemContext is not null)
    {
        <div class="st-alert st-alert--info verification-alert">
            <Icon Name="shield" Size="20" />
            <div>
                <div class="verification-alert__title">احراز هویت برای آیتم سفارش: @_orderItemContext.PolicyTitle</div>
                @if (!string.IsNullOrWhiteSpace(_orderItemContext.PolicyInstructions)) { <div class="verification-alert__line">@_orderItemContext.PolicyInstructions</div> }
                @if (_orderItemContext.CustomerActionDeadlineAt.HasValue)
                {
                    <div class="verification-alert__line">مهلت اقدام: @PersianDateHelper.ToIranTime(_orderItemContext.CustomerActionDeadlineAt.Value).ToString("yyyy/MM/dd HH:mm")</div>
                }
                @if (CustomerActionExpired)
                {
                    <div class="verification-alert__line">مهلت اقدام این آیتم پایان یافته است. برای راهنمایی با پشتیبانی تماس بگیرید.</div>
                }
                @if (_orderItemContext.LifecycleStatus == (byte)OrderItemKycStatus.FinalRejected)
                {
                    <div class="verification-alert__line">@(_orderItemContext.FinanceResolutionStatus switch { 1 => "احراز هویت این آیتم تأیید نشد و وضعیت مالی آن در حال بررسی است.", 2 => "بازپرداخت مالی ثبت شده است.", 3 => "تصمیم مالی این آیتم ثبت شده است.", _ => "وضعیت مالی این آیتم در حال بررسی است." })</div>
                }
                @if (_orderItemContext.Documents.Count > 0)
                {
                    <ul class="verification-alert__list">
                        @foreach (var document in _orderItemContext.Documents) { <li>@document.Title @(document.IsRequired ? "(الزامی)" : "(اختیاری)") — @(document.UploadStatus == "Uploaded" ? "بارگذاری شده" : "ثبت نشده")</li> }
                    </ul>
                }
            </div>
        </div>
    }
    @if (_profile is not null)
    {
        <div class="st-alert st-alert--@(_profile.Status == (byte)VerificationStatus.Verified ? "success" : _profile.Status == (byte)VerificationStatus.Rejected ? "danger" : "info") verification-alert">
            <Icon Name="shield" Size="20" />
            <div>
                <div class="verification-alert__title">وضعیت: @AUI.VerificationStatus(_profile.Status)</div>
                @if (_profile.Status == (byte)VerificationStatus.Rejected && !string.IsNullOrWhiteSpace(_profile.AdminNote))
                { <div class="verification-alert__line">دلیل: @_profile.AdminNote</div> }
                @if (_profile.Status == (byte)VerificationStatus.Pending)
                { <div class="verification-alert__line">درخواست شما در حال بررسی است.</div> }
            </div>
        </div>
    }

    <div class="st-split verification-layout">
        <div class="st-stack">
            <section class="st-card" aria-labelledby="verification-identity-title">
                <h2 id="verification-identity-title" class="st-card__head"><Icon Name="user" Size="18" /> اطلاعات هویتی و مدارک تصویری</h2>
                <div class="st-card__pad">
                    <div class="verification-form-grid">
                        <div class="st-field"><label class="st-label" for="verification-first-name">نام صاحب کارت بانکی <span class="st-required">*</span></label><input id="verification-first-name" class="st-input" @bind="_firstName" disabled="@ReadOnly" /></div>
                        <div class="st-field"><label class="st-label" for="verification-last-name">نام خانوادگی صاحب کارت بانکی <span class="st-required">*</span></label><input id="verification-last-name" class="st-input" @bind="_lastName" disabled="@ReadOnly" /></div>
                        <div class="st-field"><label class="st-label" for="verification-national-code">کد ملی صاحب کارت بانکی <span class="st-required">*</span></label><input id="verification-national-code" class="st-input st-mono" value="@_nationalCode" @oninput="OnNationalCodeInput" inputmode="numeric" maxlength="10" pattern="[0-9]{10}" dir="ltr" disabled="@ReadOnly" aria-describedby="verification-national-code-hint" /><div id="verification-national-code-hint" class="st-hint">کد ملی باید دقیقاً ۱۰ رقم باشد.</div></div>
                        <div class="st-field"><span class="st-label">تاریخ تولد صاحب کارت بانکی <span class="st-required">*</span></span><PersianDatePicker @bind-Value="_birthDate" ReadOnly="@ReadOnly" ValidationChanged="OnBirthDateValidationChanged" />
                            @if (!string.IsNullOrWhiteSpace(_birthDateError)) { <div class="st-field__error" role="alert">@_birthDateError</div> }
                        </div>
                        <div class="st-field verification-form-grid__wide">
                            <span class="st-label">آیا شماره‌ تماسی که با آن داخل سایت ثبت‌نام کرده‌اید به نام صاحب کارت بانکی است؟ <span class="st-required">*</span></span>
                            <div class="verification-mobile-owner-choice">
                                <label><input type="radio" name="registered-mobile-owner" checked="@(_registeredMobileBelongsToCardHolder == true)" @onchange="() => SetRegisteredMobileOwner(true)" disabled="@ReadOnly" /> بله</label>
                                <label><input type="radio" name="registered-mobile-owner" checked="@(_registeredMobileBelongsToCardHolder == false)" @onchange="() => SetRegisteredMobileOwner(false)" disabled="@ReadOnly" /> خیر</label>
                            </div>
                            @if (_registeredMobileBelongsToCardHolder == false)
                            {
                                <div class="st-field verification-cardholder-mobile"><label class="st-label" for="verification-cardholder-mobile">لطفاً یک شماره تماسی که به نام صاحب کارت بانکی است وارد نمایید</label><input id="verification-cardholder-mobile" class="st-input st-mono" inputmode="tel" dir="ltr" @bind="_cardHolderMobile" disabled="@ReadOnly" /></div>
                            }
                        </div>
                    </div>

                    <section class="verification-documents-section" aria-labelledby="verification-documents-title">
                        <h3 id="verification-documents-title" class="verification-documents-section__title"><Icon Name="image" Size="18" /> مدارک تصویری الزامی</h3>
                        <div class="verification-documents-grid">
                        @foreach (var document in DocumentSlots)
                        {
                            <div class="verification-document-slot">
                                <div class="st-label">@document.Title</div>
                                @if (!string.IsNullOrWhiteSpace(document.Instructions))
                                {
                                    <div class="st-muted verification-document-slot__instructions">@document.Instructions</div>
                                }
                                @{ var existing = _profile?.Documents.FirstOrDefault(d =>
                                    document.KycDocumentTypeId.HasValue
                                        ? d.KycDocumentTypeId == document.KycDocumentTypeId
                                        : d.DocumentType == document.DocumentType); }
                                @if (existing is not null)
                                {
                                    <div class="verification-document-preview">
                                        <img src="@Media.Resolve(existing.FilePath)" alt="" />
                                        @if (!ReadOnly)
                                        {
                                            <button type="button" class="st-btn st-btn--sm st-btn--surface-danger verification-document-preview__remove" @onclick="() => DeleteDoc(existing.Id)"><Icon Name="trash" Size="14" /></button>
                                        }
                                    </div>
                                }
                                else if (_stagedDocs.ContainsKey(SlotKey(document)))
                                {
                                    <div data-testid="staged-document" class="verification-document-staged">
                                        <span class="verification-document-staged__label"><Icon Name="check-circle" Size="16" /> تصویر انتخاب شد — با «ثبت نهایی» ذخیره می‌شود</span>
                                        <button type="button" class="st-btn st-btn--sm st-btn--surface-danger" title="حذف" @onclick="() => RemoveStagedDoc(document)"><Icon Name="trash" Size="14" /></button>
                                    </div>
                                }
                                else if (!ReadOnly)
                                {
                                    <DocumentRedactionUpload Value="@((string?)null)" ValueChanged="(p) => AddDoc(document.DocumentType, p, document.KycDocumentTypeId, document.OrderItemId)" RedactedValueChanged="(p) => AddDoc(document.DocumentType, p, document.KycDocumentTypeId, document.OrderItemId, true)" Label="آپلود تصویر" Endpoint="uploads/verification-document" OrderItemId="@document.OrderItemId" RedactionMode="@document.RedactionMode" RedactionInstructions="@document.RedactionInstructions" TestId="@document.KycDocumentTypeId?.ToString("N")" />
                                }
                            </div>
                        }
                        </div>
                        <div class="st-muted verification-documents-section__hint">همه مدارک ستاره‌دار باید پیش از ثبت نهایی احراز هویت بارگذاری شوند.</div>
                    </section>
                </div>
            </section>
            @if (!ReadOnly)
            {
                <button type="button" class="st-btn st-btn--primary verification-submit" @onclick="Submit" disabled="@_submitting">
                    @if (_submitting) { <span class="st-spinner sm"></span> <span>در حال ثبت…</span> } else { <Icon Name="check" Size="16" /> <span>ثبت نهایی احراز هویت</span> }
                </button>
            }
        </div>

        <Modal Visible="_showSubmittedDialog" Title="اطلاعات احراز هویت ثبت شد" Icon="check-circle"
               OnClose="CloseSubmittedDialog" InitialFocusId="verification-submitted-ok">
            <ChildContent>
                <div data-testid="verification-submitted-dialog" class="verification-submitted-dialog">
                    اطلاعات و مدارک شما با موفقیت ثبت شد و در صف بررسی قرار گرفت.
                    نتیجه حداکثر تا ۲۴ ساعت آینده بررسی و از طریق پیامک به شما اطلاع داده می‌شود.
                </div>
            </ChildContent>
            <Footer>
                <button id="verification-submitted-ok" class="st-btn st-btn--primary" @onclick="CloseSubmittedDialog">
                    <Icon Name="check" Size="16" /> متوجه شدم
                </button>
            </Footer>
        </Modal>

        <aside class="st-card st-card__pad verification-help" aria-labelledby="verification-help-title">
            <h3 id="verification-help-title">راهنما</h3>
            <ul>
                <li>تصاویر باید واضح و خوانا باشند.</li>
                <li>اطلاعات باید با کارت ملی مطابقت داشته باشد.</li>
                <li>حداکثر حجم هر تصویر ۵ مگابایت.</li>
                <li>پس از ثبت، بررسی حداکثر تا ۲۴ ساعت انجام می‌شود.</li>
            </ul>
        </aside>
    </div>
}
</section>

@code {
    [SupplyParameterFromQuery(Name = "orderItem")] public Guid? OrderItemId { get; set; }
    [SupplyParameterFromQuery(Name = "orderId")] public Guid? OrderId { get; set; }
    private bool _loading = true, _submitting, _whyNoticeExpanded, _loadError;
    private CustomerVerificationModel? _profile;
    private StoreOrderItemKycModel? _orderItemContext;
    private readonly List<OrderItemVerificationContext> _orderItemContexts = new();
    private OrderKycSettingsModel? _kycSettings;

    private string _firstName = "", _lastName = "", _nationalCode = "";
    private DateTime? _birthDate;
    private bool? _registeredMobileBelongsToCardHolder;
    private string? _cardHolderMobile;
    private string? _birthDateError;

    private bool CustomerActionExpired => _orderItemContexts.Count > 0 && _orderItemContexts.All(context =>
        context.Kyc.CustomerAction == "DeadlineExpired" ||
        context.Kyc.LifecycleStatus == (byte)OrderItemKycStatus.Expired);

    // A profile becomes Pending as soon as the customer supplies identity data or
    // an individual document.  It must remain actionable while this specific
    // paid item still requests Customer submission; otherwise a two-document
    // purchase would lock after its first document.  AwaitingReview has no such
    // customer action and remains read-only.
    private bool HasActiveCustomerSubmission => _orderItemContexts.Any(context =>
        context.Kyc.CustomerAction is "SubmitVerification" or "ResubmitVerification");

    private bool ReadOnly => CustomerActionExpired || (_profile is not null &&
        (_profile.Status == (byte)VerificationStatus.Verified ||
         (_profile.Status == (byte)VerificationStatus.Pending && _profile.SubmittedAt.HasValue && !HasActiveCustomerSubmission)));

    private static readonly Dictionary<byte, string> DocTypes = new()
    {
        { 1, "تصویر مدرک هویتی دارنده کارت" }, { 4, "تصویر کارت بانکی دارنده کارت" }
    };

    private IEnumerable<DocumentSlot> DocumentSlots
    {
        get
        {
            if (_orderItemContexts.Count > 0)
            {
                // The generic account-menu entry has no orderItem query parameter. Resolve every
                // current customer action, then retain the owning item ID beside each policy document.
                // This is what prevents an uploaded file from looking selected in the browser while
                // being unrecognised by the server's policy-ID validation at final submission.
                return _orderItemContexts
                    .SelectMany(context => context.Kyc.Documents.Select((document, index) => new DocumentSlot(
                        (byte)(index + 1), document.Title, document.DocumentTypeId, document.IsRequired,
                        document.Instructions, document.RedactionMode, document.RedactionInstructions, context.OrderItemId)))
                    .GroupBy(document => document.KycDocumentTypeId)
                    .Select(group => group
                        .OrderByDescending(document => document.IsRequired)
                        .ThenBy(document => document.DocumentType)
                        .First())
                    .ToList();
            }

            // A legacy partial request may have policy-bound documents but no
            // submitted text payload.  Keep those documents visible when the
            // customer returns through the normal account menu, so the form can
            // be completed rather than incorrectly asking for them again.
            if (_profile?.Documents.Any(document => document.KycDocumentTypeId.HasValue) == true)
                return _profile.Documents
                    .Where(document => document.KycDocumentTypeId.HasValue)
                    .GroupBy(document => document.KycDocumentTypeId)
                    .Select(group => group.First())
                    .Select(document => new DocumentSlot(
                        document.DocumentType,
                        document.DocumentTypeTitle ?? "مدرک بارگذاری‌شده",
                        document.KycDocumentTypeId,
                        true,
                        null,
                        0,
                        null,
                        null));

            return DocTypes.Select(document => new DocumentSlot(document.Key, document.Value, null, true, DocumentInstructions(document.Key), 0, null, null));
        }
    }

    private static string? DocumentInstructions(byte documentType) => documentType switch
    {
        1 => "لطفاً تصویر کارت ملی خود را بارگذاری کنید. در صورتی که به کارت ملی خود دسترسی ندارید، می‌توانید تصویر دیگر مدارک هویتی (از جمله شناسنامه، پاسپورت، گواهینامه رانندگی، کارت سوخت و ...) را نیز بارگذاری کنید.",
        4 => "در صورت نیاز، می‌توانید اطلاعات حساس کارت خود را (از جمله CVV و تاریخ انقضا) با یک تکه کاغذ یا انگشتان خود بپوشانید.",
        _ => null
    };

    protected override Task OnInitializedAsync() => Load();

    private async Task Load(bool preserveForm = false)
    {
        _loading = true;
        var result = await Api.GetAsync<CustomerVerificationModel>("verification/me");
        var settingsResult = await Api.GetAsync<OrderKycSettingsModel>("checkout/kyc-settings");
        _loadError = !result.IsSuccess;
        _profile = result.IsSuccess ? result.Data : null;
        _kycSettings = settingsResult.IsSuccess ? settingsResult.Data : null;
        _orderItemContext = null;
        _orderItemContexts.Clear();
        if (!OrderItemId.HasValue && OrderId.HasValue)
        {
            var order = await Api.GetAsync<StoreOrderModel>($"orders/{OrderId.Value}");
            OrderItemId = order.Data?.Items.FirstOrDefault(x =>
                x.Kyc?.CustomerAction is "SubmitVerification" or "ResubmitVerification")?.Id;
        }
        var candidateItemIds = new List<Guid>();
        if (OrderItemId.HasValue)
        {
            candidateItemIds.Add(OrderItemId.Value);
        }
        else
        {
            // Customers commonly reach this page from the account menu, not from an order-detail
            // link. Find the paid order items that explicitly request a KYC submission so their
            // real document IDs (rather than the legacy 1/4 placeholders) are used end-to-end.
            var orders = await Api.GetAsync<List<StoreOrderModel>>("orders");
            candidateItemIds.AddRange((orders.Data ?? [])
                .OrderByDescending(order => order.CreatedAt)
                .SelectMany(order => order.Items)
                .Where(item => item.Kyc?.CustomerAction is "SubmitVerification" or "ResubmitVerification")
                .Select(item => item.Id));
        }
        foreach (var itemId in candidateItemIds.Distinct())
        {
            var context = await Api.GetAsync<StoreOrderItemKycModel>($"orders/items/{itemId}/kyc-context");
            if (context.IsSuccess && context.Data is not null)
                _orderItemContexts.Add(new OrderItemVerificationContext(itemId, context.Data));
            else if (OrderItemId == itemId)
                Toasts.Warning("اطلاعات احراز هویت این آیتم در دسترس نیست.");
        }
        _orderItemContext = _orderItemContexts.FirstOrDefault()?.Kyc;
        if (_profile is not null && !preserveForm)
        {
            _firstName = _profile.FirstName;
            _lastName = _profile.LastName;
            _nationalCode = _profile.NationalCode;
            _birthDate = _profile.BirthDate;
            _registeredMobileBelongsToCardHolder = _profile.RegisteredMobileBelongsToCardHolder;
            _cardHolderMobile = _profile.CardHolderMobile;
        }
        _loading = false;
    }

    private async Task Submit()
    {
        if (!string.IsNullOrWhiteSpace(_birthDateError))
        { Toasts.Error(_birthDateError); return; }
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName) || string.IsNullOrWhiteSpace(_nationalCode) || !_birthDate.HasValue || !_registeredMobileBelongsToCardHolder.HasValue)
        { Toasts.Error("همه فیلدهای ستاره‌دار الزامی هستند."); return; }
        if (_nationalCode.Length != 10 || _nationalCode.Any(value => value is < '0' or > '9'))
        { Toasts.Error("کد ملی باید دقیقاً ۱۰ رقم باشد."); return; }
        if (_registeredMobileBelongsToCardHolder == false &&
            !Vitorize.Application.Common.IranMobile.TryNormalize(_cardHolderMobile, out _))
        { Toasts.Error("شماره تماس صاحب کارت بانکی را به شکل صحیح (مثلاً 09xxxxxxxxx) وارد کنید."); return; }
        if (DocumentSlots.Where(document => document.IsRequired).Any(document => !HasUploadedDocument(document)))
        { Toasts.Error("پیش از ثبت نهایی، همه مدارک تصویری الزامی را بارگذاری کنید."); return; }

        _submitting = true;

        var result = await Api.PostAsync<CustomerVerificationModel>("verification/submit", new
        {
            FirstName = _firstName,
            LastName = _lastName,
            NationalCode = _nationalCode,
            BirthDate = _birthDate?.ToString("yyyy-MM-dd"),
            RegisteredMobileBelongsToCardHolder = _registeredMobileBelongsToCardHolder,
            CardHolderMobile = _cardHolderMobile,
            Documents = _stagedDocs.Values.Select(document => new
            {
                document.DocumentType,
                document.KycDocumentTypeId,
                document.OrderItemId,
                document.FilePath,
                document.IsRedacted
            }).ToList()
        });
        _submitting = false;

        if (result.IsSuccess) { _showSubmittedDialog = true; await Load(); }
        else Toasts.Error(result.Message);
    }

    private bool _showSubmittedDialog;
    private void CloseSubmittedDialog() => _showSubmittedDialog = false;

    /// <summary>Documents picked on the base identity form, held locally until «ثبت نهایی».</summary>
    private readonly Dictionary<string, StagedDocument> _stagedDocs = new();
    private sealed record StagedDocument(byte DocumentType, Guid? KycDocumentTypeId, Guid? OrderItemId, string FilePath, bool IsRedacted);
    private static string SlotKey(DocumentSlot slot) => slot.KycDocumentTypeId?.ToString("N") ?? $"type-{slot.DocumentType}";
    private void RemoveStagedDoc(DocumentSlot slot) => _stagedDocs.Remove(SlotKey(slot));

    private Task AddDoc(byte docType, string? path, Guid? kycDocumentTypeId = null, Guid? orderItemId = null, bool isRedacted = false)
    {
        if (string.IsNullOrWhiteSpace(path)) return Task.CompletedTask;

        // Selecting a file only stores its private upload token in this form.
        // The database document and the identity payload are saved together by
        // the final-submit endpoint, including when this page was opened from
        // a specific order item.
        _stagedDocs[kycDocumentTypeId?.ToString("N") ?? $"type-{docType}"] =
            new StagedDocument(docType, kycDocumentTypeId, orderItemId, path, isRedacted);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task DeleteDoc(Guid id)
    {
        var result = await Api.DeleteAsync($"verification/documents/{id}");
        if (result.IsSuccess) { Toasts.Success("مدرک حذف شد."); await Load(); }
        else Toasts.Error(result.Message);
    }

    private bool HasUploadedDocument(DocumentSlot slot) =>
        _stagedDocs.ContainsKey(SlotKey(slot)) ||
        _profile?.Documents.Any(document =>
            slot.KycDocumentTypeId.HasValue
                ? document.KycDocumentTypeId == slot.KycDocumentTypeId
                : document.KycDocumentTypeId is null && document.DocumentType == slot.DocumentType) == true;

    private void OnNationalCodeInput(ChangeEventArgs args)
    {
        var entered = args.Value?.ToString() ?? string.Empty;
        _nationalCode = string.Concat(entered.Select(character => character switch
        {
            '۰' => '0', '۱' => '1', '۲' => '2', '۳' => '3', '۴' => '4',
            '۵' => '5', '۶' => '6', '۷' => '7', '۸' => '8', '۹' => '9',
            '٠' => '0', '١' => '1', '٢' => '2', '٣' => '3', '٤' => '4',
            '٥' => '5', '٦' => '6', '٧' => '7', '٨' => '8', '٩' => '9',
            _ => character
        }).Where(character => character is >= '0' and <= '9').Take(10));
    }

    private Task OnBirthDateValidationChanged(string? message)
    {
        _birthDateError = message;
        return Task.CompletedTask;
    }

    private void ToggleWhyNotice() => _whyNoticeExpanded = !_whyNoticeExpanded;

    private void SetRegisteredMobileOwner(bool value)
    {
        _registeredMobileBelongsToCardHolder = value;
        if (value) _cardHolderMobile = null;
    }

    private sealed record OrderItemVerificationContext(Guid OrderItemId, StoreOrderItemKycModel Kyc);
    private sealed record DocumentSlot(byte DocumentType, string Title, Guid? KycDocumentTypeId, bool IsRequired, string? Instructions, byte RedactionMode, string? RedactionInstructions, Guid? OrderItemId);
}
