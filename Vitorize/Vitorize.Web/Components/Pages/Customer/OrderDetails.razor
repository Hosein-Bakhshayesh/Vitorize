@page "/customer/orders/{Id:guid}"
@inject ApiClient Api
@inject ToastService Toasts
@inject IJSRuntime JS
@inject NavigationManager Nav
@using Vitorize.Application.Common
@using Vitorize.Shared.Enums
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>جزئیات سفارش | ویتورایز</PageTitle>

<div class="st-bc"><a href="/customer/dashboard">داشبورد</a> <Icon Name="chevron-left" Size="13" /> <a href="/customer/orders">سفارش‌ها</a> <Icon Name="chevron-left" Size="13" /> <span>جزئیات</span></div>

@if (_loading)
{
    <div class="st-state"><div class="st-spinner"></div></div>
}
else if (_order is null)
{
    <div class="st-state"><div class="st-state__ic"><Icon Name="cart" Size="30" /></div><div style="font-weight:700">سفارش یافت نشد</div><a class="st-btn st-btn--primary st-btn--sm" href="/customer/orders">بازگشت</a></div>
}
else
{
    @* One canonical status for the order, from the same mapper the list page uses. The payment and
       order enums are no longer shown side by side: that pairing is what produced a
       «در انتظار پرداخت» badge next to delivery-in-progress wording. *@
    <div class="st-spread" style="margin-bottom:18px">
        <h1 style="font-size:20px">سفارش <span class="st-mono">@_order.OrderNumber</span></h1>
        <div style="display:flex;gap:8px" data-testid="order-state" data-order-state="@_view.State">
            <StoreBadge Text="@_view.StatusLabel" Intent="@_view.BadgeIntent" />
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_view.FulfillmentNotice))
    {
        <div class="st-alert st-alert--@(_view.ShowFulfillmentProgress ? "info" : "warning")"
             data-testid="order-fulfillment-notice" style="margin-bottom:16px">
            <Icon Name="@(_view.ShowFulfillmentProgress ? "clock" : "credit-card")" Size="17" />
            <span>@_view.FulfillmentNotice</span>
        </div>
    }

    <div class="st-split">
        <div class="st-stack">
            @foreach (var item in _order.Items)
            {
                <div class="st-card st-card__pad">
                    <div class="st-spread">
                        <div>
                            @{ var variantTitle = ProductAvailabilityRules.CustomerFacingVariantTitle(item.VariantTitle); }
                            <div style="font-weight:700">@item.ProductTitle @(string.IsNullOrWhiteSpace(variantTitle) ? "" : $"— {variantTitle}")</div>
                            <div class="st-muted" style="font-size:12.5px;margin-top:4px">تعداد @AUI.Number(item.Quantity) · @AUI.MoneyFa(item.UnitPrice) · @AUI.DeliveryType(item.DeliveryType)</div>
                        </div>
                        <StoreBadge Text="@CustomerOrderPresenter.ItemDeliveryLabel(_view, item)"
                                    Intent="@(item.DeliveryStatus == (byte)DeliveryStatus.Delivered ? "success" : _view.ShowFulfillmentProgress ? "warning" : "muted")"
                                    Dot="false" />
                    </div>

                    @if (item.InputValues.Count > 0)
                    {
                        <div class="st-divider"></div>
                        <div class="st-label">اطلاعات ثبت‌شده برای این محصول</div>
                        <dl class="st-order-inputs">
                            @foreach (var value in item.InputValues) { <div><dt>@value.FieldLabel</dt><dd>@DisplayInputValue(value.FieldType, value.Value)</dd></div> }
                        </dl>
                    }

                    @if (item.Kyc is not null)
                    {
                        <div class="st-divider"></div>
                        <div class="st-alert st-alert--@(item.Kyc.BlocksFulfillment ? "warning" : item.Kyc.IsFulfilled ? "success" : "info")">
                            <Icon Name="shield" Size="17" />
                            <div style="flex:1">
                                <div style="font-weight:700">احراز هویت: @item.Kyc.LifecycleLabel</div>
                                @if (!string.IsNullOrWhiteSpace(item.Kyc.PolicyTitle)) { <div class="st-muted" style="font-size:12px;margin-top:3px">@item.Kyc.PolicyTitle</div> }
                                @if (!string.IsNullOrWhiteSpace(item.Kyc.PolicyInstructions)) { <div class="st-muted" style="font-size:12px;margin-top:3px;white-space:pre-line">@item.Kyc.PolicyInstructions</div> }
                                @if (!string.IsNullOrWhiteSpace(item.Kyc.CustomerActionLabel)) { <div style="font-size:12.5px;margin-top:5px">@item.Kyc.CustomerActionLabel</div> }
                                @if (item.Kyc.CustomerActionDeadlineAt.HasValue) { <div class="st-muted" style="font-size:12px;margin-top:4px">مهلت اقدام: @PersianDateHelper.ToIranTime(item.Kyc.CustomerActionDeadlineAt.Value).ToString("yyyy/MM/dd HH:mm")</div> }
                                @if (item.Kyc.Documents.Count > 0)
                                {
                                    <ul style="font-size:12px;margin:6px 0 0;padding-inline-start:18px">
                                        @foreach (var document in item.Kyc.Documents)
                                        { <li>@document.Title @(document.IsRequired ? "(الزامی)" : "(اختیاری)") — @(document.UploadStatus == "Uploaded" ? "بارگذاری شده" : "ثبت نشده")</li> }
                                    </ul>
                                }
                            </div>
                            @if (item.Kyc.CustomerAction is "SubmitVerification" or "ResubmitVerification")
                            {
                                <a class="st-btn st-btn--primary st-btn--sm" href="@($"/customer/verification?orderItem={item.Id}")">@(item.Kyc.CustomerAction == "ResubmitVerification" ? "ارسال مجدد مدارک" : "تکمیل احراز هویت")</a>
                            }
                        </div>
                    }

                    @{
                        var codes = item.Deliveries.Where(d => d.IsVisibleToCustomer && !string.IsNullOrWhiteSpace(d.DeliveredContent)).ToList();
                    }
                    @if (codes.Count > 0)
                    {
                        <div class="st-divider"></div>
                        <div class="st-label">کدها / محتوای تحویل‌شده</div>
                        <div class="st-stack" style="gap:8px">
                            @foreach (var d in codes)
                            {
                                <div style="display:flex;align-items:center;gap:10px;background:var(--st-surface-2);border:1px dashed var(--st-border-2);border-radius:10px;padding:10px 12px">
                                    <span class="st-mono" style="flex:1;font-size:14px;font-weight:700;letter-spacing:1px">@d.DeliveredContent</span>
                                    <button class="st-btn st-btn--ghost st-btn--sm" @onclick="() => Copy(d.DeliveredContent!)"><Icon Name="copy" Size="15" /> کپی</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Payment state gates fulfillment presentation: before a successful payment
                           this must not claim that delivery is under way. *@
                        var notice = CustomerOrderPresenter.DescribeItemDelivery(_view, item);
                        @if (notice is not null)
                        {
                            <div class="st-divider"></div>
                            <div class="st-alert st-alert--@(_view.ShowFulfillmentProgress ? "info" : "warning")" data-testid="item-delivery-notice">
                                <Icon Name="@(_view.ShowFulfillmentProgress ? "clock" : "credit-card")" Size="16" /> <span>@notice</span>
                            </div>
                        }
                    }

                    @if (CanReview(item))
                    {
                        <div class="st-divider"></div>
                        @if (_reviewsByProduct.TryGetValue(item.ProductId, out var existingReview))
                        {
                            <div class="st-alert st-alert--info" style="align-items:center">
                                <Icon Name="star" Size="16" />
                                <span>نظر شما برای این محصول ثبت شده است: <b>@AUI.ReviewStatusText(existingReview.IsApproved, existingReview.IsRejected)</b></span>
                                <a class="st-btn st-btn--ghost st-btn--sm" href="/customer/reviews">مشاهده نظر</a>
                            </div>
                        }
                        else
                        {
                            <button class="st-btn st-btn--outline st-btn--sm" @onclick="() => OpenReview(item)">
                                <Icon Name="star" Size="15" /> ثبت نظر برای این خرید
                            </button>
                        }
                    }
                </div>
            }

            @if (_order.Status != (byte)OrderStatus.Completed && _order.Status != (byte)OrderStatus.Cancelled)
            {
                <a class="st-btn st-btn--outline" style="align-self:flex-start" href="@($"/customer/tickets/new?orderId={_order.Id}")"><Icon Name="headphones" Size="16" /> ثبت تیکت برای این سفارش</a>
            }
        </div>

        <div class="st-card st-card__pad" style="align-self:start">
            <h3 style="font-size:15px;margin-bottom:12px">خلاصه پرداخت</h3>
            <div class="st-sumrow"><span class="st-muted">جمع کل</span><span>@AUI.MoneyFa(_order.SubtotalAmount)</span></div>
            <div class="st-sumrow"><span class="st-muted">تخفیف</span><span>@AUI.MoneyFa(_order.DiscountAmount)</span></div>
            @* Purchase-time snapshot only. Orders placed before VAT existed show no VAT row. *@
            @if (_order.VatEnabled)
            {
                <div class="st-sumrow" data-testid="order-vat-row"><span class="st-muted">مالیات بر ارزش افزوده (@AUI.Percent(_order.VatRatePercent)٪)</span><span>@AUI.MoneyFa(_order.VatAmount)</span></div>
            }
            <div class="st-sumrow total"><span>مبلغ نهایی</span><span>@AUI.MoneyFa(_order.FinalAmount)</span></div>
            <div class="st-divider"></div>
            <div class="st-sumrow"><span class="st-muted">تاریخ ثبت</span><span><PersianDateDisplay Value="_order.CreatedAt" WithTime="true" /></span></div>
            <div class="st-sumrow"><span class="st-muted">تاریخ پرداخت</span><span><PersianDateDisplay Value="_order.PaidAt" WithTime="true" /></span></div>
            @if (_canRetry)
            {
                <div class="st-divider"></div>
                <button class="st-btn st-btn--primary" style="width:100%" disabled="@_retrying" @onclick="RetryPayment"><Icon Name="refresh" Size="16" /> @(_retrying ? "در حال آماده‌سازی..." : "تلاش مجدد پرداخت")</button>
            }

            @* Whether the customer may act is the server's decision, carried on the order itself. *@
            @if (_order.CanCustomerCancel)
            {
                <div class="st-divider"></div>
                <button class="st-btn st-btn--outline" style="width:100%" data-testid="order-cancel"
                        disabled="@_busy" @onclick="() => _confirmKind = ConfirmKind.Cancel">
                    <Icon Name="x-circle" Size="16" /> لغو سفارش
                </button>
            }
            else if (_view.IsAwaitingCustomerPayment && !string.IsNullOrWhiteSpace(_order.CustomerCancelBlockReason))
            {
                @* An unpaid order the customer cannot cancel yet: say why rather than showing nothing. *@
                <div class="st-divider"></div>
                <div class="st-muted" style="font-size:12.5px" data-testid="order-cancel-blocked">@_order.CustomerCancelBlockReason</div>
            }

            @if (_order.CanCustomerHide)
            {
                <div class="st-divider"></div>
                <button class="st-btn st-btn--ghost" style="width:100%" data-testid="order-hide"
                        disabled="@_busy" @onclick="() => _confirmKind = ConfirmKind.Hide">
                    <Icon Name="trash" Size="16" /> حذف از لیست سفارش‌های من
                </button>
            }
        </div>
    </div>
}

<Modal Visible="_reviewOpen" Title="ثبت نظر برای خرید" Icon="star" Size="sm" OnClose="CloseReview">
    <ChildContent>
        @if (_reviewTarget is not null)
        {
            <div class="st-alert st-alert--info" style="margin-bottom:14px">
                نظر شما پس از ثبت، در سایت نمایش داده می‌شود. مدیر در صورت وجود مشکل می‌تواند آن را رد کند.
            </div>
            <div class="st-field">
                <label class="st-label">امتیاز شما</label>
                <div class="st-stars" style="font-size:27px;cursor:pointer;direction:ltr;text-align:right">
                    @for (byte i = 1; i <= 5; i++)
                    {
                        var star = i;
                        <span @onclick="() => _reviewRating = star">@(_reviewRating >= star ? "★" : "☆")</span>
                    }
                </div>
            </div>
            <div class="st-field"><label class="st-label">عنوان (اختیاری)</label><input class="st-input" maxlength="200" @bind="_reviewTitle" /></div>
            <div class="st-field"><label class="st-label">نظر شما</label><textarea class="st-textarea" rows="6" maxlength="2000" @bind="_reviewComment" placeholder="تجربه خرید خود را بنویسید..."></textarea></div>
        }
    </ChildContent>
    <Footer>
        <button class="st-btn st-btn--ghost" @onclick="CloseReview" disabled="@_reviewSending">انصراف</button>
        <button class="st-btn st-btn--primary" @onclick="SubmitReview" disabled="@_reviewSending">
            @if (_reviewSending) { <span class="st-spinner sm"></span> }
            ثبت نظر
        </button>
    </Footer>
</Modal>

<ConfirmDialog Visible="_confirmKind is not null"
               Title="@(_confirmKind == ConfirmKind.Cancel ? "لغو سفارش" : "حذف از لیست")"
               Message="@ConfirmMessage"
               ConfirmText="@(_confirmKind == ConfirmKind.Cancel ? "لغو سفارش" : "حذف از لیست")"
               Icon="@(_confirmKind == ConfirmKind.Cancel ? "x-circle" : "trash")"
               Busy="_busy"
               OnConfirm="RunConfirmed" OnCancel="() => _confirmKind = null" />

@code {
    [Parameter] public Guid Id { get; set; }

    private static string DisplayInputValue(byte fieldType, string? value) =>
        fieldType == (byte)ProductInputFieldType.Checkbox
            ? string.Equals(value, "true", StringComparison.OrdinalIgnoreCase) || value == "1" ? "✅" : "❌"
            : value ?? "—";

    private bool _loading = true;
    private StoreOrderModel? _order;
    private Guid _loadedId;
    private bool _canRetry;
    private bool _retrying;
    private bool _busy;
    private readonly Dictionary<Guid, CustomerReviewModel> _reviewsByProduct = new();
    private bool _reviewOpen, _reviewSending;
    private StoreOrderItemModel? _reviewTarget;
    private byte _reviewRating = 5;
    private string _reviewTitle = string.Empty, _reviewComment = string.Empty;

    private enum ConfirmKind { Cancel, Hide }
    private ConfirmKind? _confirmKind;

    /// <summary>The customer-facing reading of this order; the whole page renders from it.</summary>
    private CustomerOrderPresentation _view = CustomerOrderPresenter.Describe(new StoreOrderModel());

    private string ConfirmMessage => _confirmKind == ConfirmKind.Cancel
        ? $"سفارش {_order?.OrderNumber} لغو شود؟ پس از لغو، امکان پرداخت این سفارش وجود نخواهد داشت."
        : $"سفارش {_order?.OrderNumber} از فهرست شما حذف شود؟ سابقه سفارش برای پیگیری‌های بعدی نزد فروشگاه باقی می‌ماند.";

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId) return;
        _loadedId = Id;
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        var orderTask = Api.GetAsync<StoreOrderModel>($"orders/{Id}");
        var reviewsTask = Api.GetAsync<List<CustomerReviewModel>>("product-reviews/mine");
        await Task.WhenAll(orderTask, reviewsTask);
        var result = orderTask.Result;
        _order = result.IsSuccess ? result.Data : null;
        _canRetry = false;
        _reviewsByProduct.Clear();
        if (reviewsTask.Result.IsSuccess && reviewsTask.Result.Data is not null)
            foreach (var review in reviewsTask.Result.Data)
                _reviewsByProduct[review.ProductId] = review;

        if (_order is null) return;

        _view = CustomerOrderPresenter.Describe(_order);

        var eligibility = await Api.GetAsync<PaymentRetryEligibilityModel>($"payments/retry-eligibility/{Id}");
        _canRetry = eligibility.IsSuccess && eligibility.Data?.CanRetry == true;
    }

    private bool CanReview(StoreOrderItemModel item) =>
        _order?.Status == (byte)OrderStatus.Completed && item.ProductId != Guid.Empty;

    private void OpenReview(StoreOrderItemModel item)
    {
        _reviewTarget = item;
        _reviewRating = 5;
        _reviewTitle = string.Empty;
        _reviewComment = string.Empty;
        _reviewOpen = true;
    }

    private void CloseReview()
    {
        _reviewOpen = false;
        _reviewSending = false;
        _reviewTarget = null;
    }

    private async Task SubmitReview()
    {
        if (_reviewTarget is null || string.IsNullOrWhiteSpace(_reviewComment))
        {
            Toasts.Error("متن نظر الزامی است.");
            return;
        }

        _reviewSending = true;
        var result = await Api.PostAsync<CustomerReviewModel>("product-reviews", new
        {
            ProductId = _reviewTarget.ProductId,
            Title = string.IsNullOrWhiteSpace(_reviewTitle) ? null : _reviewTitle,
            Comment = _reviewComment,
            Rating = _reviewRating
        });
        _reviewSending = false;
        if (!result.IsSuccess || result.Data is null)
        {
            Toasts.Error(result.Message);
            return;
        }

        _reviewsByProduct[result.Data.ProductId] = result.Data;
        CloseReview();
        Toasts.Success("نظر شما ثبت و منتشر شد.");
    }

    private async Task RunConfirmed()
    {
        if (_order is null || _confirmKind is null) return;

        var hide = _confirmKind == ConfirmKind.Hide;
        _busy = true;

        // The server re-decides; the flag only made the button visible.
        var result = await Api.PostAsync($"orders/{Id}/{(hide ? "hide" : "cancel")}");

        _busy = false;
        _confirmKind = null;

        if (!result.IsSuccess)
        {
            Toasts.Error(result.Message);
            await LoadAsync();
            return;
        }

        if (hide)
        {
            Toasts.Success("سفارش از فهرست شما حذف شد.");
            Nav.NavigateTo("/customer/orders");
            return;
        }

        Toasts.Success("سفارش لغو شد.");
        await LoadAsync();
    }

    private async Task Copy(string text)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", text); Toasts.Success("کپی شد."); }
        catch { Toasts.Info("امکان کپی خودکار نبود."); }
    }

    private async Task RetryPayment()
    {
        _retrying = true;
        var start = await Api.PostAsync<PaymentStartResultModel>($"payments/retry/{Id}");
        if (!start.IsSuccess || start.Data is null)
        {
            _retrying = false;
            _canRetry = false;
            Toasts.Error(start.Message);
            return;
        }
        if (!string.IsNullOrWhiteSpace(start.Data.PaymentUrl) && start.Data.PaymentUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(start.Data.PaymentUrl, forceLoad: true);
            return;
        }
        var verify = await Api.PostAsync<PaymentVerifyResultModel>($"payments/mock/verify/{start.Data.PaymentId}");
        _retrying = false;
        if (verify.IsSuccess && verify.Data?.IsPaid == true)
            Nav.NavigateTo($"/payment/result?orderId={Id}&paid=1");
        else
            Toasts.Error(verify.Message);
    }
}
