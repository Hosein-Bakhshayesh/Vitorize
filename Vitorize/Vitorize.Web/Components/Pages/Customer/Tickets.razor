@page "/customer/tickets"
@inject ApiClient Api
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>پشتیبانی | ویتورایز</PageTitle>

<section class="customer-tickets-page" aria-labelledby="tickets-title" aria-busy="@(_loading ? "true" : "false")">
<header class="tickets-heading">
    <p>حساب کاربری / پشتیبانی و تیکت‌ها</p>
    <div class="st-spread">
        <h1 id="tickets-title">پشتیبانی و تیکت‌ها</h1>
        <a class="st-btn st-btn--primary" href="/customer/tickets/new"><Icon Name="plus" Size="17" /> تیکت جدید</a>
    </div>
</header>

@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت تیکت‌ها…</span></div>
}
else if (_loadError)
{
    <div class="st-state tickets-empty" role="status"><Icon Name="alert" Size="30" /><p>دریافت تیکت‌ها انجام نشد.</p><button type="button" class="st-btn st-btn--outline" @onclick="Load">تلاش مجدد</button></div>
}
else if (_tickets.Count == 0)
{
    <div class="st-state tickets-empty">
        <div class="st-state__ic"><Icon Name="message" Size="32" /></div>
        <div class="tickets-empty__title">تیکتی ثبت نکرده‌اید</div>
        <a class="st-btn st-btn--primary st-btn--sm" href="/customer/tickets/new">ثبت اولین تیکت</a>
    </div>
}
else
{
    <div class="st-card tickets-list">
        <div class="st-mobile-records">
            @foreach (var t in _tickets)
            {
                <article class="st-mobile-record">
                    <div class="st-mobile-record__head">
                        <strong>@t.Subject</strong>
                        <StoreBadge Text="@AUI.TicketStatus(t.Status)" Intent="@TicketIntent(t.Status)" />
                    </div>
                    <dl class="tickets-record-details">
                        <div><dt>بخش</dt><dd>@AUI.TicketDepartment(t.Department)</dd></div>
                        <div><dt>اولویت</dt><dd>@AUI.TicketPriority(t.Priority)</dd></div>
                        <div><dt>آخرین بروزرسانی</dt><dd><PersianDateDisplay Value="@(t.UpdatedAt ?? t.CreatedAt)" WithTime="true" /></dd></div>
                    </dl>
                    <a class="st-btn st-btn--outline st-btn--sm tickets-record-action" href="@($"/customer/tickets/{t.Id}")">مشاهدهٔ تیکت</a>
                </article>
            }
        </div>
        <div class="st-table-wrap st-mobile-records-desktop">
            <table class="st-table">
                <caption class="tickets-table-caption">فهرست تیکت‌های پشتیبانی</caption>
                <thead><tr><th scope="col">موضوع</th><th scope="col">بخش</th><th scope="col">اولویت</th><th scope="col">وضعیت</th><th scope="col">آخرین بروزرسانی</th><th scope="col"></th></tr></thead>
                <tbody>
                    @foreach (var t in _tickets)
                    {
                        <tr>
                            <th scope="row">@t.Subject</th>
                            <td>@AUI.TicketDepartment(t.Department)</td>
                            <td>@AUI.TicketPriority(t.Priority)</td>
                            <td><StoreBadge Text="@AUI.TicketStatus(t.Status)" Intent="@TicketIntent(t.Status)" /></td>
                            <td><PersianDateDisplay Value="@(t.UpdatedAt ?? t.CreatedAt)" WithTime="true" /></td>
                            <td><a class="st-btn st-btn--outline st-btn--sm" href="@($"/customer/tickets/{t.Id}")">مشاهده</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
</section>

@code {
    private bool _loading = true, _loadError;
    private List<CustomerTicketModel> _tickets = new();

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true;
        var result = await Api.GetAsync<List<CustomerTicketModel>>("tickets");
        _loadError = !result.IsSuccess;
        _tickets = (result.Data ?? new()).OrderByDescending(t => t.UpdatedAt ?? t.CreatedAt).ToList();
        _loading = false;
    }

    private static string TicketIntent(byte status) => status switch
    {
        (byte)TicketStatus.Open => "info",
        (byte)TicketStatus.WaitingForAdmin => "warning",
        (byte)TicketStatus.WaitingForCustomer => "purple",
        _ => "muted"
    };
}
