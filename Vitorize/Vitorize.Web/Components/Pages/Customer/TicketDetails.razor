@page "/customer/tickets/{Id:guid}"
@inject ApiClient Api
@inject ToastService Toasts
@using Vitorize.Application.Common
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>تیکت | ویتورایز</PageTitle>

<section class="customer-tickets-page" aria-labelledby="ticket-details-title" aria-busy="@(_loading ? "true" : "false")">
<div class="st-bc"><a href="/customer/tickets">تیکت‌ها</a> <Icon Name="chevron-left" Size="13" /> <span>جزئیات</span></div>

@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت تیکت…</span></div>
}
else if (_ticket is null)
{
    <div class="st-state tickets-empty"><div class="st-state__ic"><Icon Name="message" Size="30" /></div><div class="ticket-not-found__title">تیکت یافت نشد</div><a class="st-btn st-btn--primary st-btn--sm" href="/customer/tickets">بازگشت</a></div>
}
else
{
    <header class="tickets-heading ticket-details-heading">
        <div class="st-spread">
            <div>
                <h1 id="ticket-details-title">@_ticket.Subject</h1>
                <div class="st-muted ticket-details-meta">@AUI.TicketDepartment(_ticket.Department) · اولویت @AUI.TicketPriority(_ticket.Priority)</div>
            </div>
            <StoreBadge Text="@AUI.TicketStatus(_ticket.Status)" Intent="@TicketIntent(_ticket.Status)" />
        </div>
    </header>

    <div class="st-card ticket-thread">
        @if (_ticket.IsFulfillmentTicket)
        {
            <div class="ticket-fulfillment" data-testid="fulfillment-items">
                <strong>آیتم‌های در حال تحویل پشتیبانی</strong>
                @foreach (var item in _ticket.FulfillmentItems)
                {
                    var variantTitle = ProductAvailabilityRules.CustomerFacingVariantTitle(item.VariantTitle);
                    <div>@item.ProductTitle @if (!string.IsNullOrWhiteSpace(variantTitle)) { <span>— @variantTitle</span> } <span>× @item.Quantity</span></div>
                }
            </div>
        }
        <div class="st-chat">
            @foreach (var m in _ticket.Messages.Where(x => !x.IsInternalNote).OrderBy(x => x.CreatedAt))
            {
                var mine = m.SenderUserId == _myId;
                <div class="st-msg @(mine ? "me" : "")">
                    <div class="st-msg__b">@m.Message</div>
                    <div class="st-msg__t">@(mine ? "شما" : "پشتیبانی") · <PersianDateDisplay Value="m.CreatedAt" WithTime="true" /></div>
                </div>
            }
        </div>

        @if (_ticket.Status != (byte)TicketStatus.Closed)
        {
            <form class="ticket-reply" @onsubmit="Send" @onsubmit:preventDefault novalidate>
                <label class="st-label ticket-reply__label" for="ticket-reply">پاسخ شما</label>
                <textarea id="ticket-reply" class="st-textarea ticket-reply__input" @bind="_reply" placeholder="پاسخ خود را بنویسید ..." disabled="@_sending"></textarea>
                <div class="ticket-reply__actions">
                    <button type="submit" class="st-btn st-btn--primary" disabled="@_sending">
                        @if (_sending) { <span class="st-spinner sm"></span> <span>در حال ارسال…</span> } else { <Icon Name="send" Size="16" /> <span>ارسال پاسخ</span> }
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="ticket-closed-note st-muted">این تیکت بسته شده است.</div>
        }
    </div>
}
</section>

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _loading = true, _sending;
    private CustomerTicketModel? _ticket;
    private string _reply = string.Empty;
    private Guid _myId;
    private Guid _loadedId;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            var id = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            Guid.TryParse(id, out _myId);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == _loadedId) return;
        _loadedId = Id;
        await Load();
    }

    private async Task Load()
    {
        _loading = true;
        var result = await Api.GetAsync<CustomerTicketModel>($"tickets/{Id}");
        _ticket = result.IsSuccess ? result.Data : null;
        _loading = false;
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_reply)) { Toasts.Error("متن پاسخ الزامی است."); return; }
        _sending = true;
        var result = await Api.PostAsync<CustomerTicketModel>($"tickets/{Id}/messages",
            new { Message = _reply, AttachmentPath = (string?)null });
        _sending = false;
        if (result.IsSuccess && result.Data is not null) { _ticket = result.Data; _reply = string.Empty; }
        else Toasts.Error(result.Message);
    }

    private static string TicketIntent(byte status) => status switch
    {
        (byte)TicketStatus.Open => "info",
        (byte)TicketStatus.WaitingForAdmin => "warning",
        (byte)TicketStatus.WaitingForCustomer => "purple",
        _ => "muted"
    };
}
