@page "/customer/notifications"
@inject ApiClient Api
@inject ToastService Toasts
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<PageTitle>اعلان‌ها | ویتورایز</PageTitle>

<section class="customer-notifications-page" aria-labelledby="notifications-title" aria-busy="@(_loading ? "true" : "false")">
<header class="notifications-heading">
    <p>حساب کاربری / اعلان‌ها</p>
    <div class="st-spread">
        <h1 id="notifications-title">اعلان‌ها</h1>
        @if (_items.Any(n => !n.IsRead))
        {
            <button type="button" class="st-btn st-btn--outline st-btn--sm" @onclick="MarkAll"><Icon Name="check" Size="15" /> خواندن همه</button>
        }
    </div>
</header>

@if (_loading)
{
    <div class="st-state" role="status"><div class="st-spinner"></div><span>در حال دریافت اعلان‌ها…</span></div>
}
else if (_loadError)
{
    <div class="st-state notifications-empty" role="status"><Icon Name="alert" Size="30" /><p>دریافت اعلان‌ها انجام نشد.</p><button type="button" class="st-btn st-btn--outline" @onclick="Load">تلاش مجدد</button></div>
}
else if (_items.Count == 0)
{
    <div class="st-state notifications-empty"><div class="st-state__ic"><Icon Name="bell" Size="32" /></div><div class="st-muted">اعلانی ندارید.</div></div>
}
else
{
    <div class="st-stack">
        @foreach (var n in _items)
        {
            <article class="st-card st-card__pad notification-item @(n.IsRead ? null : "is-unread")" data-testid="@(IsAnnouncement(n) ? "customer-announcement" : "customer-notification")">
                <div class="st-spread">
                    <div class="notification-body">
                        @* Announcements get a neutral informational icon; transactional types keep the bell. *@
                        <span class="notification-icon"><Icon Name="@(IsAnnouncement(n) ? "megaphone" : "bell")" Size="18" /></span>
                        <div class="notification-content">
                            <div class="notification-title">@n.Title</div>
                            @* Plain text by design: never rendered as markup. *@
                            <div class="st-muted notification-message">@n.Message</div>
                            <div class="st-muted notification-date"><PersianDateDisplay Value="n.CreatedAt" WithTime="true" /></div>
                            @if (!string.IsNullOrWhiteSpace(n.ActionUrl))
                            {
                                <a class="st-btn st-btn--outline st-btn--sm notification-action" href="@n.ActionUrl" data-testid="notification-action">
                                    <Icon Name="arrow-left" Size="14" /> مشاهده
                                </a>
                            }
                        </div>
                    </div>
                    @if (!n.IsRead)
                    {
                        <button type="button" class="st-btn st-btn--ghost st-btn--sm" title="خوانده شد" @onclick="() => MarkRead(n)"><Icon Name="check" Size="15" /></button>
                    }
                </div>
            </article>
        }
    </div>
}
</section>

@code {
    private bool _loading = true, _loadError;
    private List<CustomerNotificationModel> _items = new();

    private static bool IsAnnouncement(CustomerNotificationModel n) =>
        n.Type == (byte)Vitorize.Shared.Enums.NotificationType.Announcement;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _loading = true;
        var result = await Api.GetAsync<List<CustomerNotificationModel>>("notifications");
        _loadError = !result.IsSuccess;
        _items = (result.Data ?? new()).OrderByDescending(n => n.CreatedAt).ToList();
        _loading = false;
    }

    private async Task MarkRead(CustomerNotificationModel n)
    {
        var result = await Api.PostAsync($"notifications/{n.Id}/read");
        if (result.IsSuccess) n.IsRead = true;
    }

    private async Task MarkAll()
    {
        var result = await Api.PostAsync("notifications/read-all");
        if (result.IsSuccess) { Toasts.Success("همه اعلان‌ها خوانده شد."); await Load(); }
        else Toasts.Error(result.Message);
    }
}
