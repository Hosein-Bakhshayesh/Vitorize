@inject IConfiguration Configuration
@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@inject Vitorize.Web.Services.UI.StorefrontMaintenanceService Maintenance
@inject MediaUrlResolver Media
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <base href="/" />
    @if (!_prerender)
    {
        <title>@_b.PageTitle()</title>
    }
    @if (!_indexableRoute)
    {
        <meta name="robots" content="noindex,nofollow" />
    }

    <link rel="icon" href="@_favicon" />
    @if (!string.IsNullOrWhiteSpace(_appleIcon))
    {
        <link rel="apple-touch-icon" href="@_appleIcon" />
    }

    <script>
        // The server already rendered data-theme from the vitorize-theme cookie, so the correct
        // palette is in the first byte of HTML and cannot flash. This only reconciles the two cases
        // the server cannot know about: a visitor whose preference lives in localStorage from before
        // the cookie existed, and a first-time visitor whose system prefers dark. It also re-applies
        // after an enhanced navigation, because the incoming document's <html> carries the attribute
        // but a client-side theme change since then would otherwise be lost.
        (function () {
            function preferred() {
                try {
                    var stored = localStorage.getItem('vitorize-theme');
                    if (stored === 'dark' || stored === 'light') return stored;
                } catch (e) { }
                var cookie = / vitorize-theme=(dark|light)/.exec('; ' + document.cookie);
                if (cookie) return cookie[1];
                try {
                    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) return 'dark';
                } catch (e) { }
                return 'light';
            }
            function apply() {
                var t = preferred();
                if (document.documentElement.getAttribute('data-theme') !== t) {
                    document.documentElement.setAttribute('data-theme', t);
                }
            }
            apply();
            window.vzApplyTheme = apply;
            document.addEventListener('DOMContentLoaded', apply);
        })();
        window.vzStorefront = window.vzStorefront || {};
        window.vzStorefront.focusAndScroll = function (id) {
            try {
                var element = document.getElementById(id);
                if (!element) return false;
                element.scrollIntoView({ behavior: 'smooth', block: 'center' });
                if (typeof element.focus === 'function') element.focus({ preventScroll: true });
                return true;
            } catch (e) { return false; }
        };
    </script>
    @if (_needsAdminAssets)
    {
        <link rel="stylesheet" href="css/admin.css?v=@AssetVersion" />
    }
    @if (_isStorefront)
    {
        <link rel="preload" href="fonts/storefront/peyda-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
        <link rel="preload" href="fonts/storefront/funnel-display-400.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    }
    <link rel="stylesheet" href="css/storefront.css?v=@AssetVersion" />

    @* FIX-17: the boot loader paints before any stylesheet is guaranteed to have loaded, and
       admin.css — which previously held the only .vz-splash rules — is not linked on /cart,
       /checkout, /login, /register, /payment or the password-reset routes. Inlining the loader's
       critical CSS here makes it correct on every route that renders it, and it deliberately
       follows the <link> tags so it wins over the older admin.css copy. *@
    <style>
        .vz-splash { position: fixed; inset: 0; z-index: 9999; display: flex; flex-direction: column;
                     align-items: center; justify-content: center; gap: 20px;
                     background: var(--st-bg, var(--bg, #ffffff)); transition: opacity .2s ease; }
        .vz-splash.is-done { opacity: 0; pointer-events: none; }
        /* The colour/size properties also cover the Authorizing and RedirectToLogin splashes,
           which render a letter mark rather than the logo image. */
        .vz-splash-mark { width: 64px; height: 64px; border-radius: 14px; display: flex;
                          align-items: center; justify-content: center;
                          background: linear-gradient(135deg, #0D9488, #0891B2);
                          color: #fff; font-size: 30px; font-weight: 700; }
        .vz-splash-mark img { width: 40px; height: 40px; object-fit: contain; }
        .vz-splash__media { max-width: min(240px, 60vw); max-height: min(240px, 40vh);
                            width: auto; height: auto; object-fit: contain; }
        .vz-spinner { width: 38px; height: 38px; border-radius: 50%;
                      border: 3px solid var(--st-chip, rgba(13, 148, 136, .18));
                      border-top-color: var(--st-primary, #0D9488);
                      animation: vz-splash-spin .8s linear infinite; }
        .vz-splash__sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
                         overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
        @@keyframes vz-splash-spin { to { transform: rotate(360deg); } }
        :root[data-theme="dark"] .vz-splash { background: var(--st-bg, var(--bg, #0A121C)); }
        @@media (prefers-reduced-motion: reduce) {
            /* The ring stops rotating; the mark and the hidden status text still convey loading. */
            .vz-spinner { animation: none; }
            .vz-splash { transition: none; }
        }
        @@media (max-width: 480px) {
            .vz-splash-mark { width: 52px; height: 52px; }
            .vz-splash-mark img { width: 32px; height: 32px; }
            .vz-spinner { width: 30px; height: 30px; }
        }
    </style>

    @if (!string.IsNullOrWhiteSpace(_b.GoogleAnalyticsId))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@_b.GoogleAnalyticsId"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@_b.GoogleAnalyticsId');
        </script>
    }
    @if (!string.IsNullOrWhiteSpace(_fontFaceCss)) { <style>@((MarkupString)_fontFaceCss)</style> }
    @if (!string.IsNullOrWhiteSpace(_storefrontTypographyCss)) { <style>@((MarkupString)_storefrontTypographyCss)</style> }

    <HeadOutlet @rendermode="PageRenderMode" />
    @if (_isStorefront && !_maintenance && !string.IsNullOrWhiteSpace(_b.CustomHeadHtml))
    {
        @((MarkupString)_b.CustomHeadHtml)
    }
</head>

<body>
    @if (!_prerender)
    {
        @* FIX-17: an administrator-configured image/GIF replaces the built-in visual; an empty or
           unsafe setting falls back to the default Vitorize mark + ring. *@
        <div id="vz-initial-loader" class="vz-splash" role="status">
            @if (_loadingMediaSrc is not null)
            {
                @* If the configured medium is missing or unreadable on disk the browser would
                   otherwise paint a broken-image icon over the whole boot screen. Drop it and
                   reveal the built-in mark instead, so a stale setting can never degrade the
                   first thing a visitor sees. display:contents keeps the flex centring intact. *@
                <img class="vz-splash__media" src="@_loadingMediaSrc" alt=""
                     onerror="this.remove();var f=document.getElementById('vz-splash-fallback');if(f)f.style.display='contents';" />
                <div id="vz-splash-fallback" style="display:none">
                    <div class="vz-splash-mark"><img src="@_logoSrc" alt="" /></div>
                    <div class="vz-spinner"></div>
                </div>
            }
            else
            {
                <div class="vz-splash-mark"><img src="@_logoSrc" alt="" /></div>
                <div class="vz-spinner"></div>
            }
            <span class="vz-splash__sr">در حال بارگذاری</span>
        </div>
        <script src="js/initial-loader.js?v=@AssetVersion"></script>
    }

    <Routes @rendermode="PageRenderMode" />

    <div id="blazor-error-ui" class="vz-error-ui">
        یک خطای پیش‌بینی‌نشده رخ داد.
        <a href="" class="reload">بارگذاری مجدد</a>
        <span class="dismiss">🗙</span>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="js/auth-session.js?v=@AssetVersion"></script>
    @* Shared yyyy/MM/dd typing mask for the Persian date field. *@
    <script src="js/persian-date-mask.js?v=@AssetVersion"></script>
    @if (_needsAdminAssets)
    {
        <script src="js/admin.js"></script>
        <script src="js/lucide-picker.js?v=@AssetVersion"></script>
    }
    <script src="js/storefront-theme.js?v=@AssetVersion"></script>
    <script src="js/form-validation.js?v=@AssetVersion"></script>
    <script src="js/image-upload.js?v=@AssetVersion"></script>
    <script src="js/document-redaction.js?v=@AssetVersion"></script>
    @* Third-party scripts only - the seal BADGES render once, inside the footer's styled box.
       Repeating the raw seal HTML here painted a second, unstyled set of giant badges at the very
       bottom of every page. Nothing third-party loads while maintenance is on: a closed shop must
       not run chat widgets or phone home to seal providers. *@
    @if (_isStorefront && !_maintenance && !string.IsNullOrWhiteSpace(_trustSealScripts))
    {
        @((MarkupString)_trustSealScripts)
    }
    @if (_isStorefront && !_maintenance && !string.IsNullOrWhiteSpace(_b.CustomFooterHtml))
    {
        @((MarkupString)_b.CustomFooterHtml)
    }
</body>

</html>

@code {
    private IComponentRenderMode PageRenderMode => new InteractiveServerRenderMode(prerender: _prerender);

    // Cache-busting token for the global stylesheets. Bump when admin.css/storefront.css change
    // so browsers fetch the new CSS instead of a stale copy.
    private const string AssetVersion = "20260901-client-fixes-1.5.1";

    private Vitorize.Web.Services.UI.StoreBranding _b = new(new Dictionary<string, string>());
    private string _favicon = "favicon.ico";
    private string _logoSrc = "images/logo.png";
    private string? _appleIcon;
    private string? _loadingMediaSrc;
    private string? _fontFaceCss;
    private string? _storefrontTypographyCss;
    /// <summary>
    /// Theme rendered into the document by the server. It comes from the vitorize-theme cookie that
    /// the client writes alongside localStorage, so a returning visitor's choice is present before
    /// any script runs - no light flash, and nothing for an enhanced navigation to drop.
    /// "light" is the deliberate default for a request with no cookie; the inline script upgrades it
    /// to dark when the system asks for dark, which the server cannot see.
    /// </summary>
    private string _theme = "light";

    private bool _prerender, _indexableRoute, _needsAdminAssets, _isStorefront, _maintenance;
    private string _trustSealScripts = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var path = HttpContextAccessor.HttpContext?.Request.Path.Value ?? "/";
        _indexableRoute = IsIndexablePublicPath(path);
        _prerender = IsPrerenderedPublicPath(path);

        // Read the persisted choice before anything renders. Only the two known values are accepted,
        // so a tampered cookie cannot inject an attribute value.
        var themeCookie = HttpContextAccessor.HttpContext?.Request.Cookies["vitorize-theme"];
        _theme = themeCookie is "dark" or "light" ? themeCookie : "light";
        _needsAdminAssets = path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase) ||
                            path.StartsWith("/customer", StringComparison.OrdinalIgnoreCase);
        _isStorefront = !path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase);
        // برندینگ عمومی از API خوانده می‌شود (کش استاتیک ۲ دقیقه‌ای)؛ در صورت خطا پیش‌فرض‌ها استفاده می‌شوند.
        _b = await Branding.GetAsync();
        // Third-party embeds are suppressed while the shop is closed (served from the same 2-minute
        // branding cache, so this costs no extra round trip).
        _maintenance = _isStorefront && await Maintenance.GetStateAsync(null) is not null;
        _trustSealScripts = Vitorize.Web.Services.UI.TrustSealHtml.Scripts(_b.TrustSealFooterHtml);

        if (!string.IsNullOrWhiteSpace(_b.FaviconPath)) _favicon = Versioned(Media.Resolve(_b.FaviconPath), _b.AssetVersion);
        if (!string.IsNullOrWhiteSpace(_b.AppleTouchIconPath)) _appleIcon = Versioned(Media.Resolve(_b.AppleTouchIconPath), _b.AssetVersion);

        var logo = _b.LogoPath;
        if (string.IsNullOrWhiteSpace(logo)) logo = _b.SiteLogoPath;
        if (!string.IsNullOrWhiteSpace(logo)) _logoSrc = Versioned(Media.Resolve(logo), _b.AssetVersion);
        if (IsSafeLoadingMedia(_b.LoadingMediaPath))
            _loadingMediaSrc = Versioned(Media.Resolve(_b.LoadingMediaPath), _b.AssetVersion);

        if (!string.IsNullOrWhiteSpace(_b.FontPath) && IsSafeFont(_b.FontPath, _b.FontFormat))
        {
            var family = CssString(_b.FontFamily);
            var url = CssString(Versioned(Media.Resolve(_b.FontPath), _b.FontVersion));
            var selector = _b.FontScope switch { 1 => ".st-shell", 2 => ".vz-shell", _ => ":root" };
            // An uploaded font drives the same shared variable, so it reaches whichever shells its
            // scope selects without needing to know about --font and --st-font separately.
            _fontFaceCss = $"@font-face{{font-family:'{family}';src:url('{url}') format('{CssString(_b.FontFormat)}');font-display:swap;}}{selector}{{--vz-font:'{family}',var(--vz-font-en),Vazirmatn,Tahoma,sans-serif;--font:var(--vz-font);--st-font:var(--vz-font);}}";
        }

        // Emitted on :root and for every area, not just the storefront. Scoping this to .st-shell was
        // why an administrator could change the font and see the admin panel ignore it: the rule never
        // applied there, and admin.css kept its own hard-coded face. Peyda is the default.
        {
            var persian = CssFontFamily(_b.StorefrontPersianFont, "Peyda");
            var english = CssFontFamily(_b.StorefrontEnglishFont, "Funnel Display");
            _storefrontTypographyCss =
                $":root{{--vz-font-fa:'{persian}';--vz-font-en:'{english}','Manrope';" +
                "--vz-font:var(--vz-font-fa),var(--vz-font-en),'Vazirmatn',Tahoma,sans-serif;}}";
        }
    }

    private static string Versioned(string url, string version) => $"{url}{(url.Contains('?') ? '&' : '?')}v={Uri.EscapeDataString(version)}";
    private static string CssString(string value) => new(value.Where(c => char.IsLetterOrDigit(c) || c is ' ' or '-' or '_' or '.' or '/' or ':' or '?' or '&' or '=').ToArray());
    private static string CssFontFamily(string value, string fallback)
    {
        var family = new string(value.Where(c => char.IsLetterOrDigit(c) || c is ' ' or '-' or '_').ToArray()).Trim();
        return family.Length is >= 2 and <= 60 ? family : fallback;
    }
    private static bool IsSafeFont(string path, string format) => path.StartsWith("/uploads/fonts/", StringComparison.OrdinalIgnoreCase) && format is "woff2" or "woff" or "ttf";

    // FIX-17: the loader src is written straight into the boot HTML, so the shared rule decides
    // whether the configured value is a safe uploaded medium; anything else falls back to default.
    private static bool IsSafeLoadingMedia(string? path) =>
        Vitorize.Application.Common.LoadingMediaRules.IsSafePath(path);

    private static bool IsPrerenderedPublicPath(string path) =>
        !path.StartsWith("/admin", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/customer", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/cart", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/checkout", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/payment", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/login", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/register", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/forgot-password", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/reset-password", StringComparison.OrdinalIgnoreCase);

    private static bool IsIndexablePublicPath(string path) => IsPrerenderedPublicPath(path) &&
        !path.StartsWith("/search", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/error", StringComparison.OrdinalIgnoreCase) &&
        !path.StartsWith("/access-denied", StringComparison.OrdinalIgnoreCase);
}
