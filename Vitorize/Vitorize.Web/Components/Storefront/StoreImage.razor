@inject MediaUrlResolver Media

<div class="st-img @(Contain ? "st-img--contain" : "") @Class">
    @if (!string.IsNullOrWhiteSpace(Url))
    {
        @if (!string.IsNullOrWhiteSpace(MobileUrl))
        {
            <picture>
                <source media="(max-width: 767px)" srcset="@Media.Resolve(MobileUrl)" />
                <img src="@Media.Resolve(Url)" alt="@Alt" loading="@Loading" fetchpriority="@FetchPriority" width="@Width" height="@Height"
                     onerror="this.style.display='none';var p=this.parentElement.nextElementSibling;if(p)p.style.display='flex';" />
            </picture>
        }
        else
        {
            <img src="@Media.Resolve(Url)" alt="@Alt" loading="@Loading" fetchpriority="@FetchPriority" width="@Width" height="@Height"
                 onerror="this.style.display='none';var p=this.nextElementSibling;if(p)p.style.display='flex';" />
        }
        <div class="st-img__ph" style="display:none"><Icon Name="@Icon" Size="@IconSize" /></div>
    }
    else
    {
        <div class="st-img__ph" style="display:flex"><Icon Name="@Icon" Size="@IconSize" /></div>
    }
</div>

@code {
    [Parameter] public string? Url { get; set; }
    /// <summary>تصویر جایگزین برای نمایشگرهای موبایل؛ در صورت خالی بودن همان تصویر اصلی استفاده می‌شود.</summary>
    [Parameter] public string? MobileUrl { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "box";
    [Parameter] public int IconSize { get; set; } = 34;
    [Parameter] public bool Contain { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string Loading { get; set; } = "lazy";
    [Parameter] public string? FetchPriority { get; set; }
    [Parameter] public int? Width { get; set; }
    [Parameter] public int? Height { get; set; }
}
