@implements IDisposable
@inject NavigationManager Nav
@inject ApiClient Api
@inject CartState Cart
@inject WishlistState Wishlist
@using Vitorize.Web.Models.Store
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<header class="st-header">
    <div class="st-container">
        <div class="st-header__row">
            <StoreLogo />

            <nav class="st-nav">
                <a href="/" class="@Active("/")">خانه</a>
                <a href="/shop" class="@Active("/shop")">فروشگاه</a>
                <div class="st-nav__mega" @onkeydown="OnCatsKeyDown">
                    <button class="st-nav__trigger @(_catsOpen ? "open" : null)" type="button"
                            aria-haspopup="true" aria-expanded="@(_catsOpen ? "true" : "false")"
                            data-testid="catmenu-trigger"
                            @onclick="ToggleCats" @onmouseover="OpenCats" @onmouseout="ScheduleCloseCats">
                        دسته‌بندی‌ها <span class="chev">▾</span>
                    </button>
                    @if (_catsOpen)
                    {
                        <div class="st-scrim" @onclick="CloseCats"></div>
                        <div class="st-catmenu" data-testid="catmenu"
                             @onmouseover="CancelCloseCats" @onmouseout="ScheduleCloseCats">
                            <aside class="st-catmenu__side">
                                @foreach (var c in _categories)
                                {
                                    <a class="st-catmenu__cat @(c.Id == _activeCat?.Id ? "active" : null)"
                                       href="@($"/category/{c.Slug}")"
                                       @onmouseover="() => SelectCat(c)" @onfocus="() => SelectCat(c)" @onclick="CloseCats">
                                        <span class="st-mega__ic"><CategoryMedia IconKey="@c.Icon" ImagePath="@c.ImagePath" Alt="@c.Title" IconSize="16" /></span>
                                        <span class="st-catmenu__t">@c.Title</span>
                                        <span class="st-catmenu__chev"><Icon Name="chevron-left" Size="14" /></span>
                                    </a>
                                }
                                <a class="st-catmenu__all" href="/categories" @onclick="CloseCats">
                                    <Icon Name="grid" Size="15" /> مشاهده همه دسته‌بندی‌ها
                                </a>
                            </aside>
                            <section class="st-catmenu__panel">
                                @if (_activeCat is not null)
                                {
                                    <div class="st-catmenu__head">
                                        <div class="st-catmenu__title">@_activeCat.Title</div>
                                        <a class="st-catmenu__more" href="@($"/category/{_activeCat.Slug}")" @onclick="CloseCats">
                                            مشاهده همه <Icon Name="chevron-left" Size="14" />
                                        </a>
                                    </div>
                                    @if (_panelLoading)
                                    {
                                        <div class="st-catmenu__grid">
                                            @for (var i = 0; i < 6; i++) { <div class="st-catmenu__skel"></div> }
                                        </div>
                                    }
                                    else if (ActiveCatProducts.Count == 0)
                                    {
                                        <div class="st-catmenu__empty">هنوز محصولی در این دسته ثبت نشده است.</div>
                                    }
                                    else
                                    {
                                        <div class="st-catmenu__grid">
                                            @foreach (var p in ActiveCatProducts)
                                            {
                                                <a class="st-catmenu__item" href="@($"/product/{p.Slug}")" @onclick="CloseCats">
                                                    <span class="st-catmenu__thumb">
                                                        <StoreImage Url="@p.ThumbnailImagePath" Alt="@(p.ThumbnailAltText ?? p.Title)" Icon="package" />
                                                    </span>
                                                    <span class="st-catmenu__name">@p.Title</span>
                                                    <span class="st-catmenu__price">
                                                        @AUI.Number((long)p.FinalPrice)
                                                        <span class="unit">@(p.CurrencyType == (byte)CurrencyType.Rial ? "ریال" : "تومان")</span>
                                                    </span>
                                                </a>
                                            }
                                            <a class="st-catmenu__seeall" href="@($"/category/{_activeCat.Slug}")" @onclick="CloseCats">
                                                <Icon Name="arrow-left" Size="16" />
                                                <span>مشاهده همه محصولات</span>
                                            </a>
                                        </div>
                                    }
                                }
                            </section>
                        </div>
                    }
                </div>
                <a href="/blog" class="@Active("/blog")">وبلاگ</a>
                <a href="/faq" class="@Active("/faq")">سوالات متداول</a>
            </nav>

            <div class="st-search">
                <span class="ico"><Icon Name="search" Size="18" /></span>
                <input type="text" placeholder="جستجو در محصولات، بازی‌ها، گیفت کارت‌ها ..."
                       @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKey" @onfocus="OpenSearch" />
                @if (_searchOpen && Suggestions.Count > 0)
                {
                    <div class="st-scrim" @onclick="CloseSearch"></div>
                    <div class="st-search__drop">
                        <div class="st-search__label">@(string.IsNullOrWhiteSpace(_search) ? "دسته‌بندی‌های محبوب" : "پیشنهادها")</div>
                        @foreach (var s in Suggestions)
                        {
                            <a class="st-search__item" href="@($"/category/{s.Slug}")" @onclick="CloseSearch">
                                <Icon Name="search" Size="13" /> <span>@s.Title</span>
                            </a>
                        }
                    </div>
                }
            </div>

            <div class="st-header__actions">
                <ThemeToggle />

                <a class="st-iconbtn st-mobile-only" href="/search" title="جستجو"><Icon Name="search" Size="19" /></a>

                @if (_authenticated)
                {
                    <a class="st-iconbtn st-mobile-hide" href="/customer/wishlist" title="علاقه‌مندی‌ها">
                        <Icon Name="heart" Size="19" />
                        @if (Wishlist.Count > 0)
                        {
                            <span class="badge">@AdminUiHelper.Number(Wishlist.Count)</span>
                        }
                    </a>
                }

                <a class="st-iconbtn" href="/cart" title="سبد خرید">
                    <Icon Name="cart" Size="19" />
                    @if (Cart.Count > 0)
                    {
                        <span class="badge">@AdminUiHelper.Number(Cart.Count)</span>
                    }
                </a>

                @if (_authenticated)
                {
                    <div class="st-pmenu">
                        <button class="st-avatar" @onclick="ToggleMenu" type="button">@Initial</button>
                        @if (_menuOpen)
                        {
                            <div class="st-dropdown-backdrop" @onclick="CloseMenu"></div>
                            @* --end: the avatar is the last control in the RTL header, so the panel
                               must grow back into the page rather than off the viewport edge. *@
                            <div class="st-dropdown st-dropdown--end">
                                <a href="/customer/dashboard"><Icon Name="dashboard" Size="17" /> داشبورد</a>
                                <a href="/customer/orders"><Icon Name="cart" Size="17" /> سفارش‌های من</a>
                                <a href="/customer/wishlist"><Icon Name="heart" Size="17" /> علاقه‌مندی‌ها</a>
                                <a href="/customer/gift-codes"><Icon Name="gift" Size="17" /> کدهای من</a>
                                <a href="/customer/wallet"><Icon Name="wallet" Size="17" /> کیف پول</a>
                                <a href="/customer/tickets"><Icon Name="message" Size="17" /> پشتیبانی</a>
                                <div class="st-dropdown__divider"></div>
                                <form method="post" action="/auth/customer/logout" style="margin:0" data-enhance="false">
                                    <button type="submit" class="danger"><Icon Name="logout" Size="17" /> خروج از حساب</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <a class="st-btn st-btn--primary" href="/login" aria-label="ورود یا ثبت‌نام"><Icon Name="log-in" Size="17" /> <span class="st-mobile-hide">ورود | ثبت‌نام</span></a>
                }
            </div>
        </div>
    </div>
</header>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _authenticated;
    private bool _menuOpen;
    private bool _catsOpen;
    private bool _searchOpen;
    private bool _panelLoading;
    private StoreLookupModel? _activeCat;
    private readonly Dictionary<Guid, List<StoreProductModel>> _catProducts = new();
    private CancellationTokenSource? _closeCts;

    private List<StoreProductModel> ActiveCatProducts =>
        _activeCat is not null && _catProducts.TryGetValue(_activeCat.Id, out var items) ? items : new();
    private string _search = string.Empty;
    private string _name = "کاربر";
    private string Initial => string.IsNullOrWhiteSpace(_name) ? "ک" : _name.Trim()[..1];

    private List<StoreLookupModel> _categories = new();

    private List<StoreLookupModel> Suggestions => (string.IsNullOrWhiteSpace(_search)
        ? _categories
        : _categories.Where(c => c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .Take(6).ToList();

    protected override void OnInitialized()
    {
        Cart.OnChange += OnCartChange;
        Wishlist.OnChange += OnCartChange;
    }

    protected override async Task OnInitializedAsync()
    {
        // Categories feed both the mega menu and the search suggestions (real lookup API).
        try
        {
            var cats = await Api.GetAsync<List<StoreLookupModel>>("products/categories");
            if (cats.IsSuccess && cats.Data is not null) _categories = cats.Data;
        }
        catch { }

        if (AuthState is null) return;

        // The CUSTOMER identity specifically - never Identity.IsAuthenticated. The circuit principal
        // can be an administrator's while the customer is signed out (or carry both at once), and the
        // storefront header must render the customer's state, not "any session exists".
        var state = await AuthState;
        var customer = state.User.CustomerIdentity();
        _authenticated = customer is not null;

        if (customer is not null)
        {
            _name = customer.Name ?? "کاربر";
            await RefreshWishlist();
        }
        await RefreshCartCount();
    }

    private void OpenSearch() { _searchOpen = true; CloseCats(); }
    private void CloseSearch() => _searchOpen = false;

    // ---- Category mega menu -------------------------------------------------------------------
    // Hover-open with a grace delay on the way out, click for touch and keyboard. Products per
    // category are fetched lazily on first hover and cached for the circuit's lifetime; the request
    // carries no sort key so the panel follows the admin-configured storefront default order.

    private async Task OpenCats()
    {
        CancelCloseCats();
        if (_catsOpen) return;
        _catsOpen = true; _searchOpen = false; _menuOpen = false;
        if (_activeCat is null && _categories.Count > 0) await SelectCat(_categories[0]);
    }

    private async Task ToggleCats()
    {
        if (_catsOpen) CloseCats();
        else await OpenCats();
    }

    private void CloseCats() { CancelCloseCats(); _catsOpen = false; }

    private void CancelCloseCats() => _closeCts?.Cancel();

    /// <summary>Leaving the trigger or the panel closes the menu after a short grace period, so the
    /// pointer can cross the gap between them without the panel flickering shut.</summary>
    private void ScheduleCloseCats()
    {
        _closeCts?.Cancel();
        var cts = new CancellationTokenSource();
        _closeCts = cts;
        _ = CloseAfterGraceAsync(cts.Token);
    }

    private async Task CloseAfterGraceAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(300, token);
            await InvokeAsync(() => { _catsOpen = false; StateHasChanged(); });
        }
        // Cancellation is routine; a disposed circuit mid-grace is equally uninteresting. This task
        // is fire-and-forget, so nothing may escape it.
        catch { }
    }

    private async Task SelectCat(StoreLookupModel category)
    {
        if (_activeCat?.Id == category.Id) return;
        _activeCat = category;
        if (!_catProducts.ContainsKey(category.Id))
        {
            _panelLoading = true;
            try
            {
                var result = await Api.GetAsync<PagedResult<StoreProductModel>>(
                    $"products?categoryId={category.Id}&pageSize=6");
                _catProducts[category.Id] = result is { IsSuccess: true, Data: not null }
                    ? result.Data.Items.ToList()
                    : new List<StoreProductModel>();
            }
            catch { _catProducts[category.Id] = new List<StoreProductModel>(); }
            _panelLoading = false;
        }
    }

    private void OnCatsKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseCats();
    }

    private async Task RefreshCartCount()
    {
        try
        {
            var result = await Api.GetAsync<CartModel>("cart");
            if (result.IsSuccess && result.Data is not null)
                Cart.Set(result.Data.TotalQuantity);
        }
        catch { }
    }

    private async Task RefreshWishlist()
    {
        try
        {
            var result = await Api.GetAsync<List<Guid>>("wishlist/product-ids");
            if (result.IsSuccess && result.Data is not null)
                Wishlist.SetIds(result.Data);
        }
        catch { }
    }

    private void OnCartChange() => InvokeAsync(StateHasChanged);

    private string Active(string path)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (path == "/") return current == "/" || current == "" ? "active" : "";
        return current.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_search))
        {
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_search.Trim())}");
            _search = string.Empty;
        }
    }

    public void Dispose()
    {
        Cart.OnChange -= OnCartChange;
        Wishlist.OnChange -= OnCartChange;
    }
}
