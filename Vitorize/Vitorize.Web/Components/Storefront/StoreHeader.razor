@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject ApiClient Api
@inject CartState Cart
@inject WishlistState Wishlist
@using Vitorize.Web.Models.Store
@using AUI = Vitorize.Web.Helpers.AdminUiHelper

<header class="st-header" @ref="_header" @onkeydown="OnHeaderKey">
    <div class="st-container">
        <div class="st-header__row">
            <StoreLogo DefaultWord="vitorize" />

            <nav class="st-nav" aria-label="منوی اصلی">
                <div class="st-nav__mega">
                    <button class="st-nav__trigger @(_catsOpen ? "open" : null)" type="button"
                            aria-haspopup="true" aria-expanded="@(_catsOpen ? "true" : "false")"
                            data-testid="catmenu-trigger" aria-controls="store-category-menu"
                            @onclick="ToggleCats">
                        دسته‌بندی‌ها <Icon Name="chevron-down" Size="12" />
                    </button>
                    @if (_catsOpen)
                    {
                        <button class="st-scrim" type="button" tabindex="-1" aria-label="بستن دسته‌بندی‌ها" @onclick="CloseCats"></button>
                        <div class="st-catmenu" data-testid="catmenu" id="store-category-menu" aria-label="دسته‌بندی محصولات">
                            <aside class="st-catmenu__side">
                                @foreach (var c in RootCategories)
                                {
                                    <a class="st-catmenu__cat @(c.Id == _activeCat?.Id ? "active" : null)"
                                       href="@($"/category/{c.Slug}")"
                                       @onmouseover="() => SelectCat(c)" @onfocus="() => SelectCat(c)" @onclick="CloseCats">
                                        <span class="st-mega__ic"><CategoryMedia IconKey="@c.Icon" ImagePath="@c.ImagePath" Alt="@c.Title" IconSize="16" /></span>
                                        <span class="st-catmenu__t">@c.Title</span>
                                        <span class="st-catmenu__chev"><Icon Name="chevron-left" Size="14" /></span>
                                    </a>
                                }
                                <a class="st-catmenu__all" href="/categories" @onclick="CloseCats">
                                    <Icon Name="grid" Size="15" /> مشاهده همه دسته‌بندی‌ها
                                </a>
                            </aside>
                            <section class="st-catmenu__panel">
                                @if (_activeCat is not null)
                                {
                                    <div class="st-catmenu__head">
                                        <div class="st-catmenu__title">@_activeCat.Title</div>
                                        <a class="st-catmenu__more" href="@($"/category/{_activeCat.Slug}")" @onclick="CloseCats">
                                            مشاهده همه <Icon Name="chevron-left" Size="14" />
                                        </a>
                                    </div>
                                    @if (ActiveCatChildren.Count > 0)
                                    {
                                        <section class="st-catmenu__children" aria-label="زیر دسته‌های @_activeCat.Title">
                                            <div class="st-catmenu__section-title">زیر دسته‌های @_activeCat.Title</div>
                                            <div class="st-catmenu__child-grid">
                                                @foreach (var child in ActiveCatChildren)
                                                {
                                                    <a class="st-catmenu__child" href="@($"/category/{child.Slug}")" @onclick="CloseCats">
                                                        <span class="st-catmenu__child-ic"><CategoryMedia IconKey="@child.Icon" ImagePath="@child.ImagePath" Alt="@child.Title" IconSize="16" /></span>
                                                        <span>@child.Title</span>
                                                        <Icon Name="chevron-left" Size="14" />
                                                    </a>
                                                }
                                            </div>
                                        </section>
                                    }
                                    @if (_panelLoading)
                                    {
                                        <div class="st-catmenu__grid">
                                            @for (var i = 0; i < 6; i++) { <div class="st-catmenu__skel"></div> }
                                        </div>
                                    }
                                    else if (ActiveCatProducts.Count == 0)
                                    {
                                        <div class="st-catmenu__empty">هنوز محصولی در این دسته ثبت نشده است.</div>
                                    }
                                    else
                                    {
                                        <div class="st-catmenu__section-title">محصولات @_activeCat.Title</div>
                                        <div class="st-catmenu__grid">
                                            @foreach (var p in ActiveCatProducts)
                                            {
                                                <a class="st-catmenu__item" href="@ProductHref(p)" @onclick="CloseCats">
                                                    <span class="st-catmenu__thumb">
                                                        <StoreImage Url="@p.ThumbnailImagePath" Alt="@(p.ThumbnailAltText ?? p.Title)" Icon="package" />
                                                    </span>
                                                    <span class="st-catmenu__name">@p.Title</span>
                                                    <span class="st-catmenu__price">
                                                        @AUI.Number((long)p.FinalPrice)
                                                        <span class="unit">@(p.CurrencyType == (byte)CurrencyType.Rial ? "ریال" : "تومان")</span>
                                                    </span>
                                                </a>
                                            }
                                            <a class="st-catmenu__seeall" href="@($"/category/{_activeCat.Slug}")" @onclick="CloseCats">
                                                <Icon Name="arrow-left" Size="16" />
                                                <span>مشاهده همه محصولات</span>
                                            </a>
                                        </div>
                                    }
                                }
                            </section>
                        </div>
                    }
                </div>
                <a href="/about" class="@Active("/about")">درباره ما</a>
                <a href="/contact" class="@Active("/contact")">ارتباط با ما</a>
                <a href="/blog" class="@Active("/blog")">بلاگ‌ها</a>
            </nav>


            <div class="st-header__actions">
                <ThemeToggle />

                <button class="st-iconbtn sf-search-toggle" type="button" title="جستجو"
                        aria-label="باز کردن جستجو" aria-expanded="@(_mobileSearchOpen ? "true" : "false")"
                        @onclick="OpenMobileSearch">
                    <Icon Name="search" Size="19" />
                </button>
                <button class="st-iconbtn st-mobile-only st-mobile-menu-toggle" type="button" title="منو"
                        aria-label="باز کردن منو" aria-expanded="@(_mobileMenuOpen ? "true" : "false")"
                        @onclick="ToggleMobileMenu">
                    <Icon Name="menu" Size="20" />
                </button>

                @if (_authenticated)
                {
                    <a class="st-iconbtn st-mobile-hide" href="/customer/wishlist" title="علاقه‌مندی‌ها">
                        <Icon Name="heart" Size="19" />
                        @if (Wishlist.Count > 0)
                        {
                            <span class="badge">@AdminUiHelper.Number(Wishlist.Count)</span>
                        }
                    </a>
                }

                <a class="st-iconbtn sf-cart" href="/cart" title="سبد خرید" aria-label="سبد خرید">
                    <Icon Name="cart" Size="19" />
                    @if (Cart.Count > 0)
                    {
                        <span class="badge">@AdminUiHelper.Number(Cart.Count)</span>
                    }
                </a>

                @if (_authenticated)
                {
                    <div class="st-pmenu">
                        <button class="st-avatar" @onclick="ToggleMenu" type="button" aria-label="منوی حساب کاربری" aria-expanded="@_menuOpen">@Initial</button>
                        @if (_menuOpen)
                        {
                            <div class="st-dropdown-backdrop" @onclick="CloseMenu"></div>
                            @* --end: the avatar is the last control in the RTL header, so the panel
                               must grow back into the page rather than off the viewport edge. *@
                            <div class="st-dropdown st-dropdown--end">
                                <a href="/customer/dashboard"><Icon Name="dashboard" Size="17" /> داشبورد</a>
                                <a href="/customer/orders"><Icon Name="cart" Size="17" /> سفارش‌های من</a>
                                <a href="/customer/wishlist"><Icon Name="heart" Size="17" /> علاقه‌مندی‌ها</a>
                                <a href="/customer/gift-codes"><Icon Name="gift" Size="17" /> کدهای من</a>
                                <a href="/customer/wallet"><Icon Name="wallet" Size="17" /> کیف پول</a>
                                <a href="/customer/tickets"><Icon Name="message" Size="17" /> پشتیبانی</a>
                                <div class="st-dropdown__divider"></div>
                                <form method="post" action="/auth/customer/logout" style="margin:0" data-enhance="false">
                                    <button type="submit" class="danger"><Icon Name="logout" Size="17" /> خروج از حساب</button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <a class="st-btn st-btn--primary sf-account" href="/login" aria-label="ورود یا ثبت‌نام"><Icon Name="contact-round" Size="20" /> <span class="st-mobile-hide">ورود | ثبت‌نام</span></a>
                }
            </div>
        </div>
    </div>

    @if (_mobileSearchOpen)
    {
        <div class="st-mobile-search" role="dialog" aria-modal="true" aria-label="جستجو در محصولات">
            <button type="button" class="sf-dialog-backdrop" tabindex="-1" aria-label="بستن جستجو" @onclick="CloseMobileSearch"></button>
            <div class="sf-search-panel">
            <form class="st-mobile-search__bar" @onsubmit="SubmitMobileSearch" @onsubmit:preventDefault="true">
                <Icon Name="search" Size="20" />
                <input @ref="_mobileSearchInput" type="search" autocomplete="off"
                       placeholder="جستجو در محصولات، بازی‌ها، گیفت کارت‌ها ..."
                       aria-label="عبارت جستجو" @bind="_search" @bind:event="oninput"
                       @onkeydown="OnMobileSearchKey" />
                <button class="st-mobile-search__submit" type="submit">جستجو</button>
                <button class="st-mobile-search__close" type="button" aria-label="بستن جستجو" @onclick="CloseMobileSearch">
                    <Icon Name="x" Size="21" />
                </button>
            </form>
            @if (Suggestions.Count > 0)
            {
                <div class="sf-search-suggestions">
                    <p>@(string.IsNullOrWhiteSpace(_search) ? "دسته‌بندی‌های محبوب" : "دسته‌بندی‌های مرتبط")</p>
                    @foreach (var suggestion in Suggestions)
                    { <a href="@($"/category/{suggestion.Slug}")" @onclick="CloseMobileSearch"><Icon Name="search" Size="16" /> @suggestion.Title</a> }
                </div>
            }
            </div>
        </div>
    }

    @if (_mobileMenuOpen)
    {
        <div class="st-mobile-nav" role="dialog" aria-modal="true" aria-label="منوی اصلی">
            <button class="st-mobile-nav__backdrop" aria-label="بستن منو" @onclick="CloseMobileMenu"></button>
            <nav class="st-mobile-nav__sheet">
                <div class="sf-mobile-menu-head"><strong>منوی ویتورایز</strong><button type="button" class="st-iconbtn" aria-label="بستن منو" @onclick="CloseMobileMenu"><Icon Name="x" Size="22" /></button></div>
                <a href="/shop" @onclick="CloseMobileMenu">فروشگاه</a>
                <a href="/categories" @onclick="CloseMobileMenu">همه دسته‌بندی‌ها</a>
                @foreach (var category in RootCategories)
                { <a href="@($"/category/{category.Slug}")" @onclick="CloseMobileMenu">@category.Title</a> }
                <a href="/about" @onclick="CloseMobileMenu">درباره ما</a>
                <a href="/contact" @onclick="CloseMobileMenu">ارتباط با ما</a>
                <a href="/blog" @onclick="CloseMobileMenu">بلاگ‌ها</a>
                <div class="sf-mobile-menu-tools"><span>ظاهر سایت</span><ThemeToggle /></div>
            </nav>
        </div>
    }
</header>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _authenticated;
    private bool _menuOpen;
    private bool _catsOpen;
    private bool _mobileSearchOpen;
    private bool _mobileMenuOpen;
    private bool _focusMobileSearch;
    private bool _panelLoading;
    private ElementReference _header;
    private IJSObjectReference? _shellModule;
    private string? _returnFocus;
    private bool _focusSheet;
    private ElementReference _mobileSearchInput;
    private StoreLookupModel? _activeCat;
    private readonly Dictionary<Guid, List<StoreProductModel>> _catProducts = new();
    private bool _disposed;

    private List<StoreProductModel> ActiveCatProducts =>
        _activeCat is not null && _catProducts.TryGetValue(_activeCat.Id, out var items) ? items : new();
    private List<StoreLookupModel> RootCategories => _categories.Where(x => x.ParentId is null).ToList();
    private List<StoreLookupModel> ActiveCatChildren => _activeCat is null
        ? new()
        : _categories.Where(x => x.ParentId == _activeCat.Id).ToList();
    private string _search = string.Empty;
    private string _name = "کاربر";
    private string Initial => string.IsNullOrWhiteSpace(_name) ? "ک" : _name.Trim()[..1];

    private List<StoreLookupModel> _categories = new();

    private List<StoreLookupModel> Suggestions => (string.IsNullOrWhiteSpace(_search)
        ? _categories
        : _categories.Where(c => c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .Take(6).ToList();

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        Cart.OnChange += OnCartChange;
        Wishlist.OnChange += OnCartChange;
    }

    protected override async Task OnInitializedAsync()
    {
        // Categories feed both the mega menu and the search suggestions (real lookup API).
        try
        {
            var cats = await Api.GetAsync<List<StoreLookupModel>>("products/categories");
            if (cats.IsSuccess && cats.Data is not null) _categories = cats.Data;
        }
        catch { }

        if (AuthState is null) return;

        // The CUSTOMER identity specifically - never Identity.IsAuthenticated. The circuit principal
        // can be an administrator's while the customer is signed out (or carry both at once), and the
        // storefront header must render the customer's state, not "any session exists".
        var state = await AuthState;
        var customer = state.User.CustomerIdentity();
        _authenticated = customer is not null;

        if (customer is not null)
        {
            _name = customer.Name ?? "کاربر";
            await RefreshWishlist();
        }
        await RefreshCartCount();
    }

    private static string ProductHref(StoreProductModel product) => string.IsNullOrWhiteSpace(product.RedirectUrl)
        ? $"/product/{product.Slug}"
        : product.RedirectUrl;

    private void OpenMobileSearch()
    {
        _mobileSearchOpen = true;
        _mobileMenuOpen = false;
        _focusMobileSearch = true;
        CloseCats();
        CloseMenu();
    }

    private void CloseMobileSearch()
    {
        _returnFocus = ".sf-search-toggle";
        _mobileSearchOpen = false;
        _search = string.Empty;
    }

    private void SubmitMobileSearch()
    {
        var term = _search.Trim();
        if (string.IsNullOrWhiteSpace(term)) return;

        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(term)}");
        _mobileSearchOpen = false;
        _search = string.Empty;
    }

    private void OnMobileSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseMobileSearch();
    }

    private void OnHeaderKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_mobileSearchOpen) CloseMobileSearch();
        if (_mobileMenuOpen) CloseMobileMenu();
        if (_catsOpen) { CloseCats(); _returnFocus = "[data-testid=catmenu-trigger]"; }
        if (_menuOpen) { CloseMenu(); _returnFocus = ".st-avatar"; }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileSearchOpen = _mobileMenuOpen = _catsOpen = _menuOpen = false;
        _returnFocus = null;
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); } catch (InvalidOperationException) { }
    }

    // ---- Category mega menu -------------------------------------------------------------------
    // Click/keyboard opens the focus panel. Products per
    // category are fetched lazily on selection and cached for the circuit's lifetime; the request
    // carries no sort key so the panel follows the admin-configured storefront default order.

    private async Task OpenCats()
    {
        if (_catsOpen) return;
        _catsOpen = true; _menuOpen = false;
        if (_activeCat is null && RootCategories.Count > 0) await SelectCat(RootCategories[0]);
    }

    private async Task ToggleCats()
    {
        if (_catsOpen) CloseCats();
        else await OpenCats();
    }

    private void CloseCats() => _catsOpen = false;

    private async Task SelectCat(StoreLookupModel category)
    {
        if (_activeCat?.Id == category.Id) return;
        _activeCat = category;
        _panelLoading = !_catProducts.ContainsKey(category.Id);
        if (!_catProducts.ContainsKey(category.Id))
        {
            _panelLoading = true;
            try
            {
                var result = await Api.GetAsync<PagedResult<StoreProductModel>>(
                    $"products?categoryId={category.Id}&pageSize=6");
                _catProducts[category.Id] = result is { IsSuccess: true, Data: not null }
                    ? result.Data.Items.ToList()
                    : new List<StoreProductModel>();
            }
            catch { _catProducts[category.Id] = new List<StoreProductModel>(); }
            if (_activeCat?.Id == category.Id) _panelLoading = false;
        }
    }

    private async Task RefreshCartCount()
    {
        try
        {
            var result = await Api.GetAsync<CartModel>("cart");
            if (result.IsSuccess && result.Data is not null)
                Cart.Set(result.Data.TotalQuantity);
        }
        catch { }
    }

    private async Task RefreshWishlist()
    {
        try
        {
            var result = await Api.GetAsync<List<Guid>>("wishlist/product-ids");
            if (result.IsSuccess && result.Data is not null)
                Wishlist.SetIds(result.Data);
        }
        catch { }
    }

    private async void OnCartChange()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); }
        catch (InvalidOperationException) { }
    }

    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
        _focusSheet = _mobileMenuOpen;
        _mobileSearchOpen = false;
        CloseCats();
        CloseMenu();
    }

    private void CloseMobileMenu() { _mobileMenuOpen = false; _returnFocus = ".st-mobile-menu-toggle"; }

    private string Active(string path)
    {
        var current = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        if (path == "/") return current == "/" || current == "" ? "active" : "";
        return current.StartsWith(path, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
        _catsOpen = _mobileMenuOpen = _mobileSearchOpen = false;
    }
    private void CloseMenu() => _menuOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _shellModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/site-shell.js");
            await _shellModule.InvokeVoidAsync("install", _header);
        }
        if (_shellModule is not null && _returnFocus is not null)
        {
            var selector = _returnFocus;
            _returnFocus = null;
            await _shellModule.InvokeVoidAsync("focus", _header, selector);
        }
        if (_shellModule is not null && _focusSheet)
        {
            _focusSheet = false;
            await _shellModule.InvokeVoidAsync("focus", _header, ".st-mobile-nav__sheet button");
        }
        if (!_focusMobileSearch) return;

        _focusMobileSearch = false;
        try { await _mobileSearchInput.FocusAsync(); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Cart.OnChange -= OnCartChange;
        Wishlist.OnChange -= OnCartChange;
        Nav.LocationChanged -= OnLocationChanged;
        if (_shellModule is not null)
        {
            try { await _shellModule.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
}
