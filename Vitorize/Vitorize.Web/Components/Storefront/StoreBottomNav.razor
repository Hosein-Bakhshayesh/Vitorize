@inject NavigationManager Nav

@implements IDisposable

<nav class="st-bottomnav" aria-label="دسترسی سریع موبایل">
    @foreach (var item in Items)
    {
        <a href="@item.Path" class="@(Selected == item.Path ? "active" : null)" aria-current="@(Selected == item.Path ? "page" : null)"><Icon Name="@item.Icon" Size="20" /> @item.Title</a>
    }
</nav>

@code {
    private bool _disposed;
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;
    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); } catch (InvalidOperationException) { }
    }
    public void Dispose() { _disposed = true; Nav.LocationChanged -= OnLocationChanged; }
    private static readonly (string Path, string Icon, string Title)[] Items =
    [("/", "home", "خانه"), ("/shop", "grid", "فروشگاه"), ("/cart", "cart", "سبد خرید"),
     ("/customer/orders", "list", "سفارش‌ها"), ("/customer/dashboard", "user", "حساب من")];
    private string Selected => new Uri(Nav.Uri).AbsolutePath switch
    {
        "/" => "/",
        var p when p.StartsWith("/customer/orders", StringComparison.OrdinalIgnoreCase) => "/customer/orders",
        var p when p.StartsWith("/customer/", StringComparison.OrdinalIgnoreCase) => "/customer/dashboard",
        "/cart" or "/checkout" or "/payment/result" => "/cart",
        var p when p == "/shop" || p == "/search" || p.StartsWith("/categor", StringComparison.OrdinalIgnoreCase) ||
                   p.StartsWith("/brand/", StringComparison.OrdinalIgnoreCase) || p.StartsWith("/product/", StringComparison.OrdinalIgnoreCase) => "/shop",
        _ => ""
    };
}
