@inject Vitorize.Web.Services.UI.StoreBrandingService Branding
@inject MediaUrlResolver Media
@using Vitorize.Web.Helpers

@* Without a logotype the mark has to carry the brand on its own, including on phones where the
   header shows the logotype alone; the class is what tells the stylesheet to keep the mark there. *@
<a class="st-logo @(_custom ? "st-logo--custom" : null) @(_hasWordmark ? null : "st-logo--markonly")" href="@Href" aria-label="@_alt">
    <img class="st-logo__img @(_hasDark ? "st-logo__img--light" : null)" src="@_src" alt="@_alt" width="42" height="42" />
    @if (_hasDark)
    {
        <img class="st-logo__img st-logo__img--dark" src="@_darkSrc" alt="@_alt" width="42" height="42" />
    }
    @if (ShowWord && _hasWordmark)
    {
        @* The shipped file's proportions are known, so its box can be reserved before it loads; an
           uploaded one is measured by the browser instead of guessed at here. *@
        <img class="st-logo__wordmark" src="@_wordmarkSrc" alt=""
             width="@(_packagedWordmark ? 210 : (int?)null)" height="@(_packagedWordmark ? 42 : (int?)null)" />
    }
</a>

@code {
    [Parameter] public string Href { get; set; } = "/";
    [Parameter] public bool ShowWord { get; set; } = true;
    [Parameter] public string? DefaultWord { get; set; }
    /// <summary>header | footer | small — کدام لوگو از تنظیمات استفاده شود.</summary>
    [Parameter] public string Variant { get; set; } = "header";

    private const string DefaultLogo = "images/logo.png";
    private string _src = DefaultLogo;
    private string _darkSrc = DefaultLogo;
    private bool _hasDark;
    private bool _custom;
    private string _alt = "ویتورایز";
    private string _word = "ویتورایز";
    private string _wordmarkSrc = string.Empty;
    private bool _hasWordmark;
    private bool _packagedWordmark;

    protected override async Task OnInitializedAsync()
    {
        var b = await Branding.GetAsync();

        if (!string.IsNullOrWhiteSpace(b.SiteName))
        {
            _alt = b.SiteName;
            _word = b.Get("SiteName", DefaultWord ?? b.SiteName);
        }

        var path = Variant switch
        {
            "footer" => b.FooterLogoPath,
            "small" => FirstNonEmpty(b.LogoSmallPath, b.LogoPath, b.SiteLogoPath),
            _ => b.HeaderLogoPath
        };

        if (!string.IsNullOrWhiteSpace(path))
        {
            _custom = true;
            _src = Versioned(Media.Resolve(path), b.AssetVersion);
        }

        if (!string.IsNullOrWhiteSpace(b.LogoDarkPath))
        {
            _darkSrc = Versioned(Media.Resolve(b.LogoDarkPath), b.AssetVersion);
            _hasDark = true;
        }

        // The logotype is a setting like any other image now, so it can be replaced without a
        // release. Cleared deliberately, it leaves the mark standing on its own rather than a gap.
        var wordmark = b.WordmarkPath;
        _hasWordmark = !string.IsNullOrWhiteSpace(wordmark);
        _packagedWordmark = BrandAsset.IsPackaged(wordmark);
        _wordmarkSrc = _packagedWordmark ? wordmark : Versioned(Media.Resolve(wordmark), b.AssetVersion);
    }

    private static string FirstNonEmpty(params string[] values)
    {
        foreach (var v in values)
            if (!string.IsNullOrWhiteSpace(v)) return v;
        return string.Empty;
    }
    private static string Versioned(string url, string version) => $"{url}{(url.Contains('?') ? '&' : '?')}v={Uri.EscapeDataString(version)}";
}
