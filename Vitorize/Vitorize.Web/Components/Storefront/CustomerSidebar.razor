@implements IDisposable
@inject NavigationManager Nav

<aside class="st-acc__side" aria-label="حساب کاربری" @onkeydown="OnMenuKeyDown">
    <div class="st-acc__user">
        <span class="st-avatar" aria-hidden="true">@Initial</span>
        <div class="customer-identity">
            <div class="customer-name">@_name</div>
            <div class="st-muted customer-caption">حساب کاربری</div>
        </div>
    </div>
    <button type="button" class="st-acc__mobile-toggle" aria-expanded="@(_mobileMenuOpen ? "true" : "false")" aria-controls="customer-account-nav" @onclick="ToggleMobileMenu" @ref="_menuToggle">
        <span><Icon Name="menu" Size="18" /> بخش‌های حساب کاربری</span>
        <Icon Name="chevron-down" Size="18" class="st-acc__mobile-chevron" />
    </button>
    <nav id="customer-account-nav" aria-label="بخش‌های حساب کاربری" class="st-acc__nav @(_mobileMenuOpen ? "is-open" : null)">
        <NavLink href="/customer/dashboard" Match="NavLinkMatch.All"><span class="ic"><Icon Name="dashboard" Size="18" /></span> داشبورد</NavLink>
        <NavLink href="/customer/orders"><span class="ic"><Icon Name="cart" Size="18" /></span> سفارش‌های من</NavLink>
        <NavLink href="/customer/gift-codes"><span class="ic"><Icon Name="gift" Size="18" /></span> کدهای من</NavLink>
        <NavLink href="/customer/wishlist"><span class="ic"><Icon Name="heart" Size="18" /></span> علاقه‌مندی‌ها</NavLink>
        <NavLink href="/customer/wallet"><span class="ic"><Icon Name="wallet" Size="18" /></span> کیف پول</NavLink>
        <NavLink href="/customer/verification"><span class="ic"><Icon Name="user-check" Size="18" /></span> احراز هویت</NavLink>
        <NavLink href="/customer/tickets"><span class="ic"><Icon Name="message" Size="18" /></span> پشتیبانی و تیکت‌ها</NavLink>
        <NavLink href="/customer/notifications"><span class="ic"><Icon Name="bell" Size="18" /></span> اعلان‌ها</NavLink>
        <NavLink href="/customer/reviews"><span class="ic"><Icon Name="star" Size="18" /></span> نظرات من</NavLink>
        <NavLink href="/customer/profile"><span class="ic"><Icon Name="user" Size="18" /></span> پروفایل و امنیت</NavLink>
        <form method="post" action="/auth/customer/logout" class="customer-logout" data-enhance="false">
            <button type="submit" class="st-acc__nav-logout">
                <span class="ic"><Icon Name="logout" Size="18" /></span> خروج از حساب
            </button>
        </form>
    </nav>
</aside>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string _name = "کاربر";
    private string Initial => string.IsNullOrWhiteSpace(_name) ? "ک" : _name.Trim()[..1];

    private bool _mobileMenuOpen;
    private ElementReference _menuToggle;
    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private async Task OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || !_mobileMenuOpen) return;
        _mobileMenuOpen = false;
        await _menuToggle.FocusAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(() => { _mobileMenuOpen = false; StateHasChanged(); });

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        if (AuthState is null) return;
        var state = await AuthState;
        _name = state.User.CustomerIdentity()?.Name ?? state.User.Identity?.Name ?? "کاربر";
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
