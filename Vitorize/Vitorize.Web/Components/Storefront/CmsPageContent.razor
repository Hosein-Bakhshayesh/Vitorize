@* Shared CMS page renderer used by /page/{slug} and by every system route, so the storefront has
   exactly one rich-content layout. Content is sanitised server-side on save and again on read. *@

<div class="st-bc"><a href="/">خانه</a> <Icon Name="chevron-left" Size="13" /> <span>@Title</span></div>
<article class="st-content-page" data-testid="cms-page">
    <h1 data-testid="cms-page-title">@Title</h1>
    <div class="st-rich-content" data-testid="cms-page-content" style="line-height:2.1;font-size:15px;color:var(--st-text-2)">
        @((MarkupString)(ContentHtml ?? string.Empty))
    </div>
    @if (Extra is not null)
    {
        @Extra
    }
</article>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? ContentHtml { get; set; }
    /// <summary>Optional trailing content, used by the Contact page for its settings block.</summary>
    [Parameter] public RenderFragment? Extra { get; set; }
}
