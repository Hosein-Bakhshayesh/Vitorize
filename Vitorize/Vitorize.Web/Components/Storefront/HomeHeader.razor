@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StoreBrandingService Branding
@inject ApiClient Api
@inject CartState Cart

<div class="hp-mobile-cap" aria-hidden="true"></div>
<header class="hp-header @(_open ? "is-focused" : null)" @ref="_header" @onkeydown="HandleKey">
    <div class="hp-header__row">
        <HomeLogo Branding="_branding" />
        <nav class="hp-nav" aria-label="منوی اصلی">
            <button type="button" @ref="_trigger" @onclick="Toggle" aria-expanded="@_open" aria-controls="hp-category-panel">دسته‌بندی‌ها <Icon Name="chevron-down" Size="12" /></button>
            <a href="/about">درباره ما</a><a href="/contact">ارتباط با ما</a><a href="/blog">بلاگ‌ها</a>
        </nav>
        <div class="hp-header__actions">
            <a class="hp-search" href="/search" aria-label="جستجو"><Icon Name="search" Size="20" /></a>
            <a class="hp-cart" href="/cart" aria-label="سبد خرید"><Icon Name="cart" Size="20" />@if (Cart.Count > 0) { <span class="hp-cart__count">@AdminUiHelper.Number(Cart.Count)</span> }</a>
            <a class="hp-account" href="@(_authenticated ? "/customer/dashboard" : "/login")" aria-label="حساب کاربری"><Icon Name="contact-round" Size="20" /></a>
            <button class="hp-menu-toggle" type="button" @ref="_mobileTrigger" @onclick="Toggle" aria-label="دسته‌بندی‌ها و منو" aria-expanded="@_open" aria-controls="hp-category-panel"><Icon Name="menu" Size="20" /></button>
        </div>
    </div>
    @if (_open)
    {
        <nav id="hp-category-panel" class="hp-focus-panel" aria-label="دسته‌بندی محصولات">
            @* Real category navigation, shaped like the tree the administrator configured: roots on the
               right, the hovered root's branches on the left. Every root's group is rendered so that
               narrow screens, where there is no hover, can stack the whole tree instead of one branch. *@
            <div class="hp-mega">
                <aside class="hp-mega__roots">
                    @* The rail scrolls, the "all categories" link does not: it must stay reachable
                       however many roots the administrator configures. *@
                    <div class="hp-mega__rootlist">
                    @foreach (var root in RootCategories)
                    {
                        var current = root;
                        <a class="hp-mega__root @(root.Id == ActiveRoot?.Id ? "is-active" : null)"
                           href="@CategoryUrl(root)"
                           @onmouseover="() => _activeRootId = current.Id" @onfocus="() => _activeRootId = current.Id">
                            <span class="hp-mega__ic" aria-hidden="true"><CategoryMedia IconKey="@root.Icon" ImagePath="@root.ImagePath" Alt="@root.Title" IconSize="18" /></span>
                            <span class="hp-mega__root-t">@root.Title</span>
                            <Icon Name="chevron-left" Size="14" />
                        </a>
                    }
                    </div>
                    <a class="hp-mega__all" href="/categories"><Icon Name="grid" Size="15" /> <span>مشاهده همه دسته‌بندی‌ها</span></a>
                </aside>
                <div class="hp-mega__panel">
                    @foreach (var root in RootCategories)
                    {
                        var branches = ChildrenOf(root.Id);
                        <section class="hp-mega__group @(root.Id == ActiveRoot?.Id ? "is-active" : null)" aria-label="@root.Title">
                            <div class="hp-mega__head">
                                <span class="hp-mega__ic" aria-hidden="true"><CategoryMedia IconKey="@root.Icon" ImagePath="@root.ImagePath" Alt="@root.Title" IconSize="18" /></span>
                                <strong>@root.Title</strong>
                                <a href="@CategoryUrl(root)">مشاهده همه محصولات <Icon Name="chevron-left" Size="13" /></a>
                            </div>
                            @if (branches.Count > 0)
                            {
                                <div class="hp-mega__cols">
                                    @foreach (var branch in branches)
                                    {
                                        var leaves = DescendantsOf(branch.Id);
                                        <div class="hp-mega__col">
                                            <a class="hp-mega__branch" href="@CategoryUrl(branch)">@branch.Title</a>
                                            @if (leaves.Count > 0)
                                            {
                                                <ul class="hp-mega__leaves">
                                                    @foreach (var leaf in leaves)
                                                    { <li><a href="@CategoryUrl(leaf)">@leaf.Title</a></li> }
                                                </ul>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </section>
                    }
                </div>
            </div>
            <div class="hp-mega__links">
                <a class="hp-mobile-link" href="/about">درباره ما</a>
                <a class="hp-mobile-link" href="/contact">ارتباط با ما</a>
                <a class="hp-mobile-link" href="/blog">بلاگ‌ها</a>
            </div>
        </nav>
    }
</header>
@if (_open)
{
    <button class="hp-focus-backdrop" tabindex="-1" aria-label="بستن دسته‌بندی‌ها" @onclick="Close"></button>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private StoreBranding _branding = new(new Dictionary<string, string>());
    private List<StoreLookupModel> _categories = new();
    private Guid? _activeRootId;
    private List<StoreLookupModel> RootCategories => CategoryTree.Roots(_categories);
    /// <summary>The root whose branches the panel shows; the first one until a pointer picks another.</summary>
    private StoreLookupModel? ActiveRoot => RootCategories.FirstOrDefault(c => c.Id == _activeRootId) ?? RootCategories.FirstOrDefault();
    private List<StoreLookupModel> ChildrenOf(Guid parentId) => CategoryTree.ChildrenOf(_categories, parentId);
    private List<StoreLookupModel> DescendantsOf(Guid parentId) => CategoryTree.DescendantsOf(_categories, parentId);
    private static string CategoryUrl(StoreLookupModel category) => $"/category/{category.Slug}";
    private bool _open, _authenticated, _disposed;
    private ElementReference _trigger, _mobileTrigger;
    private ElementReference _header;
    private IJSObjectReference? _module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_open) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/home.js");
        await _module.InvokeVoidAsync("installMenuKeyboardNavigation", _header);
    }

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += Changed;
        _branding = await Branding.GetAsync();
        if (AuthState is not null) _authenticated = (await AuthState).User.CustomerIdentity() is not null;
        var categories = await Api.GetAsync<List<StoreLookupModel>>("products/categories");
        if (categories is { IsSuccess: true, Data: not null }) _categories = categories.Data;
        var cart = await Api.GetAsync<CartModel>("cart");
        if (cart is { IsSuccess: true, Data: not null }) Cart.Set(cart.Data.TotalQuantity);
    }
    private void Toggle() => _open = !_open;
    private async Task Close()
    {
        _open = false;
        await _trigger.FocusAsync(preventScroll: true);
        await _mobileTrigger.FocusAsync(preventScroll: true);
    }
    private async Task HandleKey(KeyboardEventArgs e) { if (e.Key == "Escape" && _open) await Close(); }
    private async void Changed()
    {
        if (_disposed) return;
        try { await InvokeAsync(StateHasChanged); } catch (InvalidOperationException) { }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Cart.OnChange -= Changed;
        if (_module is null) return;
        try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}
