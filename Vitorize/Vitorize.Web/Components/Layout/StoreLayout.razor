@inherits LayoutComponentBase
@implements IDisposable
@using Vitorize.Web.Components.Storefront
@using Vitorize.Web.Helpers
@inject Vitorize.Web.Services.UI.StorefrontMaintenanceService Maintenance
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

@if (_maintenance)
{
    <div class="st-shell">
        <main class="st-main">
            <div class="st-container"><StoreState Info="_info" /></div>
        </main>
    </div>
}
else
{
    <a class="st-skip-link" href="#main-content">پرش به محتوای اصلی</a>
    <div class="st-shell">
        <StoreHeader />
        <main id="main-content" class="st-main" tabindex="-1">
            <div class="st-container">
                @Body
            </div>
        </main>
        <StoreFooter />
        <StoreBottomNav />
    </div>
}

<ToastHost />

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _maintenance;
    private ErrorStateInfo _info =
        ErrorStates.Resolve("503", new Vitorize.Web.Services.UI.StoreBranding(new Dictionary<string, string>()));

    protected override async Task OnInitializedAsync()
    {
        // Re-evaluated on every in-circuit navigation too: a shopper who was already browsing when
        // maintenance was switched on lands on the maintenance page at their next navigation instead
        // of continuing through a closed shop (purchasing is refused by the API either way).
        Nav.LocationChanged += OnLocationChanged;
        await EvaluateAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // async void: anything escaping this handler is an unhandled exception that kills the whole
        // process, not a rendering glitch. A transient branding/API failure during navigation must
        // simply leave the current maintenance verdict in place.
        try
        {
            var was = _maintenance;
            await EvaluateAsync();
            if (_maintenance != was) await InvokeAsync(StateHasChanged);
        }
        catch
        {
        }
    }

    private async Task EvaluateAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        var state = await Maintenance.GetStateAsync(user);
        if (state is not null)
        {
            _maintenance = true;
            _info = ErrorStates.Resolve("503", state.Branding) with
            {
                Message = state.Branding.Get("MaintenanceMessage", state.Branding.Get("Error503Text", "سایت موقتاً در دسترس نیست."))
            };

            // The layout renders the maintenance state instead of @Body, so the page component never
            // runs and never sets its own status. Without this the document would be served as 200
            // while showing "we are down", which is wrong for caches, crawlers and uptime checks alike.
            var response = HttpContextAccessor.HttpContext?.Response;
            if (response is not null && !response.HasStarted)
                response.StatusCode = StatusCodes.Status503ServiceUnavailable;
        }
        else
        {
            _maintenance = false;
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
